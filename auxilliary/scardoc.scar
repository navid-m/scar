import "std/io"
import "std/os"
import "std/strings" 
import "std/fs"
import "std/collections"
import "std/regex"

unsafe alias add_elem = collections::StringArrayList::add_element
unsafe alias get_size = collections::StringArrayList::get_size
unsafe alias get_element = collections::StringArrayList::get_element

class ParsedDoc:
    init:
        var this.imports        = new collections::StringArrayList(100)
        var this.functions      = new collections::StringArrayList(100)
        var this.classes        = new collections::StringArrayList(100)
        var this.function_docs  = new collections::StringArrayList(100)
        var this.class_docs     = new collections::StringArrayList(100)
        var this.methods        = new collections::StringArrayList(200)
        var this.method_docs    = new collections::StringArrayList(200)
        var this.method_parents = new collections::StringArrayList(200)
        string this.filepath    = ""
        string this.module_name = ""

fn extract_function_name(string line) -> string:
    string pattern = "^(?:pub\\s+)?fn\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\("
    
    list[string] matches = regex::find(pattern, line)
    if len(matches) >= 2:
        print "Function found: %s" | matches[1]
        return matches[1]
    
    return ""

fn extract_class_name(string line) -> string:
    string pattern = "^(?:pub\\s+)?class\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*:"
    
    list[string] matches = regex::find(pattern, line)
    if len(matches) >= 2:
        print "Class found: %s" | matches[1]
        return matches[1]
    
    return ""

fn extract_import(string line) -> string:
    string pattern = "^import\\s+\"([^\"]+)\""
    
    list[string] matches = regex::find(pattern, line)
    if len(matches) >= 2:
        print "Import found: %s" | matches[1]
        return matches[1]
    
    return ""

fn parse_file(string fpath, string module_name) -> ref ParsedDoc:
    ref ParsedDoc doc = new ParsedDoc()
    doc.filepath = fpath
    doc.module_name = module_name
    list[string] lines = fs::read_lines(fpath)
    string current_class = ""
    int class_indent = -1
    for int i = 0; i < len(lines); i++:
        string line = lines[i]
        string trimmed = strings::trim_space(line)
        if strings::length(trimmed) == 0:
            continue
        int indent = 0
        string left = line
        while strings::starts_with(left, " ") or strings::starts_with(left, "\t"):
            if strings::starts_with(left, " "):
                left = strings::trim_prefix(left, " ")
                indent = indent + 1
            else:
                left = strings::trim_prefix(left, "\t")
                indent = indent + 1
        if strings::length(current_class) > 0 and indent <= class_indent and !regex::matches("^(?:pub\\s+)?class\\s+", trimmed):
            current_class = ""
            class_indent = -1
        if regex::matches("^import\\s+\"[^\"]+\"", trimmed):
            string import_path = extract_import(trimmed)
            if strings::length(import_path) > 0:
                add_elem(doc.imports, import_path)
        if regex::matches("^(?:pub\\s+)?class\\s+[a-zA-Z_][a-zA-Z0-9_]*\\s*:", trimmed):
            string class_name = extract_class_name(trimmed)
            if strings::length(class_name) > 0:
                add_elem(doc.classes, class_name)
                current_class = class_name
                class_indent = indent
                int j = i - 1
                int start = j
                while start >= 0:
                    string t = strings::trim(lines[start])
                    if strings::starts_with(t, "##"):
                        start = start - 1
                        continue
                    break
                start = start + 1
                var cbuild = new strings::Builder()
                int k = start
                while k <= j:
                    string t2 = strings::trim(lines[k])
                    string content = strings::trim_prefix(t2, "##")
                    if strings::starts_with(content, " "):
                        content = strings::trim_prefix(content, " ")
                    cbuild.append(content)
                    cbuild.append("\n")
                    k = k + 1
                add_elem(doc.class_docs, cbuild.buffer)
        if strings::length(current_class) > 0:
            bool is_method_sig = strings::starts_with(trimmed, "fn ") or strings::starts_with(trimmed, "pub fn ") or regex::matches("^(?:pub\\s+)?init\\s*\\(", trimmed)
            if is_method_sig:
                string mname = ""
                if strings::starts_with(trimmed, "fn ") or strings::starts_with(trimmed, "pub fn "):
                    mname = extract_function_name(trimmed)
                else:
                    mname = "init"
                if strings::length(mname) > 0:
                    add_elem(doc.methods, mname)
                    add_elem(doc.method_parents, current_class)
                    int mj = i - 1
                    int mstart = mj
                    while mstart >= 0:
                        string t = strings::trim(lines[mstart])
                        if strings::starts_with(t, "##"):
                            mstart = mstart - 1
                            continue
                        break
                    mstart = mstart + 1
                    var mbuilder = new strings::Builder()
                    int mk = mstart
                    while mk <= mj:
                        string t3 = strings::trim(lines[mk])
                        string content2 = strings::trim_prefix(t3, "##")
                        if strings::starts_with(content2, " "):
                            content2 = strings::trim_prefix(content2, " ")
                        mbuilder.append(content2)
                        mbuilder.append("\n")
                        mk = mk + 1
                    add_elem(doc.method_docs, mbuilder.buffer)
                continue
        
        # top-level functions (only when not inside a class scope)
        if (strings::starts_with(trimmed, "fn ") or strings::starts_with(trimmed, "pub fn ")) and strings::length(current_class) == 0:
            print "Function line detected: '%s'" | trimmed
            string func_name = extract_function_name(trimmed)
            if strings::length(func_name) > 0:
                add_elem(doc.functions, func_name)
                print "Added function to collection: %s (total: %d)" | func_name, get_size(doc.functions)
                int j2 = i - 1
                int start2 = j2
                while start2 >= 0:
                    string t = strings::trim(lines[start2])
                    if strings::starts_with(t, "##"):
                        start2 = start2 - 1
                        continue
                    break
                start2 = start2 + 1
                var fbuild = new strings::Builder()
                int k2 = start2
                while k2 <= j2:
                    string t3 = strings::trim(lines[k2])
                    string content2 = strings::trim_prefix(t3, "##")
                    if strings::starts_with(content2, " "):
                        content2 = strings::trim_prefix(content2, " ")
                    fbuild.append(content2)
                    fbuild.append("\n")
                    k2 = k2 + 1
                add_elem(doc.function_docs, fbuild.buffer)
            else:
                print "Function name extraction failed for: '%s'" | trimmed
    
    print "Final function count: %d" | get_size(doc.functions)
    for int j = 0; j < get_size(doc.functions); j++:
        string debug_func = get_element(doc.functions, j)
        print "Function %d: %s" | j, debug_func
    
    return doc

fn generate_markdown(ref ParsedDoc doc) -> void:
    string display_path = doc.filepath
    string cwd = os::cwd()
    display_path = strings::replace(display_path, "\\", "/")
    cwd = strings::replace(cwd, "\\", "/")
    if not strings::ends_with(cwd, "/"):
        cwd = fmt!("%s/", cwd)
    string modname = display_path
    int ls0 = strings::last_index_of(display_path, "/")
    if ls0 != -1:
        modname = strings::substring(display_path, ls0 + 1, strings::length(display_path))
    int dp0 = strings::index_of(modname, ".")
    if dp0 != -1:
        modname = strings::substring(modname, 0, dp0)

    var builder = new strings::Builder()
    builder.append(fmt!("# %s\n\n", modname))
    if strings::starts_with(display_path, cwd):
        display_path = strings::substring(display_path, strings::length(cwd), strings::length(display_path))
    builder.append(fmt!("*Source: `%s`*\n\n", display_path))
    if get_size(doc.imports) > 0:
        builder.append("## Imports\n\n")
        for int i = 0; i < get_size(doc.imports); i++:
            string import_name = get_element(doc.imports, i)
            builder.append(fmt!("- `%s`\n", import_name))
        builder.append("\n")
    if get_size(doc.classes) > 0:
        builder.append("## Classes\n\n")
        for int i = 0; i < get_size(doc.classes); i++:
            string class_name = get_element(doc.classes, i)
            builder.append(fmt!("### %s\n\n", class_name))
            if i < get_size(doc.class_docs):
                string cdoc = get_element(doc.class_docs, i)
                if strings::length(cdoc) > 0:
                    builder.append(cdoc)
                    builder.append("\n")
            bool has_methods = false
            for int mi = 0; mi < get_size(doc.methods); mi++:
                string parent = get_element(doc.method_parents, mi)
                if strings::length(parent) > 0 and strings::compare(parent, class_name) == 0:
                    if not has_methods:
                        builder.append("#### Methods\n\n")
                        has_methods = true
                    string mname = get_element(doc.methods, mi)
                    builder.append(fmt!("- `%s`\n", mname))
                    if mi < get_size(doc.method_docs):
                        string mdoc = get_element(doc.method_docs, mi)
                        if strings::length(mdoc) > 0:
                            builder.append(mdoc)
                            builder.append("\n")
        builder.append("\n")
    if get_size(doc.functions) > 0:
        builder.append("## Functions\n\n")
        print "Generating markdown for %d functions" | get_size(doc.functions)
        for int i = 0; i < get_size(doc.functions); i++:
            string func_name = get_element(doc.functions, i)
            print "Processing function %d: %s" | i, func_name
            builder.append(fmt!("### %s\n\n", func_name))
            if i < get_size(doc.function_docs):
                string fdoc = get_element(doc.function_docs, i)
                if strings::length(fdoc) > 0:
                    builder.append(fdoc)
                    builder.append("\n")

    string output_file = fmt!("%s.md", modname)
    io::write_file(output_file, builder.buffer)
    print "Documentation written to: %s" | output_file
    os::exit(0)

fn generate_documentation(string source_file):
    print "Generating documentation for: %s" | source_file
    
    if not fs::exists(source_file):
        print "Error: Source file %s not found." | source_file
        return
    
    int last_slash = strings::last_index_of(source_file, "/")
    string filename = source_file
    if last_slash != -1:
        filename = strings::substring(source_file, last_slash + 1, strings::length(source_file))
    
    int dot_pos = strings::index_of(filename, ".")
    string module_name = filename
    ref ParsedDoc doc = parse_file(source_file, module_name)

    generate_markdown(doc)
    
    print "Documentation generated successfully."

string current_dir = os::cwd()

list[string] args = os::get_args()
if len(args) < 2:
    print "Usage: scardoc <file1> <file2> <file3>..."
    os::exit(1)

for i = 1 to len(args) - 1:
    generate_documentation(fmt!("%s/%s", current_dir, args[i]))
