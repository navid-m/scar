import "std/io"
import "std/os"
import "std/strings" 
import "std/fs"
import "std/collections"
import "std/regex"

unsafe alias add_elem    = collections::StringArrayList::add_element
unsafe alias get_size    = collections::StringArrayList::get_size
unsafe alias get_element = collections::StringArrayList::get_element

class ParsedDoc:
    init:
        var this.imports         = new collections::StringArrayList(100)
        var this.functions       = new collections::StringArrayList(100)
        var this.function_sigs   = new collections::StringArrayList(100)
        var this.classes         = new collections::StringArrayList(100)
        var this.function_docs   = new collections::StringArrayList(100)
        var this.class_docs      = new collections::StringArrayList(100)
        var this.methods         = new collections::StringArrayList(200)
        var this.method_docs     = new collections::StringArrayList(200)
        var this.method_parents  = new collections::StringArrayList(200)
        var this.method_sigs     = new collections::StringArrayList(200)
        var this.structs         = new collections::StringArrayList(100)
        var this.struct_docs     = new collections::StringArrayList(100)
        var this.struct_fields   = new collections::StringArrayList(100)
        var this.macros          = new collections::StringArrayList(100)
        var this.macro_docs      = new collections::StringArrayList(100)
        var this.macro_sigs      = new collections::StringArrayList(100)
        cstring this.filepath    = ""
        cstring this.module_name = ""

fn extract_function_name(string line) -> string:
    string pattern = "^(?:pub\\s+)?fn\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\("
    
    collections::StringArrayList matches = regex::find(pattern, line)
    if get_size(matches) >= 2:
        return get_element(matches,1)
    
    return ""

class MacroParts:
    init:
        this.part_one = ""
        this.part_two = ""

fn extract_struct_name(string line) -> string:
    string pattern = "^(?:pub\\s+)?struct\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*:"
    
    collections::StringArrayList matches = regex::find(pattern, line)
    if get_size(matches) >= 2:
        return get_element(matches,1)
    
    return ""

fn extract_macro_parts(string line) -> ref MacroParts:
    string pattern = "^(?:pub\\s+)?macro\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(([^)]*)\\)\\s*:"
    collections::StringArrayList matches = regex::find(pattern, line)
    if get_size(matches) >= 3:
        string name = get_element(matches,1)
        string args = get_element(matches,2)
        ref MacroParts mp = new MacroParts()
        mp->>part_one = fmt!("%s", name)
        mp->>part_two = fmt!("%s", args)
        return mp
    return new MacroParts()

fn format_return_for_doc(string ret) -> string:
    string r = strings::trim_space(ret)
    if regex::matches("^\(\s*string\s*,\s*string\s*\)$", r):
        return "{ a: string, b: string }"
    return r

fn extract_class_name(string line) -> string:
    string pattern = "^(?:pub\\s+)?class\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*:"
    
    collections::StringArrayList matches = regex::find(pattern, line)
    if get_size(matches) >= 2:
        return get_element(matches,1)
    
    return ""

fn extract_import(string line) -> string:
    string pattern = "^import\\s+\"([^\"]+)\""
    
    collections::StringArrayList matches = regex::find(pattern, line)
    if get_size(matches) >= 2:
        return get_element(matches,1)
    
    return ""

fn extract_return_type_from_signature(string line) -> string:
    int arrow_pos = strings::index_of(line, "->")
    if arrow_pos == -1:
        return ""
    
    int last_colon = strings::last_index_of(line, ":")
    if last_colon == -1 or last_colon <= arrow_pos:
        return ""
    
    string return_part = strings::substring(line, arrow_pos + 2, last_colon)
    return strings::trim_space(return_part)

fn parse_file(string fpath, string module_name) -> ref ParsedDoc:
    ref ParsedDoc doc = new ParsedDoc()
    doc.filepath = fpath
    doc.module_name = module_name
    collections::StringArrayList lines = fs::read_lines(fpath)
    string current_class = ""
    int class_indent = -1
    string current_struct = ""
    int struct_indent = -1

    for int i = 0; i < get_size(lines); i++:
        string line = get_element(lines,i)
        string trimmed = strings::trim_space(line)
        
        if strings::length(trimmed) == 0:
            continue

        int indent = 0
        string left = line
        
        while strings::starts_with(left, " ") or strings::starts_with(left, "\t"):
            if strings::starts_with(left, " "):
                left = strings::trim_prefix(left, " ")
                indent = indent + 1
            else:
                left = strings::trim_prefix(left, "\t")
                indent = indent + 1
        
        if strings::length(current_class) > 0 and indent <= class_indent and !regex::matches("^(?:pub\\s+)?class\\s+", trimmed):
            current_class = ""
            class_indent = -1
        if strings::length(current_struct) > 0 and indent <= struct_indent and !regex::matches("^(?:pub\\s+)?struct\\s+", trimmed):
            current_struct = ""
            struct_indent = -1
        if regex::matches("^import\\s+\"[^\"]+\"", trimmed):
            string import_path = extract_import(trimmed)
            if strings::length(import_path) > 0:
                add_elem(doc.imports, import_path)
        if regex::matches("^(?:pub\\s+)?class\\s+[a-zA-Z_][a-zA-Z0-9_]*\\s*:", trimmed):
            string class_name = extract_class_name(trimmed)
            if strings::length(class_name) > 0:
                add_elem(doc.classes, class_name)
                current_class = class_name
                class_indent = indent
                int j = i - 1
                int start = get_size(lines) - 1
                while start >= 0:
                    string t = strings::trim(get_element(lines,start))
                    if strings::starts_with(t, "##"):
                        start = start - 1
                        continue
                    break
                start = start + 1
                var cbuild = new strings::Builder()
                int k = start
                while k <= j:
                    string t2 = strings::trim(get_element(lines,k))
                    string content = strings::trim_prefix(t2, "##")
                    if strings::starts_with(content, " "):
                        content = strings::trim_prefix(content, " ")
                    cbuild.append(content)
                    cbuild.append("\n")
                    k = k + 1
                add_elem(doc.class_docs, cbuild.buffer)
        if regex::matches("^(?:pub\\s+)?struct\\s+[a-zA-Z_][a-zA-Z0-9_]*\\s*:", trimmed):
            string struct_name = extract_struct_name(trimmed)
            if strings::length(struct_name) > 0:
                add_elem(doc.structs, struct_name)
                current_struct = struct_name
                struct_indent = indent
                # preceding docs for struct
                int js = i - 1
                int starts = js
                while starts >= 0:
                    string ts = strings::trim(get_element(lines,starts))
                    if strings::starts_with(ts, "##"):
                        starts = starts - 1
                        continue
                    break
                starts = starts + 1
                var sbuild = new strings::Builder()
                int ks = starts
                while ks <= js:
                    string t2s = strings::trim(get_element(lines,ks))
                    string contents = strings::trim_prefix(t2s, "##")
                    if strings::starts_with(contents, " "):
                        contents = strings::trim_prefix(contents, " ")
                    sbuild.append(contents)
                    sbuild.append("\n")
                    ks = ks + 1
                add_elem(doc.struct_docs, sbuild.buffer)
                var fbuild = new strings::Builder()
                int kf = i + 1
                while kf < len(lines):
                    string l2 = get_element(lines,kf)
                    string t2 = strings::trim_space(l2)
                    int ind2 = 0
                    string lleft = l2
                    while strings::starts_with(lleft, " ") or strings::starts_with(lleft, "\t"):
                        if strings::starts_with(lleft, " "):
                            lleft = strings::trim_prefix(lleft, " ")
                            ind2 = ind2 + 1
                        else:
                            lleft = strings::trim_prefix(lleft, "\t")
                            ind2 = ind2 + 1
                    if ind2 <= struct_indent:
                        break
                    if strings::length(t2) == 0 or strings::starts_with(t2, "##"):
                        kf = kf + 1
                        continue
                    fbuild.append(t2)
                    fbuild.append("\n")
                    kf = kf + 1
                add_elem(doc.struct_fields, fbuild.buffer)
                i = kf - 1
        
        if regex::matches("^(?:pub\\s+)?macro\\s+[a-zA-Z_][a-zA-Z0-9_]*\\s*\\(", trimmed):
            ref MacroParts mp = extract_macro_parts(trimmed)
            if strings::length(mp->>part_one) > 0:
                add_elem(doc.macros, mp->>part_one)
                add_elem(doc.macro_sigs, fmt!("%s(%s)", mp->>part_one, mp->>part_two))
                int mj = i - 1
                int mstart = mj
                while mstart >= 0:
                    string t = strings::trim(get_element(lines,mstart))
                    if strings::starts_with(t, "##"):
                        mstart = mstart - 1
                        continue
                    break
                mstart = mstart + 1
                var mb = new strings::Builder()
                int mk = mstart
                while mk <= mj:
                    string t3 = strings::trim(get_element(lines,mk))
                    string content2 = strings::trim_prefix(t3, "##")
                    if strings::starts_with(content2, " "):
                        content2 = strings::trim_prefix(content2, " ")
                    mb.append(content2)
                    mb.append("\n")
                    mk = mk + 1
                add_elem(doc.macro_docs, mb.buffer)
        if strings::length(current_class) > 0:
            bool is_method_sig = strings::starts_with(trimmed, "fn ") or strings::starts_with(trimmed, "pub fn ") or regex::matches("^(?:pub\\s+)?init\\s*\\(", trimmed)
            if is_method_sig:
                string mname = ""
                if strings::starts_with(trimmed, "fn ") or strings::starts_with(trimmed, "pub fn "):
                    mname = extract_function_name(trimmed)
                else:
                    mname = "init"
                if strings::length(mname) > 0:
                    add_elem(doc.methods, mname)
                    add_elem(doc.method_parents, current_class)

                    string msig = ""
                    if strings::compare(mname, "init") == 0:
                        string ipat = "^init\\s*\\(([^)]*)\\)\\s*:"
                        collections::StringArrayList im = regex::find(ipat, trimmed)
                        if get_size(im) >= 2:
                            msig = fmt!("%s(%s)", mname, get_element(im,1))
                    else:
                        string fpat = fmt!("^(?:pub\\s+)?fn\\s+%s\\s*\\(([^)]*)\\)", mname)
                        collections::StringArrayList fm = regex::find(fpat, trimmed)
                        string args = ""
                        if get_size(fm) >= 2:
                            args = get_element(fm,1)
                        
                        string ret = extract_return_type_from_signature(trimmed)
                        
                        if strings::length(ret) > 0:
                            ret = format_return_for_doc(ret)
                            msig = fmt!("%s(%s) -> %s", mname, args, ret)
                        else:
                            msig = fmt!("%s(%s)", mname, args)
                    add_elem(doc.method_sigs, msig)
                    int mj = i - 1
                    int mstart = mj
                    while mstart >= 0:
                        string t = strings::trim(get_element(lines,mstart))
                        if strings::starts_with(t, "##"):
                            mstart = mstart - 1
                            continue
                        break
                    mstart = mstart + 1
                    var mbuilder = new strings::Builder()
                    int mk = mstart
                    while mk <= mj:
                        string t3 = strings::trim(get_element(lines,mk))
                        string content2 = strings::trim_prefix(t3, "##")
                        if strings::starts_with(content2, " "):
                            content2 = strings::trim_prefix(content2, " ")
                        mbuilder.append(content2)
                        mbuilder.append("\n")
                        mk = mk + 1
                    add_elem(doc.method_docs, mbuilder.buffer)
                continue
        
        # top-level functions (only when not inside a class scope)
        if (strings::starts_with(trimmed, "fn ") or strings::starts_with(trimmed, "pub fn ")) and strings::length(current_class) == 0:
            string func_name = extract_function_name(trimmed)
            if strings::length(func_name) > 0:
                add_elem(doc.functions, func_name)

                string fpat = fmt!("^(?:pub\\s+)?fn\\s+%s\\s*\\(([^)]*)\\)", func_name)
                collections::StringArrayList fm = regex::find(fpat, trimmed)
                string fsig = ""
                string args = ""
                if get_size(fm) >= 2:
                    args = get_element(fm,1)
                
                string ret = extract_return_type_from_signature(trimmed)
                
                if strings::length(ret) > 0:
                    ret = format_return_for_doc(ret)
                    fsig = fmt!("%s(%s) -> %s", func_name, args, ret)
                else:
                    fsig = fmt!("%s(%s)", func_name, args)

                add_elem(doc.function_sigs, fsig)
                int j2 = i - 1
                int start2 = j2
                while start2 >= 0:
                    string t = strings::trim(get_element(lines,start2))
                    if strings::starts_with(t, "##"):
                        start2 = start2 - 1
                        continue
                    break
                start2 = start2 + 1
                var fbuild = new strings::Builder()
                int k2 = start2
                while k2 <= j2:
                    string t3 = strings::trim(get_element(lines,k2))
                    string content2 = strings::trim_prefix(t3, "##")
                    if strings::starts_with(content2, " "):
                        content2 = strings::trim_prefix(content2, " ")
                    fbuild.append(content2)
                    fbuild.append("\n")
                    k2 = k2 + 1
                add_elem(doc.function_docs, fbuild.buffer)
            else:
                print "Function name extraction failed for: '%s'" | trimmed
    
    for int j = 0; j < get_size(doc.functions); j++:
        string debug_func = get_element(doc.functions, j)
    
    return doc

fn generate_markdown(ref ParsedDoc doc) -> void:
    string display_path = doc.filepath
    string cwd = os::cwd()
    display_path = strings::replace(display_path, "\\", "/")
    cwd = strings::replace(cwd, "\\", "/")
    if not strings::ends_with(cwd, "/"):
        cwd = fmt!("%s/", cwd)
    string modname = display_path
    int ls0 = strings::last_index_of(display_path, "/")
    if ls0 != -1:
        modname = strings::substring(display_path, ls0 + 1, strings::length(display_path))
    int dp0 = strings::index_of(modname, ".")
    
    if dp0 != -1:
        modname = strings::substring(modname, 0, dp0)
    var builder = new strings::Builder()
    builder.append(fmt!("# %s\n\n", modname))
    
    if strings::starts_with(display_path, cwd):
        display_path = strings::substring(display_path, strings::length(cwd), strings::length(display_path))
    builder.append(fmt!("*Source: `%s`*\n\n", display_path))
    
    if get_size(doc.imports) > 0:
        builder.append("## Imports\n\n")
        
        for int i = 0; i < get_size(doc.imports); i++:
            string import_name = get_element(doc.imports, i)
            builder.append(fmt!("- `%s`\n", import_name))
        builder.append("\n")
    
    if get_size(doc.classes) > 0:
        builder.append("## Classes\n\n")
        
        for int i = 0; i < get_size(doc.classes); i++:
            string class_name = get_element(doc.classes, i)
            builder.append(fmt!("### %s\n\n", class_name))
            
            if i < get_size(doc.class_docs):
                string cdoc = get_element(doc.class_docs, i)
                if strings::length(cdoc) > 0:
                    builder.append(cdoc)
                    builder.append("\n")

            bool any_methods = false
            for int mi = 0; mi < get_size(doc.methods); mi++:
                string parent = get_element(doc.method_parents, mi)
                if strings::length(parent) > 0 and strings::compare(parent, class_name) == 0:
                    if not any_methods:
                        builder.append("#### Methods\n\n")
                        any_methods = true
                    string mname = get_element(doc.methods, mi)
                    builder.append(fmt!("##### %s\n\n", mname))
                    if mi < get_size(doc.method_sigs):
                        string ms = get_element(doc.method_sigs, mi)
                        if strings::length(ms) > 0:
                            builder.append(fmt!("`%s`\n\n", ms))
                    if mi < get_size(doc.method_docs):
                        string mdoc = get_element(doc.method_docs, mi)
                        if strings::length(mdoc) > 0:
                            builder.append(mdoc)
                            builder.append("\n")
        builder.append("\n")
    if get_size(doc.macros) > 0:
        builder.append("## Macros\n\n")
        for int i = 0; i < get_size(doc.macros); i++:
            string name = get_element(doc.macros, i)
            builder.append(fmt!("### %s\n\n", name))
            if i < get_size(doc.macro_sigs):
                string sig = get_element(doc.macro_sigs, i)
                if strings::length(sig) > 0:
                    builder.append(fmt!("`%s`\n\n", sig))
            if i < get_size(doc.macro_docs):
                string mdoc = get_element(doc.macro_docs, i)
                if strings::length(mdoc) > 0:
                    builder.append(mdoc)
                    builder.append("\n")
        builder.append("\n")
    if get_size(doc.structs) > 0:
        builder.append("## Structs\n\n")
        for int si = 0; si < get_size(doc.structs); si++:
            string sname = get_element(doc.structs, si)
            builder.append(fmt!("### %s\n\n", sname))
            if si < get_size(doc.struct_docs):
                string sdoc = get_element(doc.struct_docs, si)
                if strings::length(sdoc) > 0:
                    builder.append(sdoc)
                    builder.append("\n")
            if si < get_size(doc.struct_fields):
                string fields_blob = get_element(doc.struct_fields, si)
                if strings::length(fields_blob) > 0:
                    builder.append("#### Fields\n\n")
                    ref collections::StringArrayList flines = strings::split(fields_blob, "\n")
                    for int fi = 0; fi < get_size(flines); fi++:
                        string ln = strings::trim_space(get_element(flines, fi))
                        if strings::length(ln) == 0:
                            continue
                        ref collections::StringArrayList toks = strings::split(ln, " ")
                        if get_size(toks) >= 2:
                            string ftype = get_element(toks, 0)
                            string fname = get_element(toks, 1)
                            builder.append(fmt!("- `%s`: `%s`\n", fname, ftype))
                        else:
                            builder.append(fmt!("- %s\n", ln))
            builder.append("\n")
    int __functions_count = 0
    if doc.functions != nil:
        __functions_count = get_size(doc.functions)
    if __functions_count > 0:
        builder.append("## Functions\n\n")
        print "Generating markdown for %d functions" | __functions_count
        for int i = 0; i < __functions_count; i++:
            string func_name = get_element(doc.functions, i)
            builder.append(fmt!("### %s\n\n", func_name))
            if i < get_size(doc.function_sigs):
                string fs = get_element(doc.function_sigs, i)
                if strings::length(fs) > 0:
                    builder.append(fmt!("`%s`\n\n", fs))
            if i < get_size(doc.function_docs):
                string fdoc = get_element(doc.function_docs, i)
                if strings::length(fdoc) > 0:
                    builder.append(fdoc)
                    builder.append("\n")

    string output_file = fmt!("%s.md", modname)
    io::write_file(output_file, builder.buffer)
    print "Documentation written to: %s" | output_file

fn generate_documentation(string source_file):
    print "Generating documentation for: %s" | source_file

    if not fs::exists(source_file):
        print "Error: Source file %s not found." | source_file
        return

    int last_slash = strings::last_index_of(source_file, "/")
    string filename = source_file

    if last_slash != -1:
        filename = strings::substring(source_file, last_slash + 1, strings::length(source_file))
    
    int dot_pos = strings::index_of(filename, ".")
    string module_name = filename
    ref ParsedDoc doc = parse_file(source_file, module_name)
    generate_markdown(doc)
    
    print "Documentation generated successfully."

string current_dir = os::cwd()

fn generate_documentation_for_dir(string dir_path):
    if not fs::exists(dir_path):
        print "Error: Directory %s not found." | dir_path
        return
    collections::StringArrayList entries = fs::list_dir(dir_path)
    for i = 0 to get_size(entries) - 1:
        string name = get_element(entries, i)
        if strings::ends_with(name, ".scar"):
            string full = fmt!("%s/%s", dir_path, name)
            generate_documentation(full)

collections::StringArrayList args = os::get_args()
if get_size(args) < 2:
    print "Usage: scardoc <file1> <file2> ... scardoc -dir <folder>"
    os::exit(1)

string first = get_element(args, 1)
if strings::compare(first, "-dir") == 0 or strings::compare(first, "--dir") == 0:
    if get_size(args) < 3:
        print "Usage: scardoc -dir <folder>"
        os::exit(1)
    string dir_path = get_element(args, 2)
    if not strings::starts_with(dir_path, "/"):
        dir_path = fmt!("%s/%s", current_dir, dir_path)
    generate_documentation_for_dir(dir_path)
else:
    for i = 1 to get_size(args) - 1:
        string path = get_element(args, i)
        if not strings::starts_with(path, "/"):
            path = fmt!("%s/%s", current_dir, path)
        generate_documentation(path)
