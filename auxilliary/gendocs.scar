import "std/strings"
import "std/fs"
import "std/os"
import "std/collections"

unsafe alias get_element = collections::StringArrayList::get_element
namespace alias Sal = collections::StringArrayList

string path = "."
Sal entries = fs::list_dir(path)

for i = 0 to entries.get_size() - 1:
    string name = get_element(entries, i)
    if strings::ends_with(name, ".scar"):
        print "Running scardoc on %s" | name
        os::exec(fmt!("scardoc %s", name))
