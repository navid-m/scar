when linux
	def linux_only_function()
		@puts("sup")
	end
end


pub def main()
	when posix
		@puts("hi posix")
	end
	when linux
		@puts("hi linux")
		linux_only_function()
	end
	when windows
		@puts("boo")
	end
	when darwin
		@puts("hi darwin")
	end
	when dragonflybsd
		@puts("hi")
	end
	when openbsd
		@puts("hello")
	end
	when freebsd
		@puts("sup")
	end
	when redox
		@puts("hellooo")
	end
	when plan9
		@puts("hey")
	end
end

