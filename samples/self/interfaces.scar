pub interface SomeInterface
    pub def some_func(x i32, y i32) i32
end

pub type SomeType : SomeInterface
    a i32
    b i32
    c i32
end

pub def SomeType.some_func(thing i32, other_thing i32) i32
    @print("{d}, {d}\n", {thing, other_thing})
end


pub def main()
    SomeType.some_func(1, 2)
end

