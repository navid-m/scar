import "std/runtime"

## String builder for manual string concatenation, works on mutable strings.
pub class Builder:
    init:
        string this.buffer = ""
        int this.length = 0
        int this.capacity = 0
    
    ## Appends a string to the builder.
    fn append(string str) -> void:
        this.buffer = cat!(this.buffer, str)
        this.length = this.length + strings::length(str)

## Returns the length of a string.
pub fn length(string str) -> int:
    $raw (
        return strlen(str);
    )

## Compares two strings.
pub fn compare(string a, string b) -> int:
    $raw (
        return strcmp(a, b);
    )

## Quickly constructs a new string by copying the input.
##
## If specific size is not needed, copy string using the fmt! builtin instead.
pub fn new_string_w_size(string s, i32 size) -> string:
    if size <= 0:
        runtime::error("invalid size for new_string_w_size")
    $raw (
        if (s == NULL) {
            s = "";
        }
        snprintf(_output_buffer, size, "%s", s);
    )

## Returns the ordinal value of the first character of a string.
pub fn ord(string str) -> int:
    $raw (
        if (str == NULL || str[0] == '\0') {
            return 0;
        }
        return (int)str[0];
    )

## Returns the ordinal value of a character.
pub fn ord_char(char c) -> int:
    return (int)c;

## Returns the character with the given ordinal value.
pub fn chr(int ascii_value) -> char*:
    $raw (
        char result[2];
        if (ascii_value < 0 || ascii_value > 255) {
            result[0] = '\0';
        } else {
            result[0] = (char)ascii_value;
            result[1] = '\0';
        }
        return strdup(result);
    )

## Trims leading and trailing whitespace from a string.
pub fn trim_space(string str) -> lstring:
    $raw (
        if (str == NULL) {
            return "";
        }
        const char *start = str;
        while (*start && (*start == ' ' || *start == '\t' || *start == '\n' || *start == '\r' || *start == '\v' || *start == '\f')) {
            start++;
        }
        if (*start == '\0') {
            return "";
        }
        const char *end = str + strlen(str) - 1;
        while (end > start && (*end == ' ' || *end == '\t' || *end == '\n' || *end == '\r' || *end == '\v' || *end == '\f')) {
            end--;
        }
        size_t len = end - start + 1;
        char *result = (char*)malloc(len + 1);
        if (!result) {
            return "";
        }
        memcpy(result, start, len);
        result[len] = '\0';
        return result;
    )

## Trims a prefix from a string.
pub fn trim_prefix(string str, string prefix) -> string:
    $raw (
        if (str == NULL || prefix == NULL) {
            strcpy(_output_buffer, str ? str : "");
            return;
        }
        size_t prefix_len = strlen(prefix);
        size_t str_len = strlen(str);
        if (str_len >= prefix_len && strncmp(str, prefix, prefix_len) == 0) {
            strcpy(_output_buffer, str + prefix_len);
        } else {
            strcpy(_output_buffer, str);
        }
    )

## Trims a suffix from a string.
pub fn trim_suffix(lstring str, lstring suffix) -> lstring:
    $raw (
        if (str == NULL || suffix == NULL) {
            return str ? str : "";
        }
        size_t str_len = strlen(str);
        size_t suffix_len = strlen(suffix);
        if (str_len >= suffix_len && strcmp(str + str_len - suffix_len, suffix) == 0) {
            size_t new_len = str_len - suffix_len;
            char* out = (char*)malloc(new_len + 1);
            if (!out) return "";
            memcpy(out, str, new_len);
            out[new_len] = '\0';
            return out;
        }
        return str;
    )

## Checks if a string ends with a suffix.
pub fn ends_with(string str, string suffix) -> bool:
    $raw (
        if (str == NULL || suffix == NULL) {
            return false;
        }
        
        size_t str_len = strlen(str);
        size_t suffix_len = strlen(suffix);
        
        if (suffix_len > str_len) {
            return false;
        }
        
        return strcmp(str + str_len - suffix_len, suffix) == 0;
    )

## Checks if a string contains a substring.
pub fn contains(string str, string substring) -> bool:
    $raw (
        if (str == NULL || substring == NULL) {
            return false;
        }
        return strstr(str, substring) != NULL;
    )

## Returns the index of the first occurrence of a substring in a string.
pub fn index_of(lstring str, lstring substring) -> int:
    $raw (
        if (str == NULL || substring == NULL) {
            return -1;
        }
        char *found = strstr(str, substring);
        if (found == NULL) {
            return -1;
        }
        return (int)(found - str);
    )

## Returns the index of the last occurrence of a substring in a string.
pub fn last_index_of(lstring str, lstring substring) -> int:
    $raw (
        if (str == NULL || substring == NULL) {
            return -1;
        }
        char *last_found = NULL;
        char *current = str;
        size_t substring_len = strlen(substring);
        
        if (substring_len == 0) {
            return strlen(str);
        }
        
        while ((current = strstr(current, substring)) != NULL) {
            last_found = current;
            current += 1;
        }
        
        if (last_found == NULL) {
            return -1;
        }
        return (int)(last_found - str);
    )

## Checks if a string starts with a prefix.
pub fn starts_with(string str, string prefix) -> bool:
    $raw (
        if (str == NULL || prefix == NULL) {
            return false;
        }
        
        int str_len = strlen(str);
        int prefix_len = strlen(prefix);
        
        if (prefix_len > str_len) {
            return false;
        }
        
        return strncmp(str, prefix, prefix_len) == 0;
    )

## Returns a substring of a string.
pub fn substring(string str, int start, int end) -> char*:
    $raw (
        if (str == NULL) {
            return strdup("");
        }
        
        int str_len = strlen(str);
        
        if (start < 0) start = 0;
        if (end > str_len) end = str_len;
        if (start >= end || start >= str_len) {
            return strdup("");
        }
        
        int sub_len = end - start;
        char *result = malloc(sub_len + 1);
        if (result == NULL) {
            return strdup("");
        }
        
        memcpy(result, str + start, sub_len);
        result[sub_len] = '\0';
        
        return result;
    )

## Converts an integer to a hexadecimal string.
pub fn to_hex(int value) -> char*:
    $raw (
        char *result = malloc(16);
        if (result == NULL) {
            return strdup("");
        }
        
        if (value < 0) {
            strcpy(result, "0");
            return result;
        }
        
        sprintf(result, "%X", value);
        return result;
    )

## Converts a hexadecimal string (like "2F" or "20") to an integer.
pub fn from_hex(string hx) -> int:
    $raw (
        if (hx == NULL) {
            return 0;
        }
        int value = 0;
        sscanf(hx, "%x", &value);
        return value;
    )

## Compares two strings.
pub fn equal(string a, string b) -> bool:
    $raw (
        if (a == NULL && b == NULL) {
            return true;
        }
        if (a == NULL || b == NULL) {
            return false;
        }
        
        return strcmp(a, b) == 0;
    )

## Replaces all occurrences of a substring in a string.
pub fn replace(string str, string old_substr, string new_substr) -> char*:
    $raw (
        if (str == NULL || old_substr == NULL || new_substr == NULL) {
            return str ? strdup(str) : strdup("");
        }
        
        int old_len = strlen(old_substr);
        int new_len = strlen(new_substr);
        int str_len = strlen(str);
        
        if (old_len == 0) {
            return strdup(str);
        }
        int count = 0;
        char *temp = str;
        while ((temp = strstr(temp, old_substr)) != NULL) {
            count++;
            temp += old_len;
        }
        
        if (count == 0) {
            return strdup(str);
        }
        
        int result_len = str_len + count * (new_len - old_len);
        char *result = malloc(result_len + 1);
        if (result == NULL) {
            return strdup("");
        }
        
        char *src = str;
        char *dst = result;
        
        while ((temp = strstr(src, old_substr)) != NULL) {
            int prefix_len = temp - src;
            memcpy(dst, src, prefix_len);
            dst += prefix_len;
            strcpy(dst, new_substr);
            dst += new_len;
            src = temp + old_len;
        }        
        strcpy(dst, src);
        return result;
    )

## Splits a string into a list of substrings.
pub fn split(string str, string delimiter) -> collections::StringArrayList:
    var result = new collections::StringArrayList(10)
    if strings::length(str) == 0:
        result.add_element("")
        return result
    
    if strings::length(delimiter) == 0:
        result.add_element(str)
        return result
    
    int str_len = strings::length(str)
    int delim_len = strings::length(delimiter)
    string current_part = ""
    int i = 0
    
    while i < str_len:
        bool found_delimiter = true
        if i + delim_len <= str_len:
            int j = 0
            while j < delim_len:
                string str_char = strings::get_char_at(str, i + j)
                string delim_char = strings::get_char_at(delimiter, j)
                if strings::compare(str_char, delim_char) != 0:
                    found_delimiter = false
                    break
                j = j + 1
        else:
            found_delimiter = false
        
        if found_delimiter:
            result.add_element(current_part)
            current_part = ""
            i = i + delim_len
        else:
            string current_char = strings::get_char_at(str, i)
            current_part = fmt!("%s%s", current_part, current_char)
            i = i + 1
    
    result.add_element(current_part)
    return result

## Trims leading and trailing whitespace from a string.
pub fn trim(string str) -> string:
    $raw (
        if (str == NULL) {
            strcpy(_output_buffer, "");
            return;
        }
        const char *start = str;
        while (*start && (*start == ' ' || *start == '\t' || *start == '\n' || *start == '\r' || *start == '\v' || *start == '\f')) {
            start++;
        }
        if (*start == '\0') {
            strcpy(_output_buffer, "");
            return;
        }
        const char *end = str + strlen(str) - 1;
        while (end > start && (*end == ' ' || *end == '\t' || *end == '\n' || *end == '\r' || *end == '\v' || *end == '\f')) {
            end--;
        }
        size_t len = end - start + 1;
        if (len >= 256) len = 255;
        memcpy(_output_buffer, start, len);
        _output_buffer[len] = '\0';
    )

## Returns the character at a specific index in a string.
macro get_char_at_either(name, return_type):
    pub fn name(string str, int index) -> return_type:
        $raw (
            if (str == NULL || index < 0 || index >= strlen(str)) {
                return "";
            }
            char result[2];
            result[0] = str[index];
            result[1] = '\0';
        )
        return result

get_char_at_either(get_char_at, string)
get_char_at_either(get_char_at_lstr, lstring)
