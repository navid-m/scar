import "std/strings"

pub fn encode_url(string url) -> cstring:
    if strings::length(url) == 0:
        return ""
    strings::Builder builder = new strings::Builder()
    i32 n = strings::length(url)

    for i = 0 to n - 1:
        char c = url[i]
        i32 oc = strings::ord_char(c)

        bool is_alnum = ((oc >= 48 && oc <= 57) || (oc >= 65 && oc <= 90) || (oc >= 97 && oc <= 122))
        bool is_unreserved = is_alnum || oc == 45 || oc == 95 || oc == 46 || oc == 126 || oc == 32

        if is_unreserved:
            if oc == 32:
                builder.append("%20")
            else:
                builder.append(strings::chr(oc))
        else:
            string hx = strings::to_hex(oc)
            if strings::length(hx) == 1:
                hx = fmt!("%s%s", "0", hx)
            builder.append(fmt!("%s%s", "%", hx))
    
    return builder.buffer
    
pub fn decode_url(string url) -> cstring:
    if strings::length(url) == 0:
        return ""
    strings::Builder builder = new strings::Builder()
    i32 n = strings::length(url)
    i32 i = 0

    while i < n:
        char c = url[i]
        if c == '%':
            if i + 2 < n:
                string hx = strings::substring(url, i + 1, 2)
                i32 oc = strings::from_hex(hx)
                builder.append(strings::chr(oc))
                i = i + 3
                continue
        elif c == '+':
            builder.append(" ")
            i = i + 1
            continue
        else:
            builder.append(strings::chr(strings::ord_char(c)))
            i = i + 1
            continue
    
    return builder.buffer
