## Execute a command.
pub fn exec(string command) -> i64:
    $raw (
        return system(command);
    )

## Execute a command with arguments.
pub fn exec_with_args(string command, list[string] args) -> i64:
    return system(fmt!("%s %s", command, args))

## Exit the program.
pub fn exit(i64 code):
    $raw (
        exit(code);
    )

## Get the current working directory.
pub fn cwd() -> char*:
    $raw (
        char *buffer = getcwd(NULL, 0);
        char *result = buffer;
        return result;
    )

## Change the current working directory.
pub fn chdir(string path) -> int:
    $raw (
        return chdir(path);
    )

## Get the home directory.
pub fn homedir() -> char*:
    $raw (
        char *home = getenv("HOME");
        if (home == NULL) {
            home = getenv("USERPROFILE");
        }
        return home ? strdup(home) : NULL;
    )

## Get an environment variable.
pub fn get_env(string name) -> char*:
    $raw (
        char *value = getenv(name);
        return value ? strdup(value) : NULL;
    )

## Get the temporary directory.
pub fn tempdir() -> char*:
    $raw (
        char *temp = getenv("TMPDIR");
        if (temp == NULL) {
            temp = getenv("TEMP");
        }
        if (temp == NULL) {
            temp = getenv("TMP");
        }
        return temp ? strdup(temp) : NULL;
    )

## Get the command line arguments.
pub fn get_args() -> collections::StringArrayList:
    var args = new collections::StringArrayList(4)
    for i = 0 to __global_argc - 1:
        args.add_element(__global_argv[i])
    return args

## Read the contents of a directory.
pub fn read_dir(string path) -> list[string]:
    platform (Posix):
        $raw (
            #define _POSIX_C_SOURCE 200809L 
            #define _DARWIN_C_SOURCE 
            #include <sys/types.h>
            return 0;
        )
    
    platform (Windows):
        $raw (
            #include <dirent.h>
            
            DIR *dir;
            struct dirent *entry;
            int count = 0;
            
            dir = opendir(path);
            if (dir == NULL) {
                return 0;
            }
            
            while ((entry = readdir(dir)) != NULL && count < _max_size) {
                if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0) {
                    continue;
                }
                strcpy(_output_array[count], entry->d_name);
                count++;
            }
            
            closedir(dir);
            return count;
        )

## Clear the terminal.
pub fn clear():
    external import "stdio.h"

    platform (Windows):
        system("cls")
    platform (Posix):
        system("clear")

## Print a runtime error message and exit with code 1.
pub fn runtime_error(string msg):
    print "\033[91mRuntimeError: %s\033[0m" | msg
    os::exit(1)
