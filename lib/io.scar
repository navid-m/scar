import "std/math"
import "std/collections"
import "std/strings"
import "std/runtime"

## Read a line from stdin without the trailing newline.
pub fn readln() -> lstring:
    $raw (
        char buffer[4096];
        if (fgets(buffer, sizeof(buffer), stdin) != NULL) {
            size_t len = strlen(buffer);
            if (len > 0 && buffer[len - 1] == '\n') {
                buffer[len - 1] = '\0';
            }
            lstring s;
            strcpy(s, buffer);
            return s;
        } else {
            return "";
        }
    )

## Print a prompt then read a line from stdin.
pub fn readln_with_prompt(string prompt) -> lstring:
    put "%s" | prompt
    return io::readln()

## Read a line from stdin and parse it as 32-bit integer.
pub fn read_int() -> i32:
    i32 y = math::to_int(io::readln())
    return y

## Read a line from stdin and parse it as 32-bit float.
pub fn read_float() -> f32:
    f32 y = math::to_float(io::readln())
    return y

## Read a line from stdin and parse it as boolean ("true" => true).
pub fn read_bool() -> bool:
    if strings::equal(io::readln(), "true"):
        return true
    else:
        return false

## Read a line and return its first character.
pub fn read_char() -> char:
    return io::readln()[0]

## Read a line and split it by the given delimiter.
pub fn read_split(char* delimiter) -> collections::StringArrayList:
    return strings::split(io::readln(), delimiter)

## Write (overwrite) text content to a file. Returns true on success.
pub fn write_file(string filepath, string content) -> bool:
    $raw (
        if (filepath == NULL || content == NULL) {
            return false;
        }
        
        FILE* file = fopen(filepath, "w");
        if (file == NULL) {
            return false;
        }
        
        size_t content_len = strlen(content);
        size_t written = fwrite(content, 1, content_len, file);
        fclose(file);
        
        return written == content_len;
    )

## Append text content to a file. Returns true on success.
pub fn append_file(string filepath, string content) -> bool:
    $raw (
        if (filepath == NULL || content == NULL) {
            return false;
        }
        
        FILE* file = fopen(filepath, "a");
        if (file == NULL) {
            return false;
        }
        
        size_t content_len = strlen(content);
        size_t written = fwrite(content, 1, content_len, file);
        fclose(file);
        
        return written == content_len;
    )

## Read entire file content as a string.
pub fn read_file(string filepath) -> lstring:
    $raw (
        if (filepath == NULL) {
            return "";
        }
        
        FILE* file = fopen(filepath, "r");
        if (file == NULL) {
            runtime_error(fmt("Failed to open file %s", filepath));
        }
        
        fseek(file, 0, SEEK_END);
        long file_size = ftell(file);
        fseek(file, 0, SEEK_SET);
        
        if (file_size <= 0) {
            fclose(file);
            return "";
        }
        
        char* buffer = (char*)malloc(file_size + 1);
        if (buffer == NULL) {
            fclose(file);
            return "";
        }
        
        size_t bytes_read = fread(buffer, 1, file_size, file);
        fclose(file);
        
        buffer[bytes_read] = '\0';
        return buffer;
    )

## Check if a file at the given path exists (readable).
pub fn exists(string filepath) -> bool:
    $raw (
        if (filepath == NULL) {
            return false;
        }
        
        FILE* file = fopen(filepath, "r");
        if (file == NULL) {
            return false;
        }
        fclose(file);
        return true;
    )

## Send a string to the stderr stream
pub fn to_stderr(string message) -> void:
    fprintf(stderr, "%s", message);
