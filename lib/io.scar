import "std/math"

pub fn readln() -> string:
    $raw (
        char buffer[1024];
        if (fgets(buffer, sizeof(buffer), stdin) != NULL) {
            size_t len = strlen(buffer);
            if (len > 0 && buffer[len - 1] == '\n') {
                buffer[len - 1] = '\0';
            }
            return buffer;
        } else {
            return "";
        }
    )

pub fn readln_with_prompt(string prompt) -> string:
    put "%s" | prompt
    return io::readln()

pub fn read_int() -> i32:
    lstring x = io::readln()
    i32 y = math::to_int(x)
    return y
