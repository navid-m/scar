## Represents a mutex for synchronizing access to shared resources.
pub class Mutex:
    init:
        i64 this.handle = 0

## Create a new mutex.
pub fn create() -> mutex::Mutex:
    $raw (
        #include <omp.h>
        #include <stdlib.h>
        mutex_Mutex* m = mutex_Mutex_new();
        omp_lock_t* lock = (omp_lock_t*)malloc(sizeof(omp_lock_t));
        if (lock) {
            omp_init_lock(lock);
            m->handle = (long long)(intptr_t)lock;
        } else {
            m->handle = 0;
        }
        return m;
    )

## Lock the mutex. Blocks until the lock is acquired.
pub fn lock(mutex::Mutex m):
    $raw (
        #include <omp.h>
        omp_lock_t* lock = (omp_lock_t*)(intptr_t)m->handle;
        if (lock) omp_set_lock(lock);
    )

## Unlock the mutex.
pub fn unlock(mutex::Mutex m):
    $raw (
        #include <omp.h>
        omp_lock_t* lock = (omp_lock_t*)(intptr_t)m->handle;
        if (lock) omp_unset_lock(lock);
    )

## Destroy the mutex and free its underlying resources.
pub fn destroy(mutex::Mutex m):
    $raw (
        #include <omp.h>
        #include <stdlib.h>
        omp_lock_t* lock = (omp_lock_t*)(intptr_t)m->handle;
        if (lock) {
            omp_destroy_lock(lock);
            free(lock);
            m->handle = 0;
        }
    )
