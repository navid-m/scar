import "std/runtime"

## Define a new array type.
pub macro new_array(class_name, field_type, elem_type, cType, d_return, alloc_expr, free_expr, copy_expr, get_check):
    pub class class_name:
        init(i32 initial_capacity):
            this.size = 0
            this.capacity = initial_capacity
            ref field_type this.data = nil
            $raw (
                this->data = malloc(this->capacity * sizeof(cType));
            )

        ## Add an element to the array.
        fn add_element(elem_type value) -> void:
            if this.size >= this.capacity:
                this.resize()
            $raw (
                ((cType*)this->data)[this->size] = copy_expr;
            )
            this.size = this.size + 1

        ## Get an element from the array.
        fn get_element(i32 index) -> elem_type:
            if index < 0 || index >= this.size:
                runtime::error("index out of bounds")
            $raw (
                get_check;
            )

        ## Set an element in the array.
        fn set_element(i32 index, elem_type value) -> void:
            if index >= 0 && index < this.size:
                $raw (
                    free_expr
                    ((cType*)this->data)[index] = copy_expr;
                )

        ## Get the size of the array.
        fn get_size() -> i32:
            return this.size

        ## Resize the array.
        fn resize() -> void:
            this.capacity = this.capacity * 2
            $raw (
                this->data = realloc(this->data, this->capacity * sizeof(cType));
            )

## Convenience macro to define an ArrayList for a custom type.
##
## Usage: define_arraylist(MyList, MyType, default_value)
##
## Notes:
##
##  - For most value types (including user-defined structs/classes that map to a C type),
##    this will Just Work (TM) by using sizeof(elem_type) and plain assignment.
##
##  - For strings, prefer the existing `StringArrayList` specialization.
pub macro define_arraylist(class_name, elem_type, default_value):
    collections::new_array(class_name, elem_type, elem_type, elem_type, default_value, malloc(this->capacity * sizeof(elem_type)),/* free_expr */,value,return ((elem_type*)this->data)[index];)

new_array(ArrayList, i32, i32, int, -1,malloc(this->capacity * sizeof(int)), /* free_expr */, value,  return ((i32*)this->data)[index];)
new_array(FloatArrayList, f32, f32, float, 0.0, malloc(this->capacity * sizeof(float)), /* free_expr */, value, return ((f32*)this->data)[index];)
new_array(CharArrayList, char, char, char, '\0', malloc(this->capacity * sizeof(char)),  /* free_expr */, value,return ((char*)this->data)[index];)
new_array(BooleanArrayList, bool, bool, bool, false, malloc(this->capacity * sizeof(bool)), /* free_expr */, value, return ((bool*)this->data)[index];)
new_array(StringArrayList, char, string, char*, "",malloc(this->capacity * sizeof(char*)),free(((char**)this->data)[index]);,strdup(value),char* value = ((char**)this->data)[index];if (value == nil) {return ""; } return value;)
new_array(ByteArrayList, u8, u8, unsigned char, (u8)0, malloc(this->capacity * sizeof(unsigned char)), /* free_expr */, value, return ((unsigned char*)this->data)[index];)


## Convenience macro to define a string-keyed map for a custom value type.
##
## Usage: define_map(MyMap, MyValueType, MyCType, default_value)
##
## Notes:
##
##  - Keys are strings and are strdup/free managed.
##
##  - Values are stored by value; no destructor/free is invoked for values.
pub macro define_map(class_name, value_type, cValueType, default_value):
    pub class class_name:
        init(i32 initial_capacity):
            this.size = 0
            this.capacity = initial_capacity > 0 ? initial_capacity : 1
            ref char this.keys = nil
            ref value_type this.values = nil
            $raw (
                this->keys = malloc(this->capacity * sizeof(char*));
                this->values = malloc(this->capacity * sizeof(cValueType));
                for (int i = 0; i < this->capacity; i++) {
                    ((char**)this->keys)[i] = nil;
                }
            )

        ## Find the index of a key.
        fn find_index(string key) -> i32:
            i32 i = 0
            $raw (
                if (key == nil) { return -1; }
                for (int i = 0; i < this->size; i++) {
                    char* k = ((char**)this->keys)[i];
                    if (k != nil && strcmp(k, key) == 0) {
                        return i;
                    }
                }
                return -1;
            )

        ## Add a key-value pair to the map.
        fn put(string key, value_type value) -> void:
            if key == nil:
                runtime::error("key cannot be nil")
            i32 idx = this.find_index(key)
            if idx >= 0:
                $raw (
                    ((cValueType*)this->values)[idx] = (cValueType)(value);
                )
                return
            if this.size >= this.capacity:
                this.resize()
            $raw (
                ((char**)this->keys)[this->size] = strdup(key);
                ((cValueType*)this->values)[this->size] = (cValueType)(value);
            )
            this.size = this.size + 1

        ## Get the value for a key.
        fn get(string key) -> value_type:
            i32 idx = this.find_index(key)
            if idx < 0:
                return default_value
            $raw (
                return ((cValueType*)this->values)[idx];
            )

        ## Check if a key exists in the map.
        fn contains_key(string key) -> bool:
            return this.find_index(key) >= 0

        ## Remove a key-value pair from the map.
        fn remove(string key) -> void:
            i32 idx = this.find_index(key)
            if idx < 0:
                return
            $raw (
                if (((char**)this->keys)[idx] != nil) { free(((char**)this->keys)[idx]); }
                for (int j = idx; j < this->size - 1; j++) {
                    ((char**)this->keys)[j] = ((char**)this->keys)[j+1];
                    ((cValueType*)this->values)[j] = ((cValueType*)this->values)[j+1];
                }
                ((char**)this->keys)[this->size - 1] = nil;
            )
            this.size = this.size - 1

        ## Get the size of the map.
        fn get_size() -> i32:
            return this.size

        ## Resize the map.
        fn resize() -> void:
            this.capacity = this.capacity * 2
            $raw (
                this->keys = realloc(this->keys, this->capacity * sizeof(char*));
                this->values = realloc(this->values, this->capacity * sizeof(cValueType));
            )

define_map(StringIntMap, i32, int, -1)
define_map(StringLongMap, i64, long long, 0)
define_map(StringFloatMap, f32, float, 0.0)
define_map(StringBoolMap, bool, bool, false)
define_map(StringByteMap, u8, unsigned char, (u8)0)
define_map(StringStringMap, string, char*, "")
define_map(StringCharMap, char, char, '\0')
define_map(StringBooleanMap, bool, bool, false)
define_map(FloatIntMap, i32, int, -1)
define_map(FloatLongMap, i64, long long, 0)
define_map(FloatFloatMap, f32, float, 0.0)
define_map(FloatBoolMap, bool, bool, false)
define_map(FloatByteMap, u8, unsigned char, (u8)0)
define_map(FloatStringMap, string, char*, "")
define_map(FloatCharMap, char, char, '\0')
define_map(IntIntMap, i32, int, -1)
define_map(IntLongMap, i64, long long, 0)
define_map(IntFloatMap, f32, float, 0.0)
define_map(IntBoolMap, bool, bool, false)
define_map(IntByteMap, u8, unsigned char, (u8)0)
define_map(IntStringMap, string, char*, "")
define_map(IntCharMap, char, char, '\0')
