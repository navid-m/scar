            $raw (
                ((cType*)this->data)[this->size] = copyExpr;
            )
            this.size = this.size + 1

        fn get_element(i32 index) -> elemType:
            if index < 0 || index >= this.size:
                return defaultReturn
            $raw (
                getCheck;
            )

        fn set_element(i32 index, elemType value) -> void:
            if index >= 0 && index < this.size:
                $raw (
                    freeExpr
                    ((cType*)this->data)[index] = copyExpr;
                )

        fn get_size() -> i32:
