import "std/strings"
import "std/io"
import "std/collections"

platform (Posix):
    external import "dirent.h"
    external import "unistd.h"
    external import "sys/types.h"

## Create a directory at the given path. Returns true on success.
pub fn make_dir(string path) -> bool:
    platform (Posix):
        $raw (
            return mkdir(path, 0777) == 0;
        )
    platform (Windows):
        $raw (
            return mkdir(path) == 0;
        )

## Remove an empty directory. Returns true on success.
pub fn remove_dir(string path) -> bool:
    $raw (
        return rmdir(path) == 0;
    )
    
## Read entire file as bytes. Returns ByteArrayList of u8 values.
pub fn read_bytes(string filename) -> collections::ByteArrayList:
    var result = new collections::ByteArrayList(16)
    lstring content = io::read_file(filename)
    i32 n = strings::length(content)
    i32 i = 0
    while i < n:
        string ch = strings::get_char_at_lstr(content, i)
        i32 b = strings::ord(ch)
        result.add_element((u8)(b))
        i = i + 1
    return result

## Write bytes to a file. Overwrites existing file. Returns true on success.
pub fn write_bytes(string filename, collections::ArrayList data) -> bool:
    string out = ""
    i32 n = data.get_size()
    for i = 0 to n - 1:
        i32 v = data.get_element(i)
        string ch = strings::chr(v)
        out = fmt!("%s%s", out, ch)
    return io::write_file(filename, out)

## Check if a file or directory exists at path.
pub fn exists(string path) -> bool:
    $raw (
        return access(path, F_OK) == 0;
    )

## Remove a file at the given path. Returns true on success.
pub fn remove(string path) -> bool:
    $raw (
        return unlink(path) == 0;
    )

## Read a text file into a list of lines (without trailing newlines).
pub fn read_lines(string filename) -> collections::StringArrayList:
    lstring content = io::read_file(filename)
    var lines = new collections::StringArrayList(16)
    if strings::length(content) == 0:
        return lines
    lines = strings::split(content, "\n")
    i32 n = lines.get_size()
    for i = 0 to n - 1:
        string ln = lines.get_element(i)
        lstring clean = strings::trim_suffix(ln, "\r")
        lines.set_element(i, clean)
    return lines

## Internal helper: returns directory entries joined by newlines. Excludes . and ..
pub fn list_dir_joined(string path) -> lstring:
    $raw (
        char *buffer = NULL;
        size_t size = 0;
        
        #ifdef _WIN32
            WIN32_FIND_DATA find_data;
            char search_path[1024];
            snprintf(search_path, sizeof(search_path), "%s\\*", path);
            
            HANDLE handle = FindFirstFile(search_path, &find_data);
            if (handle == INVALID_HANDLE_VALUE) {
                return strdup("");
            }
            
            do {
                if (strcmp(find_data.cFileName, ".") != 0 && strcmp(find_data.cFileName, "..") != 0) {
                    const char *name = find_data.cFileName;
                    size_t name_len = strlen(name);
                    size_t add_len = name_len + (size > 0 ? 1 : 0);
                    char *newbuf = realloc(buffer, size + add_len + 1);
                    if (!newbuf) { free(buffer); FindClose(handle); return strdup(""); }
                    buffer = newbuf;
                    if (size > 0) { buffer[size] = '\n'; }
                    memcpy(buffer + size + (size > 0 ? 1 : 0), name, name_len);
                    size += add_len;
                    buffer[size] = '\0';
                }
            } while (FindNextFile(handle, &find_data));
            
            FindClose(handle);
        #else
            #include <dirent.h>
            #include <sys/types.h>
            DIR* dir = opendir(path);
            if (dir == NULL) {
                return strdup("");
            }
            
            struct dirent* entry;
            while ((entry = readdir(dir)) != NULL) {
                if (strcmp(entry->d_name, ".") != 0 && strcmp(entry->d_name, "..") != 0) {
                    const char *name = entry->d_name;
                    size_t name_len = strlen(name);
                    size_t add_len = name_len + (size > 0 ? 1 : 0);
                    char *newbuf = realloc(buffer, size + add_len + 1);
                    if (!newbuf) { free(buffer); closedir(dir); return strdup(""); }
                    buffer = newbuf;
                    if (size > 0) { buffer[size] = '\n'; }
                    memcpy(buffer + size + (size > 0 ? 1 : 0), name, name_len);
                    size += add_len;
                    buffer[size] = '\0';
                }
            }
            
            closedir(dir);
        #endif
        
        if (buffer == NULL) {
            return strdup("");
        }
        return buffer;
    )

## List directory entries (files and subdirectories). Excludes . and ..
pub fn list_dir(string path) -> collections::StringArrayList:
    string joined = fs::list_dir_joined(path)
    var result = new collections::StringArrayList(16)
    if strings::length(joined) == 0:
        return result
    result = strings::split(joined, "\n")
    return result
