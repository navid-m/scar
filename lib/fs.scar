import "std/strings"
import "std/io"
import "std/collections"

platform (Posix):
    external import "dirent.h"
    external import "sys/types.h"

## Create a directory at the given path. Returns true on success.
pub fn make_dir(string path) -> bool:
    platform (Windows):
        $raw (
            return mkdir(path) == 0;
        )

## Remove an empty directory. Returns true on success.
pub fn remove_dir(string path) -> bool:
    $raw (
        return rmdir(path) == 0;
    )
    
## Read entire file as bytes. Returns ByteArrayList of u8 values.
pub fn read_bytes(string filename) -> collections::ByteArrayList:
    var result = new collections::ByteArrayList(16)
    lstring content = io::read_file(filename)
    i32 n = strings::length(content)
    i32 i = 0
    while i < n:
        string ch = strings::get_char_at_lstr(content, i)
        i32 b = strings::ord(ch)
        result.add_element((u8)(b))
        i = i + 1
    return result

## Write bytes to a file. Overwrites existing file. Returns true on success.
pub fn write_bytes(string filename, collections::ArrayList data) -> bool:
    string out = ""
    i32 n = data.get_size()
    for i = 0 to n - 1:
        i32 v = data.get_element(i)
        string ch = strings::chr(v)
        out = fmt!("%s%s", out, ch)
    return io::write_file(filename, out)

## Check if a file or directory exists at path.
pub fn exists(string path) -> bool:
    $raw (
        return access(path, F_OK) == 0;
    )

## Remove a file at the given path. Returns true on success.
pub fn remove(string path) -> bool:
    $raw (
        return unlink(path) == 0;
    )

## Read a text file into a list of lines (without trailing newlines).
pub fn read_lines(string filename) -> list[string]:
    $raw (
        char** lines_temp = malloc(1000 * sizeof(char*));
        int lines_count = 0;
        FILE* file = fopen(filename, "r");
        if (file == NULL) {
            for (int _i = 0; _i < lines_count && _i < _max_size; _i++) {
                strcpy(_output_array[_i], "");
            }
            free(lines_temp);
            return 0;
        }
        char line_buffer[1024];
        while (fgets(line_buffer, sizeof(line_buffer), file) && lines_count < 1000) {
            size_t len = strlen(line_buffer);
            if (len > 0 && line_buffer[len-1] == '\n') {
                line_buffer[len-1] = '\0';
            }    
            lines_temp[lines_count] = malloc(strlen(line_buffer) + 1);
            strcpy(lines_temp[lines_count], line_buffer);
            lines_count++;
        }
        fclose(file);
        for (int _i = 0; _i < lines_count && _i < _max_size; _i++) {
            strcpy(_output_array[_i], lines_temp[_i]);
            free(lines_temp[_i]);
        }
        free(lines_temp);
        return lines_count;
    )

## List directory entries (files and subdirectories). Excludes . and ..
pub fn list_dir(string path) -> list[string]:
    $raw (
        char** entries_temp = malloc(1000 * sizeof(char*));
        int entries_count = 0;
        
        #ifdef _WIN32
            WIN32_FIND_DATA find_data;
            char search_path[1024];
            snprintf(search_path, sizeof(search_path), "%s\\*", path);
            
            HANDLE handle = FindFirstFile(search_path, &find_data);
            if (handle == INVALID_HANDLE_VALUE) {
                for (int _i = 0; _i < entries_count && _i < _max_size; _i++) {
                    strcpy(_output_array[_i], "");
                }
                free(entries_temp);
                return 0;
            }
            
            do {
                if (strcmp(find_data.cFileName, ".") != 0 && strcmp(find_data.cFileName, "..") != 0) {
                    entries_temp[entries_count] = malloc(strlen(find_data.cFileName) + 1);
                    strcpy(entries_temp[entries_count], find_data.cFileName);
                    entries_count++;
                }
            } while (FindNextFile(handle, &find_data) && entries_count < 1000);
            
            FindClose(handle);
        #else
            #include <dirent.h>
            #include <sys/types.h>
            DIR* dir = opendir(path);
            if (dir == NULL) {
                for (int _i = 0; _i < entries_count && _i < _max_size; _i++) {
                    strcpy(_output_array[_i], "");
                }
                free(entries_temp);
                return 0;
            }
            
            struct dirent* entry;
            while ((entry = readdir(dir)) != NULL && entries_count < 1000) {
                if (strcmp(entry->d_name, ".") != 0 && strcmp(entry->d_name, "..") != 0) {
                    entries_temp[entries_count] = malloc(strlen(entry->d_name) + 1);
                    strcpy(entries_temp[entries_count], entry->d_name);
                    entries_count++;
                }
            }
            
            closedir(dir);
        #endif
        
        for (int _i = 0; _i < entries_count && _i < _max_size; _i++) {
            strcpy(_output_array[_i], entries_temp[_i]);
            free(entries_temp[_i]);
        }
        free(entries_temp);
        return entries_count;
    )
