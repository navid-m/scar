import "std/strings"
import "std/collections"
import "std/io"

external import "ctype.h"

## A CSV row represented as a string array.
pub class CSVRow:
    init:
        collections::StringArrayList this.fields = new collections::StringArrayList(8)
    
    ## Add a field to the row.
    fn add_field(string field) -> void:
        collections::StringArrayList::add_element(this->>fields, field)
    
    ## Get a field by index.
    fn get_field(i32 index) -> string:
        if index < 0 || index >= collections::StringArrayList::get_size(this->>fields):
            return ""
        return collections::StringArrayList::get_element(this->>fields, index)
    
    ## Get the number of fields in the row.
    fn get_field_count() -> i32:
        return collections::StringArrayList::get_size(this->>fields)
    
    ## Set a field at a specific index.
    fn set_field(i32 index, string value) -> void:
        collections::StringArrayList::set_element(this->>fields, index, value)
    
    fn clear() -> void:
        for i = 0 to collections::StringArrayList::get_size(this->>fields) - 1:
            string old = collections::StringArrayList::get_element(this->>fields, i)
            if old != nil:
                free old
        collections::StringArrayList::clear(this->>fields)

## A CSV document containing multiple rows.
pub class CSV:
    init:
        i32 this.row_count = 0
        i32 this.capacity = 16
        ref void* this.rows = nil
        $raw (
            this->rows = malloc(this->capacity * sizeof(void*));
            for (int i = 0; i < this->capacity; i++) {
                ((void**)this->rows)[i] = NULL;
            }
        )
    
    ## Add a row to the CSV.
    fn add_row(ref csv::CSVRow row) -> void:
        if this.row_count >= this.capacity:
            this.resize()
        $raw (
            ((void**)this->rows)[this->row_count] = row;
        )
        this.row_count = this.row_count + 1
    
    ## Get a row by index.
    fn get_row(i32 index) -> ref csv::CSVRow:
        if index < 0 || index >= this.row_count:
            return nil
        $raw (
            return (csv_CSVRow*)((void**)this->rows)[index];
        )
    
    ## Get the number of rows.
    fn get_row_count() -> i32:
        return this.row_count
    
    ## Get a specific cell value.
    fn get_cell(i32 row, i32 col) -> string:
        ref csv::CSVRow r = this.get_row(row)
        if r == nil:
            return ""
        return csv::CSVRow::get_field(r, col)
    
    ## Set a specific cell value.
    fn set_cell(i32 row, i32 col, string value) -> void:
        ref csv::CSVRow r = this.get_row(row)
        if r != nil:
            r.set_field(col, value)
    
    ## Resize the internal row storage.
    fn resize() -> void:
        this.capacity = this.capacity * 2
        $raw (
            this->rows = realloc(this->rows, this->capacity * sizeof(void*));
            for (int i = this->row_count; i < this->capacity; i++) {
                ((void**)this->rows)[i] = NULL;
            }
        )

pub class CSVIter:
    init(string filename):
        ref void* this.file = nil
        int this.buffer_size = 8192
        ref void* this.buffer = malloc(this.buffer_size)
        ref csv::CSVRow this.row = nil
        this.row = new csv::CSVRow()
        
        $raw (
            this->file = (void*)fopen(filename, "r");
            if (!this->file) {
                runtime_error(fmt("Failed to open file %s", filename));
            }
        )

    fn next() -> ref csv::CSVRow:
        $raw (
            FILE* f = (FILE*)this->file;
            char* buf = (char*)this->buffer;
            csv_CSVRow_clear(this->row);  // reset previous row

            if (fgets(buf, this->buffer_size, f) == NULL) {
                return NULL;
            }

            char* start = buf;
            char* p = buf;

            while (*p) {
                if (*p == ',' || *p == '\n' || *p == '\r') {
                    *p = '\0';
                    csv_CSVRow_add_field(this->row, start);
                    start = p + 1;
                }
                p++;
            }

            if (*start != '\0') {
                csv_CSVRow_add_field(this->row, start);
            }

            return this->row;
        )

    fn close() -> void:
        $raw (
            if (this->file) fclose((FILE*)this->file);
            this->file = NULL;
            if (this->buffer) free(this->buffer);
            this->buffer = NULL;
        )

## Parse CSV content into a CSV document using a comma delimiter.
pub fn parse(string content) -> ref csv::CSV:
    return csv::parse_with(content, ",")

## Parse CSV content with a custom single-character delimiter (use first char if longer).
pub fn parse_with(string content, string delimiter) -> ref csv::CSV:
    ref csv::CSV doc = new csv::CSV()
    if strings::length(content) == 0:
        return doc
    
    lstring delim = strings::length(delimiter) > 0 ? strings::get_char_at_lstr(delimiter, 0) : ","
    lstring quote = "\""
    bool in_quote = false
    lstring field = ""
    ref csv::CSVRow row = new csv::CSVRow()
    int n = strings::length(content)
    
    int i = 0
    while i < n:
        lstring ch = strings::get_char_at_lstr(content, i)
        if in_quote:
            if ch == nil:
                continue
            if strings::compare(ch, quote) == 0:
                bool is_doubled = false
                if i + 1 < n:
                    lstring nextc = strings::get_char_at_lstr(content, i + 1)
                    if strings::compare(nextc, quote) == 0:
                        field = fmt!("%s%s", field, quote)
                        i = i + 1
                        is_doubled = true
                if !is_doubled:
                    in_quote = false
            else:
                field = fmt!("%s%s", field, ch)
        else:
            if strings::compare(ch, quote) == 0:
                in_quote = true
            elif strings::compare(ch, delim) == 0:
                row.add_field(field)
                field = ""
            elif strings::compare(ch, "\n") == 0 || strings::compare(ch, "\r") == 0:
                row.add_field(field)
                field = ""
                doc.add_row(row)
                row = new csv::CSVRow()
                if strings::compare(ch, "\r") == 0 && i + 1 < n:
                    lstring nextn = strings::get_char_at_lstr(content, i + 1)
                    if strings::compare(nextn, "\n") == 0:
                        i = i + 1
            else:
                if field == nil or ch == nil:
                    continue
                var sb = new strings::Builder()
                sb.append(field)
                sb.append(ch)
                field = sb.to_string()
        i = i + 1
    if in_quote:
        in_quote = false
    row.add_field(field)
    bool has_any = row.get_field_count() > 1 || (row.get_field_count() == 1 && strings::length(row.get_field(0)) > 0)
    if has_any:
        doc.add_row(row)
    return doc

## Convert a CSV document to string using comma delimiter and CRLF newlines.
pub fn to_string(ref csv::CSV doc) -> string:
    return csv::to_string_with(doc, ",")

## Convert a CSV document to string using a custom delimiter.
pub fn to_string_with(ref csv::CSV doc, string delimiter) -> string:
    lstring delim = strings::length(delimiter) > 0 ? strings::get_char_at_lstr(delimiter, 0) : ","
    lstring quote = "\""
    string out = ""
    int rows = doc.get_row_count()
    for r = 0 to rows - 1:
        ref csv::CSVRow row = doc.get_row(r)
        int cols = row.get_field_count()
        for c = 0 to cols - 1:
            lstring val = row.get_field(c)
            bool needs_quote = false
            if strings::contains(val, delim) || strings::contains(val, quote) || strings::contains(val, "\n") || strings::contains(val, "\r"):
                needs_quote = true
            if needs_quote:
                lstring esc = strings::replace(val, quote, fmt!("%s%s", quote, quote))
                out = fmt!("%s\"%s\"", out, esc)
            else:
                out = fmt!("%s%s", out, val)
            if c < cols - 1:
                out = fmt!("%s%s", out, delim)
        out = fmt!("%s\r\n", out)
    return out

## Read a CSV file (text) and parse it with comma delimiter.
pub fn read_file(string filename) -> ref csv::CSV:
    lstring content = io::read_file(filename)
    return csv::parse(content)

## Read a CSV file with a custom delimiter.
pub fn read_file_with(string filename, string delimiter) -> ref csv::CSV:
    lstring content = io::read_file(filename)
    return csv::parse_with(content, delimiter)

## Write a CSV document to a file using comma delimiter.
pub fn write_file(string filename, ref csv::CSV doc) -> bool:
    string content = csv::to_string(doc)
    return io::write_file(filename, content)

## Write a CSV document to a file with a custom delimiter.
pub fn write_file_with(string filename, ref csv::CSV doc, string delimiter) -> bool:
    string content = csv::to_string_with(doc, delimiter)
    return io::write_file(filename, content)

## Read CSV as stream
pub fn read_file_stream(string filename) -> ref csv::CSV:
    ref csv::CSV doc = new csv::CSV()

    $raw (
        if (filename == NULL) {
            return nil;
        }

        FILE* file = fopen(filename, "r");
        if (file == NULL) {
            runtime_error(fmt("Failed to open file %s", filename));
        }
        char buffer[8192];
        while (fgets(buffer, sizeof(buffer), file)) {
            csv_CSVRow* row = csv_CSVRow_new();
            char* token = buffer;
            char* field_start = token;
            bool in_quote = false;

            for (; *token; token++) {
                if (*token == '"') {
                    in_quote = !in_quote;
                } else if (*token == ',' && !in_quote) {
                    *token = '\0';
                    csv_CSVRow_add_field(row, strdup(field_start));
                    field_start = token + 1;
                } else if ((*token == '\n' || *token == '\r') && !in_quote) {
                    *token = '\0';
                    csv_CSVRow_add_field(row, strdup(field_start));
                    field_start = token + 1;
                }
            }

            if (*field_start != '\0') {
                csv_CSVRow_add_field(row, strdup(field_start));
            }

            csv_CSV_add_row(doc, row);
        }

        fclose(file);
    )

    return doc
