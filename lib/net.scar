## Download a file from URL to local path
pub fn download_file(string url, string filepath) -> bool:
    $raw (
        char command[1024];
        snprintf(command, sizeof(command), "curl -s -o \"%s\" \"%s\"", filepath, url);
        
        int result = system(command);
        return (result == 0);
    )

## Simple function to check if a URL is reachable
pub fn ping_url(string url) -> bool:
    $raw (
        char command[512];
        snprintf(command, sizeof(command), "curl -s --head \"%s\" > /dev/null 2>&1", url);
        
        int result = system(command);
        return (result == 0);
    )
