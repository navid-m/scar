## VERY basic. Will wrap libcurl in the future.

import "std/strings"

## URL encode a string
pub fn url_encode(string input) -> char*:
    $raw (
        char *encodedText = (char*)malloc(sizeof(char)*strlen(input)*3+1);
        const char *hex = "0123456789abcdef";
        int pos = 0;
        for (int i = 0; i < strlen(input); i++) {
            if (('a' <= input[i] && input[i] <= 'z')
                || ('A' <= input[i] && input[i] <= 'Z')
                || ('0' <= input[i] && input[i] <= '9')
                || input[i] == '-' || input[i] == '_' || input[i] == '.' || input[i] == '~') {
                    encodedText[pos++] = input[i];
                } else {
                    encodedText[pos++] = '%';
                    encodedText[pos++] = hex[input[i] >> 4];
                    encodedText[pos++] = hex[input[i] & 15];
                }
        }
        encodedText[pos] = '\0';
        return encodedText;
    )

## URL decode a string
pub fn url_decode(char* str) -> char*:
    $raw (
        int d = 0;
        char *dStr = malloc(strlen(str) + 1);
        char eStr[] = "00";
        strcpy(dStr, str);
        while(!d) {
            d = 1;
            int i;
            for(i=0;i<strlen(dStr);++i) {
                if(dStr[i] == '%') {
                    if(dStr[i+1] == 0)
                        return dStr;  
                    if(isxdigit(dStr[i+1]) && isxdigit(dStr[i+2])) {
                        d = 0;      
                        eStr[0] = dStr[i+1];
                        eStr[1] = dStr[i+2];
                        long int x = strtol(eStr, NULL, 16);
                        memmove(&dStr[i+1], &dStr[i+3], strlen(&dStr[i+3])+1);
                        dStr[i] = x;
                    }
                }
            }
        }
    )
    return strings::replace(dStr, "+", " ")

pub class HttpResponse:
    init:
        i32 this.status_code = 0
        string this.body = ""
        string this.error = ""

## HTTP GET request using cross-platform system approach
pub fn http_get(string url) -> net::HttpResponse:
    $raw (        
        net_HttpResponse* response = net_HttpResponse_new();
        
        char *result = malloc(8192);
        char command[512];
        
        snprintf(command, sizeof(command), "curl -s -w \"%%{http_code}\" \"%s\"", url);
        
        FILE *fp = popen(command, "r");
        if (fp == NULL) {
            strcpy(response->error, "curl command failed or not available");
            response->status_code = 0;
            free(result);
            return response;
        }
        
        char buffer[1024];
        result[0] = '\0';
        
        while (fgets(buffer, sizeof(buffer), fp) != NULL) {
            strcat(result, buffer);
        }
        
        int exit_code = pclose(fp);
        
        if (strlen(result) >= 3) {
            // Extract status code from end of response
            char status_str[4];
            strcpy(status_str, result + strlen(result) - 3);
            response->status_code = atoi(status_str);
            
            // Remove status code from body
            result[strlen(result) - 3] = '\0';
            strncpy(response->body, result, 255);
            response->body[255] = '\0';
        } else {
            strcpy(response->error, "Invalid response from server");
            response->status_code = 0;
        }
        
        free(result);
        return response;
    )

## HTTP POST request using cross-platform system approach  
pub fn http_post(string url, string data) -> net::HttpResponse:
    $raw (
        net_HttpResponse* response = net_HttpResponse_new();
        
        char *result = malloc(8192);
        char *command = malloc(1024 + strlen(data));
        
        snprintf(command, 1024 + strlen(data), "curl -s -w \"%%{http_code}\" -X POST -d \"%s\" \"%s\"", data, url);
        
        FILE *fp = popen(command, "r");
        if (fp == NULL) {
            strcpy(response->error, "curl command failed or not available");
            response->status_code = 0;
            free(result);
            free(command);
            return response;
        }
        
        char buffer[1024];
        result[0] = '\0';
        
        while (fgets(buffer, sizeof(buffer), fp) != NULL) {
            strcat(result, buffer);
        }
        
        pclose(fp);
        
        if (strlen(result) >= 3) {
            char status_str[4];
            strcpy(status_str, result + strlen(result) - 3);
            response->status_code = atoi(status_str);
            
            result[strlen(result) - 3] = '\0';
            strncpy(response->body, result, 255);
            response->body[255] = '\0';
        } else {
            strcpy(response->error, "Invalid response from server");
            response->status_code = 0;
        }
        
        free(result);
        free(command);
        return response;
    )

