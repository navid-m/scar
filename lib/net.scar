import "std/strings"

external import "curl/curl.h"

## URL encode a string
pub fn url_encode(string input) -> char*:
    $raw (
        char *encodedText = (char*)malloc(sizeof(char)*strlen(input)*3+1);
        const char *hex = "0123456789abcdef";
        int pos = 0;
        for (int i = 0; i < strlen(input); i++) {
            if (('a' <= input[i] && input[i] <= 'z')
                || ('A' <= input[i] && input[i] <= 'Z')
                || ('0' <= input[i] && input[i] <= '9')
                || input[i] == '-' || input[i] == '_' || input[i] == '.' || input[i] == '~') {
                    encodedText[pos++] = input[i];
                } else {
                    encodedText[pos++] = '%';
                    encodedText[pos++] = hex[input[i] >> 4];
                    encodedText[pos++] = hex[input[i] & 15];
                }
        }
        encodedText[pos] = '\0';
        return encodedText;
    )

## URL decode a string
pub fn url_decode(char* str) -> char*:
    $raw (
        int d = 0;
        char *dStr = malloc(strlen(str) + 1);
        char eStr[] = "00";
        strcpy(dStr, str);
        while(!d) {
            d = 1;
            int i;
            for(i=0;i<strlen(dStr);++i) {
                if(dStr[i] == '%') {
                    if(dStr[i+1] == 0)
                        return dStr;  
                    if(isxdigit(dStr[i+1]) && isxdigit(dStr[i+2])) {
                        d = 0;      
                        eStr[0] = dStr[i+1];
                        eStr[1] = dStr[i+2];
                        long int x = strtol(eStr, NULL, 16);
                        memmove(&dStr[i+1], &dStr[i+3], strlen(&dStr[i+3])+1);
                        dStr[i] = x;
                    }
                }
            }
        }
    )
    return strings::replace(dStr, "+", " ")

## Represents some response from a HTTP request
pub class HttpResponse:
    init:
        i32 this.status_code = 0
        string this.body = ""
        string this.error = ""

## Send a GET request to the specified URL and return the response
pub fn http_get(char* url) -> net::HttpResponse:
    $raw (
        typedef struct {
            char *data;
            size_t size;
        } Memory;

        size_t write_callback(void *contents, size_t size, size_t nmemb, void *userp) {
            size_t realsize = size * nmemb;
            Memory *mem = (Memory *)userp;
            char *ptr = (char*)realloc(mem->data, mem->size + realsize + 1);
            if (!ptr) return 0;
            mem->data = ptr;
            memcpy(&(mem->data[mem->size]), contents, realsize);
            mem->size += realsize;
            mem->data[mem->size] = '\0';
            return realsize;
        }

        net_HttpResponse* response = net_HttpResponse_new();
        response->status_code = 0;
        response->body[0] = '\0';
        response->error[0] = '\0';

        CURL *curl = NULL;
        CURLcode res;
        Memory chunk;
        chunk.data = (char*)malloc(1);
        chunk.size = 0;

        curl_global_init(CURL_GLOBAL_DEFAULT);
        curl = curl_easy_init();
        if (curl) {
            curl_easy_setopt(curl, CURLOPT_URL, url);
            curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 1L);
            curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, write_callback);
            curl_easy_setopt(curl, CURLOPT_WRITEDATA, (void *)&chunk);

            res = curl_easy_perform(curl);
            if (res != CURLE_OK) {
                const char* err = curl_easy_strerror(res);
                strncpy(response->error, err, 255);
                response->error[255] = '\0';
            } else {
                long http_code = 0;
                curl_easy_getinfo(curl, CURLINFO_RESPONSE_CODE, &http_code);
                response->status_code = (int)http_code;
                if (chunk.size > 0 && chunk.data) {
                    strncpy(response->body, chunk.data, 255);
                    response->body[255] = '\0';
                }
            }
            curl_easy_cleanup(curl);
        } else {
            strncpy(response->error, "curl_easy_init failed", 255);
            response->error[255] = '\0';
        }

        if (chunk.data) free(chunk.data);
        curl_global_cleanup();
        return response;
    )

## Send a POST request to the specified URL and return the response
pub fn http_post(char* url, char* data) -> net::HttpResponse:
    $raw (
        typedef struct {
            char *data;
            size_t size;
        } Memory;

        size_t write_callback(void *contents, size_t size, size_t nmemb, void *userp) {
            size_t realsize = size * nmemb;
            Memory *mem = (Memory *)userp;
            char *ptr = (char*)realloc(mem->data, mem->size + realsize + 1);
            if (!ptr) return 0;
            mem->data = ptr;
            memcpy(&(mem->data[mem->size]), contents, realsize);
            mem->size += realsize;
            mem->data[mem->size] = '\0';
            return realsize;
        }

        net_HttpResponse* response = net_HttpResponse_new();
        response->status_code = 0;
        response->body[0] = '\0';
        response->error[0] = '\0';

        CURL *curl = NULL;
        CURLcode res;
        Memory chunk;
        chunk.data = (char*)malloc(1);
        chunk.size = 0;

        curl_global_init(CURL_GLOBAL_DEFAULT);
        curl = curl_easy_init();
        if (curl) {
            curl_easy_setopt(curl, CURLOPT_URL, url);
            curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 1L);
            curl_easy_setopt(curl, CURLOPT_POSTFIELDS, data);
            curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, write_callback);
            curl_easy_setopt(curl, CURLOPT_WRITEDATA, (void *)&chunk);

            res = curl_easy_perform(curl);
            if (res != CURLE_OK) {
                const char* err = curl_easy_strerror(res);
                strncpy(response->error, err, 255);
                response->error[255] = '\0';
            } else {
                long http_code = 0;
                curl_easy_getinfo(curl, CURLINFO_RESPONSE_CODE, &http_code);
                response->status_code = (int)http_code;
                if (chunk.size > 0 && chunk.data) {
                    strncpy(response->body, chunk.data, 255);
                    response->body[255] = '\0';
                }
            }
            curl_easy_cleanup(curl);
        } else {
            strncpy(response->error, "curl_easy_init failed", 255);
            response->error[255] = '\0';
        }

        if (chunk.data) free(chunk.data);
        curl_global_cleanup();
        return response;
    )

## HTTP PUT request
pub fn http_put(string url, string data) -> net::HttpResponse:
    $raw (
        typedef struct {
            char *data;
            size_t size;
        } Memory;

        size_t write_callback(void *contents, size_t size, size_t nmemb, void *userp) {
            size_t realsize = size * nmemb;
            Memory *mem = (Memory *)userp;
            char *ptr = (char*)realloc(mem->data, mem->size + realsize + 1);
            if (!ptr) return 0;
            mem->data = ptr;
            memcpy(&(mem->data[mem->size]), contents, realsize);
            mem->size += realsize;
            mem->data[mem->size] = '\0';
            return realsize;
        }

        net_HttpResponse* response = net_HttpResponse_new();
        response->status_code = 0;
        response->body[0] = '\0';
        response->error[0] = '\0';

        CURL *curl = NULL;
        CURLcode res;
        Memory chunk;
        chunk.data = (char*)malloc(1);
        chunk.size = 0;

        curl_global_init(CURL_GLOBAL_DEFAULT);
        curl = curl_easy_init();
        if (curl) {
            curl_easy_setopt(curl, CURLOPT_URL, url);
            curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 1L);
            curl_easy_setopt(curl, CURLOPT_CUSTOMREQUEST, "PUT");
            curl_easy_setopt(curl, CURLOPT_POSTFIELDS, data);
            curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, write_callback);
            curl_easy_setopt(curl, CURLOPT_WRITEDATA, (void *)&chunk);

            res = curl_easy_perform(curl);
            if (res != CURLE_OK) {
                const char* err = curl_easy_strerror(res);
                strncpy(response->error, err, 255);
                response->error[255] = '\0';
            } else {
                long http_code = 0;
                curl_easy_getinfo(curl, CURLINFO_RESPONSE_CODE, &http_code);
                response->status_code = (int)http_code;
                if (chunk.size > 0 && chunk.data) {
                    strncpy(response->body, chunk.data, 255);
                    response->body[255] = '\0';
                }
            }
            curl_easy_cleanup(curl);
        } else {
            strncpy(response->error, "curl_easy_init failed", 255);
            response->error[255] = '\0';
        }

        if (chunk.data) free(chunk.data);
        curl_global_cleanup();
        return response;
    )

## HTTP DELETE request
pub fn http_delete(string url) -> net::HttpResponse:
    $raw (
        typedef struct {
            char *data;
            size_t size;
        } Memory;

        size_t write_callback(void *contents, size_t size, size_t nmemb, void *userp) {
            size_t realsize = size * nmemb;
            Memory *mem = (Memory *)userp;
            char *ptr = (char*)realloc(mem->data, mem->size + realsize + 1);
            if (!ptr) return 0;
            mem->data = ptr;
            memcpy(&(mem->data[mem->size]), contents, realsize);
            mem->size += realsize;
            mem->data[mem->size] = '\0';
            return realsize;
        }

        net_HttpResponse* response = net_HttpResponse_new();
        response->status_code = 0;
        response->body[0] = '\0';
        response->error[0] = '\0';

        CURL *curl = NULL;
        CURLcode res;
        Memory chunk;
        chunk.data = (char*)malloc(1);
        chunk.size = 0;

        curl_global_init(CURL_GLOBAL_DEFAULT);
        curl = curl_easy_init();
        if (curl) {
            curl_easy_setopt(curl, CURLOPT_URL, url);
            curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 1L);
            curl_easy_setopt(curl, CURLOPT_CUSTOMREQUEST, "DELETE");
            curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, write_callback);
            curl_easy_setopt(curl, CURLOPT_WRITEDATA, (void *)&chunk);

            res = curl_easy_perform(curl);
            if (res != CURLE_OK) {
                const char* err = curl_easy_strerror(res);
                strncpy(response->error, err, 255);
                response->error[255] = '\0';
            } else {
                long http_code = 0;
                curl_easy_getinfo(curl, CURLINFO_RESPONSE_CODE, &http_code);
                response->status_code = (int)http_code;
                if (chunk.size > 0 && chunk.data) {
                    strncpy(response->body, chunk.data, 255);
                    response->body[255] = '\0';
                }
            }
            curl_easy_cleanup(curl);
        } else {
            strncpy(response->error, "curl_easy_init failed", 255);
            response->error[255] = '\0';
        }

        if (chunk.data) free(chunk.data);
        curl_global_cleanup();
        return response;
    )

## Download a file from URL to local path
pub fn download_file(string url, string filepath) -> bool:
    $raw (
        char command[1024];
        snprintf(command, sizeof(command), "curl -s -o \"%s\" \"%s\"", filepath, url);
        
        int result = system(command);
        return (result == 0);
    )

## Simple function to check if a URL is reachable
pub fn ping_url(string url) -> bool:
    $raw (
        char command[512];
        snprintf(command, sizeof(command), "curl -s --head \"%s\" > /dev/null 2>&1", url);
        
        int result = system(command);
        return (result == 0);
    )
