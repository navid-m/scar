## VERY basic. Will wrap libcurl in the future.

import "std/strings"

pub fn url_encode(string input) -> char*:
    $raw (
        char *encodedText = (char*)malloc(sizeof(char)*strlen(input)*3+1);
        const char *hex = "0123456789abcdef";
        int pos = 0;
        for (int i = 0; i < strlen(input); i++) {
            if (('a' <= input[i] && input[i] <= 'z')
                || ('A' <= input[i] && input[i] <= 'Z')
                || ('0' <= input[i] && input[i] <= '9')) {
                    encodedText[pos++] = input[i];
                } else {
                    encodedText[pos++] = '%';
                    encodedText[pos++] = hex[input[i] >> 4];
                    encodedText[pos++] = hex[input[i] & 15];
                }
        }
        encodedText[pos] = '\0';
        return encodedText;
    )

## URL decode a string
pub fn url_decode(char* str) -> char*:
    $raw (
        int d = 0;

        char *dStr = malloc(strlen(str) + 1);
        char eStr[] = "00";
      
        strcpy(dStr, str);
      
        while(!d) {
          d = 1;
          int i;
          for(i=0;i<strlen(dStr);++i) {
            if(dStr[i] == '%') {
              if(dStr[i+1] == 0)
                return dStr;  
              if(isxdigit(dStr[i+1]) && isxdigit(dStr[i+2])) {
    
                d = 0;      
                eStr[0] = dStr[i+1];
                eStr[1] = dStr[i+2];
      
                long int x = strtol(eStr, NULL, 16);
                memmove(&dStr[i+1], &dStr[i+3], strlen(&dStr[i+3])+1);
                dStr[i] = x;
              }
            }
          }
        }
    )
    return strings::replace(dStr, "+", " ")

## Simple HTTP GET request using system curl command
pub fn http_get(string url) -> string:
    $raw (
        #include <stdio.h>
        #include <stdlib.h>
        #include <string.h>
        
        char *result = malloc(8192);
        char command[512];
        
        snprintf(command, sizeof(command), "curl -s \"%s\"", url);
        
        FILE *fp = popen(command, "r");
        if (fp == NULL) {
            strcpy(result, "Error: curl command failed or not available");
            return result;
        }
        
        char buffer[1024];
        result[0] = '\0';
        
        while (fgets(buffer, sizeof(buffer), fp) != NULL) {
            strcat(result, buffer);
        }
        
        pclose(fp);
        
        if (strlen(result) == 0) {
            strcpy(result, "No response received");
        }
        
        return result;
    )

## Simple HTTP POST request using system curl command
pub fn http_post(string url, string data) -> string:
    $raw (
        #include <stdio.h>
        #include <stdlib.h>
        #include <string.h>
        
        char *result = malloc(8192);
        char command[1024];
        
        snprintf(command, sizeof(command), "curl -s -X POST -d \"%s\" \"%s\"", data, url);
        
        FILE *fp = popen(command, "r");
        if (fp == NULL) {
            strcpy(result, "Error: curl command failed or not available");
            return result;
        }
        
        char buffer[1024];
        result[0] = '\0';
        
        while (fgets(buffer, sizeof(buffer), fp) != NULL) {
            strcat(result, buffer);
        }
        
        pclose(fp);
        
        if (strlen(result) == 0) {
            strcpy(result, "No response received");
        }
        
        return result;
    )
