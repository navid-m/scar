        char command[512];
        
        snprintf(command, sizeof(command), "curl -s -w \"%%{http_code}\" -X DELETE \"%s\"", url);
        
        FILE *fp = popen(command, "r");
        if (fp == NULL) {
            strcpy(response->error, "curl command failed or not available");
            response->status_code = 0;
