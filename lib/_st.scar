import "std/collections"
import "std/math"
import "std/strings"
import "std/test"
import "std/os"
import "std/path"
import "std/random"
import "std/log"
import "std/time"
import "std/fs"
import "std/hash"
import "std/sort"
import "std/io"
import "std/json"
import "std/uri"
import "std/runtime"
import "std/csv"
import "std/typecons"

platform (Windows):
    import "std/net"
    import "std/threads"

import "std/regex"
import "std/crypto"

var list = new collections::ArrayList(4)

list.add_element(10)
list.add_element(20)
list.add_element(30)

var t = new test::UnitTest()
i32 size = list.get_size()

# Collections Tests
t.assert_equals(3, size, "List size should be 3")

# Math Tests
t.assert_float_equals(3.14, math::round(3.14159265359, 2), 0.01, "Rounding error should be within tolerance")
t.assert_equals(0, math::asin(2.0), "asin(2.0) should return 0.0")
t.assert_equals(0, math::acos(2.0), "acos(2.0) should return 0.0")
t.assert_equals(0, math::atan(0.0), "atan(0.0) should return 0.0")
t.assert_float_equals(1.0, math::sin(math::PI / 2), 0.0001, "sin(PI/2) should be approximately 1.0")
t.assert_float_equals(0.0, math::cos(math::PI / 2), 0.0001, "cos(PI/2) should be approximately 0.0")
t.assert_float_equals(1.0, math::tan(math::PI / 4), 0.0001, "tan(PI/4) should be approximately 1.0")
t.assert_float_equals(2.718282, math::exp(1.0), 0.0000001, "exp(1.0) should be approximately e")
t.assert_float_equals(0.0, math::ln(1.0), 0.0000001, "ln(1.0) should be approximately 0.0")
t.assert_equals(123, math::to_int("123"), "to_int should return 123")

# Vector2 Tests
ref math::Vector2 v2zero = new math::Vector2(0.0,0.0)
t.assert_equals(0, v2zero.x, "Vector2 default x should be 0")
t.assert_equals(0, v2zero.y, "Vector2 default y should be 0")

ref math::Vector2 v2a = new math::Vector2(0.0,0.0)
ref math::Vector2 v2b = new math::Vector2(0.0,0.0)
v2a.x = 1.0
v2a.y = 2.0
v2b.x = 3.0
v2b.y = 4.0

ref math::Vector2 v2add = v2a.add(v2b)
t.assert_float_equals(4.0, v2add.x, 0.0001, "Vector2 add.x should be 4")
t.assert_float_equals(6.0, v2add.y, 0.0001, "Vector2 add.y should be 6")

ref math::Vector2 v2sub = v2a.sub(v2b)
t.assert_float_equals(-2.0, v2sub.x, 0.0001, "Vector2 sub.x should be -2")
t.assert_float_equals(-2.0, v2sub.y, 0.0001, "Vector2 sub.y should be -2")

ref math::Vector2 v2mul = v2a.mul(v2b)
t.assert_float_equals(3.0, v2mul.x, 0.0001, "Vector2 mul.x should be 3")
t.assert_float_equals(8.0, v2mul.y, 0.0001, "Vector2 mul.y should be 8")
v2a.x = 8.0
v2a.y = 6.0
v2b.x = 2.0
v2b.y = 3.0
ref math::Vector2 v2div = v2a.div(v2b)
t.assert_float_equals(4.0, v2div.x, 0.0001, "Vector2 div.x should be 4")
t.assert_float_equals(2.0, v2div.y, 0.0001, "Vector2 div.y should be 2")

# Vector3 Tests
ref math::Vector3 v3zero = new math::Vector3(0.0, 0.0, 0.0)
t.assert_equals(0, v3zero.x, "Vector3 default x should be 0")
t.assert_equals(0, v3zero.y, "Vector3 default y should be 0")
t.assert_equals(0, v3zero.z, "Vector3 default z should be 0")

ref math::Vector3 v3a = new math::Vector3(0.0, 0.0, 0.0)
ref math::Vector3 v3b = new math::Vector3(0.0, 0.0, 0.0)
v3a.x = 1.0
v3a.y = 2.0
v3a.z = 3.0
v3b.x = 4.0
v3b.y = 5.0
v3b.z = 6.0

ref math::Vector3 v3add = v3a.add(v3b)
t.assert_float_equals(5.0, v3add.x, 0.0001, "Vector3 add.x should be 5")
t.assert_float_equals(7.0, v3add.y, 0.0001, "Vector3 add.y should be 7")
t.assert_float_equals(9.0, v3add.z, 0.0001, "Vector3 add.z should be 9")

ref math::Vector3 v3sub = v3a.sub(v3b)
t.assert_float_equals(-3.0, v3sub.x, 0.0001, "Vector3 sub.x should be -3")
t.assert_float_equals(-3.0, v3sub.y, 0.0001, "Vector3 sub.y should be -3")
t.assert_float_equals(-3.0, v3sub.z, 0.0001, "Vector3 sub.z should be -3")

ref math::Vector3 v3mul = v3a.mul(v3b)
t.assert_float_equals(4.0, v3mul.x, 0.0001, "Vector3 mul.x should be 4")
t.assert_float_equals(10.0, v3mul.y, 0.0001, "Vector3 mul.y should be 10")
t.assert_float_equals(18.0, v3mul.z, 0.0001, "Vector3 mul.z should be 18")
v3a.x = 8.0
v3a.y = 9.0
v3a.z = 12.0
v3b.x = 2.0
v3b.y = 3.0
v3b.z = 4.0

ref math::Vector3 v3div = v3a.div(v3b)
t.assert_float_equals(4.0, v3div.x, 0.0001, "Vector3 div.x should be 4")
t.assert_float_equals(3.0, v3div.y, 0.0001, "Vector3 div.y should be 3")
t.assert_float_equals(3.0, v3div.z, 0.0001, "Vector3 div.z should be 3")

# String Tests
t.assert_equals(0, strings::compare("Hello, World!", "Hello, World!"), "String comparison should be equal")
t.assert_equals(5, strings::length("Hello"), "String length should be 5")

bool ew1 = strings::ends_with("filename.txt", "txt")
t.assert_equals(true, ew1, "ends_with should return true for matching suffix")
bool ew2 = strings::ends_with("abc", "abcd")
t.assert_equals(false, ew2, "ends_with should return false when suffix longer than string")

bool c1 = strings::contains("hello world", "world")
t.assert_equals(true, c1, "contains should find substring")
bool c2 = strings::contains("hello", "z")
t.assert_equals(false, c2, "contains should return false when not found")

string ts1 = strings::trim_suffix("hello", "lo")
t.assert_string_equals("hel", ts1, "trim_suffix should remove matching suffix")
string ts2 = strings::trim_suffix("hello", "zz")
t.assert_string_equals("hello", ts2, "trim_suffix should return original when no match")

string hex1 = strings::to_hex(255)
t.assert_string_equals("FF", hex1, "to_hex(255) should be 'FF'")
string hex2 = strings::to_hex(-5)
t.assert_string_equals("0", hex2, "to_hex of negative should be '0'")

t.assert_equals(true, strings::equal("same", "same"), "equal should be true for same strings")
t.assert_equals(false, strings::equal("a", "b"), "equal should be false for different strings")

string rep1 = strings::replace("a-b-a-b", "a", "x")
t.assert_string_equals("x-b-x-b", rep1, "replace should substitute all occurrences")
string rep2 = strings::replace("abc", "z", "x")
t.assert_string_equals("abc", rep2, "replace should return original when no matches")
string rep3 = strings::replace("abc", "", "x")
t.assert_string_equals("abc", rep3, "replace with empty old_substr should return original")

string ch1 = strings::get_char_at("hello", 1)
t.assert_string_equals("e", ch1, "get_char_at should return character at index")
string ch2 = strings::get_char_at("hello", 99)
t.assert_string_equals("", ch2, "get_char_at out of bounds should return empty string")

ref collections::StringArrayList sp1 = strings::split("a|b|c", "|")
t.assert_equals(3, sp1.get_size(), "split should produce 3 elements when delimiter present")
t.assert_string_equals("a", sp1.get_element(0), "split[0] should be 'a'")
t.assert_string_equals("b", sp1.get_element(1), "split[1] should be 'b'")
t.assert_string_equals("c", sp1.get_element(2), "split[2] should be 'c'")

ref collections::StringArrayList sp2 = strings::split("abc", "")
t.assert_equals(1, sp2.get_size(), "split with empty delimiter should return whole string")
t.assert_string_equals("abc", sp2.get_element(0), "split(empty delim) should equal original")

ref collections::StringArrayList sp3 = strings::split("", ",")
t.assert_equals(1, sp3.get_size(), "split empty string should return one empty element")
t.assert_string_equals("", sp3.get_element(0), "split empty string -> empty element")

ref collections::StringArrayList sp4 = strings::split("abc", ",,,")
t.assert_equals(1, sp4.get_size(), "split with delimiter longer than string should return original as one element")
t.assert_string_equals("abc", sp4.get_element(0), "split with long delim should equal original")

ref collections::StringArrayList split_result1 = strings::split("apple,banana,cherry", ",")
t.assert_equals(3, split_result1.get_size(), "Split should produce 3 parts")
t.assert_string_equals("apple", split_result1.get_element(0), "First part should be 'apple'")
t.assert_string_equals("banana", split_result1.get_element(1), "Second part should be 'banana'")
t.assert_string_equals("cherry", split_result1.get_element(2), "Third part should be 'cherry'")

# OS Tests
log::success(fmt!("ASSERT PASSED: Currently directory correctly detected as: %s", os::cwd()))
log::success(fmt!("ASSERT PASSED: Home directory detected as: %s", os::homedir()))
log::success(fmt!("ASSERT PASSED: Temporary directory detected as: %s", os::tempdir()))

# Runtime Tests
int pw = runtime::pointer_width()
t.assert_true(pw == 32 || pw == 64, fmt!("pointer_width should be 32 or 64, got %d", pw))

bool le = runtime::is_little_endian()
platform (Windows):
    t.assert_equals(true, le, "Windows should be little-endian")
platform (Posix):
    log::success(fmt!("ASSERT PASSED: Endianness detected as: %s", le ? "little" : "big"))

# Path Tests
t.assert_equals(true, path::is_absolute_path("/absolute/path"), "Path should be absolute")
t.assert_equals(false, path::is_absolute_path("relative/path"), "Path should not be absolute")
t.assert_string_equals("txt", path::extension("file.txt"), "File extension should be 'txt'")
t.assert_string_equals("/base/path/file.txt", path::join("/base/path", "file.txt"), "Join should produce correct path")
t.assert_string_equals("file.txt", path::basename("/base/path/file.txt"), "Basename should be 'file.txt'")
t.assert_string_equals("/base/path", path::dirname("/base/path/file.txt"), "Dirname should be '/base/path'")

# Random Tests
t.assert_equals(6, strings::length(random::uuid(7)), "UUID length should be 6 characters")

log::success(fmt!("ASSERT PASSED: Generated UUID: %s", random::uuid(12)))
log::success(fmt!("ASSERT PASSED: Random number between 1 and 10: %d", random::num(1, 10)))
log::success(fmt!("ASSERT PASSED: Random float between 0.0 and 111.0: %f", random::float_range(0.0, 111.0)))
log::success(fmt!("ASSERT PASSED: Random float between 0 and 1: %f", random::floatb()))
log::success(fmt!("ASSERT PASSED: Current timestamp: %d", time::timestamp()))
log::success(fmt!("ASSERT PASSED: Current time: %s", time::format_date(time::now())))

collections::StringArrayList strList = new collections::StringArrayList(5)

strList.add_element("hello")
strList.add_element("world")
strList.add_element("scar")

i32 max = strList.get_size() - 1

for i = 0 to max:
    string x = strList.get_element(i)
    log::success(fmt!("ASSERT PASSED: Got list item: %s", x))

write("Hello World", "output.txt", overwrite!)
string data = read("output.txt")
t.assert_string_equals("Hello World", data, "Read data should be 'Hello World'")
collections::StringArrayList otherdata = fs::read_lines("output.txt")
t.assert_string_equals("Hello World", collections::StringArrayList::get_element(otherdata, 0), "First line should be 'Hello World'")

fs::remove("output.txt")

# Filesystem Tests
fs::make_dir("test_dir")
write("test1.txt", "test_dir/test1.txt", overwrite!)
write("test2.txt", "test_dir/test2.txt", overwrite!)
collections::StringArrayList dir_contents = fs::list_dir("test_dir")

bool found_test1 = false
bool found_test2 = false

for i = 0 to dir_contents.get_size() - 1:
    if strings::compare(collections::StringArrayList::get_element(dir_contents, i), "test1.txt") == 0:
        found_test1 = true
    if strings::compare(collections::StringArrayList::get_element(dir_contents, i), "test2.txt") == 0:
        found_test2 = true

t.assert_equals(true, found_test1, "Should find test1.txt in directory")
t.assert_equals(true, found_test2, "Should find test2.txt in directory")

fs::remove("test_dir/test1.txt")
fs::remove("test_dir/test2.txt")
fs::remove_dir("test_dir")

collections::ArrayList out = new collections::ArrayList(3)
out.add_element(65)
out.add_element(66)
out.add_element(67)
fs::write_bytes("bytes_test.bin", out)
t.assert_equals(true, fs::exists("bytes_test.bin"), "File should exist after write")
fs::remove("bytes_test.bin")
t.assert_equals(false, fs::exists("bytes_test.bin"), "File should not exist after remove")

collections::StringArrayList args = os::get_args()
for i = 0 to args.get_size() - 1:
    log::success(fmt!("ASSERT PASSED: Command line argument %d: %s", i, args[i]))

ref collections::ArrayList nums = new collections::ArrayList(10)

collections::ArrayList::add_element(nums, 5)
collections::ArrayList::add_element(nums, 10)
collections::ArrayList::add_element(nums, 2)
collections::ArrayList::add_element(nums, 20)
collections::ArrayList::add_element(nums, 14)
collections::ArrayList::add_element(nums, 12)

ref collections::ArrayList expected = new collections::ArrayList(6)
collections::ArrayList::add_element(expected, 2)
collections::ArrayList::add_element(expected, 5)
collections::ArrayList::add_element(expected, 10)
collections::ArrayList::add_element(expected, 12)
collections::ArrayList::add_element(expected, 14)
collections::ArrayList::add_element(expected, 20)

nums = sort::sort_int_list(nums)

t.assert_int_arraylist_equals(expected, nums, "Sorted list should be [2, 5, 10, 12, 14, 20]")

int x = strings::ord("H")
t.assert_equals(72, x, "ord('H') should return 72")

string c = strings::chr(72)
t.assert_string_equals("H", c, "chr(72) should return 'H'")
t.assert_string_equals("Hello", strings::trim_space("   Hello   "), "Trimmed string should be 'Hello'")
t.assert_string_equals("sdf", strings::trim_prefix("asdf", "a"), "Trimmed prefix should be 'sdf'")

platform (Windows):
    string decoded_simple = net::url_decode("hello%20world")
    t.assert_string_equals("hello world", decoded_simple, "Simple URL decoding should work")
    string decoded_special = net::url_decode("hello%40world.com")
    t.assert_string_equals("hello@world.com", decoded_special, "Special characters should be decoded")
    string decoded_plus = net::url_decode("hello+world")
    t.assert_string_equals("hello world", decoded_plus, "Plus signs should be decoded as spaces")
    string decoded_empty = net::url_decode("")
    t.assert_string_equals("", decoded_empty, "Empty string should return empty")
    string decoded_safe = net::url_decode("hello-world_test.file~")
    t.assert_string_equals("hello-world_test.file~", decoded_safe, "Safe characters should remain unchanged")

# Regex Tests
t.assert_equals(true, regex::matches("^[a-z]+$", "hello"), "regex::matches should match lowercase letters")
t.assert_equals(false, regex::matches("^[a-z]+$", "hello123"), "regex::matches should not match mixed")

collections::StringArrayList m = regex::find("(\\d+)-(\\w+)", "foo 123-abc bar")

i32 cf = 0

for i = 0 to m.get_size() - 1:
    cf = cf + 1

t.assert_equals(3, cf, "regex::find should return full match and 2 groups")
t.assert_string_equals("123-abc", m.get_element(0), "Full match should be '123-abc'")
t.assert_string_equals("123", m.get_element(1), "First group should be '123'")
t.assert_string_equals("abc", m.get_element(2), "Second group should be 'abc'")

string rep = regex::replace("\\s+", "a  b   c", "-")
t.assert_string_equals("a-b-c", rep, "regex::replace should collapse spaces into '-'")

collections::StringArrayList parts = regex::split("\\s*,\\s*", "a, b ,c")

i32 ca = 0

for i = 0 to parts.get_size() - 1:
    ca = ca + 1

t.assert_equals(3, ca, "regex::split should split into 3 parts")
t.assert_string_equals("a", parts.get_element(0), "First part 'a'")
t.assert_string_equals("b", parts.get_element(1), "Second part 'b'")
t.assert_string_equals("c", parts.get_element(2), "Third part 'c'")

# Crypto Tests
string xored_text = crypto::xor_cipher_hex("Hello World", "key")
t.assert_string_equals(xored_text, "230015070A593C0A0B0701", "XOR cipher should work")
string sha_empty = hash::sha256("")
t.assert_string_equals("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", sha_empty, "SHA-256 of empty string should match")
string sha_abc = hash::sha256("abc")
t.assert_string_equals("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", sha_abc, "SHA-256 of 'abc' should match")

string aes_key = "0123456789ABCDEF"
string aes_pt = "Attack at dawn"
string aes_ct_hex = crypto::aes128_encrypt(aes_pt, aes_key)
string aes_rt = crypto::aes128_decrypt(aes_ct_hex, aes_key)

t.assert_string_equals(aes_pt, aes_rt, "AES-128 round-trip should return original plaintext")

string ch_key = "0123456789ABCDEF0123456789ABCDEF"
string ch_nonce = "0123456789AB"
string ch_pt = "The quick brown fox jumps over the lazy dog"
string ch_ct_hex = crypto::chacha20_encrypt(ch_pt, ch_key, ch_nonce)
string ch_rt = crypto::chacha20_decrypt(ch_ct_hex, ch_key, ch_nonce)

t.assert_string_equals(ch_pt, ch_rt, "ChaCha20 round-trip should return original plaintext")

# Networking Tests
platform (Windows):
    net::HttpResponse hello = net::http_get("https://httpbin.org/get")
    print "%s" | hello.body

# JSON Tests
run void* user = json::new_object()
json::obj_set_new(user, "name", json::new_string("Alice"))
json::obj_set_new(user, "age", json::new_integer(25))
json::save_to_file(user, "user.json")

run void* loaded = json::loadup_file("user.json")
string name = json::get_object_string(loaded, "name")
i64 age = json::get_object_integer(loaded, "age")
t.assert_string_equals("Alice", name, "JSON name should be 'Alice'")
t.assert_equals(25, age, "JSON age should be 25")
run void* config = json::new_object()
json::obj_set_new(config, "theme", json::new_string("dark"))
json::obj_set_new(config, "debug", json::new_boolean(true))
json::save_to_file(config, "settings.json")

# Clean up JSON objects
json::dec_ref(user)
json::dec_ref(loaded)
json::dec_ref(config)

fs::remove("user.json")
fs::remove("settings.json")

collections::define_arraylist(LongArrayList, i64, 0)

ref LongArrayList longs = new LongArrayList(4)
LongArrayList::add_element(longs, 10000000000)
LongArrayList::add_element(longs, 20000000000)
LongArrayList::add_element(longs, 30000000000)

i64 sz = longs.get_size()
i64 first = longs.get_element(0)

t.assert_equals(3, sz, "LongArrayList size should be 3")
t.assert_equals(10000000000, first, "First element should be 10000000000")

LongArrayList::set_element(longs, 1, 22222222222)
t.assert_equals(22222222222, longs.get_element(1), "Updated second element")


uri::encode_url("https://example.com/some thing")

t.assert_string_equals("https://example.com/some%20thing", uri::encode_url("https://example.com/some thing"), "URL encoding should work")
t.assert_string_equals("https://example.com/some thing", uri::decode_url("https://example.com/some%20thing"), "URL decoding should work")

ref collections::StringIntMap sim = new collections::StringIntMap(4)
collections::StringIntMap::put(sim, "apple", 3)
collections::StringIntMap::put(sim, "banana", 7)
collections::StringIntMap::put(sim, "banana", 8)

t.assert_equals(3, collections::StringIntMap::get(sim, "apple"), "StringIntMap get 'apple' = 3")
t.assert_equals(8, collections::StringIntMap::get(sim, "banana"), "StringIntMap update works for 'banana'")
t.assert_equals(true, collections::StringIntMap::contains_key(sim, "apple"), "StringIntMap contains_key true")
t.assert_equals(false, collections::StringIntMap::contains_key(sim, "cherry"), "StringIntMap contains_key false")

collections::StringIntMap::remove(sim, "apple")
t.assert_equals(false, collections::StringIntMap::contains_key(sim, "apple"), "StringIntMap remove works")

ref collections::StringFloatMap sfm = new collections::StringFloatMap(2)
collections::StringFloatMap::put(sfm, "pi", 3.14)
collections::StringFloatMap::put(sfm, "e", 2.71)

t.assert_float_equals(3.14, collections::StringFloatMap::get(sfm, "pi"), 0.0001, "StringFloatMap get 'pi'")
t.assert_float_equals(2.71, collections::StringFloatMap::get(sfm, "e"), 0.0001, "StringFloatMap get 'e'")

ref collections::StringBoolMap sbm = new collections::StringBoolMap(2)
collections::StringBoolMap::put(sbm, "flag", true)
collections::StringBoolMap::put(sbm, "debug", false)

t.assert_equals(true, collections::StringBoolMap::get(sbm, "flag"), "StringBoolMap get 'flag'")
t.assert_equals(false, collections::StringBoolMap::get(sbm, "debug"), "StringBoolMap get 'debug'")

var str_test = new typecons::String("Hello")
t.assert_equals(true, str_test.equal(typecons::String::new("Hello")), "String equal should work")
t.assert_equals(false, str_test.equal(typecons::String::new("Not hello")), "String not equal should work")

# csv::read_file("test.csv")
fixed i32 some_fixed_integer = 10

t.test_summary()

os::exit(0)
