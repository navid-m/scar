## Standard library module for sorting algorithms
## Provides various sorting functions for different data types

import "std/math"
import "std/collections"

## Merge function for merge sort
fn merge_int(ref i32 arr, i32 left, i32 mid, i32 right) -> void:
    i32 n1 = mid - left + 1
    i32 n2 = right - mid
    i32 i = 0
    i32 j = 0
    i32 k = left
    
    $raw (
        int* left_arr = malloc(n1 * sizeof(int));
        int* right_arr = malloc(n2 * sizeof(int));
        
        for (int i = 0; i < n1; i++) {
            left_arr[i] = arr[left + i];
        }
        for (int j = 0; j < n2; j++) {
            right_arr[j] = arr[mid + 1 + j];
        }
        
        i = 0;
        j = 0;
        k = left;
        
        while (i < n1 && j < n2) {
            if (left_arr[i] <= right_arr[j]) {
                arr[k] = left_arr[i];
                i++;
            } else {
                arr[k] = right_arr[j];
                j++;
            }
            k++;
        }
        
        while (i < n1) {
            arr[k] = left_arr[i];
            i++;
            k++;
        }
        
        while (j < n2) {
            arr[k] = right_arr[j];
            j++;
            k++;
        }
        
        free(left_arr);
        free(right_arr);
    )

## Sort a list of integers and return the sorted list
## Uses bubble sort algorithm implemented in pure Scar
pub fn sort_int_list(ref collections::ArrayList input_list) -> collections::ArrayList:
    i32 n = collections::ArrayList::get_size(input_list)
    ref collections::ArrayList sorted_list = new collections::ArrayList(n > 0 ? n : 1)
    i32 k = 0
    for k = 0 to n - 1:
        collections::ArrayList::add_element(sorted_list, collections::ArrayList::get_element(input_list, k))

    i32 i = 0
    i32 j = 0
    i32 temp = 0
    if n <= 1:
        return sorted_list
    for i = 0 to n - 1:
        i32 end = n - i - 2
        if end >= 0:
            for j = 0 to end:
                if collections::ArrayList::get_element(sorted_list, j) > collections::ArrayList::get_element(sorted_list, j + 1):
                    temp = collections::ArrayList::get_element(sorted_list, j)
                    collections::ArrayList::set_element(sorted_list, j, collections::ArrayList::get_element(sorted_list, j + 1))
                    collections::ArrayList::set_element(sorted_list, j + 1, temp)
                
    return sorted_list
