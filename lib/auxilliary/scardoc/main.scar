import "std/collections"
import "std/io"
import "std/strings"
import "std/os"
import "std/regex"

class FunctionDoc:
    init:
        string this.name = ""
        string this.return_type = ""
        ref list[string] this.parameters = []
        ref list[string] this.comments = []
        bool  this.is_public = false
        string  this.visibility = ""

class ClassDoc:
    init:
        string  this.name = ""
        list[string]  this.comments = []
        list[FunctionDoc]  this.methods = []
        list[string]  this.fields = []
        bool  this.is_public = false

class ModuleDoc:
    init:
        string  this.filename = ""
        string  this.module_name = ""
        list[string]  this.imports = []
        list[FunctionDoc]  this.functions = []
        list[ClassDoc]  this.classes = []
        list[string]  this.global_vars = []
        list[string]  this.comments = []

# Parse a single line for documentation comments
fn parse_doc_comment(lstring line) -> string:
    lstring trimmed = strings::trim_space(line)
    if strings::starts_with(trimmed, "#"):
        return strings::trim_space(strings::substring(trimmed, 1, strings::length(trimmed)))
    return ""

# Extract function signature information
fn parse_function_signature(string line) -> FunctionDoc:
    ref FunctionDoc func_doc = new FunctionDoc()
    func_doc.parameters = []
    func_doc.comments = []
    
    # Check if function is public
    if strings::contains(line, "pub fn"):
        func_doc.is_public = true
        func_doc.visibility = "public"
    else:
        func_doc.is_public = false
        func_doc.visibility = "private"
    
    # Extract function name and parameters using regex
    list[string] matches = regex::find("fn\\s+(\\w+)\\s*\\(([^)]*)\\)\\s*->\\s*(\\w+|void)", line)
    if len(matches) >= 4:
        func_doc.name = matches[1]
        func_doc.return_type = matches[3]
        
        # Parse parameters
        lstring params_str = matches[2]
        if strings::length(params_str) > 0:
            list[string] param_parts = strings::split(params_str, ",")
            for int i = 0; i < len(param_parts); i++:
                string param = strings::trim(param_parts[i])
                if strings::length(param) > 0:
                    func_doc.parameters = func_doc.parameters + [param]
    else:
        list[string] simple_matches = regex::find("fn\\s+(\\w+)\\s*\\(([^)]*)\\)", line)
        if len(simple_matches) >= 3:
            func_doc.name = simple_matches[1]
            func_doc.return_type = "void"
            
            string params_str = simple_matches[2]
            if strings::length(params_str) > 0:
                list[string] param_parts = strings::split(params_str, ",")
                for int i = 0; i < len(param_parts); i++:
                    string param = strings::trim(param_parts[i])
                    if strings::length(param) > 0:
                        func_doc.parameters = catlist!(func_doc.parameters, list_of!(param))
    
    return func_doc

# Parse class definition
fn parse_class_signature(string line) -> ClassDoc:
    ref ClassDoc class_doc = new ClassDoc()
    class_doc.comments = []
    class_doc.methods = []
    class_doc.fields = []
    
    list[string] matches = regex::find("class\\s+(\\w+)", line)
    if len(matches) >= 2:
        class_doc.name = matches[1]
        class_doc.is_public = true  # Assume classes are public by default
    
    return class_doc

# Parse import statements
fn extract_imports(string line) -> string:
    list[string] matches = regex::find("import\\s+\"([^\"]+)\"", line)
    if len(matches) >= 2:
        return matches[1]
    return ""

# Parse global variable declarations
fn extract_global_var(string line) -> string:
    string trimmed = strings::trim(line)
    if strings::starts_with(trimmed, "pub ") || regex::matches("^(i32|i64|f32|f64|string|bool)\\s+\\w+", trimmed):
        return trimmed
    return ""

