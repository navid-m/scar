## On Windows:  mingw && pacman -S mingw-w64-x86_64-pcre
## On Linux:    sudo apt-get install libpcre3-dev
## On macOS:    brew install pcre

import "std/strings"
import "std/collections"
external import "pcre.h"

pub i64 _max_str_len = 954020

## Check if a string matches a regular expression pattern.
pub fn matches(string pattern, string text) -> bool: 
    $raw (
        #include <string.h>
        const char *err = NULL; int erroffset = 0;
        const pcre *re = pcre_compile(pattern, 0, &err, &erroffset, NULL);
        if (!re) return 0;
        int rc = pcre_exec(re, NULL, text, (int)strlen(text), 0, 0, NULL, 0);
        pcre_free((void*)re);
        return rc >= 0;
    )

## Internal helper: returns all matches (full match and groups) joined by newlines.
pub fn find_joined(string pattern, string text) -> lstring:
    $raw (
        #include <string.h>
        #include <stdlib.h>
        const char *err = NULL; int erroffset = 0;
        const pcre *re = pcre_compile(pattern, 0, &err, &erroffset, NULL);
        if (!re) return strdup("");
        int ovecsize = 30;
        int ovector[30];
        int rc = pcre_exec(re, NULL, text, (int)strlen(text), 0, 0, ovector, ovecsize);
        size_t cap = 0; size_t sz = 0; char *buf = NULL;
        if (rc >= 0) {
            int groups = rc;
            for (int i = 0; i < groups; i++) {
                int start = ovector[2*i];
                int end   = ovector[2*i + 1];
                int len   = end - start;
                if (len < 0) len = 0;
                size_t add = (size_t)len + (sz > 0 ? 1 : 0);
                size_t need = sz + add + 1;
                if (need > cap) {
                    char *nb = (char*)realloc(buf, need);
                    if (!nb) { free(buf); pcre_free((void*)re); return strdup(""); }
                    buf = nb; cap = need;
                }
                if (sz > 0) { buf[sz] = '\n'; sz += 1; }
                if (len > 0) { memcpy(buf + sz, text + start, len); }
                sz += len;
                buf[sz] = '\0';
            }
        }
        pcre_free((void*)re);
        if (!buf) return strdup("");
        return buf;
    )

## Find all matches of a regular expression pattern in a string.
pub fn find(string pattern, string text) -> collections::StringArrayList:
    lstring joined = regex::find_joined(pattern, text)
    var result = new collections::StringArrayList(8)
    if strings::length(joined) == 0:
        return result
    result = strings::split(joined, "\n")
    return result

## Replace all matches of a regular expression pattern in a string. 
##
## Returns the modified string.
pub fn replace(string pattern, string text, string replacement) -> char*:
    $raw (
        #include <string.h>
        #include <stdlib.h>
        const char *err = NULL; int erroffset = 0;
        const pcre *re = pcre_compile(pattern, 0, &err, &erroffset, NULL);
        if (!re) {
            return strdup("");
        }

        int text_len = (int)strlen(text);
        int repl_len = (int)strlen(replacement);
        int cap = text_len + 1; 
        char* out = (char*)malloc(cap);
        if (!out) { pcre_free((void*)re); return strdup(""); }
        int out_len = 0;

        int ovecsize = 30;
        int ovector[30];
        int start_offset = 0;
        while (start_offset <= text_len) {
            int rc = pcre_exec(re, NULL, text, text_len, start_offset, 0, ovector, ovecsize);
            if (rc < 0) {
                int chunk_len = text_len - start_offset;
                if (out_len + chunk_len + 1 > cap) {
                    cap = (out_len + chunk_len + 1) * 2;
                    char* nb = (char*)realloc(out, cap);
                    if (!nb) { free(out); pcre_free((void*)re); return strdup(""); }
                    out = nb;
                }
                if (chunk_len > 0) memcpy(out + out_len, text + start_offset, chunk_len);
                out_len += chunk_len;
                break;
            }
            int mstart = ovector[0];
            int mend   = ovector[1];
            int before_len = mstart - start_offset;
            if (before_len > 0) {
                if (out_len + before_len + 1 > cap) {
                    cap = (out_len + before_len + 1 + repl_len) * 2;
                    char* nb = (char*)realloc(out, cap);
                    if (!nb) { free(out); pcre_free((void*)re); return strdup(""); }
                    out = nb;
                }
                memcpy(out + out_len, text + start_offset, before_len);
                out_len += before_len;
            }
            if (repl_len > 0) {
                if (out_len + repl_len + 1 > cap) {
                    cap = (out_len + repl_len + 1) * 2;
                    char* nb = (char*)realloc(out, cap);
                    if (!nb) { free(out); pcre_free((void*)re); return strdup(""); }
                    out = nb;
                }
                memcpy(out + out_len, replacement, repl_len);
                out_len += repl_len;
            }
            start_offset = mend;
            if (mend == mstart) {
                start_offset++;
            }
        }
        if (out) out[out_len] = '\0';
        pcre_free((void*)re);
        return out;
    )

## Internal helper: split text by regex matches, returning pieces joined by newlines.
pub fn split_joined(string pattern, string text) -> lstring:
    $raw (
        #include <string.h>
        #include <stdlib.h>
        const char *err = NULL; int erroffset = 0;
        const pcre *re = pcre_compile(pattern, 0, &err, &erroffset, NULL);
        if (!re) return strdup("");
        int text_len = (int)strlen(text);
        int ovecsize = 30;
        int ovector[30];
        int start_offset = 0;
        int last_end = 0;
        size_t cap = 0; size_t sz = 0; char *buf = NULL;
        int safety = 0;
        while (start_offset <= text_len && safety < 100000) {
            int rc = pcre_exec(re, NULL, text, text_len, start_offset, 0, ovector, ovecsize);
            if (rc < 0) {
                int seg_len = text_len - last_end;
                size_t add = (size_t)seg_len + (sz > 0 ? 1 : 0);
                size_t need = sz + add + 1;
                if (need > cap) {
                    size_t newcap = cap ? cap : 64;
                    while (newcap < need) newcap *= 2;
                    char *nb = (char*)realloc(buf, newcap);
                    if (!nb) { free(buf); pcre_free((void*)re); return strdup(""); }
                    buf = nb; cap = newcap;
                }
                if (sz > 0) { buf[sz] = '\n'; sz += 1; }
                if (seg_len > 0) memcpy(buf + sz, text + last_end, seg_len);
                sz += seg_len;
                buf[sz] = '\0';
                break;
            }
            int mstart = ovector[0];
            int mend   = ovector[1];
            int seg_len = mstart - last_end;
            if (seg_len < 0) seg_len = 0;
            {
                size_t add = (size_t)seg_len + (sz > 0 ? 1 : 0);
                size_t need = sz + add + 1;
                if (need > cap) {
                    size_t newcap = cap ? cap : 64;
                    while (newcap < need) newcap *= 2;
                    char *nb = (char*)realloc(buf, newcap);
                    if (!nb) { free(buf); pcre_free((void*)re); return strdup(""); }
                    buf = nb; cap = newcap;
                }
                if (sz > 0) { buf[sz] = '\n'; sz += 1; }
                if (seg_len > 0) memcpy(buf + sz, text + last_end, seg_len);
                sz += seg_len;
                buf[sz] = '\0';
            }
            last_end = mend;
            start_offset = mend;
            if (mend == mstart) start_offset++;
            safety++;
        }
        pcre_free((void*)re);
        if (!buf) return strdup("");
        return buf;
    )

## Split a string into a list of substrings using a regular expression pattern.
pub fn split(string pattern, string text) -> collections::StringArrayList:
    lstring joined = regex::split_joined(pattern, text)
    var result = new collections::StringArrayList(8)
    if strings::length(joined) == 0:
        return result
    result = strings::split(joined, "\n")
    return result
