val allocators = use("std/allocators")
val math = use("std/math")
val str = use("std/string")

pub def isort[T: math.Integer, A: allocators.GeneralAllocator](l ref(list[T]), ac A) bool|error
    var n usize = @len(l)
    if n <= 1 as usize
        return true
    end

    var count_mem ref(void)|error = A.alloc(@addr(ac), 256 as usize * @sizeof(usize))
    match count_mem
        error _ => ( return false )
        ok cm => (
            var counts ref(usize) = @bitcast(cm, ref(usize))
            @memset(cm, 0, 256 as usize * @sizeof(usize))

            var elem_size usize = @sizeof(T)
            var temp ref(void) = A.alloc(@addr(ac), n * elem_size)?
            var temp_bytes ref(u8) = @bitcast(temp, ref(u8))

            var sign_mask usize = 1 as usize
            var total_bits i32 = @sizeof(T) as i32 * 8 as i32
            sign_mask = sign_mask << (total_bits - 1 as i32)
            var sign_bit T = @bitcast(sign_mask, T)

            for var i = 0 as usize .. n
                var v T = @deref(@add(l, i))
                @deref(@add(l, i)) = v ^ sign_bit
            end

            var max_val T = 0 as T
            for var i = 0 as usize .. n
                var v T = @deref(@add(l, i))
                if v > max_val
                    max_val = v
                end
            end

            var bytes_per_elem i32 = @sizeof(T) as i32
            var bytes_passed i32 = 0 as i32

            for max_val > 0 as T || bytes_passed < bytes_per_elem
                @memset(cm, 0, 256 as usize * @sizeof(usize))

                for var i = 0 as usize .. n
                    var v T = @deref(@add(l, i))
                    var byte_val u8 = 0 as u8

                    if bytes_passed < bytes_per_elem
                        var shift i32 = bytes_passed * 8 as i32
                        var masked T = @shr(v, shift)
                        byte_val = masked as u8
                    end

                    var idx usize = byte_val as usize
                    @deref(@add(counts, idx)) = @deref(@add(counts, idx)) + 1 as usize
                end

                for var i = 1 as usize .. 256 as usize
                    @deref(@add(counts, i)) = @deref(@add(counts, i)) + @deref(@add(counts, i - 1 as usize))
                end

                for var i = n, i > 0 as usize, i--
                    var i_idx usize = i - 1 as usize
                    var v T = @deref(@add(l, i_idx))
                    var byte_val u8 = 0 as u8

                    if bytes_passed < bytes_per_elem
                        var shift i32 = bytes_passed * 8 as i32
                        var masked T = @shr(v, shift)
                        byte_val = masked as u8
                    end

                    var idx usize = byte_val as usize
                    var ci usize = @deref(@add(counts, idx)) - 1 as usize
                    var dest_ptr ref(u8) = @add(temp_bytes, ci * elem_size)
                    @memcpy(dest_ptr, @addr(@deref(@add(l, i_idx))), elem_size)
                    @deref(@add(counts, idx)) = ci
                end

                for var i = 0 as usize .. n
                    @memcpy(@addr(@deref(@add(l, i))), @add(temp_bytes, i * elem_size), elem_size)
                end

                var zero T = 0 as T
                max_val = @shr(max_val, 8)
                if max_val == zero && bytes_passed >= bytes_per_elem - 1 as i32
                    break
                end
                bytes_passed = bytes_passed + 1 as i32
            end

            for var i = 0 as usize .. n
                var v T = @deref(@add(l, i))
                @deref(@add(l, i)) = v ^ sign_bit
            end

            A.free(@addr(ac), temp)
            A.free(@addr(ac), cm)
            return true
        )
    end
end

pub def fsort[T: math.Float, A: allocators.GeneralAllocator](l ref(list[T]), ac A) bool|error
    var n usize = @len(l)
    if n <= 1 as usize
        return true
    end

    var elem_size usize = @sizeof(T)
    var bytes_per_elem i32 = 4

    if elem_size != 4
        bytes_per_elem = 8
    end
    
    var count_mem = A.alloc(@addr(ac), 256 * @sizeof(usize))?
    var temp_mem  = A.alloc(@addr(ac), n * elem_size)?

    var counts     ref(usize) = @bitcast(count_mem, ref(usize))
    var temp_bytes ref(u8)    = @bitcast(temp_mem, ref(u8))

    for var pass = 0 as i32, pass < bytes_per_elem, pass++
        @memset(count_mem, 0, 256 * @sizeof(usize))

        for var i = 0 as usize .. n
            var v T = @deref(@add(l, i))
            var s u64 = float_to_sortable[T](v)
            var byte_val u8 = ((s >> (pass * 8 as i32)) & 0xFF as u64) as u8
            @deref(@add(counts, byte_val as usize)) += 1 as usize
        end

        for var i = 1 as usize .. 256 as usize
            @deref(@add(counts, i)) += @deref(@add(counts, i - 1 as usize))
        end

        for var i = n, i > 0 as usize, i--
            var idx usize = i - 1 as usize
            var v T = @deref(@add(l, idx))
            var s u64 = float_to_sortable[T](v)
            var byte_val u8 = ((s >> (pass * 8 as i32)) & 0xFF as u64) as u8
            var cidx usize = byte_val as usize

            var target usize = @deref(@add(counts, cidx)) - 1 as usize
            var dest ref(u8) = @add(temp_bytes, target * elem_size)

            @memcpy(dest, @addr(v), elem_size)
            @deref(@add(counts, cidx)) = target
        end

        for var i = 0 as usize .. n
            @memcpy(@addr(@deref(@add(l, i))), @add(temp_bytes, i * elem_size), elem_size)
        end
    end

    A.free(@addr(ac), temp_mem)
    A.free(@addr(ac), count_mem)
    return true
end

def float_to_sortable[T: math.Float](v T) u64
    if @sizeof(T) == 4 as usize
        var bits u32 = @bitcast(v, u32)
        if (bits >> 31 as u32) == 0 as u32
            return (bits as u64) ^ 0x80000000 as u64
        else
            return 0xFFFFFFFF as u64 - (bits as u64)
        end
    else
        var bits u64 = @bitcast(v, u64)
        if (bits >> 63 as u64) == 0 as u64
            return bits ^ 0x8000000000000000 as u64
        else
            return 0xFFFFFFFFFFFFFFFF as u64 - bits
        end
    end
end

pub def sort_strings[A: allocators.GeneralAllocator](l ref(list[ref(u8)]), ac A) bool|error
    var n usize = @len(l)
    if n <= 1 as usize
        return true
    end

    var max_len usize = 0 as usize
    for var i = 0 as usize .. n
        var s ref(u8) = @deref(@add(l, i))
        var len usize = 0 as usize
        if s != none
            for @deref(@add(s, len)) != 0 as u8
                len = len + 1 as usize
            end
        end
        if len > max_len
            max_len = len
        end
    end

    var count_mem ref(void)|error = A.alloc(@addr(ac), 256 as usize * @sizeof(usize))
    match count_mem
        error _ => ( return false )
        ok cm => (
            var counts ref(usize) = @bitcast(cm, ref(usize))
            @memset(cm, 0, 256 as usize * @sizeof(usize))

            var temp ref(void) = A.alloc(@addr(ac), n * @sizeof(ref(u8)))?
            var temp_str ref(ref(u8)) = @bitcast(temp, ref(ref(u8)))

            var pos i32 = max_len as i32 - 1 as i32

            for pos >= 0 as i32
                @memset(cm, 0, 256 as usize * @sizeof(usize))

                for var i = 0 as usize .. n
                    var s ref(u8) = @deref(@add(l, i))
                    var c u8 = 0 as u8
                    if s != none
                        var str_len usize = 0 as usize
                        for @deref(@add(s, str_len)) != 0 as u8
                            str_len = str_len + 1 as usize
                        end
                        if pos as usize < str_len
                            c = @deref(@add(s, pos as usize))
                        end
                    end
                    var idx usize = c as usize
                    @deref(@add(counts, idx)) = @deref(@add(counts, idx)) + 1 as usize
                end

                for var i = 1 as usize .. 256 as usize
                    @deref(@add(counts, i)) = @deref(@add(counts, i)) + @deref(@add(counts, i - 1 as usize))
                end

                for var i = n, i > 0 as usize, i--
                    var i_idx usize = i - 1 as usize
                    var s ref(u8) = @deref(@add(l, i_idx))
                    var c u8 = 0 as u8
                    if s != none
                        var str_len usize = 0 as usize
                        for @deref(@add(s, str_len)) != 0 as u8
                            str_len = str_len + 1 as usize
                        end
                        if pos as usize < str_len
                            c = @deref(@add(s, pos as usize))
                        end
                    end
                    var idx usize = c as usize
                    var ci usize = @deref(@add(counts, idx)) - 1 as usize
                    @deref(@add(temp_str, ci)) = s
                    @deref(@add(counts, idx)) = ci
                end

                for var i = 0 as usize .. n
                    @deref(@add(l, i)) = @deref(@add(temp_str, i))
                end

                pos = pos - 1 as i32
            end

            A.free(@addr(ac), temp)
            A.free(@addr(ac), cm)
            return true
        )
    end
end

test "isort i32 list"
    var ac = allocators.HeapAllocator()
    var l list[i32] = [3, 1, 4, 1, 5, 9, 2, 6]
    match isort[i32, _](@addr(l), ac)
        error _ => ( assert false )
        ok result => ( assert result )
    end
    assert l[0] == 1
    assert l[1] == 1
    assert l[2] == 2
    assert l[3] == 3
    assert l[4] == 4
    assert l[5] == 5
    assert l[6] == 6
    assert l[7] == 9
end

test "isort i32 with negatives"
    var ac = allocators.HeapAllocator()
    var l list[i32] = [5, (-3), 2, (-1), 4, 0, (-2), 3]
    match isort[i32, _](@addr(l), ac)
        error _ => ( assert false )
        ok result => ( assert result )
    end
    assert l[0] == (-3)
    assert l[1] == (-2)
    assert l[2] == (-1)
    assert l[3] == 0
    assert l[4] == 2
    assert l[5] == 3
    assert l[6] == 4
    assert l[7] == 5
end

test "isort u32 list"
    var ac = allocators.HeapAllocator()
    var l list[u32] = [100 as u32, 50 as u32, 200 as u32, 25 as u32, 150 as u32]
    match isort[u32, _](@addr(l), ac)
        error _ => ( assert false )
        ok result => ( assert result )
    end
    assert l[0] == 25 as u32
    assert l[1] == 50 as u32
    assert l[2] == 100 as u32
    assert l[3] == 150 as u32
    assert l[4] == 200 as u32
end

test "isort i64 list"
    var ac = allocators.HeapAllocator()
    var l list[i64] = [1000000 as i64, (-500000 as i64), 0 as i64, 999999 as i64, (-999999 as i64)]
    match isort[i64, _](@addr(l), ac)
        error _ => ( assert false )
        ok result => ( assert result )
    end
    assert l[0] == (-999999 as i64)
    assert l[1] == (-500000 as i64)
    assert l[2] == 0 as i64
    assert l[3] == 999999 as i64
    assert l[4] == 1000000 as i64
end

test "isort i8 list"
    var ac = allocators.HeapAllocator()
    var l list[i8] = [5 as i8, (-3 as i8), 0 as i8, 2 as i8, (-1 as i8)]
    match isort[i8, _](@addr(l), ac)
        error _ => ( assert false )
        ok result => ( assert result )
    end
    assert l[0] == (-3 as i8)
    assert l[1] == (-1 as i8)
    assert l[2] == 0 as i8
    assert l[3] == 2 as i8
    assert l[4] == 5 as i8
end

test "fsort f64 list"
    var ac = allocators.HeapAllocator()
    var l list[f64] = [3.5, 1.2, 4.9, -2.1, 0.0, 2.5]
    match fsort[f64, _](@addr(l), ac)
        error _ => ( assert false )
        ok result => ( assert result )
    end

    assert l[0] == -2.1
    assert l[1] == 0.0
    assert l[2] == 1.2
    assert l[3] == 2.5
    assert l[4] == 3.5
    assert l[5] == 4.9
end

test "fsort f32 list"
    var ac = allocators.HeapAllocator()
    var l list[f32] = [3.5, 1.2, -0.5, 2.0]
    match fsort[f32, _](@addr(l), ac)
        error _ => ( assert false )
        ok result => ( assert result )
    end
    assert l[0] == -0.5
    assert l[1] == 1.2
    assert l[2] == 2.0
    assert l[3] == 3.5
end

test "sort strings list"
    var ac = allocators.HeapAllocator()
    var l list[ref(u8)] = ["banana", "apple", "cherry", "date"]
    match sort_strings[_](@addr(l), ac)
        error _ => ( assert false )
        ok result => ( assert result )
    end
    assert str.eql(l[0], "apple")
    assert str.eql(l[1], "banana")
    assert str.eql(l[2], "cherry")
    assert str.eql(l[3], "date")
end

test "sort strings different lengths"
    var ac = allocators.HeapAllocator()
    var l list[ref(u8)] = ["b", "aaa", "aa", "a"]
    match sort_strings[_](@addr(l), ac)
        error _ => ( assert false )
        ok result => ( assert result )
    end
    assert str.eql(l[0], "a")
    assert str.eql(l[1], "aa")
    assert str.eql(l[2], "aaa")
    assert str.eql(l[3], "b")
end
