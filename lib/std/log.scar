val allocators = use("std/allocators")
val time = use("std/time")
val str = use("std/string")

pub enum Level
	Debug
	Info
	Warn
	Error
end

pub val LEVEL Level = Level.Info

def level_to_str(level Level) ref(u8)
	match level
		Level.Debug => ( return "DEBUG" )
		Level.Info  => ( return "INFO " )
		Level.Warn  => ( return "WARN " )
		Level.Error => ( return "ERROR" )
	end
end

def level_to_int(level Level) i32
	match level
		Level.Debug => ( return 0 )
		Level.Info  => ( return 1 )
		Level.Warn  => ( return 2 )
		Level.Error => ( return 3 )
	end
end

def log(level Level, msg ref(u8))
	if level_to_int(level) < level_to_int(LEVEL)
		return
	end

	var ts i64 = time.now()
	var secs i64 = ts / 1000000000 as i64
	var total_secs i64 = secs % 86400 as i64
	var hours i32 = (total_secs / 3600 as i64) as i32
	var mins i32 = ((total_secs % 3600 as i64) / 60 as i64) as i32
	var secs_sec i32 = (total_secs % 60 as i64) as i32
	var ms i32 = ((ts % 1000000000 as i64) / 1000000 as i64) as i32

	var level_str ref(u8) = level_to_str(level)

	@print("[{s}] [{02d}:{02d}:{02d}.{03d}] ", {level_str, hours, mins, secs_sec, ms})
	@puts(msg)
end

pub def debug(msg ref(u8))
	log(Level.Debug, msg)
end

pub def info(msg ref(u8))
	log(Level.Info, msg)
end

pub def warn(msg ref(u8))
	log(Level.Warn, msg)
end

pub def err(msg ref(u8))
	log(Level.Error, msg)
end

pub def debugf(format ref(u8), args ref(u8))
	debug(format)
end

pub def infof(format ref(u8), args ref(u8))
	info(format)
end

pub def warnf(format ref(u8), args ref(u8))
	warn(format)
end

pub def errorf(format ref(u8), args ref(u8))
	err(format)
end

test "logging functions exist"
	debug("debug message")
	info("info message")
	warn("warn message")
	err("error message")
end
