val allocators = use("std/allocators")
val time = use("std/time")
val str = use("std/string")

pub enum Level
	Debug
	Info
	Warn
	Error
end

pub val LEVEL Level = Level.Info

def level_to_str(level Level) ref(u8)
	match level
		Level.Debug => ( return "DEBUG" )
		Level.Info  => ( return "INFO" )
		Level.Warn  => ( return "WARN" )
		Level.Error => ( return "ERROR" )
	end
end

def level_to_int(level Level) i32
	match level
		Level.Debug => ( return 0 )
		Level.Info  => ( return 1 )
		Level.Warn  => ( return 2 )
		Level.Error => ( return 3 )
	end
end

def log[A: allocators.BumpAllocator](ac ref(A), level Level, msg ref(u8)) void|error
	if level_to_int(level) < level_to_int(LEVEL)
		return
	end

	var dt time.DateTime = time.now_datetime()
	var ms i32 = ((time.now() % 1000000000 as i64) / 1000000 as i64) as i32

	var level_str ref(u8) = level_to_str(level)

	@print("[{04d}-{02d}-{02d}T{02d}:{02d}:{02d}.{03d}] [{s}] ", {dt.year, dt.month, dt.day, dt.hour, dt.min, dt.sec, ms, level_str})
	@puts(msg)
end

pub def debug[A: allocators.BumpAllocator](ac ref(A), msg ref(u8))
	log[A](ac, Level.Debug, msg)
end

pub def info[A: allocators.BumpAllocator](ac ref(A), msg ref(u8))
	log[A](ac, Level.Info, msg)
end

pub def warn[A: allocators.BumpAllocator](ac ref(A), msg ref(u8))
	log[A](ac, Level.Warn, msg)
end

pub def err[A: allocators.BumpAllocator](ac ref(A), msg ref(u8))
	log[A](ac, Level.Error, msg)
end

pub def debugf[A: allocators.BumpAllocator](ac ref(A), format ref(u8), args ref(u8))
	debug[A](ac, format)
end

pub def infof[A: allocators.BumpAllocator](ac ref(A), format ref(u8), args ref(u8))
	info[A](ac, format)
end

pub def warnf[A: allocators.BumpAllocator](ac ref(A), format ref(u8), args ref(u8))
	warn[A](ac, format)
end

pub def errorf[A: allocators.BumpAllocator](ac ref(A), format ref(u8), args ref(u8))
	err[A](ac, format)
end

test "logging functions exist"
	var ac = allocators.Arena.new(10240 as usize)?
	debug[_](@addr(ac), "debug message")
	info[_](@addr(ac), "info message")
	warn[_](@addr(ac), "warn message")
	err[_](@addr(ac), "error message")
	allocators.Arena.destroy(@addr(ac))
end
