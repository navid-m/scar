pub type Vec2
	x f32
	y f32
end

pub def Vec2.add(a Vec2, b Vec2) Vec2
	return Vec2(x: a.x + b.x, y: a.y + b.y)
end

pub def Vec2.sub(a Vec2, b Vec2) Vec2
	return Vec2(x: a.x - b.x, y: a.y - b.y)
end

pub def Vec2.mul(a Vec2, scalar f32) Vec2
	return Vec2(x: a.x * scalar, y: a.y * scalar)
end

pub type Vec3
	x f32
	y f32
	z f32
end

pub def Vec3.add(a Vec3, b Vec3) Vec3
	return Vec3(x: a.x + b.x, y: a.y + b.y, z: a.z + b.z)
end

pub def Vec3.sub(a Vec3, b Vec3) Vec3
	return Vec3(x: a.x - b.x, y: a.y - b.y, z: a.z - b.z)
end

pub def Vec3.mul(a Vec3, scalar f32) Vec3
	return Vec3(x: a.x * scalar, y: a.y * scalar, z: a.z * scalar)
end

pub def Vec3.dot(a Vec3, b Vec3) f32
	return a.x * b.x + a.y * b.y + a.z * b.z
end

pub def Vec3.cross(a Vec3, b Vec3) Vec3
	return Vec3(
		x: a.y * b.z - a.z * b.y,
		y: a.z * b.x - a.x * b.z,
		z: a.x * b.y - a.y * b.x
	)
end

pub type Vec4
	x f32
	y f32
	z f32
	w f32
end

pub def Vec4.add(a Vec4, b Vec4) Vec4
	return Vec4(x: a.x + b.x, y: a.y + b.y, z: a.z + b.z, w: a.w + b.w)
end

pub def Vec4.sub(a Vec4, b Vec4) Vec4
	return Vec4(x: a.x - b.x, y: a.y - b.y, z: a.z - b.z, w: a.w - b.w)
end

pub type Mat4
	data [16]f32
end

pub def Mat4.identity() Mat4
	return Mat4(data: [
		1.0 as f32, 0.0 as f32, 0.0 as f32, 0.0 as f32,
		0.0 as f32, 1.0 as f32, 0.0 as f32, 0.0 as f32,
		0.0 as f32, 0.0 as f32, 1.0 as f32, 0.0 as f32,
		0.0 as f32, 0.0 as f32, 0.0 as f32, 1.0 as f32
	])
end

pub def Mat4.mul(a ref(Mat4), b ref(Mat4)) Mat4
	var res = Mat4.identity()
	
	var i i32 = 0
	for i < 4
		var j i32 = 0
		for j < 4
			var sum f32 = 0.0 as f32
			var k i32 = 0
			for k < 4
				sum += a.data[i * 4 + k as usize] * b.data[k * 4 + j as usize]
				k++
			end
			res.data[i * 4 + j as usize] = sum
			j++
		end
		i++
	end
	
	return res
end
