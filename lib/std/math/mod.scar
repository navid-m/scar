pub typeset Integer
	i8, i16, i32, i64,
	u8, u16, u32, u64,
	usize, isize
end

pub typeset Float
	f32, f64
end

pub typeset Number
	i8, i16, i32, i64,
	u8, u16, u32, u64,
	usize, isize,
	f32, f64
end

pub val PI      f64 = 3.14159265358979323846
pub val TAU     f64 = 6.28318530717958647692
pub val E       f64 = 2.71828182845904523536
pub val EPSILON f64 = 2.220446049250313e-16
pub val F64_MAX f64 = 1.7976931348623157e+308
pub val F64_MIN f64 = 5.0e-324

pub def floor(x f64) f64
	val as_int i64 = x as i64
	if x < 0 as f64 && x != (as_int as f64)
		return (as_int - 1 as i64) as f64
	end
	return as_int as f64
end

pub def ceil(x f64) f64
	val as_int i64 = x as i64
	if x > 0 as f64 && x != (as_int as f64)
		return (as_int + 1 as i64) as f64
	end
	return as_int as f64
end

pub def round(x f64) f64
	val (
		as_int i64 = x as i64
		frac f64 = x - (as_int as f64)
	)
	if frac >= 0.5 as f64
		return (as_int + 1 as i64) as f64
	end
	if frac <= -0.5 as f64
		return (as_int - 1 as i64) as f64
	end
	return as_int as f64
end

pub def trunc(x f64) f64
	return (x as i64) as f64
end

pub def fabs(x f64) f64
	if x < 0 as f64
		return -x
	end
	return x
end

pub def approx_eq(a f64, b f64, epsilon f64) bool
	return fabs(a - b) < epsilon
end

pub def sqrt(x f64) f64
	if x <= 0 as f64
		return 0 as f64
	end
	var guess f64 = x
	var i = 0
	for i < 20
		guess = (guess + (x / guess)) / 2 as f64
		i++
	end
	return guess
end

pub def pow(x f64, y f64) f64
	if y == 0 as f64
		return 1 as f64
	end
	if y == 1 as f64
		return x
	end
	if y == (y as i64) as f64
		var result f64 = 1 as f64
		var exps i64 = y as i64
		var base f64 = x
		if exps < 0 as i64
			base = 1 as f64 / base
			exps = -exps
		end
		for exps > 0 as i64
			if (exps & 1 as i64) != 0 as i64
				result = result * base
			end
			base = base * base
			exps = exps >> 1 as i64
		end
		return result
	end
	return 1 as f64
end

pub def fmod(x f64, y f64) f64
	if y == 0 as f64
		return 0 as f64
	end
	val (
		quotient f64 = x / y
		truncated f64 = (quotient as i64) as f64
	)
	return x - (truncated * y)
end

pub def exp(x f64) f64
	if x < -100 as f64
		return 0 as f64
	end
	var result f64 = 1 as f64
	var term f64 = 1 as f64
	var n f64 = 1 as f64
	for n < 30 as f64
		term = term * (x / n)
		result = result + term
		n = n + 1 as f64
	end
	return result
end

pub def log(x f64) f64
	if x <= 0 as f64
		return -1 as f64
	end
	val y f64 = (x - 1 as f64) / (x + 1 as f64)
	val y2 f64 = y * y
	var result f64 = 0 as f64
	var term f64 = y
	var n i64 = 1 as i64
	for n < 50 as i64
		result = result + (term / n as f64)
		term = term * y2
		n = n + 2 as i64
	end
	return 2 as f64 * result
end

pub def log10(x f64) f64
	return log(x) / log(10 as f64)
end

pub def sin(x f64) f64
	var x2 f64 = x
	for x2 > PI
		x2 = x2 - TAU
	end
	for x2 < -PI
		x2 = x2 + TAU
	end
	var result f64 = x2
	var term f64 = x2
	var i i64 = 1 as i64
	for i <= 10 as i64
		term = term * (-(x2 * x2) / ((2 as i64 * i) as f64) / ((2 as i64 * i + 1 as i64) as f64))
		result = result + term
		i = i + 1 as i64
	end
	return result
end

pub def cos(x f64) f64
	return sin((PI / 2 as f64) - x)
end

pub def tan(x f64) f64
	return sin(x) / cos(x)
end

pub def asin(x f64) f64
	if x >= 1 as f64
		return PI / 2 as f64
	end
	if x <= -1 as f64
		return -(PI / 2 as f64)
	end
	var result f64 = x
	var term f64 = x
	for var i = 1 as i64 .. 20
		var n f64 = i as f64
		var two_n f64 = (2 as i64 * i) as f64
		var two_n_minus_1 f64 = ((2 as i64 * i - 1 as i64) as i64) as f64
		var two_n_plus_1 f64 = ((2 as i64 * i + 1 as i64) as i64) as f64
		var factor1 f64 = two_n_minus_1 * two_n_minus_1
		var factor2 f64 = x * x
		var numerator f64 = factor1 * factor2
		var denominator f64 = two_n * two_n_plus_1
		term = term * (numerator / denominator)
		result = result + term / two_n_plus_1
	end
	return result
end

pub def acos(x f64) f64
	return (PI / 2 as f64) - asin(x)
end

pub def atan(x f64) f64
	if x > 1 as f64
		return (PI / 2 as f64) - atan(1 as f64 / x)
	end
	if x < -1 as f64
		return -(PI / 2 as f64) - atan(1 as f64 / x)
	end
	var result f64 = x
	var term f64 = x
	for var i = 1 as i64 .. 30
		var n f64 = i as f64
		term = term * (-(x * x))
		result = result + term / ((2 as i64 * n as i64 + 1 as i64) as f64)
	end
	return result
end

pub def atan2(y f64, x f64) f64
	if x > 0 as f64
		return atan(y / x)
	end
	if x < 0 as f64 && y >= 0 as f64
		return PI + atan(y / x)
	end
	if x < 0 as f64 && y < 0 as f64
		return -(PI - atan(y / x))
	end
	if x == 0 as f64 && y > 0 as f64
		return PI / 2 as f64
	end
	if x == 0 as f64 && y < 0 as f64
		return -(PI / 2 as f64)
	end
	return 0 as f64
end

pub def abs[T: Integer](x T) T
	if x < 0
		return -x
	end

	return x
end

pub def min[T](a T, b T) T
	if a < b
		return a
	end

	return b
end

pub def max[T](a T, b T) T
	if a > b
		return a
	end

	return b
end

pub def clamp[T](x T, low T, high T) T
	if x < low
		return low
	end

	if x > high
		return high
	end

	return x
end

pub def lerp(a f64, b f64, t f64) f64
	return a + ((b - a) * t)
end

pub def deg_to_rad(x f64) f64
	return x * (PI / 180.0)
end

pub def rad_to_deg(x f64) f64
	return x * (180.0 / PI)
end

pub def sign[T: Integer](x T) i32
	if x > 0
		return 1
	end

	if x < 0
		return -1
	end

	return 0
end

pub def is_even[T: Integer](x T) bool
	return (x % 2) == 0
end

pub def is_odd[T: Integer](x T) bool
	return (x % 2) != 0
end

pub def gcd[T: Integer](a T, b T) T
	var x T = abs[T](a)
	var y T = abs[T](b)

	for y != 0
		var tmp T = y
		y = x % y
		x = tmp
	end

	return x
end

pub def lcm[T: Integer](a T, b T) T
	if a == 0 || b == 0
		return 0
	end

	return abs[T]((a / gcd[T](a, b)) * b)
end

pub def ipow[T: Integer](base T, exponent u32) T
	var result T = 1 as T
	var b T = base
	var e u32 = exponent

	for e > 0 as u32
		if (e & 1 as u32) != 0 as u32
			result *= b
		end

		b *= b
		e = e >> (1 as u32)
	end

	return result
end

pub def log2(x f64) f64
    return log(x) / log(2.0)
end

pub def cbrt(x f64) f64
    if x == 0.0
        return 0.0
    end
    val neg bool = x < 0.0
    val a f64 = fabs(x)
    var guess f64 = a
    var i = 0
    for i < 20
        guess = ((2.0 * guess) + (a / (guess * guess))) / 3.0
        i++
    end
    if neg
        return -guess
    end
    return guess
end

pub def hypot(x f64, y f64) f64
    val ax f64 = fabs(x)
    val ay f64 = fabs(y)
    if ax == 0.0
        return ay
    end
    if ay == 0.0
        return ax
    end
    if ax > ay
        var r f64 = ay / ax
        return ax * sqrt(1.0 + r * r)
    end
    val r f64 = ax / ay
    return ay * sqrt(1.0 + r * r)
end

pub def copysign(x f64, y f64) f64
    val ax f64 = fabs(x)
    if y < 0.0
        return -ax
    end
    return ax
end

pub def sinh(x f64) f64
    return (exp(x) - exp(-x)) / 2.0
end

pub def cosh(x f64) f64
    return (exp(x) + exp(-x)) / 2.0
end

pub def tanh(x f64) f64
    val ep f64 = exp(x)
    val en f64 = exp(-x)
    return (ep - en) / (ep + en)
end

pub def asinh(x f64) f64
    return log(x + sqrt(x * x + 1.0))
end

pub def acosh(x f64) f64|error
    if x < 1.0
        return error("acosh: domain error (x < 1)")
    end
    return log(x + sqrt(x * x - 1.0))
end

pub def atanh(x f64) f64|error
    if x <= -1.0 || x >= 1.0
        return error("atanh: domain error (x must be in (-1, 1))")
    end
    return 0.5 * log((1.0 + x) / (1.0 - x))
end

pub def is_power_of_two[T: Integer](x T) bool
    if x <= 0
        return false
    end
    return (x & (x - 1 as T)) == 0 as T
end

pub def next_power_of_two[T: Integer](x T) T
    if x <= 1 as T
        return 1 as T
    end
    var n T = x - 1 as T
    n = n | (n >> (1 as T))
    n = n | (n >> (2 as T))
    n = n | (n >> (4 as T))
    if @sizeof(T) >= 2 as usize
        n = n | (n >> (8 as T))
    end
    if @sizeof(T) >= 4 as usize
        n = n | (n >> (16 as T))
    end
    if @sizeof(T) >= 8 as usize
        n = n | (n >> (32 as T))
    end
    return n + 1 as T
end

pub def div_ceil[T: Integer](a T, b T) T
    if b == 0 as T
        return 0 as T
    end
    if (a < 0 as T) != (b < 0 as T)
        return a / b
    end
    return (a + (b - 1 as T)) / b
end

test "log2 works"
    assert log2(1.0) == 0.0
    assert log2(2.0) == 1.0
    assert approx_eq(log2(8.0), 3.0, 0.0001)
end

test "cbrt works"
    assert cbrt(27.0) == 3.0
    assert cbrt(-8.0) == -2.0
    assert cbrt(0.0) == 0.0
end

test "hypot works"
    assert hypot(3.0, 4.0) == 5.0
    assert hypot(0.0, 5.0) == 5.0
end

test "copysign works"
    assert copysign(3.0, -1.0) == -3.0
    assert copysign(-3.0, 1.0) == 3.0
end

test "sinh cosh tanh work"
    assert fabs(sinh(0.0)) < EPSILON
    assert fabs(cosh(0.0) - 1.0) < EPSILON
    assert fabs(tanh(0.0)) < EPSILON
end

test "asinh works"
    assert fabs(asinh(0.0)) < EPSILON
    assert fabs(asinh(sinh(1.0)) - 1.0) < 1.0e-10
end

test "acosh works"
    match acosh(1.0)
        ok v => ( assert fabs(v) < EPSILON )
        error _ => ( assert false )
    end
    match acosh(0.5)
        ok _ => ( assert false )
        error _ => ()
    end
end

test "atanh works"
    match atanh(0.0)
        ok v => ( assert fabs(v) < EPSILON )
        error _ => ( assert false )
    end
    match atanh(1.0)
        ok _ => ( assert false )
        error _ => ()
    end
end

test "is_power_of_two works"
    assert is_power_of_two[_](1)
    assert is_power_of_two[_](2)
    assert is_power_of_two[_](64)
    assert !is_power_of_two[_](0)
    assert !is_power_of_two[_](3)
    assert !is_power_of_two[_](100)
end

test "next_power_of_two works"
    assert next_power_of_two[_](1) == 1
    assert next_power_of_two[_](3) == 4
    assert next_power_of_two[_](5) == 8
    assert next_power_of_two[_](8) == 8
    assert next_power_of_two[_](9) == 16
end

test "div_ceil works"
    assert div_ceil[_](10, 3) == 4
    assert div_ceil[_](9, 3) == 3
    assert div_ceil[_](1, 2) == 1
    assert div_ceil[_](0, 5) == 0
end

test "gcd with negatives works"
    assert gcd[_](-12, 8) == 4
    assert gcd[_](0, 7) == 7
end

test "ipow edge cases work"
    assert ipow[_](0, 0 as u32) == 1
    assert ipow[_](0, 3 as u32) == 0
end

test "abs works"
	assert abs[_](-5) == 5
	assert abs[_](10) == 10
end

test "min and max work"
	assert min[_](2, 5) == 2
	assert max[_](2, 5) == 5
end

test "clamp works"
	assert clamp[_](5, 0, 10) == 5
	assert clamp[_](-5, 0, 10) == 0
	assert clamp[_](99, 0, 10) == 10
end

test "lerp works"
	assert lerp(0.0, 10.0, 0.5) == 5.0
end

test "degree conversion works"
	assert deg_to_rad(180.0) == PI
	assert rad_to_deg(PI) == 180.0
end

test "sign works"
	assert sign[_](-123) == -1
	assert sign[_](0) == 0
	assert sign[_](123) == 1
end

test "parity works"
	assert is_even[_](4)
	assert !is_even[_](3)

	assert is_odd[_](3)
	assert !is_odd[_](4)
end

test "gcd works"
	assert gcd[_](48, 18) == 6
	assert gcd[_](7, 3) == 1
end

test "lcm works"
	assert lcm[_](12, 18) == 36
	assert lcm[_](7, 3) == 21
end

test "ipow works"
	assert ipow[_](2, 0 as u32) == 1
	assert ipow[_](2, 8 as u32) == 256
	assert ipow[_](5, 3 as u32) == 125
end

test "float externs work"
	assert floor(1.9) == 1.0
	assert ceil(1.1) == 2.0
	assert sqrt(25.0) == 5.0
end
