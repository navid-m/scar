val allocators = use("allocators")

extern def strcmp(x ref(u8), y ref(u8)) i32                         :: "strcmp"
extern def strcat(dest mut(ref(u8)), src ref(u8)) ref(u8)           :: "strcat"
extern def strlen(x ref(u8)) usize                                  :: "strlen"
extern def strcpy(dest mut(ref(u8)), src ref(u8)) ref(u8)           :: "strcpy"
extern def strncpy(dest mut(ref(u8)), src ref(u8), n usize) ref(u8) :: "strncpy"

pub type StringBuilder
	ptr mut(ref(u8))
	cap usize
	len usize
end

pub def eql(x ref(u8), y ref(u8)) bool
	guard y != none && x != none else
		return false
	end
	return strcmp(x, y) == 0
end

pub def len(x ref(u8)) usize
	guard x != none else
		return 0
	end
	return strlen(x)
end

pub def starts_with(x ref(u8), prefix ref(u8)) bool
	guard x != none && prefix != none else
		return false
	end

	var len_x usize = len(x)
	var len_prefix usize = len(prefix)

	if len_prefix > len_x
		return false
	end

	for var i = 0 .. len_prefix as i32
		if @deref(@add(x, i)) != @deref(@add(prefix, i))
			return false
		end
	end

	return true
end

pub def ends_with(x ref(u8), suffix ref(u8)) bool
	guard x != none && suffix != none else
		return false
	end

	var len_x usize = len(x)
	var len_suffix usize = len(suffix)

	if len_suffix > len_x
		return false
	end

	var start usize = len_x - len_suffix

	for var i = 0 .. len_suffix as i32
		if @deref(@add(x, start + i)) != @deref(@add(suffix, i))
			return false
		end
	end

	return true
end

pub def rconcat_buf(dest mut(ref(u8)), src ref(u8)) ref(u8)
	## This requires dest to be a writable buffer.
	## Do not confuse it with an in-place concat.
	return strcat(dest, src)
end

pub def rconcat[A: allocators.BumpAllocator](
	ac A,
	a ref(u8),
	b ref(u8)
) mut(ref(u8))|error
	var len_a usize = len(a)
	var len_b usize = len(b)

	var out ref(void) = A.alloc(
		@addr(ac),
		len_a + len_b + 1 as usize
	)?

	@memcpy(out, a, len_a)
	@memcpy(@add(out, len_a), b, len_b)
	@deref(@as_mut(@add(out, len_a + len_b))) = 0 as u8

	return out as mut(ref(u8))
end

pub def StringBuilder.new[A: allocators.BumpAllocator](
	ac A,
	cap usize
) mut(StringBuilder)|error
	var ptr ref(void) = A.alloc(@addr(ac), cap)?

	@deref(@as_mut(ptr as ref(u8))) = 0 as u8

	return StringBuilder(
		ptr: @as_mut(ptr as ref(u8)),
		cap: cap,
		len: 0
	)
end

pub def StringBuilder.append(
	sb mut(ref(StringBuilder)),
	s ref(u8)
) bool
	guard s != none else
		return true
	end

	var s_len usize = len(s)

	if sb.len + s_len + 1 > sb.cap
		return false
	end

	@memcpy(
		@add(sb.ptr, sb.len),
		s,
		s_len
	)

	sb.len = sb.len + s_len

	@deref(@add(sb.ptr, sb.len)) = 0 as u8

	return true
end

pub def StringBuilder.clear(sb mut(ref(StringBuilder))) void
	sb.len = 0
	@deref(sb.ptr) = 0 as u8
end

pub def StringBuilder.str(sb ref(StringBuilder)) ref(u8)
	return sb.ptr
end

pub def trim_prefix[A: allocators.BumpAllocator](
	ac A,
	x ref(u8),
	prefix ref(u8)
) ref(u8)|error
	guard x != none else
		return none
	end

	if !starts_with(x, prefix)
		return x
	end

	var len_prefix usize = len(prefix)
	var len_x usize = len(x)
	var new_len usize = len_x - len_prefix
	var out ref(void) = A.alloc(
		@addr(ac),
		new_len + 1 as usize
	)?

	@memcpy(
		out,
		@add(x, len_prefix),
		new_len
	)

	@deref(@as_mut(@add(out, new_len))) = 0 as u8

	return out as ref(u8)
end


pub def upcase[A: allocators.BumpAllocator](
	ac A,
	x ref(u8)
) ref(u8)|error
	guard x != none else
		return none
	end

	var len_x usize = len(x)

	var out ref(void) = A.alloc(
		@addr(ac),
		len_x + 1 as usize
	)?

	for var i = 0 .. len_x as i32
		var ch u8 = @deref(@add(x, i))

		if ch >= 'a' && ch <= 'z'
			ch = ch - (32 as u8)
		end

		@deref(@as_mut(@add(out, i))) = ch
	end

	@deref(@as_mut(@add(out, len_x))) = 0 as u8
	return out as ref(u8)
end

pub def downcase[A: allocators.BumpAllocator](
	ac A,
	x ref(u8)
) ref(u8)|error
	## Convert some string to its lower case form.
	## Allocates, thus requires an allocator.
	
	guard x != none else
		return none
	end

	var len_x usize = len(x)

	var out ref(void) = A.alloc(
		@addr(ac),
		len_x + 1 as usize
	)?

	for var i = 0 .. len_x as i32
		var ch u8 = @deref(@add(x, i))

		if ch >= 'A' && ch <= 'Z'
			ch = ch + (32 as u8)
		end

		@deref(@as_mut(@add(out, i))) = ch
	end

	@deref(@as_mut(@add(out, len_x))) = 0 as u8
	return out as ref(u8)
end

pub def trim_suffix[A: allocators.BumpAllocator](
	ac A,
	x ref(u8),
	suffix ref(u8)
) ref(u8)|error
	guard x != none else
		return none
	end

	if !ends_with(x, suffix)
		return x
	end

	var len_x usize = len(x)
	var len_suffix usize = len(suffix)
	var new_len usize = len_x - len_suffix
	var out ref(void) = A.alloc(
		@addr(ac),
		new_len + 1 as usize
	)?

	@memcpy(
		out,
		x,
		new_len
	)

	@deref(@as_mut(@add(out, new_len))) = 0 as u8
	return out as ref(u8)
end


pub def copy(dest mut(ref(u8)), src ref(u8)) void
    guard dest != none && src != none else
        return
    end
    strcpy(dest, src)
end

pub def copy_n(dest mut(ref(u8)), src ref(u8), n usize) void
    guard dest != none && src != none else
        return
    end
    if n == 0
        @deref(dest) = 0 as u8
        return
    end
    strncpy(dest, src, n)
    @deref(@as_mut(@add(dest, n))) = 0 as u8
end

pub def duplicate[A: allocators.BumpAllocator](ac A, src ref(u8)) ref(u8)|error
    guard src != none else
        return none
    end
    var l usize = len(src)
    var out ref(void) = A.alloc(@addr(ac), l + 1)?
    copy_n(out as mut(ref(u8)), src, l)
    return out as ref(u8)
end

pub def trim[A: allocators.BumpAllocator](
	ac A,
	x ref(u8)
) ref(u8)|error
	guard x != none else
		return none
	end

	var start usize = 0
	var nd usize = len(x)

	for start < nd
		var ch u8 = @deref(@add(x, start))

		if (
			ch != ' ' &&
			ch != '\t' &&
			ch != '\n' &&
			ch != '\r'
		)
			break
		end

		start++
	end

	for nd > start
		var ch u8 = @deref(@add(x, nd - 1))

		if (
			ch != ' ' &&
			ch != '\t' &&
			ch != '\n' &&
			ch != '\r'
		)
			break
		end

		nd--
	end

	var new_len usize = nd - start

	var out ref(void) = A.alloc(
		@addr(ac),
		new_len + 1 as usize
	)?

	@memcpy(
		out,
		@add(x, start),
		new_len
	)

	@deref(@as_mut(@add(out, new_len))) = 0 as u8

	return out as ref(u8)
end

pub def itoa[A: allocators.BumpAllocator](
	ac A,
	value i32
) ref(u8)|error
	var negative bool = value < 0
	var n i32 = value

	var buf ref(void) = A.alloc(
		@addr(ac),
		12 as usize
	)?

	var out mut(ref(u8)) = buf as mut(ref(u8))

	if n == 0
		@deref(out) = '0'
		@deref(@add(out, 1 as usize)) = 0 as u8
		return out as ref(u8)
	end

	var digits [12]u8 = @zeroed()
	var idx usize = 0

	for n != 0
		var digit i32 = n % 10

		if digit < 0
			digit = -digit
		end

		digits[idx] = ('0' as u8) + (digit as u8)

		idx++
		n = n / 10
	end

	var pos usize = 0

	if negative
		@deref(@add(out, pos)) = '-' as u8
		pos++
	end

	for idx > 0
		idx--

		@deref(@add(out, pos)) = digits[idx]
		pos++
	end

	@deref(@add(out, pos)) = 0 as u8

	return out as ref(u8)
end

extern def atoi_internal(x ref(u8)) i64 :: "atoi"

pub def atoi(x ref(u8)) i64
	guard x != none else
		return 0
	end

	return atoi_internal(x)
end

test "trim_prefix works"
	var ac = allocators.Arena.new(1024)?

	assert eql(
		trim_prefix[_](ac, "foobar", "foo")?,
		"bar"
	)

	assert eql(
		trim_prefix[_](ac, "foobar", "baz")?,
		"foobar"
	)

	allocators.Arena.destroy(@addr(ac))
end

test "trim_suffix works"
	var ac = allocators.Arena.new(1024)?

	assert eql(
		trim_suffix[_](ac, "foobar", "bar")?,
		"foo"
	)

	assert eql(
		trim_suffix[_](ac, "foobar", "baz")?,
		"foobar"
	)

	allocators.Arena.destroy(@addr(ac))
end

test "trim works"
	var ac = allocators.Arena.new(1024)?

	assert eql(
		trim[_](ac, "   hello world   ")?,
		"hello world"
	)

	assert eql(
		trim[_](ac, "\n\t hello \r\n")?,
		"hello"
	)

	assert eql(
		trim[_](ac, "no_whitespace")?,
		"no_whitespace"
	)

	assert eql(
		trim[_](ac, "   ")?,
		""
	)

	allocators.Arena.destroy(@addr(ac))
end

test "equals works"
	assert eql("hello", "hello")
	assert !eql("hello", "something else")
end

test "starts_with works"
	assert starts_with("hello world", "hello")
	assert starts_with("abc", "a")
	assert !starts_with("abc", "z")
	assert !starts_with("abc", "abcd")
end

test "ends_with works"
	assert ends_with("hello world", "world")
	assert ends_with("abc", "c")
	assert !ends_with("abc", "z")
	assert !ends_with("abc", "abcd")
end

test "concat works"
	var ac = allocators.Arena.new(1024)?

	var buffer mut(ref(u8)) = @alloc(1024)

	assert eql(
		rconcat[_](ac, buffer, "world")?,
		"world"
	)

	assert eql(
		rconcat[_](ac, "hello", " world")?,
		"hello world"
	)

	allocators.Arena.destroy(@addr(ac))
end

test "stringbuilder works"
	var ac = allocators.Arena.new(1024)?

	var sb StringBuilder = StringBuilder.new[_](ac, 128)?

	assert StringBuilder.append(@as_mut(@addr(sb)), "hello")
	assert StringBuilder.append(@as_mut(@addr(sb)), " ")
	assert StringBuilder.append(@as_mut(@addr(sb)), "world")

	assert eql(
		StringBuilder.str(@addr(sb)),
		"hello world"
	)

	StringBuilder.clear(@as_mut(@addr(sb)))

	assert eql(
		StringBuilder.str(@addr(sb)),
		""
	)

	allocators.Arena.destroy(@addr(ac))
end

test "upcase works"
	var alloc = allocators.Arena.new(1024 as usize)?
	assert eql("HELLO", upcase[_](alloc, "hello")?)
	allocators.Arena.destroy(@addr(alloc))
end

test "downcase works"
	var alloc = allocators.Arena.new(1024 as usize)?
	assert eql("hello", downcase[_](alloc, "HELLo")?)
	allocators.Arena.destroy(@addr(alloc))
end

test "copy functions work"
    var buf mut(ref(u8)) = @alloc(64)
    
    copy(buf, "hello")
    assert eql(buf, "hello")
    
    copy_n(buf, "scarlang is awesome", 8)
    assert eql(buf, "scarlang")
    
    var ac = allocators.Arena.new(256)?
    var dup = duplicate[_](ac, "copied string")?
    assert eql(dup, "copied string")
    
    allocators.Arena.destroy(@addr(ac))
    @free(buf)
end

test "itoa works"
	var ac = allocators.Arena.new(256)?

	assert eql(itoa[_](ac, 0)?, "0")
	assert eql(itoa[_](ac, 12345)?, "12345")
	assert eql(itoa[_](ac, -42)?, "-42")

	allocators.Arena.destroy(@addr(ac))
end

test "atoi works"
	assert atoi("0") == 0
	assert atoi("123") == 123
	assert atoi("-99") == -99
end
