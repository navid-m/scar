extern def strcmp(x ref(u8), y ref(u8)) i32 :: "strcmp"
extern def strcat(dest mut(ref(u8)), src ref(u8)) ref(u8) :: "strcat"

pub def raw_eql(x ref(u8), y ref(u8)) bool
	return strcmp(x, y) == 0
end

pub def raw_concat(dest mut(ref(u8)), src ref(u8)) ref(u8)
	## This requires dest to be a writable buffer.
	## Do not confuse it with an in-place concat.
	return strcat(dest, src)
end

test "equals works"
	assert raw_eql("hello", "hello")
	assert !raw_eql("hello", "something else")
end

test "concat works"
	var buffer mut(ref(u8)) = @alloc(1024)
	assert raw_eql(raw_concat(buffer, "world"), "world")
end
