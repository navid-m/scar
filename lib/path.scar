## The base name and directory name of a path.
pub class PathParts:
    init:
        string dirname = ""
        string basename = ""

## Check if a path is absolute.
pub fn is_absolute_path(string path) -> bool:
    return path[0] == '/' or (path[1] == ':' and ((path[2] == '\\') or (path[2] == '/')))

## Check if a path is relative.
pub fn is_relative(string path) -> bool:
    return !path::is_absolute_path(path)

## Get the extension of a path.
pub fn extension(string path) -> char*:
    $raw (
        const char *dot = strrchr(path, '.');
        if (dot && dot != path) {
            return strdup(dot + 1);
        }
        return strdup("");
    )

## Get the path without extension.
pub fn without_extension(string path) -> char*:
    $raw (
        char *result = strdup(path);
        char *dot = strrchr(result, '.');
        if (dot && dot != result) {
            *dot = '\0';
        }
        return result;
    )

## Join two paths.
pub fn join(string base, string relative) -> char*:
    $raw (
        char *result = malloc(strlen(base) + strlen(relative) + 2);
        if (result == NULL) {
            return NULL; // Memory allocation failed
        }
        strcpy(result, base);
        if (base[strlen(base) - 1] != '/' && base[strlen(base) - 1] != '\\') {
            strcat(result, "/");
        }
        strcat(result, relative);
        return result;
    )

## Normalize a path (remove //, ./, resolve ../ where possible).
pub fn normalize(string path) -> char*:
    $raw (
        char *in = strdup(path);
        char *out = malloc(strlen(path) + 1);
        char *token, *saveptr;
        size_t outlen = 0;
        out[0] = '\0';

        for (token = strtok_r(in, "/", &saveptr);
             token != NULL;
             token = strtok_r(NULL, "/", &saveptr)) {
            if (strcmp(token, ".") == 0) {
                continue;
            } else if (strcmp(token, "..") == 0) {
                char *slash = strrchr(out, '/');
                if (slash) *slash = '\0';
                else out[0] = '\0';
            } else {
                if (outlen > 0) strcat(out, "/");
                strcat(out, token);
            }
            outlen = strlen(out);
        }
        free(in);
        return out;
    )

## Resolve a relative path against a base path into an absolute.
pub fn resolve(string base, string rel) -> char*:
    if path::is_absolute_path(rel):
        return path::normalize(rel)
    else:
        string joined = path::join(base, rel)
        string result = path::normalize(joined)
        
        free joined
        return result

## Get the relative path from one path to another.
pub fn relative(string from, string to) -> char*:
    $raw (
        char *from_norm = path::normalize(from);
        char *to_norm = path::normalize(to);

        char *from_copy = strdup(from_norm);
        char *to_copy = strdup(to_norm);

        char *from_parts[256];
        char *to_parts[256];
        int from_count = 0, to_count = 0;

        char *token, *saveptr;
        for (token = strtok_r(from_copy, "/", &saveptr);
             token; token = strtok_r(NULL, "/", &saveptr)) {
            from_parts[from_count++] = token;
        }
        for (token = strtok_r(to_copy, "/", &saveptr);
             token; token = strtok_r(NULL, "/", &saveptr)) {
            to_parts[to_count++] = token;
        }

        int i = 0;
        while (i < from_count && i < to_count && strcmp(from_parts[i], to_parts[i]) == 0) {
            i++;
        }

        char *result = malloc(4096);
        result[0] = '\0';

        for (int j = i; j < from_count; j++) {
            strcat(result, "../");
        }
        for (int j = i; j < to_count; j++) {
            strcat(result, to_parts[j]);
            if (j < to_count - 1) strcat(result, "/");
        }

        free(from_norm);
        free(to_norm);
        free(from_copy);
        free(to_copy);
        return result;
    )

## Get the base name of a path.
pub fn basename(string path) -> char*:
    $raw (
        const char *base = strrchr(path, '/');
        if (base) {
            return strdup(base + 1);
        }
        return strdup(path);
    )

## Get the directory name of a path.
pub fn dirname(string path) -> char*:
    $raw (
        char *result = strdup(path);
        char *last_slash = strrchr(result, '/');
        if (last_slash) {
            *last_slash = '\0';
        } else {
            free(result);
            return strdup(".");
        }
        return result;
    )

## Split a path into (dirname, basename).
pub fn split(string path) -> path::PathParts:
    path::PathParts parts = new path::PathParts()
    parts.dirname = path::dirname(path)
    parts.basename = path::basename(path)
    return parts
