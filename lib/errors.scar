import "std/runtime"

pub class Error:
    init(cstring m):
        bool this.fatal = true
        cstring this.msg = m

    fn raise():
        if this.fatal:
            runtime::error(this.msg)
        else:
            $raw (
                _exception = _exception + 1;
            )

pub macro define_error_union(result_type, name):
    pub struct name:
        result_type result
        errors::Error error

define_error_union(i32, IntResult)
define_error_union(string, StringResult)
define_error_union(void, RefResult)
define_error_union(int, IntResult)
define_error_union(u32, U32Result)
define_error_union(i64, I64Result)
define_error_union(u64, U64Result)
define_error_union(f32, F32Result)
define_error_union(f64, F64Result)
define_error_union(char, CharResult)
define_error_union(u8, U8Result)
