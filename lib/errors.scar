import "std/runtime"

pub class Error:
    init(cstring m):
        bool this.fatal = true
        cstring this.msg = m

    fn raise():
        if this.fatal:
            runtime::error(this.msg)
        else:
            $raw (
                _exception = _exception + 1;
            )

pub struct ErrorUnion:
    int result
    errors::Error error
