## JSON library using Jansson
##
## On Windows:  mingw && pacman -S mingw-w64-x86_64-jansson
## On Linux:    sudo apt-get install libjansson-dev
## On macOS:    brew install jansson

external import "jansson.h"

pub val i32 JSON_OBJECT = 0
pub val i32 JSON_ARRAY = 1
pub val i32 JSON_STRING = 2
pub val i32 JSON_INTEGER = 3
pub val i32 JSON_REAL = 4
pub val i32 JSON_TRUE = 5
pub val i32 JSON_FALSE = 6
pub val i32 JSON_NULL = 7

## Parse JSON string and return json_t pointer
pub fn parse(string json_string) -> void*:
    $raw (
        json_error_t error;
        json_t *root = json_loads(json_string, 0, &error);
        return root;
    )

## Parse JSON from file and return json_t pointer
pub fn loadup_file(string filename) -> void*:
    $raw (
        json_error_t error;
        json_t *root = json_load_file(filename, 0, &error);
        return root;
    )

## Convert json_t to string representation
pub fn to_string(void* json_obj) -> string:
    $raw (
        if (!json_obj) {
            strcpy(_output_buffer, "");
            return;
        }
        char *json_string = json_dumps((json_t*)json_obj, JSON_COMPACT);
        if (json_string) {
            size_t n = strlen(json_string);
            if (n > 4095) n = 4095;
            memcpy(_output_buffer, json_string, n);
            _output_buffer[n] = '\0';
            free(json_string);
        } else {
            strcpy(_output_buffer, "");
        }
    )

## Convert json_t to pretty-printed string
pub fn to_string_pretty(void* json_obj) -> string:
    $raw (
        if (!json_obj) {
            strcpy(_output_buffer, "");
            return;
        }
        char *json_string = json_dumps((json_t*)json_obj, JSON_INDENT(2));
        if (json_string) {
            size_t n = strlen(json_string);
            if (n > 4095) n = 4095;
            memcpy(_output_buffer, json_string, n);
            _output_buffer[n] = '\0';
            free(json_string);
        } else {
            strcpy(_output_buffer, "");
        }
    )

## Save json_t to file
pub fn save_to_file(void* json_obj, string filename) -> bool:
    $raw (
        if (!json_obj) return false;
        int result = json_dump_file((json_t*)json_obj, filename, JSON_INDENT(2));
        return result == 0;
    )

## Get the type of a JSON value
pub fn get_type(void* json_obj) -> i32:
    $raw (
        if (!json_obj) return JSON_NULL;
        return (int)json_typeof((json_t*)json_obj);
    )

## Check if JSON value is of specific type
pub fn check_is_object(void* json_obj) -> bool:
    $raw (
        return json_obj && json_is_object((json_t*)json_obj);
    )

## Check if JSON value is an array
pub fn check_is_array(void* json_obj) -> bool:
    $raw (
        return json_obj && json_is_array((json_t*)json_obj);
    )

## Check if JSON value is a string
pub fn check_is_string(void* json_obj) -> bool:
    $raw (
        return json_obj && json_is_string((json_t*)json_obj);
    )

## Check if JSON value is an integer
pub fn check_is_integer(void* json_obj) -> bool:
    $raw (
        return json_obj && json_is_integer((json_t*)json_obj);
    )

## Check if JSON value is a real number
pub fn check_is_real(void* json_obj) -> bool:
    $raw (
        return json_obj && json_is_real((json_t*)json_obj);
    )

## Check if JSON value is a number
pub fn check_is_number(void* json_obj) -> bool:
    $raw (
        return json_obj && json_is_number((json_t*)json_obj);
    )

## Check if JSON value is true
pub fn check_is_true(void* json_obj) -> bool:
    $raw (
        return json_obj && json_is_true((json_t*)json_obj);
    )

## Check if JSON value is false
pub fn check_is_false(void* json_obj) -> bool:
    $raw (
        return json_obj && json_is_false((json_t*)json_obj);
    )

## Check if JSON value is a boolean
pub fn check_is_boolean(void* json_obj) -> bool:
    $raw (
        return json_obj && json_is_boolean((json_t*)json_obj);
    )

## Check if JSON value is null
pub fn check_is_null(void* json_obj) -> bool:
    $raw (
        return json_obj && json_is_null((json_t*)json_obj);
    )

## Create JSON values
pub fn new_object() -> void*:
    $raw (
        return json_object();
    )

## Create a new JSON array
pub fn new_array() -> void*:
    $raw (
        return json_array();
    )

## Create a new JSON string
pub fn new_string(string value) -> void*:
    $raw (
        return json_string(value);
    )

## Create a new JSON integer
pub fn new_integer(i64 value) -> void*:
    $raw (
        return json_integer(value);
    )

## Create a new JSON real number
pub fn new_real(f64 value) -> void*:
    $raw (
        return json_real(value);
    )

## Create a new JSON true value
pub fn new_true() -> void*:
    $raw (
        return json_true();
    )

## Create a new JSON false value
pub fn new_false() -> void*:
    $raw (
        return json_false();
    )

## Create a new JSON boolean value
pub fn new_boolean(bool value) -> void*:
    $raw (
        return value ? json_true() : json_false();
    )

## Create a new JSON null value
pub fn new_null() -> void*:
    $raw (
        return json_null();
    )

## Extract values from JSON
pub fn get_string_value(void* json_obj) -> string:
    $raw (
        if (!json_obj || !json_is_string((json_t*)json_obj)) {
            strcpy(_output_buffer, "");
            return;
        }
        const char* str = json_string_value((json_t*)json_obj);
        if (str) {
            size_t n = strlen(str);
            if (n > 4095) n = 4095;
            memcpy(_output_buffer, str, n);
            _output_buffer[n] = '\0';
        } else {
            strcpy(_output_buffer, "");
        }
    )

## Get the integer value of a JSON integer
pub fn get_integer_value(void* json_obj) -> i64:
    $raw (
        if (!json_obj || !json_is_integer((json_t*)json_obj)) {
            return 0;
        }
        return json_integer_value((json_t*)json_obj);
    )

## Get the real value of a JSON real number
pub fn get_real_value(void* json_obj) -> f64:
    $raw (
        if (!json_obj || !json_is_real((json_t*)json_obj)) {
            return 0.0;
        }
        return json_real_value((json_t*)json_obj);
    )

## Get the number value of a JSON number
pub fn get_number_value(void* json_obj) -> f64:
    $raw (
        if (!json_obj || !json_is_number((json_t*)json_obj)) {
            return 0.0;
        }
        return json_number_value((json_t*)json_obj);
    )

## Get the boolean value of a JSON boolean
pub fn get_boolean_value(void* json_obj) -> bool:
    $raw (
        if (!json_obj) return false;
        return json_is_true((json_t*)json_obj);
    )

## Object operations
pub fn obj_get(void* json_obj, string key) -> void*:
    $raw (
        if (!json_obj || !json_is_object((json_t*)json_obj)) {
            return NULL;
        }
        return json_object_get((json_t*)json_obj, key);
    )

## Set the value of a JSON object
pub fn obj_set(void* json_obj, string key, void* value) -> bool:
    $raw (
        if (!json_obj || !json_is_object((json_t*)json_obj) || !value) {
            return false;
        }
        int result = json_object_set((json_t*)json_obj, key, (json_t*)value);
        return result == 0;
    )

## Set the value of a JSON object with a new value
pub fn obj_set_new(void* json_obj, string key, void* value) -> bool:
    $raw (
        if (!json_obj || !json_is_object((json_t*)json_obj) || !value) {
            return false;
        }
        int result = json_object_set_new((json_t*)json_obj, key, (json_t*)value);
        return result == 0;
    )

## Delete a key from a JSON object
pub fn obj_del(void* json_obj, string key) -> bool:
    $raw (
        if (!json_obj || !json_is_object((json_t*)json_obj)) {
            return false;
        }
        int result = json_object_del((json_t*)json_obj, key);
        return result == 0;
    )

## Clear all keys from a JSON object
pub fn obj_clear(void* json_obj) -> bool:
    $raw (
        if (!json_obj || !json_is_object((json_t*)json_obj)) {
            return false;
        }
        int result = json_object_clear((json_t*)json_obj);
        return result == 0;
    )

## Get the size of a JSON object
pub fn obj_size(void* json_obj) -> i32:
    $raw (
        if (!json_obj || !json_is_object((json_t*)json_obj)) {
            return 0;
        }
        return (int)json_object_size((json_t*)json_obj);
    )

