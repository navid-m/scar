## Memory management
pub fn inc_ref(void* json_obj) -> void*:
    $raw (
        if (json_obj) {
            return json_incref((json_t*)json_obj);
        }
        return NULL;
    )

## This will also delete objects created with dump_to_file
pub fn dec_ref(void* json_obj) -> void:
    $raw (
        if (json_obj) {
            json_decref((json_t*)json_obj);
        }
    )

## Utility function for easier usage, get object string
pub fn get_object_string(void* json_obj, string key) -> string:
    $raw (
        if (!json_obj || !json_is_object((json_t*)json_obj)) {
            strcpy(_output_buffer, "");
            return;
        }
        json_t *value = json_object_get((json_t*)json_obj, key);
        if (!value || !json_is_string(value)) {
            strcpy(_output_buffer, "");
            return;
        }
        const char* str = json_string_value(value);
        if (str) {
            size_t n = strlen(str);
            if (n > 4095) n = 4095;
            memcpy(_output_buffer, str, n);
            _output_buffer[n] = '\0';
        } else {
            strcpy(_output_buffer, "");
        }
    )

## Utility function for easier usage, get object integer
pub fn get_object_integer(void* json_obj, string key) -> i64:
    $raw (
        if (!json_obj || !json_is_object((json_t*)json_obj)) {
            return 0;
        }
        json_t *value = json_object_get((json_t*)json_obj, key);
        if (!value || !json_is_integer(value)) {
            return 0;
        }
        return json_integer_value(value);
    )

## Utility function for easier usage, get object real
pub fn get_object_real(void* json_obj, string key) -> f64:
    $raw (
        if (!json_obj || !json_is_object((json_t*)json_obj)) {
            return 0.0;
        }
        json_t *value = json_object_get((json_t*)json_obj, key);
        if (!value || !json_is_real(value)) {
            return 0.0;
        }
        return json_real_value(value);
    )

## Utility function for easier usage, get object boolean
pub fn get_object_boolean(void* json_obj, string key) -> bool:
    $raw (
        if (!json_obj || !json_is_object((json_t*)json_obj)) {
            return false;
        }
        json_t *value = json_object_get((json_t*)json_obj, key);
        if (!value) return false;
        return json_is_true(value);
    )
