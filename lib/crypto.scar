import "std/strings"
import "std/random"

## Apply XOR cipher to a given text using the provided key.
## Return the raw string result of XOR between text and key characters.
pub fn xor_cipher(string text, string key) -> string:
    if strings::length(key) == 0:
        return ""
    i32 n = strings::length(text)
    i32 k = strings::length(key)
    string out = ""
    for i = 0 to n - 1:
        char tc = text[i]
        char kc = key[i % k]
        i32 tv = strings::ord_char(tc)
        i32 kv = strings::ord_char(kc)
        i32 xv = tv b_xor kv
        string ch = strings::chr(xv)
        out = cat!(out, ch)
    return out

## Apply XOR cipher to a given text using the provided key.
## Return the result as a hexadecimal string.
pub fn xor_cipher_hex(string text, string key) -> char*:
    if strings::length(key) == 0:
        return ""
    i32 n = strings::length(text)
    i32 k = strings::length(key)
    char* out = ""
    for i = 0 to n - 1:
        i32 tv = strings::ord_char(text[i])
        i32 kv = strings::ord_char(key[i % k])
        i32 xv = tv b_xor kv
        out = cat!(out, fmt!("%02X", xv))
    return out

## Encrypt a given text using the Vigenère cipher with the provided key.
## Return the encrypted text as a string.
pub fn vigenere_encrypt(string text, string key) -> string:
    $raw (
        if (!text || !key || key[0] == '\0') { strcpy(_output_buffer, ""); return; }
        size_t n = strlen(text);
        size_t k = strlen(key);
        char *out = (char*)malloc(n + 1); if (!out) { strcpy(_output_buffer, ""); return; }
        size_t j = 0;
        for (size_t i = 0; i < n; i++) {
            char c = text[i];
            if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')) {
                char kc = key[j % k];
                if (kc >= 'a' && kc <= 'z') kc = (char)(kc - 'a');
                else if (kc >= 'A' && kc <= 'Z') kc = (char)(kc - 'A');
                else kc = 0;
                if (c >= 'a' && c <= 'z') out[i] = (char)('a' + ((c - 'a' + kc) % 26));
                else out[i] = (char)('A' + ((c - 'A' + kc) % 26));
                j++;
            } else {
                out[i] = c;
            }
        }
        out[n] = '\0';
        strncpy(_output_buffer, out, 25402 - 1);
        _output_buffer[25402 - 1] = '\0';
        free(out);
    )

## Decrypt a given text using the Vigenère cipher with the provided key.
## Return the decrypted text as a string.
pub fn vigenere_decrypt(string text, string key) -> string:
    $raw (
        if (!text || !key || key[0] == '\0') { strcpy(_output_buffer, ""); return; }
        size_t n = strlen(text);
        size_t k = strlen(key);
        char *out = (char*)malloc(n + 1); if (!out) { strcpy(_output_buffer, ""); return; }
        size_t j = 0;
        for (size_t i = 0; i < n; i++) {
            char c = text[i];
            if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')) {
                char kc = key[j % k];
                if (kc >= 'a' && kc <= 'z') kc = (char)(kc - 'a');
                else if (kc >= 'A' && kc <= 'Z') kc = (char)(kc - 'A');
                else kc = 0;
                if (c >= 'a' && c <= 'z') out[i] = (char)('a' + ((26 + (c - 'a') - kc) % 26));
                else out[i] = (char)('A' + ((26 + (c - 'A') - kc) % 26));
                j++;
            } else {
                out[i] = c;
            }
        }
        out[n] = '\0';
        strncpy(_output_buffer, out, 25402 - 1);
        _output_buffer[25402 - 1] = '\0';
        free(out);
    )

## Generate a random salt of the specified length.
## Return the generated salt as a string.
pub fn random_salt(i32 length) -> string:
    $raw (
        static const char *alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
        int n           = length; if (n <= 0) { strcpy(_output_buffer, ""); return; }
        int alpha_len   = (int)strlen(alphabet);
        char *out       = (char*)malloc(n + 1); if (!out) { strcpy(_output_buffer, ""); return; }
        for (int i = 0; i < n; i++) {
            int r = rand();
            out[i] = alphabet[r % alpha_len];
        }
        out[n] = '\0';
        strncpy(_output_buffer, out, 25402 - 1);
        _output_buffer[25402 - 1] = '\0';
        free(out);
    )

## Compute the SHA-256 hash of the given input string.
## Return the hash as a hexadecimal string.
pub fn sha256(string input) -> string:
    $raw (
        typedef unsigned int u32;
        typedef unsigned long long u64;

        #define ROTR(x,n) (((x) >> (n)) | ((x) << (32 - (n))))
        #define CH(x,y,z)  (((x) & (y)) ^ (~(x) & (z)))
        #define MAJ(x,y,z) (((x) & (y)) ^ ((x) & (z)) ^ ((y) & (z)))
        #define BSIG0(x)   (ROTR((x),2) ^ ROTR((x),13) ^ ROTR((x),22))
        #define BSIG1(x)   (ROTR((x),6) ^ ROTR((x),11) ^ ROTR((x),25))
        #define SSIG0(x)   (ROTR((x),7) ^ ROTR((x),18) ^ ((x) >> 3))
        #define SSIG1(x)   (ROTR((x),17) ^ ROTR((x),19) ^ ((x) >> 10))

        static const u32 K[64] = {
            0x428a2f98U,0x71374491U,0xb5c0fbcfU,0xe9b5dba5U,0x3956c25bU,0x59f111f1U,0x923f82a4U,0xab1c5ed5U,
            0xd807aa98U,0x12835b01U,0x243185beU,0x550c7dc3U,0x72be5d74U,0x80deb1feU,0x9bdc06a7U,0xc19bf174U,
            0xe49b69c1U,0xefbe4786U,0x0fc19dc6U,0x240ca1ccU,0x2de92c6fU,0x4a7484aaU,0x5cb0a9dcU,0x76f988daU,
            0x983e5152U,0xa831c66dU,0xb00327c8U,0xbf597fc7U,0xc6e00bf3U,0xd5a79147U,0x06ca6351U,0x14292967U,
            0x27b70a85U,0x2e1b2138U,0x4d2c6dfcU,0x53380d13U,0x650a7354U,0x766a0abbU,0x81c2c92eU,0x92722c85U,
            0xa2bfe8a1U,0xa81a664bU,0xc24b8b70U,0xc76c51a3U,0xd192e819U,0xd6990624U,0xf40e3585U,0x106aa070U,
            0x19a4c116U,0x1e376c08U,0x2748774cU,0x34b0bcb5U,0x391c0cb3U,0x4ed8aa4aU,0x5b9cca4fU,0x682e6ff3U,
            0x748f82eeU,0x78a5636fU,0x84c87814U,0x8cc70208U,0x90befffaU,0xa4506cebU,0xbef9a3f7U,0xc67178f2U
        };

        u32 H[8] = {
            0x6a09e667U,0xbb67ae85U,0x3c6ef372U,0xa54ff53aU,
            0x510e527fU,0x9b05688cU,0x1f83d9abU,0x5be0cd19U
        };

        const unsigned char *data = (const unsigned char*)(input ? input : "");
        size_t len = strlen((const char*)data);

        size_t full = len & ~((size_t)63);
        size_t i = 0;
        for (; i < full; i += 64) {
            u32 W[64];
            for (int t = 0; t < 16; ++t) {
                int j = t * 4;
                W[t] = ((u32)data[i + j] << 24) | ((u32)data[i + j + 1] << 16) | ((u32)data[i + j + 2] << 8) | ((u32)data[i + j + 3]);
            }
            for (int t = 16; t < 64; ++t) {
                W[t] = SSIG1(W[t-2]) + W[t-7] + SSIG0(W[t-15]) + W[t-16];
            }
            u32 a=H[0],b=H[1],c=H[2],d=H[3],e=H[4],f=H[5],g=H[6],h=H[7];
            for (int t = 0; t < 64; ++t) {
                u32 T1 = h + BSIG1(e) + CH(e,f,g) + K[t] + W[t];
                u32 T2 = BSIG0(a) + MAJ(a,b,c);
                h = g; g = f; f = e; e = d + T1; d = c; c = b; b = a; a = T1 + T2;
            }
            H[0]+=a; H[1]+=b; H[2]+=c; H[3]+=d; H[4]+=e; H[5]+=f; H[6]+=g; H[7]+=h;
        }

        unsigned char block[128];
        size_t rem = len - full;
        for (size_t j = 0; j < rem; ++j) block[j] = data[full + j];
        block[rem++] = 0x80;
        size_t padLen = (rem > 56) ? (120 - rem) : (56 - rem);
        for (size_t j = 0; j < padLen; ++j) block[rem + j] = 0x00;
        rem += padLen;
        u64 bitlen = ((u64)len) * 8ULL;
        block[rem + 0] = (unsigned char)((bitlen >> 56) & 0xFF);
        block[rem + 1] = (unsigned char)((bitlen >> 48) & 0xFF);
        block[rem + 2] = (unsigned char)((bitlen >> 40) & 0xFF);
        block[rem + 3] = (unsigned char)((bitlen >> 32) & 0xFF);
        block[rem + 4] = (unsigned char)((bitlen >> 24) & 0xFF);
        block[rem + 5] = (unsigned char)((bitlen >> 16) & 0xFF);
        block[rem + 6] = (unsigned char)((bitlen >> 8) & 0xFF);
        block[rem + 7] = (unsigned char)((bitlen >> 0) & 0xFF);
        rem += 8;

        size_t total = rem;
        for (size_t off = 0; off < total; off += 64) {
            u32 W[64];
            for (int t = 0; t < 16; ++t) {
                int j = off + t * 4;
                W[t] = ((u32)block[j] << 24) | ((u32)block[j + 1] << 16) | ((u32)block[j + 2] << 8) | ((u32)block[j + 3]);
            }
            for (int t = 16; t < 64; ++t) {
                W[t] = SSIG1(W[t-2]) + W[t-7] + SSIG0(W[t-15]) + W[t-16];
            }
            u32 a=H[0],b=H[1],c=H[2],d=H[3],e=H[4],f=H[5],g=H[6],h=H[7];
            for (int t = 0; t < 64; ++t) {
                u32 T1 = h + BSIG1(e) + CH(e,f,g) + K[t] + W[t];
                u32 T2 = BSIG0(a) + MAJ(a,b,c);
                h = g; g = f; f = e; e = d + T1; d = c; c = b; b = a; a = T1 + T2;
            }
            H[0]+=a; H[1]+=b; H[2]+=c; H[3]+=d; H[4]+=e; H[5]+=f; H[6]+=g; H[7]+=h;
        }

        unsigned char digest[32];
        for (int t = 0; t < 8; ++t) {
            digest[t*4 + 0] = (unsigned char)((H[t] >> 24) & 0xFF);
            digest[t*4 + 1] = (unsigned char)((H[t] >> 16) & 0xFF);
            digest[t*4 + 2] = (unsigned char)((H[t] >> 8) & 0xFF);
            digest[t*4 + 3] = (unsigned char)((H[t] >> 0) & 0xFF);
        }

        char hex[65];
        static const char *hexd = "0123456789abcdef";
        for (int j = 0; j < 32; ++j) {
            hex[j*2]   = hexd[(digest[j] >> 4) & 0xF];
            hex[j*2+1] = hexd[digest[j] & 0xF];
        }
        hex[64] = '\0';
        strncpy(_output_buffer, hex, 25402 - 1);
        _output_buffer[25402 - 1] = '\0';
    )

## Encrypt data using AES-128 in ECB mode.
##
## Takes plaintext and a 16-byte (128-bit) key.
##
## Returns encrypted data as hexadecimal string.
pub fn aes128_encrypt(string plaintext, string key) -> string:
    $raw (
        // AES-128 S-box
        static const unsigned char sbox[256] = {
            0x63, 0x7c, 0x77, 0x7b, 0xf2, 0x6b, 0x6f, 0xc5, 0x30, 0x01, 0x67, 0x2b, 0xfe, 0xd7, 0xab, 0x76,
            0xca, 0x82, 0xc9, 0x7d, 0xfa, 0x59, 0x47, 0xf0, 0xad, 0xd4, 0xa2, 0xaf, 0x9c, 0xa4, 0x72, 0xc0,
            0xb7, 0xfd, 0x93, 0x26, 0x36, 0x3f, 0xf7, 0xcc, 0x34, 0xa5, 0xe5, 0xf1, 0x71, 0xd8, 0x31, 0x15,
            0x04, 0xc7, 0x23, 0xc3, 0x18, 0x96, 0x05, 0x9a, 0x07, 0x12, 0x80, 0xe2, 0xeb, 0x27, 0xb2, 0x75,
            0x09, 0x83, 0x2c, 0x1a, 0x1b, 0x6e, 0x5a, 0xa0, 0x52, 0x3b, 0xd6, 0xb3, 0x29, 0xe3, 0x2f, 0x84,
            0x53, 0xd1, 0x00, 0xed, 0x20, 0xfc, 0xb1, 0x5b, 0x6a, 0xcb, 0xbe, 0x39, 0x4a, 0x4c, 0x58, 0xcf,
            0xd0, 0xef, 0xaa, 0xfb, 0x43, 0x4d, 0x33, 0x85, 0x45, 0xf9, 0x02, 0x7f, 0x50, 0x3c, 0x9f, 0xa8,
            0x51, 0xa3, 0x40, 0x8f, 0x92, 0x9d, 0x38, 0xf5, 0xbc, 0xb6, 0xda, 0x21, 0x10, 0xff, 0xf3, 0xd2,
            0xcd, 0x0c, 0x13, 0xec, 0x5f, 0x97, 0x44, 0x17, 0xc4, 0xa7, 0x7e, 0x3d, 0x64, 0x5d, 0x19, 0x73,
            0x60, 0x81, 0x4f, 0xdc, 0x22, 0x2a, 0x90, 0x88, 0x46, 0xee, 0xb8, 0x14, 0xde, 0x5e, 0x0b, 0xdb,
            0xe0, 0x32, 0x3a, 0x0a, 0x49, 0x06, 0x24, 0x5c, 0xc2, 0xd3, 0xac, 0x62, 0x91, 0x95, 0xe4, 0x79,
            0xe7, 0xc8, 0x37, 0x6d, 0x8d, 0xd5, 0x4e, 0xa9, 0x6c, 0x56, 0xf4, 0xea, 0x65, 0x7a, 0xae, 0x08,
            0xba, 0x78, 0x25, 0x2e, 0x1c, 0xa6, 0xb4, 0xc6, 0xe8, 0xdd, 0x74, 0x1f, 0x4b, 0xbd, 0x8b, 0x8a,
            0x70, 0x3e, 0xb5, 0x66, 0x48, 0x03, 0xf6, 0x0e, 0x61, 0x35, 0x57, 0xb9, 0x86, 0xc1, 0x1d, 0x9e,
            0xe1, 0xf8, 0x98, 0x11, 0x69, 0xd9, 0x8e, 0x94, 0x9b, 0x1e, 0x87, 0xe9, 0xce, 0x55, 0x28, 0xdf,
            0x8c, 0xa1, 0x89, 0x0d, 0xbf, 0xe6, 0x42, 0x68, 0x41, 0x99, 0x2d, 0x0f, 0xb0, 0x54, 0xbb, 0x16
        };

        static const unsigned char rcon[11] = {
            0x00, 0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1b, 0x36
        };

        if (!plaintext || !key || strlen(key) != 16) {
            strcpy(_output_buffer, "");
            return;
        }

        size_t plen = strlen(plaintext);
        size_t padded_len = ((plen + 15) / 16) * 16;
        unsigned char *padded_data = (unsigned char*)malloc(padded_len);
        if (!padded_data) {
            strcpy(_output_buffer, "");
            return;
        }

        memcpy(padded_data, plaintext, plen);
        unsigned char pad_val = (unsigned char)(padded_len - plen);
        for (size_t i = plen; i < padded_len; i++) {
            padded_data[i] = pad_val;
        }

        unsigned char round_keys[176];
        memcpy(round_keys, key, 16);
        
        for (int i = 1; i <= 10; i++) {
            unsigned char temp[4];
            memcpy(temp, round_keys + (i-1)*16 + 12, 4);
            
            unsigned char t = temp[0];
            temp[0] = temp[1]; temp[1] = temp[2]; temp[2] = temp[3]; temp[3] = t;
            
            for (int j = 0; j < 4; j++) temp[j] = sbox[temp[j]];
            
            temp[0] ^= rcon[i];
            
            for (int j = 0; j < 4; j++) {
                round_keys[i*16 + j] = round_keys[(i-1)*16 + j] ^ temp[j];
                round_keys[i*16 + 4 + j] = round_keys[(i-1)*16 + 4 + j] ^ round_keys[i*16 + j];
                round_keys[i*16 + 8 + j] = round_keys[(i-1)*16 + 8 + j] ^ round_keys[i*16 + 4 + j];
                round_keys[i*16 + 12 + j] = round_keys[(i-1)*16 + 12 + j] ^ round_keys[i*16 + 8 + j];
            }
        }

        char *hex_output = (char*)malloc(padded_len * 2 + 1);
        if (!hex_output) {
            free(padded_data);
            strcpy(_output_buffer, "");
            return;
        }
        hex_output[0] = '\0';

        for (size_t block = 0; block < padded_len; block += 16) {
            unsigned char state[16];
            memcpy(state, padded_data + block, 16);

            for (int i = 0; i < 16; i++) {
                state[i] ^= round_keys[i];
            }

            for (int round = 1; round <= 9; round++) {
                for (int i = 0; i < 16; i++) {
                    state[i] = sbox[state[i]];
                }

                unsigned char temp = state[1]; state[1] = state[5]; state[5] = state[9]; state[9] = state[13]; state[13] = temp;
                temp = state[2]; state[2] = state[10]; state[10] = temp;
                temp = state[6]; state[6] = state[14]; state[14] = temp;
                temp = state[3]; state[3] = state[15]; state[15] = state[11]; state[11] = state[7]; state[7] = temp;

                for (int col = 0; col < 4; col++) {
                    unsigned char a = state[col*4], b = state[col*4+1], c = state[col*4+2], d = state[col*4+3];
                    state[col*4] = (a<<1) ^ (a>>7 ? 0x1b : 0) ^ (b<<1) ^ (b>>7 ? 0x1b : 0) ^ b ^ c ^ d;
                    state[col*4+1] = a ^ (b<<1) ^ (b>>7 ? 0x1b : 0) ^ (c<<1) ^ (c>>7 ? 0x1b : 0) ^ c ^ d;
                    state[col*4+2] = a ^ b ^ (c<<1) ^ (c>>7 ? 0x1b : 0) ^ (d<<1) ^ (d>>7 ? 0x1b : 0) ^ d;
                    state[col*4+3] = (a<<1) ^ (a>>7 ? 0x1b : 0) ^ a ^ b ^ c ^ (d<<1) ^ (d>>7 ? 0x1b : 0);
                }

                for (int i = 0; i < 16; i++) {
                    state[i] ^= round_keys[round*16 + i];
                }
            }

            for (int i = 0; i < 16; i++) state[i] = sbox[state[i]];
            unsigned char temp = state[1]; state[1] = state[5]; state[5] = state[9]; state[9] = state[13]; state[13] = temp;
            temp = state[2]; state[2] = state[10]; state[10] = temp;
            temp = state[6]; state[6] = state[14]; state[14] = temp;
            temp = state[3]; state[3] = state[15]; state[15] = state[11]; state[11] = state[7]; state[7] = temp;
            for (int i = 0; i < 16; i++) state[i] ^= round_keys[160 + i];

            for (int i = 0; i < 16; i++) {
                sprintf(hex_output + strlen(hex_output), "%02x", state[i]);
            }
        }

        strncpy(_output_buffer, hex_output, 25402 - 1);
        _output_buffer[25402 - 1] = '\0';
        free(padded_data);
        free(hex_output);
    )

## Decrypt data using AES-128 in ECB mode.
##
## Takes hexadecimal encrypted data and a 16-byte (128-bit) key.
##
## Returns decrypted plaintext as a string.
pub fn aes128_decrypt(string ciphertext_hex, string key) -> string:
    $raw (
        static const unsigned char inv_sbox[256] = {
            0x52, 0x09, 0x6a, 0xd5, 0x30, 0x36, 0xa5, 0x38, 0xbf, 0x40, 0xa3, 0x9e, 0x81, 0xf3, 0xd7, 0xfb,
            0x7c, 0xe3, 0x39, 0x82, 0x9b, 0x2f, 0xff, 0x87, 0x34, 0x8e, 0x43, 0x44, 0xc4, 0xde, 0xe9, 0xcb,
            0x54, 0x7b, 0x94, 0x32, 0xa6, 0xc2, 0x23, 0x3d, 0xee, 0x4c, 0x95, 0x0b, 0x42, 0xfa, 0xc3, 0x4e,
            0x08, 0x2e, 0xa1, 0x66, 0x28, 0xd9, 0x24, 0xb2, 0x76, 0x5b, 0xa2, 0x49, 0x6d, 0x8b, 0xd1, 0x25,
            0x72, 0xf8, 0xf6, 0x64, 0x86, 0x68, 0x98, 0x16, 0xd4, 0xa4, 0x5c, 0xcc, 0x5d, 0x65, 0xb6, 0x92,
            0x6c, 0x70, 0x48, 0x50, 0xfd, 0xed, 0xb9, 0xda, 0x5e, 0x15, 0x46, 0x57, 0xa7, 0x8d, 0x9d, 0x84,
            0x90, 0xd8, 0xab, 0x00, 0x8c, 0xbc, 0xd3, 0x0a, 0xf7, 0xe4, 0x58, 0x05, 0xb8, 0xb3, 0x45, 0x06,
            0xd0, 0x2c, 0x1e, 0x8f, 0xca, 0x3f, 0x0f, 0x02, 0xc1, 0xaf, 0xbd, 0x03, 0x01, 0x13, 0x8a, 0x6b,
            0x3a, 0x91, 0x11, 0x41, 0x4f, 0x67, 0xdc, 0xea, 0x97, 0xf2, 0xcf, 0xce, 0xf0, 0xb4, 0xe6, 0x73,
            0x96, 0xac, 0x74, 0x22, 0xe7, 0xad, 0x35, 0x85, 0xe2, 0xf9, 0x37, 0xe8, 0x1c, 0x75, 0xdf, 0x6e,
            0x47, 0xf1, 0x1a, 0x71, 0x1d, 0x29, 0xc5, 0x89, 0x6f, 0xb7, 0x62, 0x0e, 0xaa, 0x18, 0xbe, 0x1b,
            0xfc, 0x56, 0x3e, 0x4b, 0xc6, 0xd2, 0x79, 0x20, 0x9a, 0xdb, 0xc0, 0xfe, 0x78, 0xcd, 0x5a, 0xf4,
            0x1f, 0xdd, 0xa8, 0x33, 0x88, 0x07, 0xc7, 0x31, 0xb1, 0x12, 0x10, 0x59, 0x27, 0x80, 0xec, 0x5f,
            0x60, 0x51, 0x7f, 0xa9, 0x19, 0xb5, 0x4a, 0x0d, 0x2d, 0xe5, 0x7a, 0x9f, 0x93, 0xc9, 0x9c, 0xef,
            0xa0, 0xe0, 0x3b, 0x4d, 0xae, 0x2a, 0xf5, 0xb0, 0xc8, 0xeb, 0xbb, 0x3c, 0x83, 0x53, 0x99, 0x61,
            0x17, 0x2b, 0x04, 0x7e, 0xba, 0x77, 0xd6, 0x26, 0xe1, 0x69, 0x14, 0x63, 0x55, 0x21, 0x0c, 0x7d
        };

        static const unsigned char rcon[11] = {
            0x00, 0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1b, 0x36
        };

        if (!ciphertext_hex || !key || strlen(key) != 16) {
            strcpy(_output_buffer, "");
            return;
        }

        size_t hex_len = strlen(ciphertext_hex);
        if (hex_len % 32 != 0) { 
            strcpy(_output_buffer, "");
            return;
        }

        size_t data_len = hex_len / 2;
        unsigned char *ciphertext = (unsigned char*)malloc(data_len);
        if (!ciphertext) {
            strcpy(_output_buffer, "");
            return;
        }

        for (size_t i = 0; i < data_len; i++) {
            char hex_byte[3] = {ciphertext_hex[i*2], ciphertext_hex[i*2+1], '\0'};
            ciphertext[i] = (unsigned char)strtol(hex_byte, NULL, 16);
        }
        unsigned char round_keys[176];
        memcpy(round_keys, key, 16);
        
        for (int i = 1; i <= 10; i++) {
            unsigned char temp[4];
            memcpy(temp, round_keys + (i-1)*16 + 12, 4);
            
            unsigned char t = temp[0];
            temp[0] = temp[1]; temp[1] = temp[2]; temp[2] = temp[3]; temp[3] = t;
            
            static const unsigned char sbox[256] = {
                0x63, 0x7c, 0x77, 0x7b, 0xf2, 0x6b, 0x6f, 0xc5, 0x30, 0x01, 0x67, 0x2b, 0xfe, 0xd7, 0xab, 0x76,
                0xca, 0x82, 0xc9, 0x7d, 0xfa, 0x59, 0x47, 0xf0, 0xad, 0xd4, 0xa2, 0xaf, 0x9c, 0xa4, 0x72, 0xc0,
                0xb7, 0xfd, 0x93, 0x26, 0x36, 0x3f, 0xf7, 0xcc, 0x34, 0xa5, 0xe5, 0xf1, 0x71, 0xd8, 0x31, 0x15,
                0x04, 0xc7, 0x23, 0xc3, 0x18, 0x96, 0x05, 0x9a, 0x07, 0x12, 0x80, 0xe2, 0xeb, 0x27, 0xb2, 0x75,
                0x09, 0x83, 0x2c, 0x1a, 0x1b, 0x6e, 0x5a, 0xa0, 0x52, 0x3b, 0xd6, 0xb3, 0x29, 0xe3, 0x2f, 0x84,
                0x53, 0xd1, 0x00, 0xed, 0x20, 0xfc, 0xb1, 0x5b, 0x6a, 0xcb, 0xbe, 0x39, 0x4a, 0x4c, 0x58, 0xcf,
                0xd0, 0xef, 0xaa, 0xfb, 0x43, 0x4d, 0x33, 0x85, 0x45, 0xf9, 0x02, 0x7f, 0x50, 0x3c, 0x9f, 0xa8,
                0x51, 0xa3, 0x40, 0x8f, 0x92, 0x9d, 0x38, 0xf5, 0xbc, 0xb6, 0xda, 0x21, 0x10, 0xff, 0xf3, 0xd2,
                0xcd, 0x0c, 0x13, 0xec, 0x5f, 0x97, 0x44, 0x17, 0xc4, 0xa7, 0x7e, 0x3d, 0x64, 0x5d, 0x19, 0x73,
                0x60, 0x81, 0x4f, 0xdc, 0x22, 0x2a, 0x90, 0x88, 0x46, 0xee, 0xb8, 0x14, 0xde, 0x5e, 0x0b, 0xdb,
                0xe0, 0x32, 0x3a, 0x0a, 0x49, 0x06, 0x24, 0x5c, 0xc2, 0xd3, 0xac, 0x62, 0x91, 0x95, 0xe4, 0x79,
                0xe7, 0xc8, 0x37, 0x6d, 0x8d, 0xd5, 0x4e, 0xa9, 0x6c, 0x56, 0xf4, 0xea, 0x65, 0x7a, 0xae, 0x08,
                0xba, 0x78, 0x25, 0x2e, 0x1c, 0xa6, 0xb4, 0xc6, 0xe8, 0xdd, 0x74, 0x1f, 0x4b, 0xbd, 0x8b, 0x8a,
                0x70, 0x3e, 0xb5, 0x66, 0x48, 0x03, 0xf6, 0x0e, 0x61, 0x35, 0x57, 0xb9, 0x86, 0xc1, 0x1d, 0x9e,
                0xe1, 0xf8, 0x98, 0x11, 0x69, 0xd9, 0x8e, 0x94, 0x9b, 0x1e, 0x87, 0xe9, 0xce, 0x55, 0x28, 0xdf,
                0x8c, 0xa1, 0x89, 0x0d, 0xbf, 0xe6, 0x42, 0x68, 0x41, 0x99, 0x2d, 0x0f, 0xb0, 0x54, 0xbb, 0x16
            };
            for (int j = 0; j < 4; j++) temp[j] = sbox[temp[j]];
            
            temp[0] ^= rcon[i];
            
            for (int j = 0; j < 4; j++) {
                round_keys[i*16 + j] = round_keys[(i-1)*16 + j] ^ temp[j];
                round_keys[i*16 + 4 + j] = round_keys[(i-1)*16 + 4 + j] ^ round_keys[i*16 + j];
                round_keys[i*16 + 8 + j] = round_keys[(i-1)*16 + 8 + j] ^ round_keys[i*16 + 4 + j];
                round_keys[i*16 + 12 + j] = round_keys[(i-1)*16 + 12 + j] ^ round_keys[i*16 + 8 + j];
            }
        }

        char *plaintext = (char*)malloc(data_len + 1);
        if (!plaintext) {
            free(ciphertext);
            strcpy(_output_buffer, "");
            return;
        }

        for (size_t block = 0; block < data_len; block += 16) {
            unsigned char state[16];
            memcpy(state, ciphertext + block, 16);
            for (int i = 0; i < 16; i++) {
                state[i] ^= round_keys[160 + i];  
            }

            for (int round = 9; round >= 1; round--) {
                unsigned char temp = state[13]; state[13] = state[9]; state[9] = state[5]; state[5] = state[1]; state[1] = temp;
                temp = state[2]; state[2] = state[10]; state[10] = temp;
                temp = state[6]; state[6] = state[14]; state[14] = temp;
                temp = state[7]; state[7] = state[11]; state[11] = state[15]; state[15] = state[3]; state[3] = temp;

                for (int i = 0; i < 16; i++) {
                    state[i] = inv_sbox[state[i]];
                }

                for (int i = 0; i < 16; i++) {
                    state[i] ^= round_keys[round*16 + i];
                }

                for (int col = 0; col < 4; col++) {
                    unsigned char a = state[col*4], b = state[col*4+1], c = state[col*4+2], d = state[col*4+3];
                    unsigned char a2 = (a<<1) ^ (a>>7 ? 0x1b : 0);
                    unsigned char a4 = (a2<<1) ^ (a2>>7 ? 0x1b : 0);
                    unsigned char a8 = (a4<<1) ^ (a4>>7 ? 0x1b : 0);
                    unsigned char b2 = (b<<1) ^ (b>>7 ? 0x1b : 0);
                    unsigned char b4 = (b2<<1) ^ (b2>>7 ? 0x1b : 0);
                    unsigned char b8 = (b4<<1) ^ (b4>>7 ? 0x1b : 0);
                    unsigned char c2 = (c<<1) ^ (c>>7 ? 0x1b : 0);
                    unsigned char c4 = (c2<<1) ^ (c2>>7 ? 0x1b : 0);
                    unsigned char c8 = (c4<<1) ^ (c4>>7 ? 0x1b : 0);
                    unsigned char d2 = (d<<1) ^ (d>>7 ? 0x1b : 0);
                    unsigned char d4 = (d2<<1) ^ (d2>>7 ? 0x1b : 0);
                    unsigned char d8 = (d4<<1) ^ (d4>>7 ? 0x1b : 0);

                    state[col*4] = (a8^a4^a2) ^ (b8^b) ^ (c8^c2^c) ^ (d8^d4^d);
                    state[col*4+1] = (a8^a) ^ (b8^b4^b2) ^ (c8^c4^c) ^ (d8^d2^d);
                    state[col*4+2] = (a8^a2^a) ^ (b8^b) ^ (c8^c4^c2) ^ (d8^d4^d);
                    state[col*4+3] = (a8^a4^a) ^ (b8^b2^b) ^ (c8^c) ^ (d8^d4^d2);
                }
            }

            unsigned char temp = state[13]; state[13] = state[9]; state[9] = state[5]; state[5] = state[1]; state[1] = temp;
            temp = state[2]; state[2] = state[10]; state[10] = temp;
            temp = state[6]; state[6] = state[14]; state[14] = temp;
            temp = state[7]; state[7] = state[11]; state[11] = state[15]; state[15] = state[3]; state[3] = temp;
            
            for (int i = 0; i < 16; i++) state[i] = inv_sbox[state[i]];
            
            for (int i = 0; i < 16; i++) state[i] ^= round_keys[i];

            memcpy(plaintext + block, state, 16);
        }

        if (data_len > 0) {
            unsigned char pad_val = plaintext[data_len - 1];
            if (pad_val > 0 && pad_val <= 16) {
                int valid_padding = 1;
                for (int i = 0; i < pad_val; i++) {
                    if (plaintext[data_len - 1 - i] != pad_val) {
                        valid_padding = 0;
                        break;
                    }
                }
                if (valid_padding) {
                    data_len -= pad_val;
                }
            }
        }

        plaintext[data_len] = '\0';
        strncpy(_output_buffer, plaintext, 25402 - 1);
        _output_buffer[25402 - 1] = '\0';
        
        free(ciphertext);
        free(plaintext);
    )
