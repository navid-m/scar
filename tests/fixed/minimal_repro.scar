pub class SimpleClass:
    init:
        int this.value = 0
        string this.name = "test"
        
    fn get_value() -> int:
        return this.value
        
    fn set_value(int val) -> void:
        this.value = val

pub class WithBuffer:
    init(int size):
        int this.size = size
        ref void this.buffer = nil
        $raw (
            this->buffer = scar_malloc(size * sizeof(int));
        )
        
    fn store(int index, int value) -> void:
        if index >= 0 && index < this.size:
            $raw (
                ((int*)this->buffer)[index] = value;
            )

pub fn create_simple() -> SimpleClass:
    SimpleClass obj = new SimpleClass()
    return obj

print "Testing simple classes\n"
SimpleClass simple = new SimpleClass()
simple.set_value(42)
print "Value: %d\n" | simple.get_value()

WithBuffer buffer = new WithBuffer(5)
buffer.store(0, 100)

SimpleClass created = create_simple()
created.set_value(123)
print "Created value: %d\n" | created.get_value()

print "Test completed\n"
