pub class Simple:
    init:
        int this.value = 5
        
    fn get_value() -> int:
        return this.value

pub fn create_object() -> Simple:
    Simple obj = new Simple()
    return obj

print "Testing return type issue\n"
var direct = new Simple()
print "Direct value: %d\n" | direct.get_value()
Simple factory = create_object()
print "Factory value: %d\n" | factory.get_value()
print "Test completed\n"
