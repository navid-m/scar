# Test ref type and string initialization issue

pub class RefTest:
    init:
        string this.name = ""
        ref void this.data = nil
        
    fn set_name(string name) -> void:
        this.name = name
        
    fn get_name() -> string:
        return this.name

print "Testing ref types and string init\n"
RefTest test = new RefTest()
test.set_name("hello")
print "Name: %s\n" | test.get_name()
print "Test completed\n"
