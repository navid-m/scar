# Test enum usage issue

pub enum Status:
    PENDING = 0
    COMPLETE = 1
    FAILED = 2

pub class TestClass:
    init:
        int this.status = Status::PENDING
        
    fn set_complete() -> void:
        this.status = Status::COMPLETE
        
    fn is_complete() -> bool:
        return this.status == Status::COMPLETE

print "Testing enum usage\n"

TestClass test = new TestClass()
test.set_complete()

if test.is_complete():
    print "Status is complete\n"
else:
    print "Status is not complete\n"

print "Test completed\n"
