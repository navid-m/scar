import "std/os"
import "std/math"

pub int WIDTH = 60
pub int RANDOM_BUF_SIZE = 60000 
pub int OUT_BUF_SIZE = 61000
pub int IM = 139968
pub int IA = 3877
pub int IC = 29573
pub u32 lastrandom = 42
pub allocate AminoAcid iub = 15
pub allocate AminoAcid homosapiens = 4

fn initialize_amino_acids() -> void:
    iub[0].p = 0.27
    iub[0].c = 97  # 'a'
    iub[1].p = 0.12
    iub[1].c = 99  # 'c'
    iub[2].p = 0.12
    iub[2].c = 103 # 'g'
    iub[3].p = 0.27
    iub[3].c = 116 # 't'
    iub[4].p = 0.02
    iub[4].c = 66  # 'B'
    iub[5].p = 0.02
    iub[5].c = 68  # 'D'
    iub[6].p = 0.02
    iub[6].c = 72  # 'H'
    iub[7].p = 0.02
    iub[7].c = 75  # 'K'
    iub[8].p = 0.02
    iub[8].c = 77  # 'M'
    iub[9].p = 0.02
    iub[9].c = 78  # 'N'
    iub[10].p = 0.02
    iub[10].c = 82 # 'R'
    iub[11].p = 0.02
    iub[11].c = 83 # 'S'
    iub[12].p = 0.02
    iub[12].c = 86 # 'V'
    iub[13].p = 0.02
    iub[13].c = 87 # 'W'
    iub[14].p = 0.02
    iub[14].c = 89 # 'Y'

    homosapiens[0].p = 0.3029549426680
    homosapiens[0].c = 97  # 'a'
    homosapiens[1].p = 0.1979883004921
    homosapiens[1].c = 99  # 'c'
    homosapiens[2].p = 0.1975473066391
    homosapiens[2].c = 103 # 'g'
    homosapiens[3].p = 0.3015094502008
    homosapiens[3].c = 116 # 't'

    accumulate_probabilities(iub, 15)
    accumulate_probabilities(homosapiens, 4)

class AminoAcid:
    init(f64 prob, u8 character):
        f64 this.p = prob
        u8 this.c = character

fn accumulate_probabilities(ref AminoAcid genelist, int len) -> void:
    for i = 1 to (len - 1):
        genelist[i].p = genelist[i].p + genelist[i - 1].p

fn repeat_fasta(ref u8 s, int s_len, int count) -> void:
    int pos = 0
    allocate u8 s2 = s_len + WIDTH

    for i = 0 to (s_len - 1):
        s2[i] = s[i]

    for i = 0 to (WIDTH - 1):
        if i < s_len:
            s2[s_len + i] = s[i]
    
    while count > 0:
        int line = min(WIDTH, count)
        
        for i = 0 to (line - 1):
            print "%c" | s2[pos + i]
        print ""
        
        pos = pos + line
        if pos >= s_len:
            pos = pos - s_len
        count = count - line

fn generate_random(ref f64 buf, int len) -> void:
    for i = 0 to (len - 1):
        lastrandom = (lastrandom * (u32)(IA) + (u32)(IC)) % (u32)(IM)
        buf[i] = (f64)(lastrandom) / (f64)(IM)

fn generate_dna(ref AminoAcid genelist, int genelist_len, ref f64 rb, ref u8 wb, int count) -> int:
    int i = 0
    int o = 0
    
    while count > 0:
        int line = min(WIDTH, count)
        count = count - line
        
        for j = 0 to (line - 1):
            f64 r = rb[i]
            for k = 0 to (genelist_len - 1):
                if genelist[k].p >= r:
                    wb[o] = genelist[k].c
                    break
            i = i + 1
            o = o + 1
        
        wb[o] = 10
        o = o + 1
    
    return o

fn random_fasta(ref AminoAcid genelist, int genelist_len, int count) -> void:
    allocate f64 rb = RANDOM_BUF_SIZE
    allocate u8 wb = OUT_BUF_SIZE
    
    while count > 0:
        int chunk = min(count, RANDOM_BUF_SIZE)
        count = count - chunk
        
        generate_random(rb, chunk)
        int output_len = generate_dna(genelist, genelist_len, rb, wb, chunk)
        
        # Output the generated DNA
        for i = 0 to (output_len - 1):
            print "%c" | wb[i]

list[string] args = os::get_args()
int n = 0
if len(args) > 1:
    n = math::to_int(args[1])

initialize_amino_acids()

string alu_str = "GGCCGGGCGCGGTGGCTCACGCCTGTAATCCCAGCACTTTGGGAGGCCGAGGCGGGCGGATCACCTGAGGTCAGGAGTTCGAGACCAGCCTGGCCAACATGGTGAAACCCCGTCTCTACTAAAAATACAAAAATTAGCCGGGCGTGGTGGCGCGCGCCTGTAATCCCAGCTACTCGGGAGGCTGAGGCAGGAGAATCGCTTGAACCCGGGAGGCGGAGGTTGCAGTGAGCCGAGATCGCGCCACTGCACTCCAGCCTGGGCGACAGAGCGAGACTCCGTCTCAAAAA"
int alu_len = 287

allocate u8 alu = alu_len
for i = 0 to (alu_len - 1):
    alu[i] = (u8)(alu_str[i])

print ">ONE Homo sapiens alu"
repeat_fasta(alu, alu_len, 2 * n)
print ">TWO IUB ambiguity codes"
random_fasta(iub, 15, 3 * n)
print ">THREE Homo sapiens frequency"
random_fasta(homosapiens, 4, 5 * n)
