pub macro CreateObject(varName, className):
    ref className varName = nil
    varName = new className()

pub macro InitArray(arrayType, arrayName, size, initValue):
    list[arrayType] arrayName = []

pub macro DebugPrint(varName):
    print "DEBUG: %d " | varName

pub macro SafeAssign(target, source):
    if source != nil:
        target = source

macro InternalMacro(x):
    print "This is internal: " x
