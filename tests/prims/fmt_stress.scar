import "std/strings"

print "Starting fmt! stress test"
string chunk = "0123456789abcdef0123456789abcdef"  # 32 bytes
string big = ""
int iterations = 50000  # ~1.6MB total
for int i = 0; i < iterations; i++:
    big = fmt!("%s%s", big, chunk)
print "Built big string, length=%d" | strings::length(big)

string out = fmt!("%s-%d", big, 123456789)
print "Formatted string length=%d" | strings::length(out)

int tailStart = strings::length(out) - 64
if tailStart < 0:
    tailStart = 0
string tail = strings::substring(out, tailStart, strings::length(out))
print "Tail: %s" | tail
