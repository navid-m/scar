local import "raylib.h"

i32 WIDTH = 800
i32 HEIGHT = 600
i32 DROPS = 400

InitWindow(WIDTH, HEIGHT, "Rain")
SetTargetFPS(60)

i32 t = 0

while not WindowShouldClose():
    BeginDrawing()
    ClearBackground(BLACK)

    for i = 0 to DROPS - 1:
        i32 xi = (i * 37) % WIDTH
        i32 sp = 4 + ((i * 13) % 8)
        i32 yi0 = (i * 97) % HEIGHT
        i32 y = (yi0 + t * sp) % HEIGHT

        i32 y2 = y + 12
        if y2 >= HEIGHT:
            y2 = HEIGHT

        DrawLine(xi, y, xi, y2, BLUE)

    DrawText("Rainfall", 10, 10, 20, RAYWHITE)
    EndDrawing()
    t = t + 1

