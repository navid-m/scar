# Test file for the alias system

import "std/strings"
import "std/collections"

# Define aliases for function calls
alias add_elem = collections::StringArrayList::add_element
alias get_size = collections::StringArrayList::get_size
alias length = strings::length
alias trim = strings::trim_space

# Test basic function alias
string test_str = "  hello world  "
int len = length(test_str)
print "Length of '%s' is %d" | test_str, len

# Test function alias with trim
string trimmed = trim(test_str)
print "Trimmed: '%s'" | trimmed

# Test static method alias
collections::StringArrayList list = new collections::StringArrayList(10)
add_elem(list, "first")
add_elem(list, "second")
add_elem(list, "third")

int size = get_size(list)
print "List size: %d" | size

# Test that the original syntax still works
collections::StringArrayList::add_element(list, "fourth")
int new_size = collections::StringArrayList::get_size(list)
print "New list size: %d" | new_size
