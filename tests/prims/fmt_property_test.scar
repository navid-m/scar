class Person:
    init(string n, int a):
        string this.name = n
        int this.age = a
    
    fn print_info() -> void:
        print "%s" | fmt!("Name: %s, Age: %d", this.name, this.age)
        print "%s" | fmt!("Person: %s is %d years old", this.name, this.age)

var person = new Person("Alice", 30)
person.print_info()
