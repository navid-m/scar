class MyClass:
    init:
        pass

macro Hello(x, y):
    x = new y()

macro Swap(a, b, type):
    type temp = a
    a = b
    b = temp

ref MyClass obj = nil
Hello(obj, MyClass)

int a = 10
int b = 20

print "Before swap: a= %d b=%d" | a, b

Swap(a, b, int)

print "After swap: a= %d b=%d" | a, b
