import "../test_modules/macros"

class TestClass:
    init():
        this.value = 42
    
    int value

fn test_pub_macros():
    print "Testing public macros..."
    macros::CreateObject(obj, TestClass)
    print "Object created successfully"
    
    macros::InitArray(int, numbers, 5, 0)
    print "Array initialized with size: %d" | len(numbers)
    
    int test_var = 123
    macros::DebugPrint(test_var)
    
    ref TestClass safe_obj = nil
    ref TestClass source_obj = new TestClass()
    print "Testing safe assignment..."
    macros::SafeAssign(safe_obj, source_obj)
    print "Safe assignment completed"
    
test_pub_macros()
