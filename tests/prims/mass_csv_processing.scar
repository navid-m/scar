import "std/csv"
import "std/io"
import "std/strings"
import "std/os"
import "std/math"

string filename = "yellow_tripdata.csv"

print "Reading CSV..."

ref csv::CSVIter iter = new csv::CSVIter(filename)

ref csv::CSVRow header = iter.next()
if header == nil:
    print "No rows in CSV"
    os::exit(1)

i32 num_cols = csv::CSVRow::get_field_count(header)
i32 col_PULocationID = -1
i32 col_long = -1
i32 col_lat = -1

for i = 0 to num_cols - 1:
    string col_name = csv::CSVRow::get_field(header, i)
    if strings::equal(col_name, "PULocationID"):
        col_PULocationID = i
    elif strings::equal(col_name, "pickup_longitude"):
        col_long = i
    elif strings::equal(col_name, "pickup_latitude"):
        col_lat = i

i32 cnt_Manhattan = 0
i32 cnt_Bronx = 0
i32 cnt_Brooklyn = 0
i32 cnt_Queens = 0
i32 cnt_StatenIsland = 0
i32 cnt_Unknown = 0
i32 cnt_West = 0
i32 cnt_East = 0

make lock counts_lock

ref csv::CSVRow row = new csv::CSVRow()

while true:
    row = iter.next()
    if row == nil:
        break

    if col_PULocationID != -1 and col_PULocationID < csv::CSVRow::get_field_count(row):
        string value = csv::CSVRow::get_field(row, col_PULocationID)

        if strings::equal(value, "1"):
            lock counts_lock:
                cnt_Manhattan = cnt_Manhattan + 1
        elif strings::equal(value, "2"):
            lock counts_lock:
                cnt_Bronx = cnt_Bronx + 1
        elif strings::equal(value, "3"):
            lock counts_lock:
                cnt_Brooklyn = cnt_Brooklyn + 1
        elif strings::equal(value, "4"):
            lock counts_lock:
                cnt_Queens = cnt_Queens + 1
        elif strings::equal(value, "5"):
            lock counts_lock:
                cnt_StatenIsland = cnt_StatenIsland + 1
        else:
            lock counts_lock:
                cnt_Unknown = cnt_Unknown + 1

    elif col_long != -1 && col_lat != -1 and col_long < csv::CSVRow::get_field_count(row):
        string val_long = csv::CSVRow::get_field(row, col_long)
        double lon = math::to_double(val_long)
        if lon < -73.95:
            lock counts_lock:
                cnt_West = cnt_West + 1
        else:
            lock counts_lock:
                cnt_East = cnt_East + 1


print "Results:"
if col_PULocationID != -1:
    print "%s" | fmt!("Manhattan : %d", cnt_Manhattan)
    print "%s" | fmt!("Bronx : %d", cnt_Bronx)
    print "%s" | fmt!("Brooklyn : %d", cnt_Brooklyn)
    print "%s" | fmt!("Queens : %d", cnt_Queens)
    print "%s" | fmt!("Staten Island : %d", cnt_StatenIsland)
    print "%s" | fmt!("Unknown : %d", cnt_Unknown)
else:
    print "%s" | fmt!("West : %d", cnt_West)
    print "%s" | fmt!("East : %d", cnt_East)

drop lock counts_lock
