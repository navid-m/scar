struct InnerMetaData:
    cstring data

pub struct Vector2:
    InnerMetaData inner
    int x
    int y

pub struct Stuff:
    cstring stuff_name
    Vector2 vec

var stuff = Stuff()

stuff:stuff_name = "test"
stuff:vec:x = 10
stuff:vec:y = 20
stuff:vec:inner = InnerMetaData()
stuff:vec:inner:data = "testing inner inner data"

print "name: %s" | stuff:stuff_name
print "x: %d, y: %d" | stuff:vec:x, stuff:vec:y
print "inner data: %s" | stuff:vec:inner:data
