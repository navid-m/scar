import "std/csv"
import "std/io"
import "std/strings"
import "std/collections"
import "std/os"

string filename = "hi.csv"

ref csv::CSV doc = csv::read_file(filename)
int num_rows = csv::CSV::get_row_count(doc)

if num_rows == 0:
    print "No rows in CSV"
    os::exit(1)

int num_cols = 0
for i = 0 to num_rows - 1:
    ref csv::CSVRow row = csv::CSV::get_row(doc, i)
    int fc = csv::CSVRow::get_field_count(row)
    if fc > num_cols:
        num_cols = fc

collections::ArrayList widths = new collections::ArrayList(num_cols)
for i = 0 to num_cols - 1:
    widths.add_element(0)

for i = 0 to num_rows - 1:
    ref csv::CSVRow row = csv::CSV::get_row(doc, i)
    for j = 0 to num_cols - 1:
        if j < csv::CSVRow::get_field_count(row):
            string field = csv::CSVRow::get_field(row, j)
            int len = strings::length(field)
            int current_max = widths.get_element(j)
            if len > current_max:
                widths.set_element(j, len)

for i = 0 to num_rows - 1:
    ref csv::CSVRow row = csv::CSV::get_row(doc, i)
    string line = ""
    for j = 0 to num_cols - 1:
        string field = ""
        if j < csv::CSVRow::get_field_count(row):
            field = csv::CSVRow::get_field(row, j)
        int pad = widths.get_element(j) - strings::length(field)
        string padded = field
        for p = 0 to pad - 1:
            padded = fmt!("%s ", padded)
        if j < num_cols - 1:
            line = fmt!("%s%s | ", line, padded)
        else:
            line = fmt!("%s%s", line, padded)
    print "%s" | line
