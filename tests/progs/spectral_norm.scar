import "std/os"
import "std/math"

fn A(int i, int j) -> f64:
    return (f64)((i + j) * (i + j + 1) / 2 + i + 1)

fn dot(ref f64 v, ref f64 u, int n) -> f64:
    f64 sum = 0.0
    for i = 0 to (n - 1):
        sum = sum + v[i] * u[i]
    return sum

fn mult_Av(ref f64 v, ref f64 outv, int n) -> void:
    for i = 0 to (n - 1):
        f64 sum = 0.0
        for j = 0 to (n - 1):
            sum = sum + v[j] / A(i, j)
        outv[i] = sum

fn mult_Atv(ref f64 v, ref f64 outv, int n) -> void:
    for i = 0 to (n - 1):
        f64 sum = 0.0
        for j = 0 to (n - 1):
            sum = sum + v[j] / A(j, i)
        outv[i] = sum

fn mult_AtAv(ref f64 v, ref f64 outv, int n) -> void:
    allocate f64 tmp = n
    mult_Av(v, tmp, n)
    mult_Atv(tmp, outv, n)

int n = 100
list[string] args = os::get_args()
if len(args) > 1:
    n = math::to_int(args[1])

allocate f64 u = n
allocate f64 v = n

for i = 0 to (n - 1):
    u[i] = 1.0

parallel for i = 0 to 9:
    mult_AtAv(u, v, n)
    mult_AtAv(v, u, n)

f64 result = math::sqrt(dot(u, v, n) / dot(v, v, n))
print "%.9f" | result
