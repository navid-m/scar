# Min-Heap implementation in Scar
# A complete binary tree where each parent node is smaller than its children

class Heap:
    init:
        int this.capacity = 10
        int this.size = 0
        ref int this.data = nil
        $raw (
            this->data = malloc(this->capacity * sizeof(int));
        )

    # Set capacity and initialize data array
    fn set_capacity(int max_capacity):
        this.capacity = max_capacity
        this.size = 0
        $raw (
            this->data = malloc(this->capacity * sizeof(int));
        )

    # Get parent index for node at index i
    fn parent(int i) -> int:
        return (i - 1) / 2

    # Get left child index for node at index i
    fn left_child(int i) -> int:
        return 2 * i + 1

    # Get right child index for node at index i
    fn right_child(int i) -> int:
        return 2 * i + 2

    # Check if heap is empty
    fn is_empty() -> bool:
        return this.size == 0

    fn is_full() -> bool:
        return this.size == this.capacity

    fn get_size() -> int:
        return this.size

    fn peek() -> int:
        if this.is_empty():
            print "Error: Heap is empty"
            return -1
        return this.data[0]

    fn swap(int i, int j):
        int temp = this.data[i]
        this.data[i] = this.data[j]
        this.data[j] = temp

    fn heapify_up(int index):
        if index == 0:
            return
        
        int parent_idx = this.parent(index)
        if this.data[index] < this.data[parent_idx]:
            this.swap(index, parent_idx)
            this.heapify_up(parent_idx)

    fn heapify_down(int index):
        int left_idx = this.left_child(index)
        int right_idx = this.right_child(index)
        int smallest = index

        if left_idx < this.size && this.data[left_idx] < this.data[smallest]:
            smallest = left_idx

        if right_idx < this.size && this.data[right_idx] < this.data[smallest]:
            smallest = right_idx

        if smallest != index:
            this.swap(index, smallest)
            this.heapify_down(smallest)

    fn insert(int value):
        if this.is_full():
            print "Error: Heap is full, cannot insert %d" | value
            return

        this.data[this.size] = value
        this.heapify_up(this.size)
        this.size = this.size + 1
        print "Inserted %d into heap" | value

    fn extract_min() -> int:
        if this.is_empty():
            print "Error: Heap is empty"
            return -1

        int min_value = this.data[0]
        
        this.size = this.size - 1
        this.data[0] = this.data[this.size]
        this.heapify_down(0)

        print "Extracted minimum: %d" | min_value
        return min_value

    fn build_heap(ref int arr, int n):
        if n > this.capacity:
            print "Error: Array size exceeds heap capacity"
            return

        for int i = 0; i < n; i++:
            this.data[i] = arr[i]
        
        this.size = n

        int start = this.parent(n - 1)
        for int i = start; i >= 0; i--:
            this.heapify_down(i)

        print "Built heap from array of size %d" | n

    fn print_heap():
        if this.is_empty():
            print "Heap is empty"
            return

        print "Heap contents (size: %d):" | this.size
        for int i = 0; i < this.size; i++:
            print "Index %d: %d" | i, this.data[i]

    fn print_tree():
        if this.is_empty():
            print "Heap is empty"
            return

        print "Heap tree structure:"
        this.print_tree_recursive(0, 0)

    fn print_tree_recursive(int index, int depth):
        if index >= this.size:
            return

        int right_idx = this.right_child(index)
        if right_idx < this.size:
            this.print_tree_recursive(right_idx, depth + 1)

        for int i = 0; i < depth; i++:
            print "    "

        print "%d" | this.data[index]

        int left_idx = this.left_child(index)
        if left_idx < this.size:
            this.print_tree_recursive(left_idx, depth + 1)

    fn get_height() -> int:
        if this.is_empty():
            return 0
        
        int height = 0
        int temp = this.size
        while temp > 1:
            temp = temp / 2
            height = height + 1
        return height

    fn is_valid_heap() -> bool:
        for int i = 0; i < this.size; i++:
            int left_idx = this.left_child(i)
            int right_idx = this.right_child(i)

            if left_idx < this.size && this.data[i] > this.data[left_idx]:
                return false
            
            if right_idx < this.size && this.data[i] > this.data[right_idx]:
                return false

        return true

    fn heap_sort():
        int original_size = this.size        
        print "Heap sort result (ascending order):"
        while !this.is_empty():
            int min_val = this.extract_min()
            print "%d " | min_val

        print ""
        
print "=== Heap Data Structure Test ==="

Heap heap = new Heap()
heap.set_capacity(20)

print "\n1. Testing basic operations:"
print "Is empty: %s" | (heap.is_empty() ? "true" : "false")
print "Size: %d" | heap.get_size()

print "\n2. Inserting elements:"
heap.insert(10)
heap.insert(5)
heap.insert(15)
heap.insert(3)
heap.insert(8)
heap.insert(12)
heap.insert(20)
heap.insert(1)

print "\n3. Heap contents:"
heap.print_heap()

print "\n4. Heap tree visualization:"
heap.print_tree()

print "\n5. Heap properties:"
print "Size: %d" | heap.get_size()
print "Height: %d" | heap.get_height()
print "Minimum element: %d" | heap.peek()
print "Is valid heap: %s" | (heap.is_valid_heap() ? "true" : "false")

print "\n6. Extracting minimum elements:"
heap.extract_min()
heap.extract_min()
heap.extract_min()

print "\n7. Heap after extractions:"
heap.print_heap()
heap.print_tree()

print "\n8. Testing build_heap with array:"
Heap heap2 = new Heap()
heap2.set_capacity(15)
int arr[10] = {25, 12, 7, 6, 30, 17, 8, 2, 15, 9}
heap2.build_heap(arr, 10)
heap2.print_heap()

print "\n9. Heap sort demonstration:"
heap2.heap_sort()

print "\n=== Heap Test Complete ==="
