import "std/random"
import "std/math"
import "std/os"

fn compute_something(int seed, int length) -> i64:
    allocate i64 arr = length
    for i = 0 to (length - 1):
        arr[i] = (i64)((seed * i) ^ (seed + i)) % 1000003
    i64 sum = 0
    for i = 0 to (length - 1):
        sum = sum + arr[i]
    return sum

fn nested_parallel_test(int outer_n, int inner_n) -> void:
    i32 grand_sum = 0
    i64 grand_max = -9223372036854775807

    parallel for outer = 0 to (outer_n - 1) reduce(sum: grand_sum, max: grand_max):
        i64 local_seed = random::num(1, 99999)
        i64 local_sum = 0

        parallel for inner = 0 to (inner_n - 1) reduce(sum: local_sum):
            local_sum = local_sum + compute_something(local_seed + inner, 32)

        if local_sum > grand_max:
            grand_max = local_sum
        grand_sum = grand_sum + local_sum

    print "Nested parallel finished. Sum=%lld, Max=%lld" | grand_sum, grand_max

list[string] args = os::get_args()
int outer_n = 4
int inner_n = 8
if len(args) > 2:
    outer_n = math::to_int(args[1])
    inner_n = math::to_int(args[2])

nested_parallel_test(outer_n, inner_n)
