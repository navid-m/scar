import std/os
import std/math

class FannkuchOptimized:
    init:
        int this.n = 0
        ref int this.factorial_table = nil
        int this.maximum_flip_count = 0
        int this.checksum = 0

    fn compute_factorials() -> void:
        allocate int this.factorial_table = this.n + 1
        this.factorial_table[0] = 1
        for i = 1 to this.n:
            this.factorial_table[i] = i * this.factorial_table[i - 1]

    fn set_n(int value) -> void:
        this.n = value
        this.compute_factorials()

    fn process_block(int initial_permutation_index, int block_size) -> void:
        stallocate int local_count = this.n
        stallocate i8 local_temp_permutation = this.n
        stallocate i8 local_current_permutation = this.n
        
        int local_max_flip_count = 0
        int local_checksum = 0

        local_count[0] = 0
        for i = 0 to (this.n - 1):
            local_current_permutation[i] = i

        # Convert initial permutation index to factoradic
        int permutation_index = initial_permutation_index
        int i = this.n - 1
        while i > 0:
            int d = permutation_index / this.factorial_table[i]
            permutation_index = permutation_index % this.factorial_table[i]
            local_count[i] = d

            for j = 0 to (this.n - 1):
                local_temp_permutation[j] = local_current_permutation[j]
            for j = 0 to i:
                if (j + d) <= i:
                    local_current_permutation[j] = local_temp_permutation[j + d]
                else:
                    local_current_permutation[j] = local_temp_permutation[j + d - i - 1]
            
            i = i - 1

        int last_permutation_index = initial_permutation_index + block_size - 1
        int current_permutation_index = initial_permutation_index

        while true:
            if local_current_permutation[0] > 0:
                for i = 1 to (this.n - 1):
                    local_temp_permutation[i] = local_current_permutation[i]

                int flip_count = 1
                i8 first_value = local_current_permutation[0]

                while local_temp_permutation[first_value] > 0:
                    i8 new_first_value = local_temp_permutation[first_value]
                    local_temp_permutation[first_value] = first_value
                    if first_value > 2:
                        int low_index = 1
                        int high_index = first_value - 1
                        
                        while (low_index < high_index) and (low_index < 16):
                            i8 temp = local_temp_permutation[high_index]
                            local_temp_permutation[high_index] = local_temp_permutation[low_index]
                            local_temp_permutation[low_index] = temp
                            low_index = low_index + 1
                            high_index = high_index - 1

                    first_value = new_first_value
                    flip_count = flip_count + 1

                if current_permutation_index % 2 == 0:
                    local_checksum = local_checksum + flip_count
                else:
                    local_checksum = local_checksum - flip_count

                if flip_count > local_max_flip_count:
                    local_max_flip_count = flip_count

            if current_permutation_index >= last_permutation_index:
                break

            i8 first_value = local_current_permutation[1]
            local_current_permutation[1] = local_current_permutation[0]
            local_current_permutation[0] = first_value

            int i = 1
            while true:
                local_count[i] = local_count[i] + 1
                if local_count[i] <= i:
                    break
                
                local_count[i] = 0
                i = i + 1
                
                i8 new_first_value = local_current_permutation[0]
                local_current_permutation[0] = local_current_permutation[1]

                for j = 1 to (i - 1):
                    local_current_permutation[j] = local_current_permutation[j + 1]

                local_current_permutation[i] = first_value
                first_value = new_first_value

            current_permutation_index = current_permutation_index + 1

        this.checksum = this.checksum + local_checksum
        if local_max_flip_count > this.maximum_flip_count:
            this.maximum_flip_count = local_max_flip_count

    fn run_fannkuch(int n_value) -> void:
        this.set_n(n_value)
        
        int preferred_blocks = 12
        int total_permutations = this.factorial_table[this.n]
        int block_size = total_permutations / preferred_blocks
        
        if total_permutations < preferred_blocks:
            block_size = total_permutations
        if block_size < 1:
            block_size = 1

        this.maximum_flip_count = 0
        this.checksum = 0

        int start_index = 0
        while start_index < total_permutations:
            int current_block_size = block_size
            if (start_index + block_size) > total_permutations:
                current_block_size = total_permutations - start_index
            
            this.process_block(start_index, current_block_size)
            start_index = start_index + block_size

        print "%d" | this.checksum
        print "Pfannkuchen(%d) = %d\n" | n_value, this.maximum_flip_count

list[string] args = os::get_args()

if len(args) < 2:
    print "Usage: fannkuch_optimized <n>"
    print "Where n is the size of the permutation (typically 7-12)"
else:
    int n = math::to_int(args[1])
    if n < 1:
        print "Error: n must be a positive integer"
    else:
        var fannkuch = new FannkuchOptimized()
        fannkuch.run_fannkuch(n)
