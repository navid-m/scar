import std/os
import std/math

fn fannkuch(int n) -> list[int]:
    allocate int p = n
    allocate int q = n
    allocate int s = n
    
    int sign = 1
    int maxflips = 0
    int sum = 0
    int m = n - 1
    
    for i = 0 to (n - 1):
        p[i] = i
        q[i] = i
        s[i] = i
    
    while true:
        int q0 = p[0]  # Cache 0th element
        if q0 != 0:
            for i = 1 to (n - 1):
                q[i] = p[i]
            
            int flips = 1
            while true:
                int qq = q[q0]
                if qq == 0:  
                    sum = sum + sign * flips
                    if flips > maxflips:
                        maxflips = flips 
                    break
                
                q[q0] = q0
                if q0 >= 3:
                    int i = 1
                    int j = q0 - 1
                    while i < j:
                        int t = q[i]
                        q[i] = q[j]
                        q[j] = t
                        i = i + 1
                        j = j - 1
                
                q0 = qq
                flips = flips + 1
        
        # Permute
        if sign == 1:
            int t = p[1]
            p[1] = p[0]
            p[0] = t
            sign = -1  
        else:
            int t = p[1]
            p[1] = p[2]
            p[2] = t
            sign = 1  # Rotate 0<-1 and 0<-1<-2
            
            for i = 2 to (n - 1):
                int sx = s[i]
                if sx != 0:
                    s[i] = sx - 1
                    break
                
                if i == m:
                    # Out of permutations - return results
                    list[int] result = [sum, maxflips]
                    free p
                    free q
                    free s
                    return result
                
                s[i] = i
                # Rotate 0<-...<-i+1
                t = p[0]
                for j = 0 to i:
                    p[j] = p[j + 1]
                p[i + 1] = t

list[string] args = os::get_args()

int n = 7
if len(args) > 1:
    n = math::to_int(args[1])

if n == 0:
    print "Pfannkuchen(0) = 0"
    return
if n == 1:
    print "Pfannkuchen(1) = 0"
    return
if n == 2:
    print "Pfannkuchen(2) = 1"
    return

list[int] pf = fannkuch(n)
print "%d" | pf[0]
print "Pfannkuchen(%d) = %d" | n, pf[1]
