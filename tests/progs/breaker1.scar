import "std/random"
import "std/math"

class Node:
    init(int val):
        this.val = val
        ref Node this.left = nil
        ref Node this.right = nil

    fn insert(int x):
        if x < this.val:
            if this.left == nil:
                this.left = new Node(x)
            else:
                this.left.insert(x)
        else:
            if this.right == nil:
                this.right = new Node(x)
            else:
                this.right.insert(x)

    fn sum() -> int:
        int s = this.val
        if this.left != nil:
            s = s + this.left.sum()
        if this.right != nil:
            s = s + this.right.sum()
        return s

fn generate_random_tree(int n) -> ref Node:
    if n <= 0:
        return nil
    ref Node root = new Node(random::num(0, 1000))
    int ignored_sum = 0
    parallel for i = 1 to (n - 1) reduce(+: ignored_sum):
        int val = random::num(0, 1000)
        root.insert(val)
        # sum discarded to focus on insert parallelism, but included for reduce syntax
        ignored_sum = ignored_sum + val
    return root

fn compute_tree_sum(ref Node root) -> int:
    if root == nil:
        return 0
    return root.sum()

fn fibonacci(int n) -> int:
    if n <= 1:
        return n
    return fibonacci(n - 1) + fibonacci(n - 2)

fn recursive_reduction_test(int n) -> int:
    int result = 0
    parallel for i = 1 to n reduce(+: result):
        int fib_val = fibonacci(i % 10)
        # Add a little jitter to test concurrency
        if random::num(0, 20) == 0:
            sleep 0.001
        result = result + fib_val
    return result

fn aliasing_test():
    allocate int arr = 10
    for i = 0 to 9:
        arr[i] = i * i

    ref int alias = arr
    for i = 0 to 9:
        alias[i] = alias[i] + 1

    int total = 0
    for i = 0 to 9:
        total = total + arr[i]

    print "Aliasing total: %d" | total

fn dynamic_allocation_stress(int n):
    allocate ref Node nodes = n
    for i = 0 to (n - 1):
        ref Node newNode = new Node(i)
        nodes[i] = newNode
    parallel for i = 0 to (n - 1):
        if i % 2 == 0:
            ref Node node = nodes[i]
            node.val = node.val * 2
        else:
            ref Node node = nodes[i]
            node.val = node.val * 3

    int sum = 0
    for i = 0 to (n - 1):
        ref Node node = nodes[i]
        sum = sum + node.val

    print "Dynamic allocation sum: %d" | sum

ref Node tree = generate_random_tree(50)
int tree_sum = compute_tree_sum(tree)
print "Tree sum (recursive insertions): %d" | tree_sum

int fib_sum = recursive_reduction_test(15)
print "Fibonacci sum with parallel reduction: %d" | fib_sum

aliasing_test()

dynamic_allocation_stress(1000)
