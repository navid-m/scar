class TreeNode:
    init:
        ref TreeNode this.left = nil
        ref TreeNode this.right = nil
    
    stat fn test_method(int depth) -> ref TreeNode:
        if depth > 0:
            ref TreeNode left_child = TreeNode::test_method(depth - 1)
            ref TreeNode right_child = TreeNode::test_method(depth - 1)
            var node = new TreeNode()
            return node
        else:
            return new TreeNode()

print "starting test"
ref TreeNode test = TreeNode::test_method(2)
print "test complete"
