import "std/os"
import "std/math"

int iterations = 50
f64 depth = 4.0

list[string] args = os::get_args()
int width = 100
if len(args) > 1:
    width = math::to_int(args[1])

int height = width
f64 start_x = -1.5
f64 start_i = -1.0
f64 end_x = 0.5
f64 end_i = 1.0
int line_count = height
int line_size = (width + 7) / 8
f64 pixel_height = math::absolute(end_x - start_x) / (f64)(height)
f64 pixel_width = math::absolute(end_i - start_i) / (f64)(width)
f64 pixel_width_8 = pixel_width * 8.0

int output_size = line_count * line_size
allocate u8 pixel_buffer = output_size
f64 ci_0 = start_i
allocate f64 cr_array = line_size * 8  

for x = 0 to (line_size - 1):
    for i = 0 to 7:
        int idx = x * 8 + i
        cr_array[idx] = start_x + (f64)(x * 8 + i) * pixel_width

for y = 0 to (line_count - 1):
    f64 ci = ci_0 + (f64)(y) * pixel_height
    
    for x = 0 to (line_size - 1):
        u8 pixel = 0
        
        for bit = 0 to 7:
            int cr_idx = x * 8 + bit
            if cr_idx < width:
                f64 cr = cr_array[cr_idx]
                f32 zr = 0.0
                f32 zi = 0.0
                f32 tr = 0.0
                f32 ti = 0.0
                
                bool escaped = false
                
                for iter = 0 to (iterations - 1):
                    zi = 2.0 * zr * zi + ci
                    zr = tr - ti + cr
                    tr = zr * zr
                    ti = zi * zi
                    
                    if tr + ti >= depth:
                        escaped = true
                        break
                
                if not escaped:
                    u8 bit_value = (u8)(1 b_lshift (7 - bit))
                    pixel = (u8)(pixel b_or bit_value)
        
        pixel_buffer[y * line_size + x] = pixel

print "P4"
print "%d %d" | width, height

for i = 0 to (output_size - 1):
    print "%d" | pixel_buffer[i]
