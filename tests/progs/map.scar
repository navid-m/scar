import "std/random"

class SomeCustomType:
    init:
        i32 this.x = random::num(0, 100)
        print "%d" | this.x
        pass

var sct = new SomeCustomType()
map[string: string] some_map = []

put!(some_map, "key1", "value1")
put!(some_map, "key2", "value2")

print "%s" | get!(some_map, "key1")

map[string: SomeCustomType] custom_map = []
var to_add = new SomeCustomType()
put!(custom_map, "custom_key", to_add)
print "%d" | get!(custom_map, "custom_key").x
