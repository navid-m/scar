import "std/random"

class Node:
    init(int val):
        this.val = val
        ref Node this.left = nil
        ref Node this.right = nil

    fn insert(int x):
        if x == this.val:
            return
        elif x < this.val:
            if this.left == nil:
                this.left = new Node(x)
            else:
                this.left.insert(x)
        else:
            if this.right == nil:
                this.right = new Node(x)
            else:
                this.right.insert(x)

    fn find(int x) -> bool:
        if this == nil:
            return false
        if x == this.val:
            return true
        elif x < this.val:
            if this.left == nil:
                return false
            else:
                return this.left.find(x)
        else:
            if this.right == nil:
                return false
            else:
                return this.right.find(x)

fn generate_balanced_tree(int n) -> ref Node:
    if n <= 0:
        return nil
    ref Node root = new Node(n / 2)
    parallel for i = 0 to (n - 1):
        if i != n / 2:
            root.insert(i)
    return root

fn parallel_search_test(int n, int target) -> bool:
    ref Node tree = generate_balanced_tree(n)
    bool found = false

    parallel for i = 0 to (n - 1):
        if i == target:
            if tree.find(i):
                found = true
    return found

int n = 1000
int target = 777
bool is_found = parallel_search_test(n, target)
if is_found:
    print "Target %d found in tree!" | target
else:
    print "Target %d NOT found." | target


