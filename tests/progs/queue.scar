# Queue (FIFO - First In, First Out) implementation in Scar
# A linear data structure where elements are added at the rear and removed from the front

class Queue:
    init:
        int this.capacity = 10
        int this.size = 0
        int this.front = 0
        int this.rear = 0
        ref int this.data = nil
        allocate int this.data = this.capacity

    # Set capacity and initialize data array
    fn set_capacity(int max_capacity):
        if this.data != nil:
            free this.data
        this.capacity = max_capacity
        this.size = 0
        this.front = 0
        this.rear = 0
        allocate int this.data = this.capacity

    # Check if queue is empty
    fn is_empty() -> bool:
        return this.size == 0

    # Check if queue is full
    fn is_full() -> bool:
        return this.size == this.capacity

    # Get current size of queue
    fn get_size() -> int:
        return this.size

    # Get maximum capacity of queue
    fn get_capacity() -> int:
        return this.capacity

    # Peek at the front element without removing it
    fn peek_front() -> int:
        if this.is_empty():
            print "Error: Queue is empty, cannot peek front"
            return -1
        return this.data[this.front]

    # Peek at the rear element without removing it
    fn peek_rear() -> int:
        if this.is_empty():
            print "Error: Queue is empty, cannot peek rear"
            return -1
        int rear_index = (this.rear - 1 + this.capacity) % this.capacity
        return this.data[rear_index]

    # Enqueue (add) an element to the rear of the queue
    fn enqueue(int value):
        if this.is_full():
            print "Error: Queue is full, cannot enqueue %d" | value
            return

        this.data[this.rear] = value
        this.rear = (this.rear + 1) % this.capacity
        this.size = this.size + 1
        print "Enqueued %d to queue" | value

    # Dequeue (remove) an element from the front of the queue
    fn dequeue() -> int:
        if this.is_empty():
            print "Error: Queue is empty, cannot dequeue"
            return -1

        int dequeued_value = this.data[this.front]
        this.front = (this.front + 1) % this.capacity
        this.size = this.size - 1
        print "Dequeued %d from queue" | dequeued_value
        return dequeued_value

    # Clear all elements from the queue
    fn clear():
        this.size = 0
        this.front = 0
        this.rear = 0
        print "Queue cleared"

    # Print all elements in the queue (front to rear)
    fn print_queue():
        if this.is_empty():
            print "Queue is empty"
            return

        print "Queue contents (front to rear, size: %d):" | this.size
        int current = this.front
        for int i = 0; i < this.size; i++:
            if i == 0:
                print "Front -> %d" | this.data[current]
            elif i == this.size - 1:
                print "Rear  -> %d" | this.data[current]
            else:
                print "         %d" | this.data[current]
            current = (current + 1) % this.capacity

    # Print queue indices for debugging
    fn print_debug_info():
        print "Debug Info - Front: %d, Rear: %d, Size: %d, Capacity: %d" | this.front, this.rear, this.size, this.capacity

    # Search for an element in the queue (returns position from front, -1 if not found)
    fn search(int value) -> int:
        int current = this.front
        for int i = 0; i < this.size; i++:
            if this.data[current] == value:
                print "Found %d at position %d from front" | value, i
                return i
            current = (current + 1) % this.capacity

        print "Value %d not found in queue" | value
        return -1

    # Check if queue contains a specific value
    fn contains(int value) -> bool:
        int current = this.front
        for int i = 0; i < this.size; i++:
            if this.data[current] == value:
                return true
            current = (current + 1) % this.capacity
        return false

    # Get element at specific position from front (0 = front element)
    fn get_at_position(int position) -> int:
        if position < 0 || position >= this.size:
            print "Error: Position %d out of bounds (size: %d)" | position, this.size
            return -1
        
        int index = (this.front + position) % this.capacity
        return this.data[index]

    # Copy elements from another queue
    fn copy_from(ref Queue other):
        if other.size > this.capacity:
            this.resize(other.size)

        this.clear()
        int current = other.front
        for int i = 0; i < other.size; i++:
            this.enqueue(other.data[current])
            current = (current + 1) % other.capacity

        print "Copied %d elements from another queue" | other.size

    # Resize the queue capacity (preserves existing elements)
    fn resize(int new_capacity):
        if new_capacity < this.size:
            print "Error: New capacity %d is smaller than current size %d" | new_capacity, this.size
            return

        allocate int new_data = new_capacity
        int current = this.front
        for int i = 0; i < this.size; i++:
            new_data[i] = this.data[current]
            current = (current + 1) % this.capacity
        
        free this.data
        this.data = new_data
        this.front = 0
        this.rear = this.size
        this.capacity = new_capacity
        print "Resized queue capacity to %d" | new_capacity

    # Reverse the order of elements in the queue
    fn reverse():
        if this.size <= 1:
            return

        allocate int temp_array = this.size
        int current = this.front
        for int i = 0; i < this.size; i++:
            temp_array[i] = this.data[current]
            current = (current + 1) % this.capacity

        for int i = 0; i < this.size; i++:
            this.data[(this.front + i) % this.capacity] = temp_array[this.size - 1 - i]

        free temp_array

        print "Queue reversed"

    # Get sum of all elements in queue
    fn sum() -> int:
        int total = 0
        int current = this.front
        for int i = 0; i < this.size; i++:
            total = total + this.data[current]
            current = (current + 1) % this.capacity
        return total

    # Get minimum element in queue
    fn min() -> int:
        if this.is_empty():
            print "Error: Queue is empty"
            return -1

        int minimum = this.data[this.front]
        int current = this.front
        for int i = 0; i < this.size; i++:
            if this.data[current] < minimum:
                minimum = this.data[current]
            current = (current + 1) % this.capacity
        return minimum

    # Get maximum element in queue
    fn max() -> int:
        if this.is_empty():
            print "Error: Queue is empty"
            return -1

        int maximum = this.data[this.front]
        int current = this.front
        for int i = 0; i < this.size; i++:
            if this.data[current] > maximum:
                maximum = this.data[current]
            current = (current + 1) % this.capacity
        return maximum

    # Convert queue to array (returns elements in front-to-rear order)
    fn to_array() -> ref int:
        if this.is_empty():
            print "Error: Queue is empty, cannot convert to array"
            return nil

        allocate int result = this.size
        int current = this.front
        for int i = 0; i < this.size; i++:
            result[i] = this.data[current]
            current = (current + 1) % this.capacity
        return result

# Demonstration and testing of the Queue data structure

print "=== Queue Data Structure Test ==="

Queue queue = new Queue()
queue.set_capacity(12)

print "\n1. Testing basic operations:"
print "Is empty: %s" | (queue.is_empty() ? "true" : "false")
print "Size: %d" | queue.get_size()
print "Capacity: %d" | queue.get_capacity()

print "\n2. Enqueuing elements:"
queue.enqueue(10)
queue.enqueue(20)
queue.enqueue(30)
queue.enqueue(40)
queue.enqueue(50)

print "\n3. Queue contents:"
queue.print_queue()
queue.print_debug_info()

print "\n4. Peek operations:"
print "Front element: %d" | queue.peek_front()
print "Rear element: %d" | queue.peek_rear()
print "Size after peek: %d" | queue.get_size()

print "\n5. Dequeue operations:"
int dequeued1 = queue.dequeue()
int dequeued2 = queue.dequeue()
print "After dequeuing two elements:"
queue.print_queue()

print "\n6. Search operations:"
queue.search(30)
queue.search(100)
print "Contains 40: %s" | (queue.contains(40) ? "true" : "false")
print "Contains 10: %s" | (queue.contains(10) ? "true" : "false")

print "\n7. Queue statistics:"
print "Sum of elements: %d" | queue.sum()
print "Minimum element: %d" | queue.min()
print "Maximum element: %d" | queue.max()

print "\n8. Adding more elements (testing circular behavior):"
queue.enqueue(60)
queue.enqueue(70)
queue.enqueue(80)
queue.enqueue(90)
queue.print_queue()
queue.print_debug_info()

print "\n9. Testing queue wrapping:"
queue.dequeue()
queue.dequeue()
queue.enqueue(100)
queue.enqueue(110)
queue.print_queue()
queue.print_debug_info()

print "\n10. Reverse operation:"
queue.reverse()
queue.print_queue()

print "\n11. Testing queue copy:"
Queue queue2 = new Queue()
queue2.set_capacity(15)
queue2.copy_from(queue)
print "Original queue:"
queue.print_queue()
print "Copied queue:"
queue2.print_queue()

print "\n12. Testing resize:"
queue.resize(20)
print "After resize, capacity: %d" | queue.get_capacity()
queue.print_debug_info()

print "\n13. Filling queue to test full condition:"
for int i = 0; i < 8; i++:
    queue.enqueue(i * 5)

print "Queue after filling:"
queue.print_queue()

print "\n14. Testing clear operation:"
queue.clear()
print "After clear:"
queue.print_queue()
print "Is empty: %s" | (queue.is_empty() ? "true" : "false")

print "\n15. Testing edge cases:"
queue.dequeue()     # Dequeue from empty queue
queue.peek_front()  # Peek empty queue front
queue.peek_rear()   # Peek empty queue rear
queue.search(99)    # Search in empty queue

print "\n16. Testing position access:"
queue.enqueue(100)
queue.enqueue(200)
queue.enqueue(300)
print "Element at position 0: %d" | queue.get_at_position(0)
print "Element at position 1: %d" | queue.get_at_position(1)
print "Element at position 2: %d" | queue.get_at_position(2)

print "\n=== Queue Test Complete ==="
