import "std/net"
import "std/strings"
import "std/log"
import "std/os"

# Basic HTTP server example using std/net
#
# Routes:
#   - GET /             -> HTML hello
#   - GET /json         -> JSON payload
#   - All other paths   -> 404

i32 port = 8080

log::success(fmt!("Starting Scar HTTP server on port %d", port))

if !net::socket_init():
    log::error("Socket initialization failed")
    os::exit(1)

net::TcpServer server = net::tcp_server_create(port)
if server.socket_fd < 0:
    log::error(fmt!("Failed to create TCP server on port %d", port))
    net::socket_cleanup()
    os::exit(1)

if !net::tcp_server_listen(server):
    log::error("Failed to listen on server socket")
    net::tcp_server_close(server)
    net::socket_cleanup()
    os::exit(1)

log::success(fmt!("Listening at http://localhost:%d", port))

while true:
    net::TcpConnection conn = net::tcp_server_accept(server)
    if conn.socket_fd < 0:
        continue

    lstring raw = net::tcp_receive(conn, 8192)
    net::HttpRequest req = net::http_parse_request(raw)

    if strings::compare(req.path, "/") == 0:
        net::http_html_response(conn, "<html><body><h1>Hello from Scar HTTP server</h1><p>Try <a href=\"/json\">/json</a></p></body></html>")
    elif strings::compare(req.path, "/json") == 0:
        net::http_json_response(conn, "{\"ok\":true,\"message\":\"Hello JSON\"}")
    else:
        string body = "Not Found"
        string resp = fmt!("HTTP/1.1 404 Not Found\r\nContent-Type: text/plain\r\nContent-Length: %d\r\nConnection: close\r\n\r\n%s", strings::length(body), body)
        net::tcp_send(conn, resp)

    net::tcp_close(conn)

net::tcp_server_close(server)
net::socket_cleanup()
