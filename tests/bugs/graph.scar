# Graph implementation in Scar using adjacency list representation
# Supports both directed and undirected graphs with vertex and edge management

# Node to represent vertices in the adjacency list
pub class GraphNode:
    init(int vertex_id):
        int this.vertex = vertex_id
        ref GraphNode this.next = nil

# Edge to represent graph edges with weights (for weighted graphs)
pub class Edge:
    init(int from, int to, int weight):
        int this.from = from
        int this.to = to
        int this.weight = weight

# Main Graph class using adjacency list representation
pub class Graph:
    init(int max_vertices, bool is_directed):
        int this.max_vertices = max_vertices
        bool this.is_directed = is_directed
        int this.vertex_count = 0
        int this.edge_count = 0
        
        # Adjacency list - array of pointers to GraphNode
        ref ref GraphNode this.adj_list = nil
        allocate ref GraphNode this.adj_list = this.max_vertices
        
        # Vertex labels/values
        ref int this.vertices = nil
        allocate int this.vertices = this.max_vertices
        
        # Initialize adjacency list to nil
        for int i = 0; i < this.max_vertices; i++:
            this.adj_list[i] = nil
            this.vertices[i] = -1  # -1 indicates unused vertex

    # Add a vertex to the graph
    fn add_vertex(int vertex_id) -> bool:
        if vertex_id < 0 || vertex_id >= this.max_vertices:
            print "Error: Vertex ID %d out of bounds (0-%d)" | vertex_id, this.max_vertices - 1
            return false
        
        if this.vertices[vertex_id] != -1:
            print "Warning: Vertex %d already exists" | vertex_id
            return false
        
        this.vertices[vertex_id] = vertex_id
        this.vertex_count = this.vertex_count + 1
        print "Added vertex %d" | vertex_id
        return true

    # Remove a vertex and all its edges
    fn remove_vertex(int vertex_id) -> bool:
        if vertex_id < 0 || vertex_id >= this.max_vertices:
            print "Error: Vertex ID %d out of bounds" | vertex_id
            return false
        
        if this.vertices[vertex_id] == -1:
            print "Error: Vertex %d does not exist" | vertex_id
            return false
        
        # Remove all edges from this vertex
        ref GraphNode current = this.adj_list[vertex_id]
        while current != nil:
            ref GraphNode temp = current
            current = current.next
            free temp
            this.edge_count = this.edge_count - 1
        this.adj_list[vertex_id] = nil
        
        # Remove all edges to this vertex
        for int i = 0; i < this.max_vertices; i++:
            if this.vertices[i] != -1 && i != vertex_id:
                this.remove_edge_from_list(i, vertex_id)
        
        this.vertices[vertex_id] = -1
        this.vertex_count = this.vertex_count - 1
        print "Removed vertex %d" | vertex_id
        return true

    # Helper function to remove a specific edge from adjacency list
    fn remove_edge_from_list(int from, int to) -> void:
        if this.adj_list[from] == nil:
            return
        
        # If first node is the target
        if this.adj_list[from].vertex == to:
            ref GraphNode temp = this.adj_list[from]
            this.adj_list[from] = this.adj_list[from].next
            free temp
            this.edge_count = this.edge_count - 1
            return
        
        # Search for the target node
        ref GraphNode current = this.adj_list[from]
        while current.next != nil && current.next.vertex != to:
            current = current.next
        
        if current.next != nil:
            ref GraphNode temp = current.next
            current.next = current.next.next
            free temp
            this.edge_count = this.edge_count - 1

    # Add an edge between two vertices
    fn add_edge(int from, int to) -> bool:
        if from < 0 || from >= this.max_vertices || to < 0 || to >= this.max_vertices:
            print "Error: Invalid vertex IDs (%d, %d)" | from, to
            return false
        
        if this.vertices[from] == -1 || this.vertices[to] == -1:
            print "Error: One or both vertices (%d, %d) do not exist" | from, to
            return false
        
        if this.has_edge(from, to):
            print "Warning: Edge from %d to %d already exists" | from, to
            return false
        
        # Add edge from -> to
        ref GraphNode new_node = new GraphNode(to)
        new_node.next = this.adj_list[from]
        this.adj_list[from] = new_node
        this.edge_count = this.edge_count + 1
        
        # If undirected, add reverse edge
        if !this.is_directed:
            ref GraphNode reverse_node = new GraphNode(from)
            reverse_node.next = this.adj_list[to]
            this.adj_list[to] = reverse_node
            # Don't increment edge_count for undirected since it's the same edge
        
        if this.is_directed:
            print "Added directed edge: %d -> %d" | from, to
        else:
            print "Added undirected edge: %d <-> %d" | from, to
        
        return true

    # Remove an edge between two vertices
    fn remove_edge(int from, int to) -> bool:
        if from < 0 || from >= this.max_vertices || to < 0 || to >= this.max_vertices:
            print "Error: Invalid vertex IDs (%d, %d)" | from, to
            return false
        
        if !this.has_edge(from, to):
            print "Error: Edge from %d to %d does not exist" | from, to
            return false
        
        # Remove edge from -> to
        this.remove_edge_from_list(from, to)
        
        # If undirected, remove reverse edge
        if !this.is_directed:
            this.remove_edge_from_list(to, from)
        
        if this.is_directed:
            print "Removed directed edge: %d -> %d" | from, to
        else:
            print "Removed undirected edge: %d <-> %d" | from, to
        
        return true

    # Check if an edge exists between two vertices
    fn has_edge(int from, int to) -> bool:
        if from < 0 || from >= this.max_vertices || to < 0 || to >= this.max_vertices:
            return false
        
        if this.vertices[from] == -1 || this.vertices[to] == -1:
            return false
        
        ref GraphNode current = this.adj_list[from]
        while current != nil:
            if current.vertex == to:
                return true
            current = current.next
        
        return false

    # Get the degree of a vertex (number of adjacent vertices)
    fn get_degree(int vertex_id) -> int:
        if vertex_id < 0 || vertex_id >= this.max_vertices:
            print "Error: Vertex ID %d out of bounds" | vertex_id
            return -1
        
        if this.vertices[vertex_id] == -1:
            print "Error: Vertex %d does not exist" | vertex_id
            return -1
        
        int degree = 0
        ref GraphNode current = this.adj_list[vertex_id]
        while current != nil:
            degree = degree + 1
            current = current.next
        
        return degree

    # Get all neighbors of a vertex
    fn get_neighbors(int vertex_id) -> void:
        if vertex_id < 0 || vertex_id >= this.max_vertices:
            print "Error: Vertex ID %d out of bounds" | vertex_id
            return
        
        if this.vertices[vertex_id] == -1:
            print "Error: Vertex %d does not exist" | vertex_id
            return
        
        print "Neighbors of vertex %d:" | vertex_id
        ref GraphNode current = this.adj_list[vertex_id]
        if current == nil:
            print "  (no neighbors)"
            return
        
        while current != nil:
            print "  -> %d" | current.vertex
            current = current.next

    # Depth-First Search traversal starting from a given vertex
    fn dfs(int start_vertex) -> void:
        if start_vertex < 0 || start_vertex >= this.max_vertices:
            print "Error: Start vertex %d out of bounds" | start_vertex
            return
        
        if this.vertices[start_vertex] == -1:
            print "Error: Start vertex %d does not exist" | start_vertex
            return
        
        print "DFS traversal starting from vertex %d:" | start_vertex
        
        # Create visited array
        ref bool visited = nil
        allocate bool visited = this.max_vertices
        for int i = 0; i < this.max_vertices; i++:
            visited[i] = false
        
        this.dfs_recursive(start_vertex, visited)
        print ""
        
        free visited

    # Recursive helper for DFS
    fn dfs_recursive(int vertex, ref bool visited) -> void:
        visited[vertex] = true
        print "%d " | vertex
        
        ref GraphNode current = this.adj_list[vertex]
        while current != nil:
            if !visited[current.vertex]:
                this.dfs_recursive(current.vertex, visited)
            current = current.next

    # Breadth-First Search traversal starting from a given vertex
    fn bfs(int start_vertex) -> void:
        if start_vertex < 0 || start_vertex >= this.max_vertices:
            print "Error: Start vertex %d out of bounds" | start_vertex
            return
        
        if this.vertices[start_vertex] == -1:
            print "Error: Start vertex %d does not exist" | start_vertex
            return
        
        print "BFS traversal starting from vertex %d:" | start_vertex
        
        # Create visited array and simple queue using array
        ref bool visited = nil
        allocate bool visited = this.max_vertices
        ref int queue = nil
        allocate int queue = this.max_vertices
        
        for int i = 0; i < this.max_vertices; i++:
            visited[i] = false
        
        int front = 0
        int rear = 0
        
        # Start BFS
        queue[rear] = start_vertex
        rear = rear + 1
        visited[start_vertex] = true
        
        while front < rear:
            int current_vertex = queue[front]
            front = front + 1
            print "%d " | current_vertex
            
            # Add all unvisited neighbors to queue
            ref GraphNode neighbor = this.adj_list[current_vertex]
            while neighbor != nil:
                if !visited[neighbor.vertex]:
                    visited[neighbor.vertex] = true
                    queue[rear] = neighbor.vertex
                    rear = rear + 1
                neighbor = neighbor.next
        
        print ""
        
        free visited
        free queue

    # Check if the graph is connected (for undirected graphs)
    fn is_connected() -> bool:
        if this.vertex_count == 0:
            return true
        
        # Find first existing vertex
        int start_vertex = -1
        for int i = 0; i < this.max_vertices; i++:
            if this.vertices[i] != -1:
                start_vertex = i
                break
        
        if start_vertex == -1:
            return true
        
        # Perform DFS and count reachable vertices
        ref bool visited = nil
        allocate bool visited = this.max_vertices
        for int i = 0; i < this.max_vertices; i++:
            visited[i] = false
        
        this.dfs_recursive(start_vertex, visited)
        
        # Check if all vertices were visited
        for int i = 0; i < this.max_vertices; i++:
            if this.vertices[i] != -1 && !visited[i]:
                free visited
                return false
        
        free visited
        return true

    # Print the entire graph
    fn print_graph() -> void:
        print "Graph Information:"
        print "  Type: %s" | (this.is_directed ? "Directed" : "Undirected")
        print "  Vertices: %d/%d" | this.vertex_count, this.max_vertices
        print "  Edges: %d" | this.edge_count
        print ""
        
        print "Adjacency List:"
        for int i = 0; i < this.max_vertices; i++:
            if this.vertices[i] != -1:
                print "  Vertex %d:" | i
                ref GraphNode current = this.adj_list[i]
                if current == nil:
                    print "    (no edges)"
                else:
                    while current != nil:
                        print "    -> %d" | current.vertex
                        current = current.next

    # Get basic statistics about the graph
    fn print_statistics() -> void:
        print "Graph Statistics:"
        print "  Total vertices: %d" | this.vertex_count
        print "  Total edges: %d" | this.edge_count
        print "  Graph type: %s" | (this.is_directed ? "Directed" : "Undirected")
        
        if this.vertex_count > 0:
            int min_degree = this.max_vertices + 1
            int max_degree = -1
            int total_degree = 0
            
            for int i = 0; i < this.max_vertices; i++:
                if this.vertices[i] != -1:
                    int degree = this.get_degree(i)
                    total_degree = total_degree + degree
                    if degree < min_degree:
                        min_degree = degree
                    if degree > max_degree:
                        max_degree = degree
            
            print "  Minimum degree: %d" | min_degree
            print "  Maximum degree: %d" | max_degree
            print "  Average degree: %d" | (total_degree / this.vertex_count)
        
        if !this.is_directed:
            if this.is_connected():
                print "  Connectivity: Connected"
            else:
                print "  Connectivity: Disconnected"

    # Cleanup function to free all allocated memory
    fn cleanup() -> void:
        # Free all adjacency list nodes
        for int i = 0; i < this.max_vertices; i++:
            ref GraphNode current = this.adj_list[i]
            while current != nil:
                ref GraphNode temp = current
                current = current.next
                free temp
        
        # Free the arrays
        if this.adj_list != nil:
            free this.adj_list
        if this.vertices != nil:
            free this.vertices
        
        print "Graph memory cleaned up"

# Test function to demonstrate graph functionality
fn test_graph() -> void:
    print "=== Graph Implementation Test ==="
    print ""
    
    # Create an undirected graph
    ref Graph g = new Graph(6, false)
    
    # Add vertices
    print "Adding vertices..."
    g.add_vertex(0)
    g.add_vertex(1)
    g.add_vertex(2)
    g.add_vertex(3)
    g.add_vertex(4)
    g.add_vertex(5)
    print ""
    
    # Add edges to create a sample graph
    print "Adding edges..."
    g.add_edge(0, 1)
    g.add_edge(0, 2)
    g.add_edge(1, 3)
    g.add_edge(2, 4)
    g.add_edge(3, 4)
    g.add_edge(4, 5)
    print ""
    
    # Print the graph
    g.print_graph()
    print ""
    
    # Test traversals
    g.dfs(0)
    g.bfs(0)
    print ""
    
    # Test degree calculations
    print "Vertex degrees:"
    for int i = 0; i < 6; i++:
        int degree = g.get_degree(i)
        print "  Vertex %d: degree %d" | i, degree
    print ""
    
    # Test neighbors
    g.get_neighbors(0)
    g.get_neighbors(4)
    print ""
    
    # Print statistics
    g.print_statistics()
    print ""
    
    # Test edge removal
    print "Removing edge 0-2..."
    g.remove_edge(0, 2)
    g.print_graph()
    print ""
    
    # Test vertex removal
    print "Removing vertex 5..."
    g.remove_vertex(5)
    g.print_graph()
    print ""
    
    # Final statistics
    g.print_statistics()
    
    # Cleanup
    g.cleanup()
    print ""
    print "=== Test Complete ==="

# Run the test
test_graph()
