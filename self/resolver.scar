val ast = use("ast")
val allocators = use("std/allocators")
val str = use("std/string")
val lxr = use("lexer")
val prs = use("parser")
val reflection = use("std/reflection")
val os = use("std/os")

def read_file(path ref(u8), arena ref(allocators.Arena)) ref(u8)
    val f ref(u8) = os.fopen(path, "rb")
    if f == none
        return none
    end
    os.fseek(f, 0 as i64, 2 as i32)
    val size i64 = os.ftell(f)
    os.fseek(f, 0 as i64, 0 as i32)
    if size <= 0 as i64
        os.fclose(f)
        return none
    end
    val buf_res = allocators.Arena.alloc(arena, size as usize + 1)
    var buf ref(u8) = none
    match buf_res
        ok m => buf = m as ref(u8)
        error _ => (
            os.fclose(f)
            return none
        )
    end
    os.fread(buf, 1 as usize, size as usize, f)
    @deref(@as_mut(@add(buf, size as usize))) = 0
    os.fclose(f)
    return buf
end

def get_dirname(path ref(u8), arena ref(allocators.Arena)) ref(u8)
    val plen usize = str.len(path)
    var last_sep usize = plen
    var i usize = 0
    for i < plen
        if @deref(@add(path, i)) == '/'
            last_sep = i
        end
        i++
    end
    if last_sep == plen
        val dot_res = allocators.Arena.alloc(arena, 2)
        var dot ref(u8) = none
        match dot_res
            ok m => dot = m as ref(u8)
            error _ => return "."
        end
        @deref(@as_mut(dot)) = '.'
        @deref(@as_mut(@add(dot, 1))) = 0
        return dot
    end
    val buf_res = allocators.Arena.alloc(arena, last_sep + 1)
    var buf ref(u8) = none
    match buf_res
        ok m => buf = m as ref(u8)
        error _ => return "."
    end
    @memcpy(buf, path, last_sep)
    @deref(@as_mut(@add(buf, last_sep))) = 0
    return buf
end

def path_exists(path ref(u8)) bool
    val f ref(u8) = os.fopen(path, "rb")
    if f == none
        return false
    end
    os.fclose(f)
    return true
end

def concat_path(a ref(u8), b ref(u8), arena ref(allocators.Arena)) ref(u8)
    val (
        alen usize = str.len(a)
        blen usize = str.len(b)
        total usize = alen + 1 + blen + 1
        buf_res = allocators.Arena.alloc(arena, total)
    )
    var buf ref(u8) = none
    match buf_res
        ok m => buf = m as ref(u8)
        error _ => return none
    end
    @memcpy(buf, a, alen)
    @deref(@as_mut(@add(buf, alen))) = '/'
    @memcpy(@add(buf, alen + 1), b, blen)
    @deref(@as_mut(@add(buf, alen + 1 + blen))) = 0
    return buf
end

def find_std_root(arena ref(allocators.Arena)) ref(u8)
    val cwd_buf_res = allocators.Arena.alloc(arena, 4096 as usize)
    var cwd_buf ref(u8) = none
    match cwd_buf_res
        ok m => cwd_buf = m as ref(u8)
        error _ => return none
    end
    val cwd_result ref(u8) = os.getcwd(cwd_buf, 4096 as usize)
    if cwd_result != none
        val local_std ref(u8) = concat_path(cwd_buf, "lib/std", arena)
        if local_std != none
            val check_file ref(u8) = concat_path(local_std, "string/mod.scar", arena)
            if check_file != none && path_exists(check_file)
                return local_std
            end
        end
    end
    val home ref(u8) = os.getenv("HOME")
    if home != none
        val home_std ref(u8) = concat_path(home, ".scar/lib/std", arena)
        if home_std != none
            val check_file ref(u8) = concat_path(home_std, "string/mod.scar", arena)
            if check_file != none && path_exists(check_file)
                return home_std
            end
        end
    end
    return none
end

def resolve_std_module_path(std_root ref(u8), std_path ref(u8), arena ref(allocators.Arena)) ref(u8)
    val rest_len usize = str.len(std_path) - 4 as usize
    val rest_res = allocators.Arena.alloc(arena, rest_len + 1)
    var rest ref(u8) = none
    match rest_res
        ok m => rest = m as ref(u8)
        error _ => return none
    end
    @memcpy(rest, @add(std_path, 4 as usize), rest_len)
    @deref(@as_mut(@add(rest, rest_len))) = 0
    val mod_scar ref(u8) = concat_path(std_root, concat_path(rest, "mod.scar", arena), arena)
    if mod_scar != none && path_exists(mod_scar)
        return mod_scar
    end
    val scar_len usize = rest_len + 5 as usize
    val scar_res = allocators.Arena.alloc(arena, scar_len + 1)
    var scar_path ref(u8) = none
    match scar_res
        ok m => scar_path = m as ref(u8)
        error _ => return none
    end
    @memcpy(scar_path, rest, rest_len)
    @memcpy(@add(scar_path, rest_len), ".scar", 5 as usize)
    @deref(@as_mut(@add(scar_path, scar_len))) = 0
    return concat_path(std_root, scar_path, arena)
end

def resolve_module_into(
    mod_path ref(u8),
    alias_name ref(u8),
    std_root ref(u8),
    resolved_type_defs ref(list[ast.TypeDef]),
    resolved_functions ref(list[ast.Function]),
    resolved_extern_headers ref(list[ref(u8)]),
    resolved_globals ref(list[ast.GlobalVar]),
    visited ref(list[ref(u8)]),
    arena ref(allocators.Arena)
) void|error
    var vi usize = 0
    for vi < @len(@deref(visited))
        if str.eql(@deref(visited)[vi], mod_path)
            return
        end
        vi++
    end
    @append(@deref(visited), mod_path)

    val mod_source ref(u8) = read_file(mod_path, arena)
    if mod_source == none
        return
    end
    val plat ref(u8) = reflection.current_platform_name[allocators.Arena](arena)?
    val mod_tokens list[ast.Token] = lxr.lex(mod_source, arena)
    val mod_prog ast.Program = prs.parse_program(mod_tokens, arena, plat, mod_path)
    val mod_dir ref(u8) = get_dirname(mod_path, arena)

    var smi usize = 0
    for smi < @len(mod_prog.module_uses)
        val smu ref(ast.ModuleUse) = @addr(mod_prog.module_uses[smi])
        val spath_len usize = str.len(smu.path)
        val sub_is_std bool = spath_len >= 4
            && @deref(smu.path) == 's'
            && @deref(@add(smu.path, 1)) == 't'
            && @deref(@add(smu.path, 2)) == 'd'
            && @deref(@add(smu.path, 3)) == '/'
        if sub_is_std
            if std_root != none
                val sub_mod_path ref(u8) = resolve_std_module_path(std_root, smu.path, arena)
                if sub_mod_path != none
                    resolve_module_into(sub_mod_path, smu.name, std_root, resolved_type_defs, resolved_functions, resolved_extern_headers, resolved_globals, visited, arena)?
                end
            end
        else
            val sub_mod_path ref(u8) = resolve_module_path(mod_dir, smu.path, arena)?
            resolve_module_into(sub_mod_path, smu.name, std_root, resolved_type_defs, resolved_functions, resolved_extern_headers, resolved_globals, visited, arena)?
        end
        smi++
    end

    var pub_type_names list[ref(u8)] = []
    var ti usize = 0
    for ti < @len(mod_prog.type_defs)
        if mod_prog.type_defs[ti].is_pub
            @append(pub_type_names, mod_prog.type_defs[ti].name)
        end
        ti++
    end

    ti = 0
    for ti < @len(mod_prog.type_defs)
        val td ref(ast.TypeDef) = @addr(mod_prog.type_defs[ti])
        if td.is_pub
            val prefixed_name ref(u8) = prefix_name(alias_name, td.name, arena)
            var prefixed_fields list[ast.FieldDef] = []
            var fi2 usize = 0
            for fi2 < @len(td.fields)
                val f ref(ast.FieldDef) = @addr(td.fields[fi2])
                val rewritten_ty ast.Type = rewrite_type_with_prefix(@addr(f.ty), alias_name, @addr(pub_type_names), arena)
                @append(prefixed_fields, ast.FieldDef(name: f.name, ty: rewritten_ty, line: f.line, column: f.column))
                fi2++
            end
            var prefixed_variants list[ast.VariantDef] = []
            var vi2 usize = 0
            for vi2 < @len(td.variants)
                val v ref(ast.VariantDef) = @addr(td.variants[vi2])
                var rewritten_payloads list[ast.Type] = []
                var pi usize = 0
                for pi < @len(v.payload_types)
                    @append(rewritten_payloads, rewrite_type_with_prefix(@addr(v.payload_types[pi]), alias_name, @addr(pub_type_names), arena))
                    pi++
                end
                @append(prefixed_variants, ast.VariantDef(name: v.name, payload_types: rewritten_payloads))
                vi2++
            end
            val prefixed_td ast.TypeDef = ast.TypeDef(
                name: prefixed_name,
                kind: td.kind,
                fields: prefixed_fields,
                variants: prefixed_variants,
                is_pub: false,
                derives: ([] as list[ref(u8)])
            )
            @append(@deref(resolved_type_defs), prefixed_td)
        end
        ti++
    end

    var fi usize = 0
    for fi < @len(mod_prog.functions)
        val fn_ref ref(ast.Function) = @addr(mod_prog.functions[fi])
        val prefixed_name ref(u8) = prefix_name(alias_name, fn_ref.name, arena)
        var prefixed_params list[ast.Param] = []
        var pi usize = 0
        for pi < @len(fn_ref.params)
            val param ref(ast.Param) = @addr(fn_ref.params[pi])
            val rewritten_ty ast.Type = rewrite_type_with_prefix(@addr(param.ty), alias_name, @addr(pub_type_names), arena)
            @append(prefixed_params, ast.Param(name: param.name, ty: rewritten_ty, line: param.line, column: param.column))
            pi++
        end
        val rewritten_ret ast.Type = rewrite_type_with_prefix(@addr(fn_ref.return_type), alias_name, @addr(pub_type_names), arena)
        val prefixed_fn ast.Function = ast.Function(
            name: prefixed_name,
            params: prefixed_params,
            return_type: rewritten_ret,
            body: fn_ref.body,
            is_pub: false,
            is_extern: fn_ref.is_extern,
            extern_name: fn_ref.extern_name,
            generic_params: fn_ref.generic_params,
            line: fn_ref.line,
            column: fn_ref.column
        )
        @append(@deref(resolved_functions), prefixed_fn)
        fi++
    end

    var hi usize = 0
    for hi < @len(mod_prog.extern_headers)
        @append(@deref(resolved_extern_headers), mod_prog.extern_headers[hi])
        hi++
    end

    var pgi usize = 0
    for pgi < @len(mod_prog.globals)
        val pg ref(ast.GlobalVar) = @addr(mod_prog.globals[pgi])
        val prefixed_name ref(u8) = prefix_name(alias_name, pg.name, arena)
        @append(@deref(resolved_globals), ast.GlobalVar(
            name: prefixed_name,
            mutable: pg.mutable,
            ty: pg.ty,
            init: pg.init,
            is_pub: false,
            line: pg.line,
            column: pg.column
        ))
        pgi++
    end
end

pub def resolve(program ref(ast.Program), source_path ref(u8), arena ref(allocators.Arena)) ast.Program|error
    var resolved_type_defs list[ast.TypeDef] = []
    var resolved_functions list[ast.Function] = []
    var resolved_extern_headers list[ref(u8)] = []
    var resolved_globals list[ast.GlobalVar] = []

    val source_dir ref(u8) = get_dirname(source_path, arena)
    val std_root ref(u8) = find_std_root(arena)
    var visited list[ref(u8)] = []

    var mi usize = 0
    for mi < @len(program.module_uses)
        val mu ref(ast.ModuleUse) = @addr(program.module_uses[mi])
        val path_len usize = str.len(mu.path)
        val is_std bool = path_len >= 4
            && @deref(mu.path) == 's'
            && @deref(@add(mu.path, 1)) == 't'
            && @deref(@add(mu.path, 2)) == 'd'
            && @deref(@add(mu.path, 3)) == '/'
        if is_std
            if std_root != none
                val mod_path ref(u8) = resolve_std_module_path(std_root, mu.path, arena)
                if mod_path != none
                    resolve_module_into(mod_path, mu.name, std_root, @addr(resolved_type_defs), @addr(resolved_functions), @addr(resolved_extern_headers), @addr(resolved_globals), @addr(visited), arena)?
                end
            end
            mi++
            continue
        end
        val mod_path ref(u8) = resolve_module_path(source_dir, mu.path, arena)?
        resolve_module_into(mod_path, mu.name, std_root, @addr(resolved_type_defs), @addr(resolved_functions), @addr(resolved_extern_headers), @addr(resolved_globals), @addr(visited), arena)?
        mi++
    end

    var ti usize = 0
    for ti < @len(program.type_defs)
        @append(resolved_type_defs, program.type_defs[ti])
        ti++
    end

    var hi usize = 0
    for hi < @len(program.extern_headers)
        @append(resolved_extern_headers, program.extern_headers[hi])
        hi++
    end

    hi = 0
    for hi < @len(program.globals)
        @append(resolved_globals, program.globals[hi])
        hi++
    end

    val result ast.Program = ast.Program(
        module_uses: program.module_uses,
        functions: [] as list[ast.Function],
        type_defs: resolved_type_defs,
        interface_defs: program.interface_defs,
        tests: program.tests,
        extern_headers: resolved_extern_headers,
        globals: resolved_globals
    )

    var i usize = 0
    for i < @len(resolved_functions)
        val fn_ref ref(ast.Function) = @addr(resolved_functions[i])
        val resolved_fn ast.Function = resolve_function(fn_ref, arena)?
        @append(result.functions, resolved_fn)
        i++
    end

    i = 0
    for i < @len(program.functions)
        val fn_ref ref(ast.Function) = @addr(program.functions[i])
        val resolved_fn ast.Function = resolve_function(fn_ref, arena)?
        @append(result.functions, resolved_fn)
        i++
    end

    return result
end

def resolve_module_path(source_dir ref(u8), mod_path ref(u8), arena ref(allocators.Arena)) ref(u8)|error
    val dir_len usize = str.len(source_dir)
    val path_len usize = str.len(mod_path)
    var needs_scar bool = true
    if path_len >= 5
        if @deref(@add(mod_path, path_len - 5)) == '.'
            && @deref(@add(mod_path, path_len - 4)) == 's'
            && @deref(@add(mod_path, path_len - 3)) == 'c'
            && @deref(@add(mod_path, path_len - 2)) == 'a'
            && @deref(@add(mod_path, path_len - 1)) == 'r'
            needs_scar = false
        end
    end
    var ext_len usize = 0
    if needs_scar
        ext_len = 5
    end
    val total usize = dir_len + 1 + path_len + ext_len + 1
    val buf_res = allocators.Arena.alloc(arena, total)
    var buf ref(u8) = none
    match buf_res
        ok m => buf = m as ref(u8)
        error _ => return error("alloc failed")
    end
    @memcpy(buf, source_dir, dir_len)
    @deref(@as_mut(@add(buf, dir_len))) = '/'
    @memcpy(@add(buf, dir_len + 1), mod_path, path_len)
    if needs_scar
        @memcpy(@add(buf, dir_len + 1 + path_len), ".scar", 5)
    end
    @deref(@as_mut(@add(buf, dir_len + 1 + path_len + ext_len))) = 0
    return buf
end

def prefix_name(prefix ref(u8), name ref(u8), arena ref(allocators.Arena)) ref(u8)
    val plen usize = str.len(prefix)
    val nlen usize = str.len(name)
    val total usize = plen + 2 + nlen + 1
    val buf_res = allocators.Arena.alloc(arena, total)
    var buf ref(u8) = none
    match buf_res
        ok m => buf = m as ref(u8)
        error _ => return name
    end
    @memcpy(buf, prefix, plen)
    @deref(@as_mut(@add(buf, plen))) = '_'
    @deref(@as_mut(@add(buf, plen + 1))) = '_'
    @memcpy(@add(buf, plen + 2), name, nlen)
    @deref(@as_mut(@add(buf, plen + 2 + nlen))) = 0
    return buf
end

def resolve_function(fun ref(ast.Function), arena ref(allocators.Arena)) ast.Function|error
    val resolved ast.Function = ast.Function(
        name: fun.name,
        params: [] as list[ast.Param],
        return_type: resolve_type(@addr(fun.return_type), arena)?,
        body: [] as list[ast.Stmt],
        is_pub: fun.is_pub,
        is_extern: fun.is_extern,
        extern_name: fun.extern_name,
        generic_params: fun.generic_params,
        line: fun.line,
        column: fun.column
    )

    var i usize = 0
    for i < @len(fun.params)
        val param_ref ref(ast.Param) = @addr(fun.params[i])
        var resolved_param ast.Param = ast.Param(
            name: param_ref.name,
            ty: resolve_type(@addr(param_ref.ty), arena)?,
            line: param_ref.line,
            column: param_ref.column
        )
        @append(resolved.params, resolved_param)
        i++
    end

    i = 0
    for i < @len(fun.body)
        val resolved_stmt ast.Stmt = resolve_stmt(@addr(fun.body[i]), arena)?
        @append(resolved.body, resolved_stmt)
        i++
    end
    return resolved
end

def resolve_stmt(stmt ref(ast.Stmt), arena ref(allocators.Arena)) ast.Stmt|error
    match @deref(stmt)
        ast.Stmt.VarDecl(vd) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtVarDecl) as usize)?
            var p ref(ast.StmtVarDecl) = @bitcast(raw, ref(ast.StmtVarDecl))
            p.name = vd.name
            p.mutable = vd.mutable
            p.declared_type = resolve_type(@addr(vd.declared_type), arena)?
            p.init = resolve_expr(@addr(vd.init), arena)?
            p.line = vd.line
            p.column = vd.column
            return ast.Stmt.VarDecl(p)
        )
        ast.Stmt.Assign(a) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtAssign) as usize)?
            var p ref(ast.StmtAssign) = @bitcast(raw, ref(ast.StmtAssign))
            p.target = resolve_expr(@addr(a.target), arena)?
            p.value = resolve_expr(@addr(a.value), arena)?
            p.line = a.line
            p.column = a.column
            return ast.Stmt.Assign(p)
        )
        ast.Stmt.AddAssign(a) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtAssign) as usize)?
            var p ref(ast.StmtAssign) = @bitcast(raw, ref(ast.StmtAssign))
            p.target = resolve_expr(@addr(a.target), arena)?
            p.value = resolve_expr(@addr(a.value), arena)?
            p.line = a.line
            p.column = a.column
            return ast.Stmt.AddAssign(p)
        )
        ast.Stmt.SubAssign(a) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtAssign) as usize)?
            var p ref(ast.StmtAssign) = @bitcast(raw, ref(ast.StmtAssign))
            p.target = resolve_expr(@addr(a.target), arena)?
            p.value = resolve_expr(@addr(a.value), arena)?
            p.line = a.line
            p.column = a.column
            return ast.Stmt.SubAssign(p)
        )
        ast.Stmt.MulAssign(a) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtAssign) as usize)?
            var p ref(ast.StmtAssign) = @bitcast(raw, ref(ast.StmtAssign))
            p.target = resolve_expr(@addr(a.target), arena)?
            p.value = resolve_expr(@addr(a.value), arena)?
            p.line = a.line
            p.column = a.column
            return ast.Stmt.MulAssign(p)
        )
        ast.Stmt.DivAssign(a) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtAssign) as usize)?
            var p ref(ast.StmtAssign) = @bitcast(raw, ref(ast.StmtAssign))
            p.target = resolve_expr(@addr(a.target), arena)?
            p.value = resolve_expr(@addr(a.value), arena)?
            p.line = a.line
            p.column = a.column
            return ast.Stmt.DivAssign(p)
        )
        ast.Stmt.BitXorAssign(a) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtAssign) as usize)?
            var p ref(ast.StmtAssign) = @bitcast(raw, ref(ast.StmtAssign))
            p.target = resolve_expr(@addr(a.target), arena)?
            p.value = resolve_expr(@addr(a.value), arena)?
            p.line = a.line
            p.column = a.column
            return ast.Stmt.BitXorAssign(p)
        )
        ast.Stmt.BitAndAssign(a) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtAssign) as usize)?
            var p ref(ast.StmtAssign) = @bitcast(raw, ref(ast.StmtAssign))
            p.target = resolve_expr(@addr(a.target), arena)?
            p.value = resolve_expr(@addr(a.value), arena)?
            p.line = a.line
            p.column = a.column
            return ast.Stmt.BitAndAssign(p)
        )
        ast.Stmt.BitOrAssign(a) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtAssign) as usize)?
            var p ref(ast.StmtAssign) = @bitcast(raw, ref(ast.StmtAssign))
            p.target = resolve_expr(@addr(a.target), arena)?
            p.value = resolve_expr(@addr(a.value), arena)?
            p.line = a.line
            p.column = a.column
            return ast.Stmt.BitOrAssign(p)
        )
        ast.Stmt.Return(r) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtReturn) as usize)?
            var p ref(ast.StmtReturn) = @bitcast(raw, ref(ast.StmtReturn))
            p.value = resolve_expr(@addr(r.value), arena)?
            p.line = r.line
            p.column = r.column
            return ast.Stmt.Return(p)
        )
        ast.Stmt.If(if_stmt) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtIf) as usize)?
            var p ref(ast.StmtIf) = @bitcast(raw, ref(ast.StmtIf))
            p.condition = resolve_expr(@addr(if_stmt.condition), arena)?
            p.line = if_stmt.line
            p.column = if_stmt.column
            var resolved_then list[ast.Stmt] = []
            var resolved_else list[ast.Stmt] = []
            var k usize = 0
            for k < @len(if_stmt.then_body)
                @append(resolved_then, resolve_stmt(@addr(if_stmt.then_body[k]), arena)?)
                k++
            end
            k = 0
            for k < @len(if_stmt.else_body)
                @append(resolved_else, resolve_stmt(@addr(if_stmt.else_body[k]), arena)?)
                k++
            end
            p.then_body = resolved_then
            p.else_body = resolved_else
            return ast.Stmt.If(p)
        )
        ast.Stmt.While(w) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtWhile) as usize)?
            var p ref(ast.StmtWhile) = @bitcast(raw, ref(ast.StmtWhile))
            p.condition = resolve_expr(@addr(w.condition), arena)?
            p.line = w.line
            p.column = w.column
            var resolved_body list[ast.Stmt] = []
            var k usize = 0
            for k < @len(w.body)
                @append(resolved_body, resolve_stmt(@addr(w.body[k]), arena)?)
                k++
            end
            p.body = resolved_body
            return ast.Stmt.While(p)
        )
        ast.Stmt.ForRange(fr) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtForRange) as usize)?
            var p ref(ast.StmtForRange) = @bitcast(raw, ref(ast.StmtForRange))
            p.var_name = fr.var_name
            p.start = resolve_expr(@addr(fr.start), arena)?
            p.End = resolve_expr(@addr(fr.End), arena)?
            p.line = fr.line
            p.column = fr.column
            var resolved_body list[ast.Stmt] = []
            var k usize = 0
            for k < @len(fr.body)
                @append(resolved_body, resolve_stmt(@addr(fr.body[k]), arena)?)
                k++
            end
            p.body = resolved_body
            return ast.Stmt.ForRange(p)
        )
        ast.Stmt.ForEach(fe) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtForEach) as usize)?
            var p ref(ast.StmtForEach) = @bitcast(raw, ref(ast.StmtForEach))
            p.var_name = fe.var_name
            p.iterable = resolve_expr(@addr(fe.iterable), arena)?
            p.line = fe.line
            p.column = fe.column
            var resolved_body list[ast.Stmt] = []
            var k usize = 0
            for k < @len(fe.body)
                @append(resolved_body, resolve_stmt(@addr(fe.body[k]), arena)?)
                k++
            end
            p.body = resolved_body
            return ast.Stmt.ForEach(p)
        )
        ast.Stmt.Match(m) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtMatch) as usize)?
            var p ref(ast.StmtMatch) = @bitcast(raw, ref(ast.StmtMatch))
            p.expr = resolve_expr(@addr(m.expr), arena)?
            p.line = m.line
            p.column = m.column
            var resolved_arms list[ast.MatchArm] = []
            var k usize = 0
            for k < @len(m.arms)
                var resolved_body list[ast.Stmt] = []
                var l usize = 0
                for l < @len(m.arms[k].body)
                    @append(resolved_body, resolve_stmt(@addr(m.arms[k].body[l]), arena)?)
                    l++
                end
                @append(resolved_arms, ast.MatchArm(
                    kind: m.arms[k].kind,
                    bindings: m.arms[k].bindings,
                    body: resolved_body
                ))
                k++
            end
            p.arms = resolved_arms
            return ast.Stmt.Match(p)
        )
        ast.Stmt.ExprStmt(e) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var p ref(ast.Expr) = @bitcast(raw, ref(ast.Expr))
            @deref(p) = resolve_expr(e, arena)?
            return ast.Stmt.ExprStmt(p)
        )
        ast.Stmt.Increment(e) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var p ref(ast.Expr) = @bitcast(raw, ref(ast.Expr))
            @deref(p) = resolve_expr(e, arena)?
            return ast.Stmt.Increment(p)
        )
        ast.Stmt.Decrement(e) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var p ref(ast.Expr) = @bitcast(raw, ref(ast.Expr))
            @deref(p) = resolve_expr(e, arena)?
            return ast.Stmt.Decrement(p)
        )
        ast.Stmt.Assert(e) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var p ref(ast.Expr) = @bitcast(raw, ref(ast.Expr))
            @deref(p) = resolve_expr(e, arena)?
            return ast.Stmt.Assert(p)
        )
        ast.Stmt.Block(body) => (
            var resolved_body list[ast.Stmt] = []
            var k usize = 0
            for k < @len(body)
                @append(resolved_body, resolve_stmt(@addr(body[k]), arena)?)
                k++
            end
            return ast.Stmt.Block(resolved_body)
        )
        ast.Stmt.Defer(body) => (
            var resolved_body list[ast.Stmt] = []
            var k usize = 0
            for k < @len(body)
                @append(resolved_body, resolve_stmt(@addr(body[k]), arena)?)
                k++
            end
            return ast.Stmt.Defer(resolved_body)
        )
        _ => return @deref(stmt)
    end
end

def resolve_expr(expr ref(ast.Expr), arena ref(allocators.Arena)) ast.Expr|error
    match @deref(expr)
        ast.Expr.IntLit(v) => return ast.Expr.IntLit(v)
        ast.Expr.FloatLit(v) => return ast.Expr.FloatLit(v)
        ast.Expr.BoolLit(v) => return ast.Expr.BoolLit(v)
        ast.Expr.CharLit(v) => return ast.Expr.CharLit(v)
        ast.Expr.StrLit(v) => return ast.Expr.StrLit(v)
        ast.Expr.Ident(v) => return ast.Expr.Ident(v)
        ast.Expr.None(v) => return ast.Expr.None(v)
        ast.Expr.ErrorLit(v) => return ast.Expr.ErrorLit(v)
        ast.Expr.Path(segments) => return ast.Expr.Path(segments)
        ast.Expr.Binary(b) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.ExprBinary) as usize)?
            var p ref(ast.ExprBinary) = @bitcast(raw, ref(ast.ExprBinary))
            
            val lhs_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var lhs_p ref(ast.Expr) = @bitcast(lhs_raw, ref(ast.Expr))
            @deref(lhs_p) = resolve_expr(b.lhs, arena)?
            p.lhs = lhs_p
            
            p.op = b.op
            
            val rhs_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var rhs_p ref(ast.Expr) = @bitcast(rhs_raw, ref(ast.Expr))
            @deref(rhs_p) = resolve_expr(b.rhs, arena)?
            p.rhs = rhs_p
            
            return ast.Expr.Binary(p)
        )
        ast.Expr.Unary(u) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.ExprUnary) as usize)?
            var p ref(ast.ExprUnary) = @bitcast(raw, ref(ast.ExprUnary))
            
            val expr_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var expr_p ref(ast.Expr) = @bitcast(expr_raw, ref(ast.Expr))
            @deref(expr_p) = resolve_expr(u.expr, arena)?
            p.expr = expr_p
            
            p.op = u.op
            return ast.Expr.Unary(p)
        )
        ast.Expr.Call(c) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.ExprCall) as usize)?
            var p ref(ast.ExprCall) = @bitcast(raw, ref(ast.ExprCall))
            
            val callee_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var callee_p ref(ast.Expr) = @bitcast(callee_raw, ref(ast.Expr))
            @deref(callee_p) = resolve_expr(c.callee, arena)?
            p.callee = callee_p
            
            var resolved_args list[ast.Expr] = []
            var i usize = 0
            for i < @len(c.args)
                @append(resolved_args, resolve_expr(@addr(c.args[i]), arena)?)
                i++
            end
            p.args = resolved_args
            return ast.Expr.Call(p)
        )
        ast.Expr.Index(idx) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.ExprIndex) as usize)?
            var p ref(ast.ExprIndex) = @bitcast(raw, ref(ast.ExprIndex))
            
            val base_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var base_p ref(ast.Expr) = @bitcast(base_raw, ref(ast.Expr))
            @deref(base_p) = resolve_expr(idx.base, arena)?
            p.base = base_p
            
            val index_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var index_p ref(ast.Expr) = @bitcast(index_raw, ref(ast.Expr))
            @deref(index_p) = resolve_expr(idx.index, arena)?
            p.index = index_p
            
            return ast.Expr.Index(p)
        )
        ast.Expr.Field(f) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.ExprField) as usize)?
            var p ref(ast.ExprField) = @bitcast(raw, ref(ast.ExprField))
            
            val base_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var base_p ref(ast.Expr) = @bitcast(base_raw, ref(ast.Expr))
            @deref(base_p) = resolve_expr(f.base, arena)?
            p.base = base_p
            
            p.field = f.field
            return ast.Expr.Field(p)
        )
        ast.Expr.Cast(c) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.ExprCast) as usize)?
            var p ref(ast.ExprCast) = @bitcast(raw, ref(ast.ExprCast))
            
            val expr_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var expr_p ref(ast.Expr) = @bitcast(expr_raw, ref(ast.Expr))
            @deref(expr_p) = resolve_expr(c.expr, arena)?
            p.expr = expr_p
            
            p.ty = resolve_type(@addr(c.ty), arena)?
            return ast.Expr.Cast(p)
        )
        ast.Expr.BitCast(bc) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.ExprBitCast) as usize)?
            var p ref(ast.ExprBitCast) = @bitcast(raw, ref(ast.ExprBitCast))
            
            val expr_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var expr_p ref(ast.Expr) = @bitcast(expr_raw, ref(ast.Expr))
            @deref(expr_p) = resolve_expr(bc.expr, arena)?
            p.expr = expr_p
            
            p.ty = resolve_type(@addr(bc.ty), arena)?
            return ast.Expr.BitCast(p)
        )
        ast.Expr.SizeOf(ty) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.Type) as usize)?
            var p ref(ast.Type) = @bitcast(raw, ref(ast.Type))
            @deref(p) = resolve_type(ty, arena)?
            return ast.Expr.SizeOf(p)
        )
        ast.Expr.ListLit(elems) => (
            var resolved list[ast.Expr] = []
            var i usize = 0
            for i < @len(elems)
                @append(resolved, resolve_expr(@addr(elems[i]), arena)?)
                i++
            end
            return ast.Expr.ListLit(resolved)
        )
        ast.Expr.StructInit(si) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.ExprStructInit) as usize)?
            var p ref(ast.ExprStructInit) = @bitcast(raw, ref(ast.ExprStructInit))
            p.name = si.name
            var resolved_fields list[ast.FieldInit] = []
            var i usize = 0
            for i < @len(si.fields)
                var resolved_value ast.Expr = resolve_expr(@addr(si.fields[i].value), arena)?
                @append(resolved_fields, ast.FieldInit(
                    name: si.fields[i].name,
                    value: resolved_value
                ))
                i++
            end
            p.fields = resolved_fields
            var resolved_type_args list[ast.Type] = []
            i = 0
            for i < @len(si.type_args)
                @append(resolved_type_args, resolve_type(@addr(si.type_args[i]), arena)?)
                i++
            end
            p.type_args = resolved_type_args
            return ast.Expr.StructInit(p)
        )
        ast.Expr.MethodCall(mc) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.ExprMethodCall) as usize)?
            var p ref(ast.ExprMethodCall) = @bitcast(raw, ref(ast.ExprMethodCall))
            
            val receiver_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var receiver_p ref(ast.Expr) = @bitcast(receiver_raw, ref(ast.Expr))
            @deref(receiver_p) = resolve_expr(mc.receiver, arena)?
            p.receiver = receiver_p
            
            p.method = mc.method
            var resolved_args list[ast.Expr] = []
            var i usize = 0
            for i < @len(mc.args)
                @append(resolved_args, resolve_expr(@addr(mc.args[i]), arena)?)
                i++
            end
            p.args = resolved_args
            return ast.Expr.MethodCall(p)
        )
        ast.Expr.Specialize(sp) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.ExprSpecialize) as usize)?
            var p ref(ast.ExprSpecialize) = @bitcast(raw, ref(ast.ExprSpecialize))
            
            val callee_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var callee_p ref(ast.Expr) = @bitcast(callee_raw, ref(ast.Expr))
            @deref(callee_p) = resolve_expr(sp.callee, arena)?
            p.callee = callee_p
            
            var resolved_type_args list[ast.Type] = []
            var i usize = 0
            for i < @len(sp.type_args)
                @append(resolved_type_args, resolve_type(@addr(sp.type_args[i]), arena)?)
                i++
            end
            p.type_args = resolved_type_args
            return ast.Expr.Specialize(p)
        )
        ast.Expr.BuiltinCall(bc) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.ExprBuiltinCall) as usize)?
            var p ref(ast.ExprBuiltinCall) = @bitcast(raw, ref(ast.ExprBuiltinCall))
            p.name = bc.name
            var resolved_args list[ast.Expr] = []
            var i usize = 0
            for i < @len(bc.args)
                @append(resolved_args, resolve_expr(@addr(bc.args[i]), arena)?)
                i++
            end
            p.args = resolved_args
            return ast.Expr.BuiltinCall(p)
        )
        ast.Expr.Try(inner) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var p ref(ast.Expr) = @bitcast(raw, ref(ast.Expr))
            
            val inner_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var inner_p ref(ast.Expr) = @bitcast(inner_raw, ref(ast.Expr))
            @deref(inner_p) = resolve_expr(inner, arena)?
            @deref(p) = ast.Expr.Try(inner_p)
            return @deref(p)
        )
        ast.Expr.Pack(elems) => (
            var resolved list[ast.Expr] = []
            var i usize = 0
            for i < @len(elems)
                @append(resolved, resolve_expr(@addr(elems[i]), arena)?)
                i++
            end
            return ast.Expr.Pack(resolved)
        )
    end
end

def resolve_type(ty ref(ast.Type), arena ref(allocators.Arena)) ast.Type|error
    match @deref(ty)
        ast.Type.Void(v) => return ast.Type.Void(v)
        ast.Type.Bool(v) => return ast.Type.Bool(v)
        ast.Type.I8(v) => return ast.Type.I8(v)
        ast.Type.I16(v) => return ast.Type.I16(v)
        ast.Type.I32(v) => return ast.Type.I32(v)
        ast.Type.I64(v) => return ast.Type.I64(v)
        ast.Type.Isize(v) => return ast.Type.Isize(v)
        ast.Type.U8(v) => return ast.Type.U8(v)
        ast.Type.U16(v) => return ast.Type.U16(v)
        ast.Type.U32(v) => return ast.Type.U32(v)
        ast.Type.U64(v) => return ast.Type.U64(v)
        ast.Type.Usize(v) => return ast.Type.Usize(v)
        ast.Type.F32(v) => return ast.Type.F32(v)
        ast.Type.F64(v) => return ast.Type.F64(v)
        ast.Type.Infer(v) => return ast.Type.Infer(v)
        ast.Type.Error(v) => return ast.Type.Error(v)
        ast.Type.None(v) => return ast.Type.None(v)
        ast.Type.Named(name) => (
            val nlen usize = str.len(name)
            var dot_pos usize = nlen
            var i usize = 0
            for i < nlen
                if @deref(@add(name, i)) == '.'
                    dot_pos = i
                    break
                end
                i++
            end
            if dot_pos == nlen
                return ast.Type.Named(name)
            end
            val result_res = allocators.Arena.alloc(arena, nlen + 2)
            var result ref(u8) = none
            match result_res
                ok m => result = m as ref(u8)
                error _ => return ast.Type.Named(name)
            end
            var src usize = 0
            var dst usize = 0
            for src < nlen
                val ch u8 = @deref(@add(name, src))
                if ch == '.'
                    @deref(@as_mut(@add(result, dst))) = '_'
                    dst++
                    @deref(@as_mut(@add(result, dst))) = '_'
                    dst++
                else
                    @deref(@as_mut(@add(result, dst))) = ch
                    dst++
                end
                src++
            end
            @deref(@as_mut(@add(result, dst))) = 0
            return ast.Type.Named(result)
        )
        ast.Type.Applied(name, type_args) => (
            var resolved list[ast.Type] = []
            var i usize = 0
            for i < @len(type_args)
                @append(resolved, resolve_type(@addr(type_args[i]), arena)?)
                i++
            end
            return ast.Type.Applied(name, resolved)
        )
        ast.Type.Ref(inner) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.Type) as usize)?
            var p ref(ast.Type) = @bitcast(raw, ref(ast.Type))
            @deref(p) = resolve_type(inner, arena)?
            return ast.Type.Ref(p)
        )
        ast.Type.Mut(inner) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.Type) as usize)?
            var p ref(ast.Type) = @bitcast(raw, ref(ast.Type))
            @deref(p) = resolve_type(inner, arena)?
            return ast.Type.Mut(p)
        )
        ast.Type.List(inner) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.Type) as usize)?
            var p ref(ast.Type) = @bitcast(raw, ref(ast.Type))
            @deref(p) = resolve_type(inner, arena)?
            return ast.Type.List(p)
        )
        ast.Type.Result(inner) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.Type) as usize)?
            var p ref(ast.Type) = @bitcast(raw, ref(ast.Type))
            @deref(p) = resolve_type(inner, arena)?
            return ast.Type.Result(p)
        )
        ast.Type.FnPtr(params, ret) => (
            var resolved_params list[ast.Type] = []
            var i usize = 0
            for i < @len(params)
                @append(resolved_params, resolve_type(@addr(params[i]), arena)?)
                i++
            end
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.Type) as usize)?
            var p ref(ast.Type) = @bitcast(raw, ref(ast.Type))
            @deref(p) = resolve_type(ret, arena)?
            return ast.Type.FnPtr(resolved_params, p)
        )
        ast.Type.StaticArray(size, inner) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.Type) as usize)?
            var p ref(ast.Type) = @bitcast(raw, ref(ast.Type))
            @deref(p) = resolve_type(inner, arena)?
            return ast.Type.StaticArray(size, p)
        )
    end
end

def rewrite_type_with_prefix(ty ref(ast.Type), module_prefix ref(u8), pub_names ref(list[ref(u8)]), arena ref(allocators.Arena)) ast.Type
    match @deref(ty)
        ast.Type.Named(name) => (
            var i usize = 0
            for i < @len(@deref(pub_names))
                if str.eql(@deref(pub_names)[i], name)
                    return ast.Type.Named(prefix_name(module_prefix, name, arena))
                end
                i++
            end
            return @deref(ty)
        )
        ast.Type.Ref(inner) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.Type) as usize)
            match raw
                ok m => (
                    var p ref(ast.Type) = @bitcast(m, ref(ast.Type))
                    @deref(p) = rewrite_type_with_prefix(inner, module_prefix, pub_names, arena)
                    return ast.Type.Ref(p)
                )
                error _ => return @deref(ty)
            end
        )
        ast.Type.Mut(inner) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.Type) as usize)
            match raw
                ok m => (
                    var p ref(ast.Type) = @bitcast(m, ref(ast.Type))
                    @deref(p) = rewrite_type_with_prefix(inner, module_prefix, pub_names, arena)
                    return ast.Type.Mut(p)
                )
                error _ => return @deref(ty)
            end
        )
        ast.Type.List(inner) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.Type) as usize)
            match raw
                ok m => (
                    var p ref(ast.Type) = @bitcast(m, ref(ast.Type))
                    @deref(p) = rewrite_type_with_prefix(inner, module_prefix, pub_names, arena)
                    return ast.Type.List(p)
                )
                error _ => return @deref(ty)
            end
        )
        ast.Type.StaticArray(size, inner) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.Type) as usize)
            match raw
                ok m => (
                    var p ref(ast.Type) = @bitcast(m, ref(ast.Type))
                    @deref(p) = rewrite_type_with_prefix(inner, module_prefix, pub_names, arena)
                    return ast.Type.StaticArray(size, p)
                )
                error _ => return @deref(ty)
            end
        )
        _ => return @deref(ty)
    end
end
