val ast = use("ast")
val allocators = use("std/allocators")

pub def resolve(program ref(ast.Program), arena ref(allocators.Arena)) ast.Program|error
    val result ast.Program = ast.Program(
        module_uses: program.module_uses,
        functions: [] as list[ast.Function],
        type_defs: program.type_defs,
        tests: program.tests,
        extern_headers: program.extern_headers
    )

    var i usize = 0
    for i < @len(program.functions)
        val fn_ref ref(ast.Function) = @addr(program.functions[i])
        val resolved ast.Function = resolve_function(fn_ref, arena)?
        @append(result.functions, resolved)
        i++
    end

    return result
end

def resolve_function(fun ref(ast.Function), arena ref(allocators.Arena)) ast.Function|error
    val resolved ast.Function = ast.Function(
        name: fun.name,
        params: [] as list[ast.Param],
        return_type: resolve_type(@addr(fun.return_type), arena)?,
        body: [] as list[ast.Stmt],
        is_pub: fun.is_pub,
        is_extern: fun.is_extern,
        extern_name: fun.extern_name,
        line: fun.line,
        column: fun.column
    )

    var i usize = 0
    for i < @len(fun.params)
        val param_ref ref(ast.Param) = @addr(fun.params[i])
        var resolved_param ast.Param = ast.Param(
            name: param_ref.name,
            ty: resolve_type(@addr(param_ref.ty), arena)?,
            line: param_ref.line,
            column: param_ref.column
        )
        @append(resolved.params, resolved_param)
        i++
    end

    i = 0
    for i < @len(fun.body)
        val resolved_stmt ast.Stmt = resolve_stmt(@addr(fun.body[i]), arena)?
        @append(resolved.body, resolved_stmt)
        i++
    end
    return resolved
end

def resolve_stmt(stmt ref(ast.Stmt), arena ref(allocators.Arena)) ast.Stmt|error
    match @deref(stmt)
        ast.Stmt.VarDecl(vd) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtVarDecl) as usize)?
            var p ref(ast.StmtVarDecl) = @bitcast(raw, ref(ast.StmtVarDecl))
            p.name = vd.name
            p.mutable = vd.mutable
            p.declared_type = resolve_type(@addr(vd.declared_type), arena)?
            p.init = resolve_expr(@addr(vd.init), arena)?
            p.line = vd.line
            p.column = vd.column
            return ast.Stmt.VarDecl(p)
        )
        ast.Stmt.Assign(a) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtAssign) as usize)?
            var p ref(ast.StmtAssign) = @bitcast(raw, ref(ast.StmtAssign))
            p.target = resolve_expr(@addr(a.target), arena)?
            p.value = resolve_expr(@addr(a.value), arena)?
            p.line = a.line
            p.column = a.column
            return ast.Stmt.Assign(p)
        )
        ast.Stmt.AddAssign(a) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtAssign) as usize)?
            var p ref(ast.StmtAssign) = @bitcast(raw, ref(ast.StmtAssign))
            p.target = resolve_expr(@addr(a.target), arena)?
            p.value = resolve_expr(@addr(a.value), arena)?
            p.line = a.line
            p.column = a.column
            return ast.Stmt.AddAssign(p)
        )
        ast.Stmt.SubAssign(a) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtAssign) as usize)?
            var p ref(ast.StmtAssign) = @bitcast(raw, ref(ast.StmtAssign))
            p.target = resolve_expr(@addr(a.target), arena)?
            p.value = resolve_expr(@addr(a.value), arena)?
            p.line = a.line
            p.column = a.column
            return ast.Stmt.SubAssign(p)
        )
        ast.Stmt.MulAssign(a) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtAssign) as usize)?
            var p ref(ast.StmtAssign) = @bitcast(raw, ref(ast.StmtAssign))
            p.target = resolve_expr(@addr(a.target), arena)?
            p.value = resolve_expr(@addr(a.value), arena)?
            p.line = a.line
            p.column = a.column
            return ast.Stmt.MulAssign(p)
        )
        ast.Stmt.DivAssign(a) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtAssign) as usize)?
            var p ref(ast.StmtAssign) = @bitcast(raw, ref(ast.StmtAssign))
            p.target = resolve_expr(@addr(a.target), arena)?
            p.value = resolve_expr(@addr(a.value), arena)?
            p.line = a.line
            p.column = a.column
            return ast.Stmt.DivAssign(p)
        )
        ast.Stmt.BitXorAssign(a) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtAssign) as usize)?
            var p ref(ast.StmtAssign) = @bitcast(raw, ref(ast.StmtAssign))
            p.target = resolve_expr(@addr(a.target), arena)?
            p.value = resolve_expr(@addr(a.value), arena)?
            p.line = a.line
            p.column = a.column
            return ast.Stmt.BitXorAssign(p)
        )
        ast.Stmt.BitAndAssign(a) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtAssign) as usize)?
            var p ref(ast.StmtAssign) = @bitcast(raw, ref(ast.StmtAssign))
            p.target = resolve_expr(@addr(a.target), arena)?
            p.value = resolve_expr(@addr(a.value), arena)?
            p.line = a.line
            p.column = a.column
            return ast.Stmt.BitAndAssign(p)
        )
        ast.Stmt.BitOrAssign(a) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtAssign) as usize)?
            var p ref(ast.StmtAssign) = @bitcast(raw, ref(ast.StmtAssign))
            p.target = resolve_expr(@addr(a.target), arena)?
            p.value = resolve_expr(@addr(a.value), arena)?
            p.line = a.line
            p.column = a.column
            return ast.Stmt.BitOrAssign(p)
        )
        ast.Stmt.Return(r) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtReturn) as usize)?
            var p ref(ast.StmtReturn) = @bitcast(raw, ref(ast.StmtReturn))
            p.value = resolve_expr(@addr(r.value), arena)?
            p.line = r.line
            p.column = r.column
            return ast.Stmt.Return(p)
        )
        ast.Stmt.If(if_stmt) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtIf) as usize)?
            var p ref(ast.StmtIf) = @bitcast(raw, ref(ast.StmtIf))
            p.condition = resolve_expr(@addr(if_stmt.condition), arena)?
            p.line = if_stmt.line
            p.column = if_stmt.column
            var resolved_then list[ast.Stmt] = []
            var resolved_else list[ast.Stmt] = []
            var k usize = 0
            for k < @len(if_stmt.then_body)
                @append(resolved_then, resolve_stmt(@addr(if_stmt.then_body[k]), arena)?)
                k++
            end
            k = 0
            for k < @len(if_stmt.else_body)
                @append(resolved_else, resolve_stmt(@addr(if_stmt.else_body[k]), arena)?)
                k++
            end
            p.then_body = resolved_then
            p.else_body = resolved_else
            return ast.Stmt.If(p)
        )
        ast.Stmt.While(w) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtWhile) as usize)?
            var p ref(ast.StmtWhile) = @bitcast(raw, ref(ast.StmtWhile))
            p.condition = resolve_expr(@addr(w.condition), arena)?
            p.line = w.line
            p.column = w.column
            var resolved_body list[ast.Stmt] = []
            var k usize = 0
            for k < @len(w.body)
                @append(resolved_body, resolve_stmt(@addr(w.body[k]), arena)?)
                k++
            end
            p.body = resolved_body
            return ast.Stmt.While(p)
        )
        ast.Stmt.ForRange(fr) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtForRange) as usize)?
            var p ref(ast.StmtForRange) = @bitcast(raw, ref(ast.StmtForRange))
            p.var_name = fr.var_name
            p.start = resolve_expr(@addr(fr.start), arena)?
            p.End = resolve_expr(@addr(fr.End), arena)?
            p.line = fr.line
            p.column = fr.column
            var resolved_body list[ast.Stmt] = []
            var k usize = 0
            for k < @len(fr.body)
                @append(resolved_body, resolve_stmt(@addr(fr.body[k]), arena)?)
                k++
            end
            p.body = resolved_body
            return ast.Stmt.ForRange(p)
        )
        ast.Stmt.Match(m) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtMatch) as usize)?
            var p ref(ast.StmtMatch) = @bitcast(raw, ref(ast.StmtMatch))
            p.expr = resolve_expr(@addr(m.expr), arena)?
            p.line = m.line
            p.column = m.column
            var resolved_arms list[ast.MatchArm] = []
            var k usize = 0
            for k < @len(m.arms)
                var resolved_body list[ast.Stmt] = []
                var l usize = 0
                for l < @len(m.arms[k].body)
                    @append(resolved_body, resolve_stmt(@addr(m.arms[k].body[l]), arena)?)
                    l++
                end
                @append(resolved_arms, ast.MatchArm(
                    kind: m.arms[k].kind,
                    bindings: m.arms[k].bindings,
                    body: resolved_body
                ))
                k++
            end
            p.arms = resolved_arms
            return ast.Stmt.Match(p)
        )
        ast.Stmt.ExprStmt(e) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var p ref(ast.Expr) = @bitcast(raw, ref(ast.Expr))
            @deref(p) = resolve_expr(e, arena)?
            return ast.Stmt.ExprStmt(p)
        )
        ast.Stmt.Increment(e) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var p ref(ast.Expr) = @bitcast(raw, ref(ast.Expr))
            @deref(p) = resolve_expr(e, arena)?
            return ast.Stmt.Increment(p)
        )
        ast.Stmt.Decrement(e) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var p ref(ast.Expr) = @bitcast(raw, ref(ast.Expr))
            @deref(p) = resolve_expr(e, arena)?
            return ast.Stmt.Decrement(p)
        )
        ast.Stmt.Assert(e) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var p ref(ast.Expr) = @bitcast(raw, ref(ast.Expr))
            @deref(p) = resolve_expr(e, arena)?
            return ast.Stmt.Assert(p)
        )
        ast.Stmt.Block(body) => (
            var resolved_body list[ast.Stmt] = []
            var k usize = 0
            for k < @len(body)
                @append(resolved_body, resolve_stmt(@addr(body[k]), arena)?)
                k++
            end
            return ast.Stmt.Block(resolved_body)
        )
        _ => return @deref(stmt)
    end
end

def resolve_expr(expr ref(ast.Expr), arena ref(allocators.Arena)) ast.Expr|error
    match @deref(expr)
        ast.Expr.IntLit(v) => return ast.Expr.IntLit(v)
        ast.Expr.FloatLit(v) => return ast.Expr.FloatLit(v)
        ast.Expr.BoolLit(v) => return ast.Expr.BoolLit(v)
        ast.Expr.CharLit(v) => return ast.Expr.CharLit(v)
        ast.Expr.StrLit(v) => return ast.Expr.StrLit(v)
        ast.Expr.Ident(v) => return ast.Expr.Ident(v)
        ast.Expr.None(v) => return ast.Expr.None(v)
        ast.Expr.ErrorLit(v) => return ast.Expr.ErrorLit(v)
        ast.Expr.Path(segments) => return ast.Expr.Path(segments)
        ast.Expr.Binary(b) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.ExprBinary) as usize)?
            var p ref(ast.ExprBinary) = @bitcast(raw, ref(ast.ExprBinary))
            
            val lhs_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var lhs_p ref(ast.Expr) = @bitcast(lhs_raw, ref(ast.Expr))
            @deref(lhs_p) = resolve_expr(b.lhs, arena)?
            p.lhs = lhs_p
            
            p.op = b.op
            
            val rhs_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var rhs_p ref(ast.Expr) = @bitcast(rhs_raw, ref(ast.Expr))
            @deref(rhs_p) = resolve_expr(b.rhs, arena)?
            p.rhs = rhs_p
            
            return ast.Expr.Binary(p)
        )
        ast.Expr.Unary(u) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.ExprUnary) as usize)?
            var p ref(ast.ExprUnary) = @bitcast(raw, ref(ast.ExprUnary))
            
            val expr_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var expr_p ref(ast.Expr) = @bitcast(expr_raw, ref(ast.Expr))
            @deref(expr_p) = resolve_expr(u.expr, arena)?
            p.expr = expr_p
            
            p.op = u.op
            return ast.Expr.Unary(p)
        )
        ast.Expr.Call(c) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.ExprCall) as usize)?
            var p ref(ast.ExprCall) = @bitcast(raw, ref(ast.ExprCall))
            
            val callee_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var callee_p ref(ast.Expr) = @bitcast(callee_raw, ref(ast.Expr))
            @deref(callee_p) = resolve_expr(c.callee, arena)?
            p.callee = callee_p
            
            var resolved_args list[ast.Expr] = []
            var i usize = 0
            for i < @len(c.args)
                @append(resolved_args, resolve_expr(@addr(c.args[i]), arena)?)
                i++
            end
            p.args = resolved_args
            return ast.Expr.Call(p)
        )
        ast.Expr.Index(idx) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.ExprIndex) as usize)?
            var p ref(ast.ExprIndex) = @bitcast(raw, ref(ast.ExprIndex))
            
            val base_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var base_p ref(ast.Expr) = @bitcast(base_raw, ref(ast.Expr))
            @deref(base_p) = resolve_expr(idx.base, arena)?
            p.base = base_p
            
            val index_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var index_p ref(ast.Expr) = @bitcast(index_raw, ref(ast.Expr))
            @deref(index_p) = resolve_expr(idx.index, arena)?
            p.index = index_p
            
            return ast.Expr.Index(p)
        )
        ast.Expr.Field(f) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.ExprField) as usize)?
            var p ref(ast.ExprField) = @bitcast(raw, ref(ast.ExprField))
            
            val base_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var base_p ref(ast.Expr) = @bitcast(base_raw, ref(ast.Expr))
            @deref(base_p) = resolve_expr(f.base, arena)?
            p.base = base_p
            
            p.field = f.field
            return ast.Expr.Field(p)
        )
        ast.Expr.Cast(c) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.ExprCast) as usize)?
            var p ref(ast.ExprCast) = @bitcast(raw, ref(ast.ExprCast))
            
            val expr_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var expr_p ref(ast.Expr) = @bitcast(expr_raw, ref(ast.Expr))
            @deref(expr_p) = resolve_expr(c.expr, arena)?
            p.expr = expr_p
            
            p.ty = resolve_type(@addr(c.ty), arena)?
            return ast.Expr.Cast(p)
        )
        ast.Expr.BitCast(bc) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.ExprBitCast) as usize)?
            var p ref(ast.ExprBitCast) = @bitcast(raw, ref(ast.ExprBitCast))
            
            val expr_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var expr_p ref(ast.Expr) = @bitcast(expr_raw, ref(ast.Expr))
            @deref(expr_p) = resolve_expr(bc.expr, arena)?
            p.expr = expr_p
            
            p.ty = resolve_type(@addr(bc.ty), arena)?
            return ast.Expr.BitCast(p)
        )
        ast.Expr.SizeOf(ty) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.Type) as usize)?
            var p ref(ast.Type) = @bitcast(raw, ref(ast.Type))
            @deref(p) = resolve_type(ty, arena)?
            return ast.Expr.SizeOf(p)
        )
        ast.Expr.ListLit(elems) => (
            var resolved list[ast.Expr] = []
            var i usize = 0
            for i < @len(elems)
                @append(resolved, resolve_expr(@addr(elems[i]), arena)?)
                i++
            end
            return ast.Expr.ListLit(resolved)
        )
        ast.Expr.StructInit(si) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.ExprStructInit) as usize)?
            var p ref(ast.ExprStructInit) = @bitcast(raw, ref(ast.ExprStructInit))
            p.name = si.name
            var resolved_fields list[ast.FieldInit] = []
            var i usize = 0
            for i < @len(si.fields)
                var resolved_value ast.Expr = resolve_expr(@addr(si.fields[i].value), arena)?
                @append(resolved_fields, ast.FieldInit(
                    name: si.fields[i].name,
                    value: resolved_value
                ))
                i++
            end
            p.fields = resolved_fields
            var resolved_type_args list[ast.Type] = []
            i = 0
            for i < @len(si.type_args)
                @append(resolved_type_args, resolve_type(@addr(si.type_args[i]), arena)?)
                i++
            end
            p.type_args = resolved_type_args
            return ast.Expr.StructInit(p)
        )
        ast.Expr.MethodCall(mc) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.ExprMethodCall) as usize)?
            var p ref(ast.ExprMethodCall) = @bitcast(raw, ref(ast.ExprMethodCall))
            
            val receiver_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var receiver_p ref(ast.Expr) = @bitcast(receiver_raw, ref(ast.Expr))
            @deref(receiver_p) = resolve_expr(mc.receiver, arena)?
            p.receiver = receiver_p
            
            p.method = mc.method
            var resolved_args list[ast.Expr] = []
            var i usize = 0
            for i < @len(mc.args)
                @append(resolved_args, resolve_expr(@addr(mc.args[i]), arena)?)
                i++
            end
            p.args = resolved_args
            return ast.Expr.MethodCall(p)
        )
        ast.Expr.Specialize(sp) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.ExprSpecialize) as usize)?
            var p ref(ast.ExprSpecialize) = @bitcast(raw, ref(ast.ExprSpecialize))
            
            val callee_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var callee_p ref(ast.Expr) = @bitcast(callee_raw, ref(ast.Expr))
            @deref(callee_p) = resolve_expr(sp.callee, arena)?
            p.callee = callee_p
            
            var resolved_type_args list[ast.Type] = []
            var i usize = 0
            for i < @len(sp.type_args)
                @append(resolved_type_args, resolve_type(@addr(sp.type_args[i]), arena)?)
                i++
            end
            p.type_args = resolved_type_args
            return ast.Expr.Specialize(p)
        )
        ast.Expr.BuiltinCall(bc) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.ExprBuiltinCall) as usize)?
            var p ref(ast.ExprBuiltinCall) = @bitcast(raw, ref(ast.ExprBuiltinCall))
            p.name = bc.name
            var resolved_args list[ast.Expr] = []
            var i usize = 0
            for i < @len(bc.args)
                @append(resolved_args, resolve_expr(@addr(bc.args[i]), arena)?)
                i++
            end
            p.args = resolved_args
            return ast.Expr.BuiltinCall(p)
        )
        ast.Expr.Try(inner) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var p ref(ast.Expr) = @bitcast(raw, ref(ast.Expr))
            
            val inner_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)?
            var inner_p ref(ast.Expr) = @bitcast(inner_raw, ref(ast.Expr))
            @deref(inner_p) = resolve_expr(inner, arena)?
            @deref(p) = ast.Expr.Try(inner_p)
            return @deref(p)
        )
        ast.Expr.Pack(elems) => (
            var resolved list[ast.Expr] = []
            var i usize = 0
            for i < @len(elems)
                @append(resolved, resolve_expr(@addr(elems[i]), arena)?)
                i++
            end
            return ast.Expr.Pack(resolved)
        )
    end
end

def resolve_type(ty ref(ast.Type), arena ref(allocators.Arena)) ast.Type|error
    match @deref(ty)
        ast.Type.Void(v) => return ast.Type.Void(v)
        ast.Type.Bool(v) => return ast.Type.Bool(v)
        ast.Type.I8(v) => return ast.Type.I8(v)
        ast.Type.I16(v) => return ast.Type.I16(v)
        ast.Type.I32(v) => return ast.Type.I32(v)
        ast.Type.I64(v) => return ast.Type.I64(v)
        ast.Type.Isize(v) => return ast.Type.Isize(v)
        ast.Type.U8(v) => return ast.Type.U8(v)
        ast.Type.U16(v) => return ast.Type.U16(v)
        ast.Type.U32(v) => return ast.Type.U32(v)
        ast.Type.U64(v) => return ast.Type.U64(v)
        ast.Type.Usize(v) => return ast.Type.Usize(v)
        ast.Type.F32(v) => return ast.Type.F32(v)
        ast.Type.F64(v) => return ast.Type.F64(v)
        ast.Type.Infer(v) => return ast.Type.Infer(v)
        ast.Type.Error(v) => return ast.Type.Error(v)
        ast.Type.None(v) => return ast.Type.None(v)
        ast.Type.Named(name) => return ast.Type.Named(name)
        ast.Type.Applied(name, type_args) => (
            var resolved list[ast.Type] = []
            var i usize = 0
            for i < @len(type_args)
                @append(resolved, resolve_type(@addr(type_args[i]), arena)?)
                i++
            end
            return ast.Type.Applied(name, resolved)
        )
        ast.Type.Ref(inner) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.Type) as usize)?
            var p ref(ast.Type) = @bitcast(raw, ref(ast.Type))
            @deref(p) = resolve_type(inner, arena)?
            return ast.Type.Ref(p)
        )
        ast.Type.Mut(inner) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.Type) as usize)?
            var p ref(ast.Type) = @bitcast(raw, ref(ast.Type))
            @deref(p) = resolve_type(inner, arena)?
            return ast.Type.Mut(p)
        )
        ast.Type.List(inner) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.Type) as usize)?
            var p ref(ast.Type) = @bitcast(raw, ref(ast.Type))
            @deref(p) = resolve_type(inner, arena)?
            return ast.Type.List(p)
        )
        ast.Type.Result(inner) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.Type) as usize)?
            var p ref(ast.Type) = @bitcast(raw, ref(ast.Type))
            @deref(p) = resolve_type(inner, arena)?
            return ast.Type.Result(p)
        )
        ast.Type.FnPtr(params, ret) => (
            var resolved_params list[ast.Type] = []
            var i usize = 0
            for i < @len(params)
                @append(resolved_params, resolve_type(@addr(params[i]), arena)?)
                i++
            end
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.Type) as usize)?
            var p ref(ast.Type) = @bitcast(raw, ref(ast.Type))
            @deref(p) = resolve_type(ret, arena)?
            return ast.Type.FnPtr(resolved_params, p)
        )
    end
end
