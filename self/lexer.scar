val str = use("std/string")
val ast = use("ast")
val allocators = use("std/allocators")

pub def lex(source ref(u8), arena ref(allocators.Arena)) list[ast.Token]
	val len usize = str.len(source)
	var l ast.Lexer = ast.Lexer(
		source: source,
		len: len,
		pos: 0,
		line: 1,
		column: 1,
		tokens: [
			ast.Token(kind: ast.TokenKind.Eof(0), line: 0, column: 0)
		]
	)
	@clear(l.tokens)

	for l.pos < l.len
		val ch u8 = @deref(@add(l.source, l.pos))

		match ch
			' ' => (
				l.pos++
				l.column++
			)
			'\t' => (
				l.pos++
				l.column++
			)
			'\r' => l.pos++
			'\n' => (
				@append(
					l.tokens,
					ast.Token(
						kind: ast.TokenKind.Newline(0),
						line: l.line,
						column: l.column
					)
				)
				l.pos++
				l.line++
				l.column = 1
			)
			'#' => (
				l.pos++
				for l.pos < l.len
					val c u8 = @deref(@add(l.source, l.pos))
					if c == '\n'
						break
					end
					l.pos++
				end
			)
			'@' => (
				@append(
					l.tokens,
					ast.Token(
						kind: ast.TokenKind.At(0),
						line: l.line,
						column: l.column
					)
				)
				l.pos++
				l.column++
			)
			'(' => (
				@append(l.tokens, ast.Token(kind: ast.TokenKind.LParen(0), line: l.line, column: l.column))
				l.pos++
				l.column++
			)
			')' => (
				@append(l.tokens, ast.Token(kind: ast.TokenKind.RParen(0), line: l.line, column: l.column))
				l.pos++
				l.column++
			)
			',' => (
				@append(l.tokens, ast.Token(kind: ast.TokenKind.Comma(0), line: l.line, column: l.column))
				l.pos++
				l.column++
			)
			'.' => (
				l.pos++
				l.column++
				if @deref(@add(l.source, l.pos)) == '.'
					l.pos++
					l.column++
					@append(l.tokens, ast.Token(kind: ast.TokenKind.DotDot(0), line: l.line, column: l.column))
				else
					@append(l.tokens, ast.Token(kind: ast.TokenKind.Dot(0), line: l.line, column: l.column))
				end
			)
			':' => (
				l.pos++
				l.column++
				if @deref(@add(l.source, l.pos)) == ':'
					l.pos++
					l.column++
					@append(l.tokens, ast.Token(kind: ast.TokenKind.ColonColon(0), line: l.line, column: l.column))
				else
					@append(l.tokens, ast.Token(kind: ast.TokenKind.Colon(0), line: l.line, column: l.column))
				end
			)
			'=' => (
				l.pos++
				l.column++
				match @deref(@add(l.source, l.pos))
					'=' => (
						l.pos++
						l.column++
						@append(l.tokens, ast.Token(kind: ast.TokenKind.EqualEqual(0), line: l.line, column: l.column))
					)
					'>' => (
						l.pos++
						l.column++
						@append(l.tokens, ast.Token(kind: ast.TokenKind.FatArrow(0), line: l.line, column: l.column))
					)
					_ => @append(l.tokens, ast.Token(kind: ast.TokenKind.Assign(0), line: l.line, column: l.column))
				end
			)
			'!' => (
				l.pos++
				l.column++
				if @deref(@add(l.source, l.pos)) == '='
					l.pos++
					l.column++
					@append(l.tokens, ast.Token(kind: ast.TokenKind.BangEqual(0), line: l.line, column: l.column))
				else
					@append(l.tokens, ast.Token(kind: ast.TokenKind.Bang(0), line: l.line, column: l.column))
				end
			)
			'<' => (
				l.pos++
				l.column++
				match @deref(@add(l.source, l.pos))
					'<' => (
						l.pos++
						l.column++
						@append(l.tokens, ast.Token(kind: ast.TokenKind.ShiftLeft(0), line: l.line, column: l.column))
					)
					'=' => (
						l.pos++
						l.column++
						@append(l.tokens, ast.Token(kind: ast.TokenKind.LessEqual(0), line: l.line, column: l.column))
					)
					_ => @append(l.tokens, ast.Token(kind: ast.TokenKind.Less(0), line: l.line, column: l.column))
				end
			)
			'>' => (
				l.pos++
				l.column++
				match @deref(@add(l.source, l.pos))
					'>' => (
						l.pos++
						l.column++
						@append(l.tokens, ast.Token(kind: ast.TokenKind.ShiftRight(0), line: l.line, column: l.column))
					)
					'=' => (
						l.pos++
						l.column++
						@append(l.tokens, ast.Token(kind: ast.TokenKind.GreaterEqual(0), line: l.line, column: l.column))
					)
					_ => @append(l.tokens, ast.Token(kind: ast.TokenKind.Greater(0), line: l.line, column: l.column))
				end
			)
			'*' => (
				l.pos++
				l.column++
				if @deref(@add(l.source, l.pos)) == '='
					l.pos++
					l.column++
					@append(l.tokens, ast.Token(kind: ast.TokenKind.StarEqual(0), line: l.line, column: l.column))
				else
					@append(l.tokens, ast.Token(kind: ast.TokenKind.Star(0), line: l.line, column: l.column))
				end
			)
			'/' => (
				l.pos++
				l.column++
				if @deref(@add(l.source, l.pos)) == '='
					l.pos++
					l.column++
					@append(l.tokens, ast.Token(kind: ast.TokenKind.SlashEqual(0), line: l.line, column: l.column))
				else
					@append(l.tokens, ast.Token(kind: ast.TokenKind.Slash(0), line: l.line, column: l.column))
				end
			)
			'%' => (
				@append(l.tokens, ast.Token(kind: ast.TokenKind.Percent(0), line: l.line, column: l.column))
				l.pos++
				l.column++
			)
			'+' => (
				l.pos++
				l.column++
				match @deref(@add(l.source, l.pos))
					'+' => (
						l.pos++
						l.column++
						@append(l.tokens, ast.Token(kind: ast.TokenKind.PlusPlus(0), line: l.line, column: l.column))
					)
					'=' => (
						l.pos++
						l.column++
						@append(l.tokens, ast.Token(kind: ast.TokenKind.PlusEqual(0), line: l.line, column: l.column))
					)
					_ => @append(l.tokens, ast.Token(kind: ast.TokenKind.Plus(0), line: l.line, column: l.column))
				end
			)
			'-' => (
				l.pos++
				l.column++
				match @deref(@add(l.source, l.pos))
					'-' => (
						l.pos++
						l.column++
						@append(l.tokens, ast.Token(kind: ast.TokenKind.MinusMinus(0), line: l.line, column: l.column))
					)
					'=' => (
						l.pos++
						l.column++
						@append(l.tokens, ast.Token(kind: ast.TokenKind.MinusEqual(0), line: l.line, column: l.column))
					)
					_ => @append(l.tokens, ast.Token(kind: ast.TokenKind.Minus(0), line: l.line, column: l.column))
				end
			)
			'&' => (
				l.pos++
				l.column++
				match @deref(@add(l.source, l.pos))
					'&' => (
						l.pos++
						l.column++
						@append(l.tokens, ast.Token(kind: ast.TokenKind.AmpAmp(0), line: l.line, column: l.column))
					)
					'=' => (
						l.pos++
						l.column++
						@append(l.tokens, ast.Token(kind: ast.TokenKind.AmpEqual(0), line: l.line, column: l.column))
					)
					_ => @append(l.tokens, ast.Token(kind: ast.TokenKind.Amp(0), line: l.line, column: l.column))
				end
			)
			'|' => (
				l.pos++
				l.column++
				match @deref(@add(l.source, l.pos))
					'|' => (
						l.pos++
						l.column++
						@append(l.tokens, ast.Token(kind: ast.TokenKind.PipePipe(0), line: l.line, column: l.column))
					)
					'=' => (
						l.pos++
						l.column++
						@append(l.tokens, ast.Token(kind: ast.TokenKind.PipeEqual(0), line: l.line, column: l.column))
					)
					_ => @append(l.tokens, ast.Token(kind: ast.TokenKind.Pipe(0), line: l.line, column: l.column))
				end
			)
			'^' => (
				l.pos++
				l.column++
				if @deref(@add(l.source, l.pos)) == '='
					l.pos++
					l.column++
					@append(l.tokens, ast.Token(kind: ast.TokenKind.CaretEqual(0), line: l.line, column: l.column))
				else
					@append(l.tokens, ast.Token(kind: ast.TokenKind.Caret(0), line: l.line, column: l.column))
				end
			)
			'~' => (
				@append(l.tokens, ast.Token(kind: ast.TokenKind.Tilde(0), line: l.line, column: l.column))
				l.pos++
				l.column++
			)
			'?' => (
				@append(l.tokens, ast.Token(kind: ast.TokenKind.Question(0), line: l.line, column: l.column))
				l.pos++
				l.column++
			)
			'#' => (
				l.pos++
				for l.pos < l.len
					val c u8 = @deref(@add(l.source, l.pos))
					if c == '\n'
						break
					end
					l.pos++
				end
			)
			'[' => (
				@append(l.tokens, ast.Token(kind: ast.TokenKind.LBracket(0), line: l.line, column: l.column))
				l.pos++
				l.column++
			)
			']' => (
				@append(l.tokens, ast.Token(kind: ast.TokenKind.RBracket(0), line: l.line, column: l.column))
				l.pos++
				l.column++
			)
			'{' => (
				@append(l.tokens, ast.Token(kind: ast.TokenKind.LBrace(0), line: l.line, column: l.column))
				l.pos++
				l.column++
			)
			'}' => (
				@append(l.tokens, ast.Token(kind: ast.TokenKind.RBrace(0), line: l.line, column: l.column))
				l.pos++
				l.column++
			)
			'\'' => (
				l.pos++
				l.column++
				@append(l.tokens, lex_char_lit(@addr(l)))
			)
			'"' => (
				l.pos++
				l.column++
				@append(l.tokens, lex_string_lit(@addr(l), arena))
			)
			_ => (
				if ch >= '0' && ch <= '9'
					@append(l.tokens, lex_number(@addr(l)))
				elif ch == '_' || (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z')
					@append(l.tokens, lex_ident(@addr(l), arena))
				else
					l.pos++
					l.column++
				end
			)
		end
	end

	@append(l.tokens, ast.Token(kind: ast.TokenKind.Eof(0), line: l.line, column: l.column))
	return l.tokens
end

def lex_string_lit(l ref(ast.Lexer), arena ref(allocators.Arena)) ast.Token
	val line usize = l.line
	val column usize = l.column
	val buf_res = allocators.Arena.alloc(arena, 256)
	var buf ref(u8) = none
	match buf_res
		ok m => buf = m as ref(u8)
		error _ => return ast.Token(kind: ast.TokenKind.Str(none), line: line, column: column)
	end
	var buf_len usize = 0

	for l.pos < l.len
		val ch u8 = @deref(@add(l.source, l.pos))
		if ch == '"'
			l.pos++
			l.column++
			@deref(@as_mut(@add(buf, buf_len))) = 0
			return ast.Token(kind: ast.TokenKind.Str(buf), line: line, column: column)
		elif ch == '\\'
			l.pos++
			@deref(@as_mut(@add(buf, buf_len))) = lex_escape(l)
			buf_len = buf_len + 1
		elif ch == '\n'
			l.pos++
			return ast.Token(kind: ast.TokenKind.Str(none), line: line, column: column)
		else
			@deref(@as_mut(@add(buf, buf_len))) = ch
			buf_len = buf_len + 1
			l.pos++
			l.column++
		end
	end

	return ast.Token(kind: ast.TokenKind.Str(none), line: line, column: column)
end

def lex_char_lit(l ref(ast.Lexer)) ast.Token
	val line usize = l.line
	val column usize = l.column
	var ch u8 = @deref(@add(l.source, l.pos))
	if ch == '\\'
		l.pos++
		ch = lex_escape(l)
	else
		l.pos++
		l.column++
	end
	if @deref(@add(l.source, l.pos)) == '\''
		l.pos++
		l.column++
	end
	return ast.Token(kind: ast.TokenKind.Char(ch), line: line, column: column)
end

def lex_escape(l ref(ast.Lexer)) u8
	val ch u8 = @deref(@add(l.source, l.pos))
	l.pos++
	l.column++
	match ch
		'n' => return '\n'
		't' => return '\t'
		'r' => return '\r'
		'0' => return 0
		'\\' => return '\\'
		'"' => return '"'
		'\'' => return '\''
		'x' => (
			val high u8 = @deref(@add(l.source, l.pos))
			l.pos++
			l.column++
			val low u8 = @deref(@add(l.source, l.pos))
			l.pos++
			l.column++
			var high_val u8 = 0
			if high >= '0' && high <= '9'
				high_val = high - '0'
			elif high >= 'a' && high <= 'f'
				high_val = high - 'a' + 10
			elif high >= 'A' && high <= 'F'
				high_val = high - 'A' + 10
			end
			var low_val u8 = 0
			if low >= '0' && low <= '9'
				low_val = low - '0'
			elif low >= 'a' && low <= 'f'
				low_val = low - 'a' + 10
			elif low >= 'A' && low <= 'F'
				low_val = low - 'A' + 10
			end
			return (high_val << 4) | low_val
		)
		_ => return ch
	end
end

def lex_number(l ref(ast.Lexer)) ast.Token
	val (
		line usize   = l.line
		column usize = l.column
	)
	
	if @deref(@add(l.source, l.pos)) == '0' && (@deref(@add(l.source, l.pos + 1)) == 'x' || @deref(@add(l.source, l.pos + 1)) == 'X')
		l.pos++
		l.column++
		l.pos++
		l.column++
		var value u64 = 0
		for l.pos < l.len
			val ch u8 = @deref(@add(l.source, l.pos))
			if ch == '_' || (ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f') || (ch >= 'A' && ch <= 'F')
				if ch >= '0' && ch <= '9'
					value = value * 16 + (ch - '0') as u64
				elif ch >= 'a' && ch <= 'f'
					value = value * 16 + (ch - 'a' + 10) as u64
				elif ch >= 'A' && ch <= 'F'
					value = value * 16 + (ch - 'A' + 10) as u64
				end
				l.pos++
				l.column++
			else
				break
			end
		end
		return ast.Token(kind: ast.TokenKind.Int(value), line: line, column: column)
	end

	if @deref(@add(l.source, l.pos)) == '0' && (@deref(@add(l.source, l.pos + 1)) == 'b' || @deref(@add(l.source, l.pos + 1)) == 'B')
		l.pos++
		l.column++
		l.pos++
		l.column++
		var value u64 = 0
		for l.pos < l.len
			val ch u8 = @deref(@add(l.source, l.pos))
			if ch == '0' || ch == '1'
				value = value * 2 + (ch - '0') as u64
			elif ch == '_'
			else
				break
			end
			l.pos++
			l.column++
		end
		return ast.Token(kind: ast.TokenKind.Int(value), line: line, column: column)
	end

	val start_pos usize = l.pos
	var is_float bool = false

	for l.pos < l.len
		val ch u8 = @deref(@add(l.source, l.pos))
		if ch == '_' || (ch >= '0' && ch <= '9') || (ch == '.' && !is_float)
			if ch >= '0' && ch <= '9'
				l.pos++
				l.column++
			elif ch == '.' && @deref(@add(l.source, l.pos + 1)) >= '0' && @deref(@add(l.source, l.pos + 1)) <= '9'
				is_float = true
				l.pos++
				l.column++
			elif ch == '_'
				l.pos++
				l.column++
			end
		else
			break
		end
	end

	if l.pos < l.len && (@deref(@add(l.source, l.pos)) == 'e' || @deref(@add(l.source, l.pos)) == 'E')
		is_float = true
		l.pos++
		l.column++
		if l.pos < l.len && (@deref(@add(l.source, l.pos)) == '+' || @deref(@add(l.source, l.pos)) == '-')
			l.pos++
			l.column++
		end
		for l.pos < l.len && @deref(@add(l.source, l.pos)) >= '0' && @deref(@add(l.source, l.pos)) <= '9'
			l.pos++
			l.column++
		end
	end

	if is_float
		return ast.Token(kind: ast.TokenKind.Float(0.0), line: line, column: column)
	end

	var value u64 = 0
	var i usize = start_pos
	for i < l.pos
		val c u8 = @deref(@add(l.source, i))
		if c != '_'
			value = value * 10 + (c - '0') as u64
		end
		i = i + 1
	end
	return ast.Token(kind: ast.TokenKind.Int(value), line: line, column: column)
end

def lex_ident(l ref(ast.Lexer), arena ref(allocators.Arena)) ast.Token
	val line usize = l.line
	val column usize = l.column
	val start usize = l.pos

	for l.pos < l.len
		val ch u8 = @deref(@add(l.source, l.pos))
		if ch == '_' || (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9')
			l.pos++
			l.column++
		else
			break
		end
	end

	val length usize = l.pos - start
	val name_res = allocators.Arena.alloc(arena, length + 1)
	var name ref(u8) = none
	match name_res
		ok m => name = m as ref(u8)
		error _ => return ast.Token(kind: ast.TokenKind.Eof(0), line: line, column: column)
	end
	@memcpy(name, @add(l.source, start), length)
	@deref(@as_mut(@add(name, length))) = 0

	match str.len(name)
		2 => match @deref(@add(name, 0))
			'a' => if str.eql(name, "as")
				return ast.Token(kind: ast.TokenKind.Keyword(32), line: line, column: column)
			end
			'i' => if str.eql(name, "if")
				return ast.Token(kind: ast.TokenKind.Keyword(7), line: line, column: column)
			elif str.eql(name, "in")
				return ast.Token(kind: ast.TokenKind.Keyword(33), line: line, column: column)
			elif str.eql(name, "i8")
				return ast.Token(kind: ast.TokenKind.Keyword(17), line: line, column: column)
			end
			'u' => if str.eql(name, "u8")
				return ast.Token(kind: ast.TokenKind.Keyword(22), line: line, column: column)
			end
		end
		3 => match @deref(@add(name, 0))
			'd' => if str.eql(name, "def")
				return ast.Token(kind: ast.TokenKind.Keyword(2), line: line, column: column)
			end
			'e' => if str.eql(name, "end")
				return ast.Token(kind: ast.TokenKind.Keyword(3), line: line, column: column)
			end
			'f' => if str.eql(name, "f32")
				return ast.Token(kind: ast.TokenKind.Keyword(27), line: line, column: column)
			elif str.eql(name, "f64")
				return ast.Token(kind: ast.TokenKind.Keyword(28), line: line, column: column)
			elif str.eql(name, "for")
				return ast.Token(kind: ast.TokenKind.Keyword(10), line: line, column: column)
			end
			'i' => if str.eql(name, "i16")
				return ast.Token(kind: ast.TokenKind.Keyword(18), line: line, column: column)
			elif str.eql(name, "i32")
				return ast.Token(kind: ast.TokenKind.Keyword(19), line: line, column: column)
			elif str.eql(name, "i64")
				return ast.Token(kind: ast.TokenKind.Keyword(20), line: line, column: column)
			end
			'm' => if str.eql(name, "mut")
				return ast.Token(kind: ast.TokenKind.Keyword(29), line: line, column: column)
			end
			'r' => if str.eql(name, "ref")
				return ast.Token(kind: ast.TokenKind.Keyword(30), line: line, column: column)
			end
			'u' => if str.eql(name, "u16")
				return ast.Token(kind: ast.TokenKind.Keyword(23), line: line, column: column)
			elif str.eql(name, "u32")
				return ast.Token(kind: ast.TokenKind.Keyword(24), line: line, column: column)
			elif str.eql(name, "u64")
				return ast.Token(kind: ast.TokenKind.Keyword(25), line: line, column: column)
			end
			'p' => if str.eql(name, "pub")
				return ast.Token(kind: ast.TokenKind.Keyword(1), line: line, column: column)
			end
			'v' => if str.eql(name, "val")
				return ast.Token(kind: ast.TokenKind.Keyword(5), line: line, column: column)
			elif str.eql(name, "var")
				return ast.Token(kind: ast.TokenKind.Keyword(4), line: line, column: column)
			end
		end
		4 => match @deref(@add(name, 0))
			'b' => if str.eql(name, "bool")
				return ast.Token(kind: ast.TokenKind.Keyword(16), line: line, column: column)
			end
			'e' => if str.eql(name, "else")
				return ast.Token(kind: ast.TokenKind.Keyword(8), line: line, column: column)
			elif str.eql(name, "elif")
				return ast.Token(kind: ast.TokenKind.Keyword(9), line: line, column: column)
			elif str.eql(name, "enum")
				return ast.Token(kind: ast.TokenKind.Keyword(41), line: line, column: column)
			end
			'l' => if str.eql(name, "link")
				return ast.Token(kind: ast.TokenKind.Keyword(46), line: line, column: column)
			elif str.eql(name, "list")
				return ast.Token(kind: ast.TokenKind.Keyword(31), line: line, column: column)
			end
			'n' => if str.eql(name, "none")
				return ast.Token(kind: ast.TokenKind.Keyword(38), line: line, column: column)
			end
			't' => if str.eql(name, "test")
				return ast.Token(kind: ast.TokenKind.Keyword(35), line: line, column: column)
			elif str.eql(name, "true")
				return ast.Token(kind: ast.TokenKind.Keyword(36), line: line, column: column)
			elif str.eql(name, "type")
				return ast.Token(kind: ast.TokenKind.Keyword(39), line: line, column: column)
			end
			'v' => if str.eql(name, "void")
				return ast.Token(kind: ast.TokenKind.Keyword(15), line: line, column: column)
			end
			'w' => if str.eql(name, "when")
				return ast.Token(kind: ast.TokenKind.Keyword(45), line: line, column: column)
			end
		end
		5 => match @deref(@add(name, 0))
			'b' => if str.eql(name, "break")
				return ast.Token(kind: ast.TokenKind.Keyword(13), line: line, column: column)
			end
			'd' => if str.eql(name, "defer")
				return ast.Token(kind: ast.TokenKind.Keyword(44), line: line, column: column)
			end
			'f' => if str.eql(name, "false")
				return ast.Token(kind: ast.TokenKind.Keyword(37), line: line, column: column)
			end
			'g' => if str.eql(name, "guard")
				return ast.Token(kind: ast.TokenKind.Keyword(47), line: line, column: column)
			end
			'i' => if str.eql(name, "isize")
				return ast.Token(kind: ast.TokenKind.Keyword(21), line: line, column: column)
			end
			'm' => if str.eql(name, "match")
				return ast.Token(kind: ast.TokenKind.Keyword(12), line: line, column: column)
			end
			'u' => if str.eql(name, "union")
				return ast.Token(kind: ast.TokenKind.Keyword(40), line: line, column: column)
			elif str.eql(name, "usize")
				return ast.Token(kind: ast.TokenKind.Keyword(26), line: line, column: column)
			end
			'w' => if str.eql(name, "while")
				return ast.Token(kind: ast.TokenKind.Keyword(11), line: line, column: column)
			end
		end
		6 => match @deref(@add(name, 0))
			'e' => if str.eql(name, "extern")
				return ast.Token(kind: ast.TokenKind.Keyword(34), line: line, column: column)
			end
			'r' => if str.eql(name, "return")
				return ast.Token(kind: ast.TokenKind.Keyword(6), line: line, column: column)
			end
		end
		7 => match @deref(@add(name, 0))
			't' => if str.eql(name, "typeset")
				return ast.Token(kind: ast.TokenKind.Keyword(43), line: line, column: column)
			end
		end
		8 => match @deref(@add(name, 0))
			'c' => if str.eql(name, "continue")
				return ast.Token(kind: ast.TokenKind.Keyword(14), line: line, column: column)
			end
		end
		9 => match @deref(@add(name, 0))
			'i' => if str.eql(name, "interface")
				return ast.Token(kind: ast.TokenKind.Keyword(42), line: line, column: column)
			end
		end
	end

	return ast.Token(kind: ast.TokenKind.Ident(name), line: line, column: column)
end

pub def token_kind_name(kind ast.TokenKind) ref(u8)
	match kind
		Keyword(_) => return "keyword"
		Ident(_) => return "ident"
		Int(_) => return "int"
		Float(_) => return "float"
		Char(_) => return "char"
		Str(_) => return "string"
		LParen(_) => return "("
		RParen(_) => return ")"
		LBrace(_) => return "{"
		RBrace(_) => return "}"
		LBracket(_) => return "["
		RBracket(_) => return "]"
		Comma(_) => return ","
		Colon(_) => return ":"
		ColonColon(_) => return "::"
		Dot(_) => return "."
		DotDot(_) => return ".."
		Assign(_) => return "="
		EqualEqual(_) => return "=="
		BangEqual(_) => return "!="
		Amp(_) => return "&"
		AmpAmp(_) => return "&&"
		AmpEqual(_) => return "&="
		Pipe(_) => return "|"
		PipePipe(_) => return "||"
		PipeEqual(_) => return "|="
		Caret(_) => return "^"
		CaretEqual(_) => return "^="
		Bang(_) => return "!"
		Tilde(_) => return "~"
		Less(_) => return "<"
		LessEqual(_) => return "<="
		ShiftLeft(_) => return "<<"
		Greater(_) => return ">"
		GreaterEqual(_) => return ">="
		ShiftRight(_) => return ">>"
		Star(_) => return "*"
		StarEqual(_) => return "*="
		Slash(_) => return "/"
		SlashEqual(_) => return "/="
		Percent(_) => return "%"
		Minus(_) => return "-"
		MinusMinus(_) => return "--"
		MinusEqual(_) => return "-="
		Plus(_) => return "+"
		PlusPlus(_) => return "++"
		PlusEqual(_) => return "+="
		FatArrow(_) => return "=>"
		Question(_) => return "?"
		At(_) => return "@"
		Newline(_) => return "newline"
		Eof(_) => return "eof"
	end
end
