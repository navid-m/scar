val str = use("std/string")

pub union TokenKind
	Keyword(u8)
	Ident(ref(u8))
	Int(u64)
	Float(f64)
	Char(u8)
	Str(ref(u8))
	LParen(u8)
	RParen(u8)
	LBrace(u8)
	RBrace(u8)
	LBracket(u8)
	RBracket(u8)
	Comma(u8)
	Colon(u8)
	ColonColon(u8)
	Dot(u8)
	DotDot(u8)
	Assign(u8)
	EqualEqual(u8)
	BangEqual(u8)
	Amp(u8)
	AmpAmp(u8)
	AmpEqual(u8)
	Pipe(u8)
	PipePipe(u8)
	PipeEqual(u8)
	Caret(u8)
	CaretEqual(u8)
	Bang(u8)
	Tilde(u8)
	Less(u8)
	LessEqual(u8)
	ShiftLeft(u8)
	Greater(u8)
	GreaterEqual(u8)
	ShiftRight(u8)
	Star(u8)
	StarEqual(u8)
	Slash(u8)
	SlashEqual(u8)
	Percent(u8)
	Minus(u8)
	MinusMinus(u8)
	MinusEqual(u8)
	Plus(u8)
	PlusPlus(u8)
	PlusEqual(u8)
	FatArrow(u8)
	Question(u8)
	At(u8)
	Newline(u8)
	Eof(u8)
end

pub type Token
	kind TokenKind
	line usize
	column usize
end

pub type Lexer
	source ref(u8)
	len usize
	pos usize
	line usize
	column usize
	tokens list[Token]
end

pub def lex(source ref(u8)) list[Token]
	val len usize = str.len(source)
	var l Lexer = Lexer(source: source, len: len, pos: 0, line: 1, column: 1, tokens: [Token(kind: TokenKind.Eof(0), line: 0, column: 0)])
	@clear(l.tokens)

	for l.pos < l.len
		val ch u8 = @deref(@add(l.source, l.pos))

		match ch
			' ' => (
				l.pos = l.pos + 1
				l.column = l.column + 1
			)
			'\t' => (
				l.pos = l.pos + 1
				l.column = l.column + 1
			)
			'\r' => l.pos = l.pos + 1
			'\n' => (
				@append(l.tokens, Token(kind: TokenKind.Newline(0), line: l.line, column: l.column))
				l.pos = l.pos + 1
				l.line = l.line + 1
				l.column = 1
			)
			'#' => (
				l.pos = l.pos + 1
				for l.pos < l.len
					val c u8 = @deref(@add(l.source, l.pos))
					if c == '\n'
						l.pos = l.pos + 1
						break
					end
					l.pos = l.pos + 1
				end
			)
			'@' => (
				@append(l.tokens, Token(kind: TokenKind.At(0), line: l.line, column: l.column))
				l.pos = l.pos + 1
				l.column = l.column + 1
			)
			'(' => (
				@append(l.tokens, Token(kind: TokenKind.LParen(0), line: l.line, column: l.column))
				l.pos = l.pos + 1
				l.column = l.column + 1
			)
			')' => (
				@append(l.tokens, Token(kind: TokenKind.RParen(0), line: l.line, column: l.column))
				l.pos = l.pos + 1
				l.column = l.column + 1
			)
			',' => (
				@append(l.tokens, Token(kind: TokenKind.Comma(0), line: l.line, column: l.column))
				l.pos = l.pos + 1
				l.column = l.column + 1
			)
			'.' => (
				l.pos = l.pos + 1
				l.column = l.column + 1
				if @deref(@add(l.source, l.pos)) == '.'
					l.pos = l.pos + 1
					l.column = l.column + 1
					@append(l.tokens, Token(kind: TokenKind.DotDot(0), line: l.line, column: l.column))
				else
					@append(l.tokens, Token(kind: TokenKind.Dot(0), line: l.line, column: l.column))
				end
			)
			':' => (
				l.pos = l.pos + 1
				l.column = l.column + 1
				if @deref(@add(l.source, l.pos)) == ':'
					l.pos = l.pos + 1
					l.column = l.column + 1
					@append(l.tokens, Token(kind: TokenKind.ColonColon(0), line: l.line, column: l.column))
				else
					@append(l.tokens, Token(kind: TokenKind.Colon(0), line: l.line, column: l.column))
				end
			)
			'=' => (
				l.pos = l.pos + 1
				l.column = l.column + 1
				match @deref(@add(l.source, l.pos))
					'=' => (
						l.pos = l.pos + 1
						l.column = l.column + 1
						@append(l.tokens, Token(kind: TokenKind.EqualEqual(0), line: l.line, column: l.column))
					)
					'>' => (
						l.pos = l.pos + 1
						l.column = l.column + 1
						@append(l.tokens, Token(kind: TokenKind.FatArrow(0), line: l.line, column: l.column))
					)
					_ => @append(l.tokens, Token(kind: TokenKind.Assign(0), line: l.line, column: l.column))
				end
			)
			'!' => (
				l.pos = l.pos + 1
				l.column = l.column + 1
				if @deref(@add(l.source, l.pos)) == '='
					l.pos = l.pos + 1
					l.column = l.column + 1
					@append(l.tokens, Token(kind: TokenKind.BangEqual(0), line: l.line, column: l.column))
				else
					@append(l.tokens, Token(kind: TokenKind.Bang(0), line: l.line, column: l.column))
				end
			)
			'<' => (
				l.pos = l.pos + 1
				l.column = l.column + 1
				match @deref(@add(l.source, l.pos))
					'<' => (
						l.pos = l.pos + 1
						l.column = l.column + 1
						@append(l.tokens, Token(kind: TokenKind.ShiftLeft(0), line: l.line, column: l.column))
					)
					'=' => (
						l.pos = l.pos + 1
						l.column = l.column + 1
						@append(l.tokens, Token(kind: TokenKind.LessEqual(0), line: l.line, column: l.column))
					)
					_ => @append(l.tokens, Token(kind: TokenKind.Less(0), line: l.line, column: l.column))
				end
			)
			'>' => (
				l.pos = l.pos + 1
				l.column = l.column + 1
				match @deref(@add(l.source, l.pos))
					'>' => (
						l.pos = l.pos + 1
						l.column = l.column + 1
						@append(l.tokens, Token(kind: TokenKind.ShiftRight(0), line: l.line, column: l.column))
					)
					'=' => (
						l.pos = l.pos + 1
						l.column = l.column + 1
						@append(l.tokens, Token(kind: TokenKind.GreaterEqual(0), line: l.line, column: l.column))
					)
					_ => @append(l.tokens, Token(kind: TokenKind.Greater(0), line: l.line, column: l.column))
				end
			)
			'*' => (
				l.pos = l.pos + 1
				l.column = l.column + 1
				if @deref(@add(l.source, l.pos)) == '='
					l.pos = l.pos + 1
					l.column = l.column + 1
					@append(l.tokens, Token(kind: TokenKind.StarEqual(0), line: l.line, column: l.column))
				else
					@append(l.tokens, Token(kind: TokenKind.Star(0), line: l.line, column: l.column))
				end
			)
			'/' => (
				l.pos = l.pos + 1
				l.column = l.column + 1
				if @deref(@add(l.source, l.pos)) == '='
					l.pos = l.pos + 1
					l.column = l.column + 1
					@append(l.tokens, Token(kind: TokenKind.SlashEqual(0), line: l.line, column: l.column))
				else
					@append(l.tokens, Token(kind: TokenKind.Slash(0), line: l.line, column: l.column))
				end
			)
			'%' => (
				@append(l.tokens, Token(kind: TokenKind.Percent(0), line: l.line, column: l.column))
				l.pos = l.pos + 1
				l.column = l.column + 1
			)
			'+' => (
				l.pos = l.pos + 1
				l.column = l.column + 1
				match @deref(@add(l.source, l.pos))
					'+' => (
						l.pos = l.pos + 1
						l.column = l.column + 1
						@append(l.tokens, Token(kind: TokenKind.PlusPlus(0), line: l.line, column: l.column))
					)
					'=' => (
						l.pos = l.pos + 1
						l.column = l.column + 1
						@append(l.tokens, Token(kind: TokenKind.PlusEqual(0), line: l.line, column: l.column))
					)
					_ => @append(l.tokens, Token(kind: TokenKind.Plus(0), line: l.line, column: l.column))
				end
			)
			'-' => (
				l.pos = l.pos + 1
				l.column = l.column + 1
				match @deref(@add(l.source, l.pos))
					'-' => (
						l.pos = l.pos + 1
						l.column = l.column + 1
						@append(l.tokens, Token(kind: TokenKind.MinusMinus(0), line: l.line, column: l.column))
					)
					'=' => (
						l.pos = l.pos + 1
						l.column = l.column + 1
						@append(l.tokens, Token(kind: TokenKind.MinusEqual(0), line: l.line, column: l.column))
					)
					_ => @append(l.tokens, Token(kind: TokenKind.Minus(0), line: l.line, column: l.column))
				end
			)
			'&' => (
				l.pos = l.pos + 1
				l.column = l.column + 1
				match @deref(@add(l.source, l.pos))
					'&' => (
						l.pos = l.pos + 1
						l.column = l.column + 1
						@append(l.tokens, Token(kind: TokenKind.AmpAmp(0), line: l.line, column: l.column))
					)
					'=' => (
						l.pos = l.pos + 1
						l.column = l.column + 1
						@append(l.tokens, Token(kind: TokenKind.AmpEqual(0), line: l.line, column: l.column))
					)
					_ => @append(l.tokens, Token(kind: TokenKind.Amp(0), line: l.line, column: l.column))
				end
			)
			'|' => (
				l.pos = l.pos + 1
				l.column = l.column + 1
				match @deref(@add(l.source, l.pos))
					'|' => (
						l.pos = l.pos + 1
						l.column = l.column + 1
						@append(l.tokens, Token(kind: TokenKind.PipePipe(0), line: l.line, column: l.column))
					)
					'=' => (
						l.pos = l.pos + 1
						l.column = l.column + 1
						@append(l.tokens, Token(kind: TokenKind.PipeEqual(0), line: l.line, column: l.column))
					)
					_ => @append(l.tokens, Token(kind: TokenKind.Pipe(0), line: l.line, column: l.column))
				end
			)
			'^' => (
				l.pos = l.pos + 1
				l.column = l.column + 1
				if @deref(@add(l.source, l.pos)) == '='
					l.pos = l.pos + 1
					l.column = l.column + 1
					@append(l.tokens, Token(kind: TokenKind.CaretEqual(0), line: l.line, column: l.column))
				else
					@append(l.tokens, Token(kind: TokenKind.Caret(0), line: l.line, column: l.column))
				end
			)
			'~' => (
				@append(l.tokens, Token(kind: TokenKind.Tilde(0), line: l.line, column: l.column))
				l.pos = l.pos + 1
				l.column = l.column + 1
			)
			'?' => (
				@append(l.tokens, Token(kind: TokenKind.Question(0), line: l.line, column: l.column))
				l.pos = l.pos + 1
				l.column = l.column + 1
			)
			'#' => (
				l.pos = l.pos + 1
				for l.pos < l.len
					val c u8 = @deref(@add(l.source, l.pos))
					if c == '\n'
						break
					end
					l.pos = l.pos + 1
				end
			)
			'[' => (
				@append(l.tokens, Token(kind: TokenKind.LBracket(0), line: l.line, column: l.column))
				l.pos = l.pos + 1
				l.column = l.column + 1
			)
			']' => (
				@append(l.tokens, Token(kind: TokenKind.RBracket(0), line: l.line, column: l.column))
				l.pos = l.pos + 1
				l.column = l.column + 1
			)
			'{' => (
				@append(l.tokens, Token(kind: TokenKind.LBrace(0), line: l.line, column: l.column))
				l.pos = l.pos + 1
				l.column = l.column + 1
			)
			'}' => (
				@append(l.tokens, Token(kind: TokenKind.RBrace(0), line: l.line, column: l.column))
				l.pos = l.pos + 1
				l.column = l.column + 1
			)
			'\'' => (
				l.pos = l.pos + 1
				l.column = l.column + 1
				@append(l.tokens, lex_char_lit(@addr(l)))
			)
			'"' => (
				l.pos = l.pos + 1
				l.column = l.column + 1
				@append(l.tokens, lex_string_lit(@addr(l)))
			)
			_ => (
				if ch >= '0' && ch <= '9'
					@append(l.tokens, lex_number(@addr(l)))
				elif ch == '_' || (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z')
					@append(l.tokens, lex_ident(@addr(l)))
				else
					l.pos = l.pos + 1
					l.column = l.column + 1
				end
			)
		end
	end

	@append(l.tokens, Token(kind: TokenKind.Eof(0), line: l.line, column: l.column))
	return l.tokens
end

def lex_string_lit(l ref(Lexer)) Token
	val line usize = l.line
	val column usize = l.column
	var buf ref(u8) = @alloc(256)
	var buf_len usize = 0

	for l.pos < l.len
		val ch u8 = @deref(@add(l.source, l.pos))
		if ch == '"'
			l.pos = l.pos + 1
			l.column = l.column + 1
			@deref(@as_mut(@add(buf, buf_len))) = 0
			return Token(kind: TokenKind.Str(buf), line: line, column: column)
		elif ch == '\\'
			l.pos = l.pos + 1
			@deref(@as_mut(@add(buf, buf_len))) = lex_escape(l)
			buf_len = buf_len + 1
		elif ch == '\n'
			l.pos = l.pos + 1
			return Token(kind: TokenKind.Str(none), line: line, column: column)
		else
			@deref(@as_mut(@add(buf, buf_len))) = ch
			buf_len = buf_len + 1
			l.pos = l.pos + 1
			l.column = l.column + 1
		end
	end

	return Token(kind: TokenKind.Str(none), line: line, column: column)
end

def lex_char_lit(l ref(Lexer)) Token
	val line usize = l.line
	val column usize = l.column
	var ch u8 = @deref(@add(l.source, l.pos))
	if ch == '\\'
		l.pos = l.pos + 1
		ch = lex_escape(l)
	else
		l.pos = l.pos + 1
		l.column = l.column + 1
	end
	if @deref(@add(l.source, l.pos)) == '\''
		l.pos = l.pos + 1
		l.column = l.column + 1
	end
	return Token(kind: TokenKind.Char(ch), line: line, column: column)
end

def lex_escape(l ref(Lexer)) u8
	val ch u8 = @deref(@add(l.source, l.pos))
	l.pos = l.pos + 1
	l.column = l.column + 1
	match ch
		'n' => return '\n'
		't' => return '\t'
		'r' => return '\r'
		'0' => return 0
		'\\' => return '\\'
		'"' => return '"'
		'\'' => return '\''
		_ => return ch
	end
end

def lex_number(l ref(Lexer)) Token
	val line usize = l.line
	val column usize = l.column
	
	if @deref(@add(l.source, l.pos)) == '0' && (@deref(@add(l.source, l.pos + 1)) == 'x' || @deref(@add(l.source, l.pos + 1)) == 'X')
		l.pos = l.pos + 1
		l.column = l.column + 1
		l.pos = l.pos + 1
		l.column = l.column + 1
		var value u64 = 0
		for l.pos < l.len
			val ch u8 = @deref(@add(l.source, l.pos))
			if ch == '_' || (ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f') || (ch >= 'A' && ch <= 'F')
				if ch >= '0' && ch <= '9'
					value = value * 16 + (ch - '0') as u64
				elif ch >= 'a' && ch <= 'f'
					value = value * 16 + (ch - 'a' + 10) as u64
				elif ch >= 'A' && ch <= 'F'
					value = value * 16 + (ch - 'A' + 10) as u64
				end
				l.pos = l.pos + 1
				l.column = l.column + 1
			else
				break
			end
		end
		return Token(kind: TokenKind.Int(value), line: line, column: column)
	end

	if @deref(@add(l.source, l.pos)) == '0' && (@deref(@add(l.source, l.pos + 1)) == 'b' || @deref(@add(l.source, l.pos + 1)) == 'B')
		l.pos = l.pos + 1
		l.column = l.column + 1
		l.pos = l.pos + 1
		l.column = l.column + 1
		var value u64 = 0
		for l.pos < l.len
			val ch u8 = @deref(@add(l.source, l.pos))
			if ch == '0' || ch == '1'
				value = value * 2 + (ch - '0') as u64
			elif ch == '_'
			else
				break
			end
			l.pos = l.pos + 1
			l.column = l.column + 1
		end
		return Token(kind: TokenKind.Int(value), line: line, column: column)
	end

	val start_pos usize = l.pos
	var is_float bool = false

	for l.pos < l.len
		val ch u8 = @deref(@add(l.source, l.pos))
		if ch == '_' || (ch >= '0' && ch <= '9') || (ch == '.' && !is_float)
			if ch >= '0' && ch <= '9'
				l.pos = l.pos + 1
				l.column = l.column + 1
			elif ch == '.' && @deref(@add(l.source, l.pos + 1)) >= '0' && @deref(@add(l.source, l.pos + 1)) <= '9'
				is_float = true
				l.pos = l.pos + 1
				l.column = l.column + 1
			elif ch == '_'
				l.pos = l.pos + 1
				l.column = l.column + 1
			end
		else
			break
		end
	end

	if l.pos < l.len && (@deref(@add(l.source, l.pos)) == 'e' || @deref(@add(l.source, l.pos)) == 'E')
		is_float = true
		l.pos = l.pos + 1
		l.column = l.column + 1
		if l.pos < l.len && (@deref(@add(l.source, l.pos)) == '+' || @deref(@add(l.source, l.pos)) == '-')
			l.pos = l.pos + 1
			l.column = l.column + 1
		end
		for l.pos < l.len && @deref(@add(l.source, l.pos)) >= '0' && @deref(@add(l.source, l.pos)) <= '9'
			l.pos = l.pos + 1
			l.column = l.column + 1
		end
	end

	if is_float
		return Token(kind: TokenKind.Float(0.0), line: line, column: column)
	end

	var value u64 = 0
	var i usize = start_pos
	for i < l.pos
		val c u8 = @deref(@add(l.source, i))
		if c != '_'
			value = value * 10 + (c - '0') as u64
		end
		i = i + 1
	end
	return Token(kind: TokenKind.Int(value), line: line, column: column)
end

def lex_ident(l ref(Lexer)) Token
	val line usize = l.line
	val column usize = l.column
	val start usize = l.pos

	for l.pos < l.len
		val ch u8 = @deref(@add(l.source, l.pos))
		if ch == '_' || (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9')
			l.pos = l.pos + 1
			l.column = l.column + 1
		else
			break
		end
	end

	val length usize = l.pos - start
	var name ref(u8) = @alloc(length + 1)
	@memcpy(name, @add(l.source, start), length)
	@deref(@as_mut(@add(name, length))) = 0

	match str.len(name)
		2 => match @deref(@add(name, 0))
			'a' => if str.eql(name, "as")
				return Token(kind: TokenKind.Keyword(32), line: line, column: column)
			end
			'i' => if str.eql(name, "if")
				return Token(kind: TokenKind.Keyword(7), line: line, column: column)
			elif str.eql(name, "in")
				return Token(kind: TokenKind.Keyword(33), line: line, column: column)
			elif str.eql(name, "i8")
				return Token(kind: TokenKind.Keyword(17), line: line, column: column)
			end
			'u' => if str.eql(name, "u8")
				return Token(kind: TokenKind.Keyword(22), line: line, column: column)
			end
		end
		3 => match @deref(@add(name, 0))
			'd' => if str.eql(name, "def")
				return Token(kind: TokenKind.Keyword(2), line: line, column: column)
			end
			'e' => if str.eql(name, "end")
				return Token(kind: TokenKind.Keyword(3), line: line, column: column)
			end
			'f' => if str.eql(name, "f32")
				return Token(kind: TokenKind.Keyword(27), line: line, column: column)
			elif str.eql(name, "f64")
				return Token(kind: TokenKind.Keyword(28), line: line, column: column)
			elif str.eql(name, "for")
				return Token(kind: TokenKind.Keyword(10), line: line, column: column)
			end
			'i' => if str.eql(name, "i16")
				return Token(kind: TokenKind.Keyword(18), line: line, column: column)
			elif str.eql(name, "i32")
				return Token(kind: TokenKind.Keyword(19), line: line, column: column)
			elif str.eql(name, "i64")
				return Token(kind: TokenKind.Keyword(20), line: line, column: column)
			end
			'm' => if str.eql(name, "mut")
				return Token(kind: TokenKind.Keyword(29), line: line, column: column)
			end
			'r' => if str.eql(name, "ref")
				return Token(kind: TokenKind.Keyword(30), line: line, column: column)
			end
			'u' => if str.eql(name, "u16")
				return Token(kind: TokenKind.Keyword(23), line: line, column: column)
			elif str.eql(name, "u32")
				return Token(kind: TokenKind.Keyword(24), line: line, column: column)
			elif str.eql(name, "u64")
				return Token(kind: TokenKind.Keyword(25), line: line, column: column)
			end
			'p' => if str.eql(name, "pub")
				return Token(kind: TokenKind.Keyword(1), line: line, column: column)
			end
			'v' => if str.eql(name, "val")
				return Token(kind: TokenKind.Keyword(5), line: line, column: column)
			elif str.eql(name, "var")
				return Token(kind: TokenKind.Keyword(4), line: line, column: column)
			end
		end
		4 => match @deref(@add(name, 0))
			'b' => if str.eql(name, "bool")
				return Token(kind: TokenKind.Keyword(16), line: line, column: column)
			end
			'e' => if str.eql(name, "else")
				return Token(kind: TokenKind.Keyword(8), line: line, column: column)
			elif str.eql(name, "elif")
				return Token(kind: TokenKind.Keyword(9), line: line, column: column)
			elif str.eql(name, "enum")
				return Token(kind: TokenKind.Keyword(41), line: line, column: column)
			end
			'l' => if str.eql(name, "link")
				return Token(kind: TokenKind.Keyword(46), line: line, column: column)
			elif str.eql(name, "list")
				return Token(kind: TokenKind.Keyword(31), line: line, column: column)
			end
			'n' => if str.eql(name, "none")
				return Token(kind: TokenKind.Keyword(38), line: line, column: column)
			end
			't' => if str.eql(name, "test")
				return Token(kind: TokenKind.Keyword(35), line: line, column: column)
			elif str.eql(name, "true")
				return Token(kind: TokenKind.Keyword(36), line: line, column: column)
			elif str.eql(name, "type")
				return Token(kind: TokenKind.Keyword(39), line: line, column: column)
			end
			'v' => if str.eql(name, "void")
				return Token(kind: TokenKind.Keyword(15), line: line, column: column)
			end
			'w' => if str.eql(name, "when")
				return Token(kind: TokenKind.Keyword(45), line: line, column: column)
			end
		end
		5 => match @deref(@add(name, 0))
			'b' => if str.eql(name, "break")
				return Token(kind: TokenKind.Keyword(13), line: line, column: column)
			end
			'd' => if str.eql(name, "defer")
				return Token(kind: TokenKind.Keyword(44), line: line, column: column)
			end
			'f' => if str.eql(name, "false")
				return Token(kind: TokenKind.Keyword(37), line: line, column: column)
			end
			'g' => if str.eql(name, "guard")
				return Token(kind: TokenKind.Keyword(47), line: line, column: column)
			end
			'i' => if str.eql(name, "isize")
				return Token(kind: TokenKind.Keyword(21), line: line, column: column)
			end
			'm' => if str.eql(name, "match")
				return Token(kind: TokenKind.Keyword(12), line: line, column: column)
			end
			'u' => if str.eql(name, "union")
				return Token(kind: TokenKind.Keyword(40), line: line, column: column)
			elif str.eql(name, "usize")
				return Token(kind: TokenKind.Keyword(26), line: line, column: column)
			end
			'w' => if str.eql(name, "while")
				return Token(kind: TokenKind.Keyword(11), line: line, column: column)
			end
		end
		6 => match @deref(@add(name, 0))
			'e' => if str.eql(name, "extern")
				return Token(kind: TokenKind.Keyword(34), line: line, column: column)
			end
			'r' => if str.eql(name, "return")
				return Token(kind: TokenKind.Keyword(6), line: line, column: column)
			end
		end
		7 => match @deref(@add(name, 0))
			't' => if str.eql(name, "typeset")
				return Token(kind: TokenKind.Keyword(43), line: line, column: column)
			end
		end
		8 => match @deref(@add(name, 0))
			'c' => if str.eql(name, "continue")
				return Token(kind: TokenKind.Keyword(14), line: line, column: column)
			end
		end
		9 => match @deref(@add(name, 0))
			'i' => if str.eql(name, "interface")
				return Token(kind: TokenKind.Keyword(42), line: line, column: column)
			end
		end
	end

	return Token(kind: TokenKind.Ident(name), line: line, column: column)
end

pub def token_kind_name(kind TokenKind) ref(u8)
	match kind
		Keyword(_) => return "keyword"
		Ident(_) => return "ident"
		Int(_) => return "int"
		Float(_) => return "float"
		Char(_) => return "char"
		Str(_) => return "string"
		LParen(_) => return "("
		RParen(_) => return ")"
		LBrace(_) => return "{"
		RBrace(_) => return "}"
		LBracket(_) => return "["
		RBracket(_) => return "]"
		Comma(_) => return ","
		Colon(_) => return ":"
		ColonColon(_) => return "::"
		Dot(_) => return "."
		DotDot(_) => return ".."
		Assign(_) => return "="
		EqualEqual(_) => return "=="
		BangEqual(_) => return "!="
		Amp(_) => return "&"
		AmpAmp(_) => return "&&"
		AmpEqual(_) => return "&="
		Pipe(_) => return "|"
		PipePipe(_) => return "||"
		PipeEqual(_) => return "|="
		Caret(_) => return "^"
		CaretEqual(_) => return "^="
		Bang(_) => return "!"
		Tilde(_) => return "~"
		Less(_) => return "<"
		LessEqual(_) => return "<="
		ShiftLeft(_) => return "<<"
		Greater(_) => return ">"
		GreaterEqual(_) => return ">="
		ShiftRight(_) => return ">>"
		Star(_) => return "*"
		StarEqual(_) => return "*="
		Slash(_) => return "/"
		SlashEqual(_) => return "/="
		Percent(_) => return "%"
		Minus(_) => return "-"
		MinusMinus(_) => return "--"
		MinusEqual(_) => return "-="
		Plus(_) => return "+"
		PlusPlus(_) => return "++"
		PlusEqual(_) => return "+="
		FatArrow(_) => return "=>"
		Question(_) => return "?"
		At(_) => return "@"
		Newline(_) => return "newline"
		Eof(_) => return "eof"
	end
end

test "identifies simple identifier"
	val tokens list[Token] = lex("hello")
	assert @len(tokens) == 2
	assert str.eql(token_kind_name(tokens[0].kind), "ident")
	assert str.eql(token_kind_name(tokens[1].kind), "eof")
end

test "identifies keywords"
	val tokens list[Token] = lex("pub def end")
	assert @len(tokens) == 4
	assert str.eql(token_kind_name(tokens[0].kind), "keyword")
	assert str.eql(token_kind_name(tokens[1].kind), "keyword")
	assert str.eql(token_kind_name(tokens[2].kind), "keyword")
	assert str.eql(token_kind_name(tokens[3].kind), "eof")
end

test "string literal"
	val tokens list[Token] = lex("\"hello world\"")
	assert @len(tokens) == 2
	assert str.eql(token_kind_name(tokens[0].kind), "string")
	assert str.eql(token_kind_name(tokens[1].kind), "eof")
end

test "integer literal"
	val tokens list[Token] = lex("42")
	assert @len(tokens) == 2
	assert str.eql(token_kind_name(tokens[0].kind), "int")
	assert str.eql(token_kind_name(tokens[1].kind), "eof")
end

test "comment skipping"
	val tokens list[Token] = lex("# this is a comment\nident")
	assert @len(tokens) == 2
	assert str.eql(token_kind_name(tokens[0].kind), "ident")
	assert str.eql(token_kind_name(tokens[1].kind), "eof")
end

test "single zero"
	val tokens list[Token] = lex("0")
	assert @len(tokens) == 2
end

test "hex prefix only"
	val tokens list[Token] = lex("0x")
	assert @len(tokens) == 2
end

test "hex number"
	val tokens list[Token] = lex("0xFF")
	assert @len(tokens) == 2
	assert str.eql(token_kind_name(tokens[0].kind), "int")
	assert str.eql(token_kind_name(tokens[1].kind), "eof")
end

test "operators"
	val tokens list[Token] = lex("+ - * / == != <= >=")
	assert @len(tokens) == 9
	assert str.eql(token_kind_name(tokens[0].kind), "+")
	assert str.eql(token_kind_name(tokens[1].kind), "-")
	assert str.eql(token_kind_name(tokens[2].kind), "*")
	assert str.eql(token_kind_name(tokens[3].kind), "/")
	assert str.eql(token_kind_name(tokens[4].kind), "==")
	assert str.eql(token_kind_name(tokens[5].kind), "!=")
	assert str.eql(token_kind_name(tokens[6].kind), "<=")
	assert str.eql(token_kind_name(tokens[7].kind), ">=")
	assert str.eql(token_kind_name(tokens[8].kind), "eof")
end

test "brackets and parens"
	val tokens list[Token] = lex("(){}[]")
	assert @len(tokens) == 7
	assert str.eql(token_kind_name(tokens[0].kind), "(")
	assert str.eql(token_kind_name(tokens[1].kind), ")")
	assert str.eql(token_kind_name(tokens[2].kind), "{")
	assert str.eql(token_kind_name(tokens[3].kind), "}")
	assert str.eql(token_kind_name(tokens[4].kind), "[")
	assert str.eql(token_kind_name(tokens[5].kind), "]")
	assert str.eql(token_kind_name(tokens[6].kind), "eof")
end
