val str        = use("std/string")
val fs         = use("std/fs")
val os         = use("std/os")
val allocators = use("std/allocators")
val collect    = use("std/collections")
val meta       = use("meta")
val builds     = use("builds")

val scar_version  ref(u8) = "v0.0.1"

pub def main() void
    val args list[ref(u8)] = @args()
    if @len(args) == 1
        meta.print_usage_message_and_exit()
    end
    if str.eql(args[1], "help")
        meta.print_usage_message_and_exit()
    end

    if @len(args) >= 2 && str.eql(args[1], "-v") || str.eql(args[1], "-version")
        @print("{s}\n", {scar_version})
        os.exit(0)
    end
    
    if @len(args) >= 2 && str.eql(args[1], "test")
        var (
            emit_mode bool           = false
            output_path ref(u8)      = none
            source_path ref(u8)      = none
            i usize                  = 2
        )
        for i < @len(args)
            val arg ref(u8) = args[i]
            if str.eql(arg, "-emit") || str.eql(arg, "-e")
                emit_mode = true
            elif str.eql(arg, "-o")
                if i + 1 >= @len(args)
                    @puts(meta.usage_message)
                    return
                end
                i++
                output_path = args[i]
            else
                if source_path == none
                    source_path = arg
                else
                    @puts(meta.usage_message)
                    return
                end
            end
            i++
        end
        if source_path == none
            @puts(meta.usage_message)
            return
        end
        var test_arena = allocators.Arena.new(4096 as usize)?
        defer
            allocators.Arena.destroy(@addr(test_arena))
        end
        match builds.run_test_on_file(source_path, emit_mode, output_path, @addr(test_arena))
            ok rc => (
                if rc != 0
                    os.exit(rc)
                end
            )
            error msg => (
                @print("comperr: {s}", {msg})
                os.exit(1)
            )
        end
        return
    end

    var (
        emit_mode bool             = false
        emit_output_path ref(u8)   = none
        source_path ref(u8)        = none
        binary_output_path ref(u8) = none
        i usize                    = 1
    )
    for i < @len(args)
        val arg ref(u8) = args[i]
        if str.eql(arg, "-emit") || str.eql(arg, "-e")
            emit_mode = true
        elif str.eql(arg, "-o")
            if i + 1 >= @len(args)
                @puts(meta.usage_message)
                return
            end
            i++
            val next_arg ref(u8) = args[i]
            if emit_mode
                emit_output_path = next_arg
            elif source_path != none && binary_output_path == none
                binary_output_path = next_arg
            else
                @puts(meta.usage_message)
                return
            end
        else
            if source_path == none
                source_path = arg
            else
                @puts(meta.usage_message)
                return
            end
        end
        i++
    end
    
    if source_path == none
        @puts(meta.usage_message)
        return
    end

    if emit_mode
        match builds.emit(source_path, emit_output_path)
            ok rc => (
                if rc != 0
                    os.exit(rc)
                end
            )
            error msg => (
                @puts(msg)
                os.exit(1)
            )
        end
    else
        if binary_output_path == none
            var arena = allocators.Arena.new(4096 as usize)?
            defer
                allocators.Arena.destroy(@addr(arena))
            end
            val base = fs.strip_extension[_](@addr(arena), source_path)?
            val bname = fs.basename[_](@addr(arena), base)?
            var out_buf list[u8] = []
            collect.append_str(@addr(out_buf), "./scar-out/")
            collect.append_str(@addr(out_buf), bname)
            when windows
                append_str(@addr(out_buf), ".exe")
            end
            @append(out_buf, 0)
            binary_output_path = @addr(out_buf[0])
            match fs.create_dir_all("./scar-out")
                ok _ => ()
                error msg => (
                    @puts(msg)
                    os.exit(1)
                )
            end
        end
        match builds.compile(source_path, binary_output_path)
            ok rc => (
                if rc != 0
                    os.exit(rc)
                end
            )
            error msg => (
                @print("comperr: {s}", {msg})
                os.exit(1)
            )
        end
    end
end

