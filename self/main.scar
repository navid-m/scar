val str = use("std/string")
val ast = use("ast")
val lxr = use("lexer")
val prs = use("parser")
val sema = use("sema")
val cgen = use("codegen")
val rslv = use("resolver")

extern def fopen(path ref(u8), mode ref(u8)) mut(ref(u8)) :: "fopen"
extern def fclose(file mut(ref(u8))) i32 :: "fclose"
extern def fread(buf mut(ref(u8)), size usize, count usize, file mut(ref(u8))) usize :: "fread"
extern def fseek(file mut(ref(u8)), offset i64, whence i32) i32 :: "fseek"
extern def ftell(file mut(ref(u8))) i64 :: "ftell"
extern def fwrite(buf ref(u8), size usize, count usize, file mut(ref(u8))) usize :: "fwrite"
extern def remove(path ref(u8)) i32 :: "remove"
extern def system(cmd ref(u8)) i32 :: "system"
extern def printf(fmt ref(u8)) i32 :: "printf"
extern def strlen(s ref(u8)) usize :: "strlen"
extern def exit(code i32) void :: "exit"

def read_file(path ref(u8)) ref(u8)
    val f mut(ref(u8)) = fopen(path, "rb")
    if @deref(f) == 0
        return @alloc(1)
    end
    fseek(f, 0, 0)
    val file_len i64 = ftell(f)
    fseek(f, 0, 0)
    val buf mut(ref(u8)) = @alloc(file_len as usize + 1)
    fread(buf, 1, file_len as usize, f)
    @deref(@as_mut(@add(buf, file_len as usize))) = 0
    fclose(f)
    return buf
end

def write_file(path ref(u8), content ref(u8)) i32
    val f mut(ref(u8)) = fopen(path, "w")
    if @deref(f) == 0
        return 1
    end
    val len usize = strlen(content)
    val written usize = fwrite(content, 1, len, f)
    fclose(f)
    if written != len
        return 1
    end
    return 0
end

pub def compile(source_path ref(u8), output_path ref(u8)) i32
    val source ref(u8) = read_file(source_path)
    if @deref(source) == 0
        @puts("scar: cannot read file")
        return 1
    end

    val tokens list[ast.Token] = lxr.lex(source)
    val prog ast.Program = prs.parse_program(tokens)
    val resolved ast.Program = rslv.resolve(@addr(prog))
    val info sema.ProgramInfo = sema.analyze(@addr(resolved))
    val c_code ref(u8) = cgen.generate_c(@addr(resolved), @addr(info))

    val c_path ref(u8) = "/tmp/scar-compile.c"
    val write_rc i32 = write_file(c_path, c_code)
    if write_rc != 0
        printf("scar: cannot write C output\n")
        return 1
    end

    val cmd_buf list[u8] = []
    append_str(@addr(cmd_buf), "tcc -O0 ")
    append_str(@addr(cmd_buf), c_path)
    append_str(@addr(cmd_buf), " -o ")
    append_str(@addr(cmd_buf), output_path)
    append_str(@addr(cmd_buf), " 2>/dev/null")
    @append(cmd_buf, 0)
    val cmd_str ref(u8) = @addr(cmd_buf[0])
    val rc i32 = system(cmd_str)
    if rc != 0
        printf("scar: tcc failed to compile\n")
        remove(c_path)
        return 1
    end

    remove(c_path)
    return 0
end

def append_str(buf ref(list[u8]), s ref(u8))
    val slen usize = strlen(s)
    var i usize = 0
    for i < slen
        @append(buf, @deref(@add(s, i)))
        i++
    end
end

pub def main() void
    val args list[ref(u8)] = @args()
    if @len(args) < 2
        printf("usage: scar-compile <source.scar> [output]\n")
        return
    end
    val source_path ref(u8) = args[1]
    var output_path ref(u8) = "./a.out"
    if @len(args) >= 3
        output_path = args[2]
    end
    @print("SOURCE PATH: {s}\n", {source_path})
    val rc i32 = compile(source_path, output_path)
    if rc != 0
        exit(rc)
    end
end
