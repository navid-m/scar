val str = use("std/string")
val fs = use("std/fs")
val os = use("std/os")
val allocators = use("std/allocators")
val ast = use("ast")
val lxr = use("lexer")
val prs = use("parser")
val sema = use("sema")
val cgen = use("codegen")
val rslv = use("resolver")

extern def exit(code i32) void :: "exit"

pub def compile(source_path ref(u8), output_path ref(u8)) i32|error
    var arena = allocators.Arena.new(131072 as usize)?
    defer
        allocators.Arena.destroy(@addr(arena))
    end

    val source = fs.read_text[_](@addr(arena), source_path)?
    if source == none
        return error("scar: cannot read file")
    end

    val tokens list[ast.Token] = lxr.lex(source)
    val prog ast.Program = prs.parse_program(tokens)
    val resolved ast.Program = rslv.resolve(@addr(prog))
    val info sema.ProgramInfo = sema.analyze(@addr(resolved))
    val c_code ref(u8) = cgen.generate_c(@addr(resolved), @addr(info))

    val c_path ref(u8) = "/tmp/scar-compile.c"
    fs.write_text(c_path, c_code)?

    val cmd_buf list[u8] = []
    append_str(@addr(cmd_buf), "tcc -O0 ")
    append_str(@addr(cmd_buf), c_path)
    append_str(@addr(cmd_buf), " -o ")
    append_str(@addr(cmd_buf), output_path)
    append_str(@addr(cmd_buf), " 2>/dev/null")
    @append(cmd_buf, 0)
    val cmd_str ref(u8) = @addr(cmd_buf[0])

    val rc i32 = os.exec(cmd_str)?
    if rc != 0
        fs.remove_file(c_path)
        return error("scar: tcc failed to link")
    end

    fs.remove_file(c_path)
    return 0
end

def append_str(buf ref(list[u8]), s ref(u8))
    val slen usize = str.len(s)
    var i usize = 0
    for i < slen
        @append(buf, @deref(@add(s, i)))
        i++
    end
end

pub def main() void
    val args list[ref(u8)] = @args()
    if @len(args) < 2
        @puts("usage: scar-compile <source.scar> [output]")
        return
    end
    val source_path ref(u8) = args[1]
    var output_path ref(u8) = "./a.out"
    if @len(args) >= 3
        output_path = args[2]
    end
    match compile(source_path, output_path)
        ok rc => (
            if rc != 0
                exit(rc)
            end
        )
        error msg => (
            @puts(msg)
            exit(1)
        )
    end
end
