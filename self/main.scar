val str = use("std/string")
val fs = use("std/fs")
val os = use("std/os")
val allocators = use("std/allocators")
val ast = use("ast")
val lxr = use("lexer")
val prs = use("parser")
val sema = use("sema")
val cgen = use("codegen")
val rslv = use("resolver")

pub def compile(source_path ref(u8), output_path ref(u8)) i32|error
    guard source_path != none && !str.eql(source_path, "") else
        return error("scar: source path was empty")
    end
    var arena = allocators.Arena.new(131072 as usize)?
    defer
        allocators.Arena.destroy(@addr(arena))
    end

    val source = fs.read_text[_](@addr(arena), source_path)?
    if source == none
        return error("scar: cannot read file")
    end

    val (
        tokens list[ast.Token] = lxr.lex(source)
        prog ast.Program       = prs.parse_program(tokens)
        resolved ast.Program   = rslv.resolve(@addr(prog))
        info sema.ProgramInfo  = sema.analyze(@addr(resolved))
        c_code ref(u8)         = cgen.generate_c(@addr(resolved), @addr(info))
        c_path ref(u8)         = "/tmp/scar-compile.c"
    )
    
    fs.write_text(c_path, c_code)?

    val cmd_buf list[u8] = []
    append_str(@addr(cmd_buf), "tcc -O0 ")
    append_str(@addr(cmd_buf), c_path)
    append_str(@addr(cmd_buf), " -o ")
    append_str(@addr(cmd_buf), output_path)
    append_str(@addr(cmd_buf), " 2>/dev/null")
    @append(cmd_buf, 0)

    val (
        cmd_str ref(u8) = @addr(cmd_buf[0])
        rc i32          = os.exec(cmd_str)?
    )
    
    if rc != 0
        fs.remove_file(c_path)
        return error("scar: tcc failed to link")
    end

    fs.remove_file(c_path)
    return 0
end

pub def emit(source_path ref(u8), output_path ref(u8)) i32|error
    var arena = allocators.Arena.new(131072 as usize)?
    defer
        allocators.Arena.destroy(@addr(arena))
    end

    val source = fs.read_text[_](@addr(arena), source_path)?
    if source == none
        return error("scar: cannot read file")
    end

    val (
        tokens list[ast.Token] = lxr.lex(source)
        prog ast.Program       = prs.parse_program(tokens)
        resolved ast.Program   = rslv.resolve(@addr(prog))
        info sema.ProgramInfo  = sema.analyze(@addr(resolved))
        c_code ref(u8)         = cgen.generate_c(@addr(resolved), @addr(info))
    )
    
    if output_path == none
        @puts(c_code)
    else
        fs.write_text(output_path, c_code)?
    end

    return 0
end

def append_str(buf ref(list[u8]), s ref(u8))
    val slen usize = str.len(s)
    var i usize = 0
    for i < slen
        @append(buf, @deref(@add(s, i)))
        i++
    end
end

pub def main() void
    val args list[ref(u8)] = @args()
    
    var emit_mode bool = false
    var emit_output_path ref(u8) = none
    var source_path ref(u8) = none
    var binary_output_path ref(u8) = none
    var i usize = 1
    
    for i < @len(args)
        val arg ref(u8) = args[i]
        if str.eql(arg, "-emit")
            emit_mode = true
        elif str.eql(arg, "-o")
            if i + 1 >= @len(args)
                @puts("usage: scar-compile [--emit [-o <output.c>]] <source.scar> [output]")
                return
            end
            if emit_mode
                emit_output_path = args[i + 1]
            else
                binary_output_path = args[i + 1]
            end
            i++
        else
            if source_path == none
                source_path = arg
            elif !emit_mode && binary_output_path == none
                binary_output_path = arg
            else
                @puts("usage: scar-compile [--emit [-o <output.c>]] <source.scar> [output]")
                return
            end
        end
        i++
    end
    
    if source_path == none
        @puts("usage: scar-compile [--emit [-o <output.c>]] <source.scar> [output]")
        return
    end
    
    if !emit_mode && binary_output_path == none
        binary_output_path = "./a.out"
    end
    
    if emit_mode
        match emit(source_path, emit_output_path)
            ok rc => (
                if rc != 0
                    os.exit(rc)
                end
            )
            error msg => (
                @puts(msg)
                os.exit(1)
            )
        end
    else
        match compile(source_path, binary_output_path)
            ok rc => (
                if rc != 0
                    os.exit(rc)
                end
            )
            error msg => (
                @puts(msg)
                os.exit(1)
            )
        end
    end
end
