val str = use("std/string")
val fs = use("std/fs")
val os = use("std/os")
val allocators = use("std/allocators")
val ast = use("ast")
val lxr = use("lexer")
val prs = use("parser")
val sema = use("sema")
val cgen = use("codegen")
val rslv = use("resolver")

val usage_message ref(u8) = \\ usage:
                            \\   scar [-emit <source.scar> [-o <output>]
                            \\
                            \\ -emit       Emit the generated IR
                            \\ -o          Choose output file (for -emit or binary)
    
pub def compile(source_path ref(u8), output_path ref(u8)) i32|error
    guard source_path != none && !str.eql(source_path, "") else
        return error("scar: source path was empty")
    end
    var arena = allocators.Arena.new(2097152 as usize)?
    defer
        allocators.Arena.destroy(@addr(arena))
    end

    val source = fs.read_text[_](@addr(arena), source_path)?
    if source == none
        return error("scar: cannot read file")
    end

    val (
        tokens list[ast.Token] = lxr.lex(source, @addr(arena))
        prog ast.Program       = prs.parse_program(tokens, @addr(arena))
        resolved ast.Program   = rslv.resolve(@addr(prog))
        info sema.ProgramInfo  = sema.analyze(@addr(resolved), @addr(arena))
        c_code ref(u8)         = cgen.generate_c(@addr(resolved), @addr(info), @addr(arena))
        c_path ref(u8)         = "/tmp/scar-compile.c"
    )
    
    fs.write_text(c_path, c_code)?

    val cmd_buf list[u8] = []
    append_str(@addr(cmd_buf), "tcc -O0 ")
    append_str(@addr(cmd_buf), c_path)
    append_str(@addr(cmd_buf), " -o ")
    append_str(@addr(cmd_buf), output_path)
    append_str(@addr(cmd_buf), " 2>/dev/null")
    @append(cmd_buf, 0)

    val (
        cmd_str ref(u8) = @addr(cmd_buf[0])
        rc i32          = os.exec(cmd_str)?
    )
    
    if rc != 0
        fs.remove_file(c_path)
        return error("scar: tcc failed to link")
    end

    fs.remove_file(c_path)
    return 0
end

pub def emit(source_path ref(u8), output_path ref(u8)) i32|error
    var arena = allocators.Arena.new(2097152 as usize)?
    defer
        allocators.Arena.destroy(@addr(arena))
    end

    val source = fs.read_text[_](@addr(arena), source_path)?
    if source == none
        return error("scar: cannot read file")
    end

    val (
        tokens list[ast.Token] = lxr.lex(source, @addr(arena))
        prog ast.Program       = prs.parse_program(tokens, @addr(arena))
        resolved ast.Program   = rslv.resolve(@addr(prog))
        info sema.ProgramInfo  = sema.analyze(@addr(resolved), @addr(arena))
        c_code ref(u8)         = cgen.generate_c(@addr(resolved), @addr(info), @addr(arena))
    )
    
    if output_path == none
        @puts(c_code)
        return 0
    else
        fs.write_text(output_path, c_code)?
    end

    return 0
end

def append_str(buf ref(list[u8]), s ref(u8))
    val slen usize = str.len(s)
    var i usize = 0
    for i < slen
        @append(buf, @deref(@add(s, i)))
        i++
    end
end

pub def main() void
    val args list[ref(u8)] = @args()  
    var (
        emit_mode bool             = false
        emit_output_path ref(u8)   = none
        source_path ref(u8)        = none
        binary_output_path ref(u8) = none
        i usize                    = 1
    )
    for i < @len(args)
        val arg ref(u8) = args[i]
        if str.eql(arg, "-emit")
            emit_mode = true
        elif str.eql(arg, "-o")
            if i + 1 >= @len(args)
                @puts(usage_message)
                return
            end
            i++
            val next_arg ref(u8) = args[i]
            if emit_mode
                emit_output_path = next_arg
            elif source_path != none && binary_output_path == none
                binary_output_path = next_arg
            else
                @puts(usage_message)
                return
            end
        else
            if source_path == none
                source_path = arg
            else
                @puts(usage_message)
                return
            end
        end
        i++
    end
    
    if source_path == none
        @puts(usage_message)
        return
    end
    
    if emit_mode
        match emit(source_path, emit_output_path)
            ok rc => (
                if rc != 0
                    os.exit(rc)
                end
            )
            error msg => (
                @puts(msg)
                os.exit(1)
            )
        end
    else
        if binary_output_path == none
            var arena = allocators.Arena.new(4096 as usize)?
            defer
                allocators.Arena.destroy(@addr(arena))
            end
            val base = fs.strip_extension[_](@addr(arena), source_path)?
            val bname = fs.basename[_](@addr(arena), base)?
            var out_buf list[u8] = []
            append_str(@addr(out_buf), "./scar-out/")
            append_str(@addr(out_buf), bname)
            when windows
                append_str(@addr(out_buf), ".exe")
            end
            @append(out_buf, 0)
            binary_output_path = @addr(out_buf[0])
            match fs.create_dir_all("./scar-out")
                ok _ => ()
                error msg => (
                    @puts(msg)
                    os.exit(1)
                )
            end
        end
        match compile(source_path, binary_output_path)
            ok rc => (
                if rc != 0
                    os.exit(rc)
                end
            )
            error msg => (
                @puts(msg)
                os.exit(1)
            )
        end
    end
end
