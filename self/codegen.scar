val str = use("std/string")
val ast = use("ast")
val sema = use("sema")
val allocators = use("std/allocators")

pub def generate_c(program ref(ast.Program), info ref(sema.ProgramInfo), arena ref(allocators.Arena)) ref(u8)
    val output_res = allocators.Arena.alloc(arena, 1048576)
    var output ref(u8) = none
    match output_res
        ok m => output = m as ref(u8)
        error _ => return none
    end
    var output_len usize = 0

    append_str(@addr(output), @addr(output_len), "#include <inttypes.h>\n")
    append_str(@addr(output), @addr(output_len), "#include <signal.h>\n")
    append_str(@addr(output), @addr(output_len), "#include <stdint.h>\n")
    append_str(@addr(output), @addr(output_len), "#include <stdio.h>\n")
    append_str(@addr(output), @addr(output_len), "#include <stdlib.h>\n")
    append_str(@addr(output), @addr(output_len), "#include <string.h>\n")
    append_str(@addr(output), @addr(output_len), "#include <errno.h>\n")
    append_str(@addr(output), @addr(output_len), "#include <sys/stat.h>\n")
    append_str(@addr(output), @addr(output_len), "#if !defined(_WIN32)\n")
    append_str(@addr(output), @addr(output_len), "#include <unistd.h>\n")
    append_str(@addr(output), @addr(output_len), "#endif\n\n")
    append_str(@addr(output), @addr(output_len), "#if !defined(_WIN32)\n")
    append_str(@addr(output), @addr(output_len), "#include <execinfo.h>\n")
    append_str(@addr(output), @addr(output_len), "#include <unistd.h>\n")
    append_str(@addr(output), @addr(output_len), "#endif\n\n")

    append_runtime_prelude(@addr(output), @addr(output_len))

    var j usize = 0
    for j < @len(program.extern_headers)
        append_str(@addr(output), @addr(output_len), "#include \"")
        append_str(@addr(output), @addr(output_len), program.extern_headers[j])
        append_str(@addr(output), @addr(output_len), "\"\n")
        j++
    end
    if @len(program.extern_headers) > 0
        append_str(@addr(output), @addr(output_len), "\n")
    end

    j = 0
    for j < @len(program.type_defs)
        val td ref(ast.TypeDef) = @addr(program.type_defs[j])
        render_typedef_forward(td, @addr(output), @addr(output_len))
        j++
    end

    val list_types list[ast.Type] = collect_list_types(program, info, arena)
    if @len(list_types) > 0
        j = 0
        for j < @len(list_types)
            render_list_typedef(@addr(list_types[j]), arena, @addr(output), @addr(output_len))
            j++
        end
        append_str(@addr(output), @addr(output_len), "\n")
    end

    j = 0
    for j < @len(program.type_defs)
        val td ref(ast.TypeDef) = @addr(program.type_defs[j])
        render_typedef(td, arena, @addr(output), @addr(output_len))
        j++
    end

    if @len(list_types) > 0
        j = 0
        for j < @len(list_types)
            render_list_helpers(@addr(list_types[j]), arena, @addr(output), @addr(output_len))
            append_str(@addr(output), @addr(output_len), "\n")
            j++
        end
    end

    var i usize = 0
    for i < @len(program.functions)
        val fn_ref ref(ast.Function) = @addr(program.functions[i])
        if fn_ref.is_extern
            i++
            continue
        end
        render_signature(fn_ref, info, arena, @addr(output), @addr(output_len))
        append_str(@addr(output), @addr(output_len), ";\n")
        i++
    end
    append_str(@addr(output), @addr(output_len), "\n")

    i = 0
    for i < @len(program.functions)
        val fn_ref ref(ast.Function) = @addr(program.functions[i])
        if fn_ref.is_extern
            i++
            continue
        end
        render_function(fn_ref, info, arena, @addr(output), @addr(output_len))
        append_str(@addr(output), @addr(output_len), "\n")
        i++
    end

    i = 0
    for i < @len(program.functions)
        if str.eql(program.functions[i].name, "main") && !program.functions[i].is_extern
            render_entrypoint(@addr(program.functions[i]), info, arena, @addr(output), @addr(output_len))
            break
        end
        i++
    end

    @deref(@as_mut(@add(output, output_len))) = 0
    return output
end

def append_runtime_prelude(output ref(ref(u8)), output_len ref(usize))
    append_str(output, output_len, "static void scar_runtime_panic(const char *message) {\n")
    append_str(output, output_len, "    fprintf(stderr, \"scar: panic: %s\\n\", message);\n")
    append_str(output, output_len, "    exit(1);\n")
    append_str(output, output_len, "}\n\n")
    append_str(output, output_len, "static void *scar_runtime_alloc(size_t size) {\n")
    append_str(output, output_len, "    void *ptr = malloc(size);\n")
    append_str(output, output_len, "    if (ptr == NULL) {\n")
    append_str(output, output_len, "        scar_runtime_panic(\"allocation failed\");\n")
    append_str(output, output_len, "    }\n")
    append_str(output, output_len, "    return ptr;\n")
    append_str(output, output_len, "}\n\n")
    append_str(output, output_len, "static void *scar_runtime_realloc(void *ptr, size_t size) {\n")
    append_str(output, output_len, "    void *resized = realloc(ptr, size);\n")
    append_str(output, output_len, "    if (resized == NULL) {\n")
    append_str(output, output_len, "        scar_runtime_panic(\"reallocation failed\");\n")
    append_str(output, output_len, "    }\n")
    append_str(output, output_len, "    return resized;\n")
    append_str(output, output_len, "}\n\n")
    append_str(output, output_len, "static void scar_runtime_free(void *ptr) {\n")
    append_str(output, output_len, "    free(ptr);\n")
    append_str(output, output_len, "}\n\n")
    append_str(output, output_len, "static int scar__argc;\n")
    append_str(output, output_len, "static char **scar__argv;\n\n")
    append_str(output, output_len, "static void scar_runtime_signal_handler(int signal_number) {\n")
    append_str(output, output_len, "    fprintf(stderr, \"scar: fatal signal %d\\n\", signal_number);\n")
    append_str(output, output_len, "#if !defined(_WIN32)\n")
    append_str(output, output_len, "    void *frames[64];\n")
    append_str(output, output_len, "    int frame_count = backtrace(frames, 64);\n")
    append_str(output, output_len, "    backtrace_symbols_fd(frames, frame_count, STDERR_FILENO);\n")
    append_str(output, output_len, "#endif\n")
    append_str(output, output_len, "    _Exit(128 + signal_number);\n")
    append_str(output, output_len, "}\n\n")
    append_str(output, output_len, "static void scar_runtime_install_signal_handlers(void) {\n")
    append_str(output, output_len, "    signal(SIGSEGV, scar_runtime_signal_handler);\n")
    append_str(output, output_len, "#ifdef SIGBUS\n")
    append_str(output, output_len, "    signal(SIGBUS, scar_runtime_signal_handler);\n")
    append_str(output, output_len, "#endif\n")
    append_str(output, output_len, "#ifdef SIGILL\n")
    append_str(output, output_len, "    signal(SIGILL, scar_runtime_signal_handler);\n")
    append_str(output, output_len, "#endif\n")
    append_str(output, output_len, "#ifdef SIGABRT\n")
    append_str(output, output_len, "    signal(SIGABRT, scar_runtime_signal_handler);\n")
    append_str(output, output_len, "#endif\n")
    append_str(output, output_len, "}\n\n")
end

def collect_list_types(program ref(ast.Program), info ref(sema.ProgramInfo), arena ref(allocators.Arena)) list[ast.Type]
    var seen list[ast.Type] = []
    var i usize = 0
    for i < @len(program.type_defs)
        val td ref(ast.TypeDef) = @addr(program.type_defs[i])
        var j usize = 0
        for j < @len(td.fields)
            collect_list_types_from_type(@addr(td.fields[j].ty), @addr(seen), arena)
            j++
        end
        j = 0
        for j < @len(td.variants)
            var k usize = 0
            for k < @len(td.variants[j].payload_types)
                collect_list_types_from_type(@addr(td.variants[j].payload_types[k]), @addr(seen), arena)
                k++
            end
            j++
        end
        i++
    end
    i = 0
    for i < @len(program.functions)
        val fn_ref ref(ast.Function) = @addr(program.functions[i])
        collect_list_types_from_type(@addr(fn_ref.return_type), @addr(seen), arena)
        var j usize = 0
        for j < @len(fn_ref.params)
            collect_list_types_from_type(@addr(fn_ref.params[j].ty), @addr(seen), arena)
            j++
        end
        i++
    end
    i = 0
    for i < @len(info.locals)
        var j usize = 0
        for j < @len(info.locals[i].bindings)
            collect_list_types_from_type(@addr(info.locals[i].bindings[j].ty), @addr(seen), arena)
            j++
        end
        i++
    end
    return seen
end

def list_type_equals(a ref(ast.Type), b ref(ast.Type)) bool
    match @deref(a)
        ast.Type.List(a_inner) => (
            match @deref(b)
                ast.Type.List(b_inner) => return list_type_equals(a_inner, b_inner)
                _ => return false
            end
        )
        ast.Type.I8(_) => (
            match @deref(b)
                ast.Type.I8(_) => return true
                _ => return false
            end
        )
        ast.Type.I16(_) => (
            match @deref(b)
                ast.Type.I16(_) => return true
                _ => return false
            end
        )
        ast.Type.I32(_) => (
            match @deref(b)
                ast.Type.I32(_) => return true
                _ => return false
            end
        )
        ast.Type.I64(_) => (
            match @deref(b)
                ast.Type.I64(_) => return true
                _ => return false
            end
        )
        ast.Type.Isize(_) => (
            match @deref(b)
                ast.Type.Isize(_) => return true
                _ => return false
            end
        )
        ast.Type.U8(_) => (
            match @deref(b)
                ast.Type.U8(_) => return true
                _ => return false
            end
        )
        ast.Type.U16(_) => (
            match @deref(b)
                ast.Type.U16(_) => return true
                _ => return false
            end
        )
        ast.Type.U32(_) => (
            match @deref(b)
                ast.Type.U32(_) => return true
                _ => return false
            end
        )
        ast.Type.U64(_) => (
            match @deref(b)
                ast.Type.U64(_) => return true
                _ => return false
            end
        )
        ast.Type.Usize(_) => (
            match @deref(b)
                ast.Type.Usize(_) => return true
                _ => return false
            end
        )
        ast.Type.Bool(_) => (
            match @deref(b)
                ast.Type.Bool(_) => return true
                _ => return false
            end
        )
        ast.Type.F32(_) => (
            match @deref(b)
                ast.Type.F32(_) => return true
                _ => return false
            end
        )
        ast.Type.F64(_) => (
            match @deref(b)
                ast.Type.F64(_) => return true
                _ => return false
            end
        )
        ast.Type.Named(na) => (
            match @deref(b)
                ast.Type.Named(nb) => return str.eql(na, nb)
                _ => return false
            end
        )
        ast.Type.Ref(inner) => (
            match @deref(b)
                ast.Type.Ref(inner2) => return list_type_equals(inner, inner2)
                _ => return false
            end
        )
        ast.Type.Mut(inner) => (
            match @deref(b)
                ast.Type.Mut(inner2) => return list_type_equals(inner, inner2)
                _ => return false
            end
        )
        _ => return false
    end
end

def list_type_in_list(ty ref(ast.Type), list_list ref(list[ast.Type])) bool
    var i usize = 0
    for i < @len(list_list)
        if list_type_equals(ty, @addr(list_list[i]))
            return true
        end
        i++
    end
    return false
end

def collect_list_types_from_type(ty ref(ast.Type), seen ref(list[ast.Type]), arena ref(allocators.Arena))
    match @deref(ty)
        ast.Type.List(inner) => (
            collect_list_types_from_type(inner, seen, arena)
            if !list_type_in_list(ty, seen)
                @append(seen, @deref(ty))
            end
        )
        ast.Type.Result(inner) => collect_list_types_from_type(inner, seen, arena)
        ast.Type.Mut(inner) => collect_list_types_from_type(inner, seen, arena)
        ast.Type.Ref(inner) => collect_list_types_from_type(inner, seen, arena)
        ast.Type.FnPtr(params, ret) => (
            var i usize = 0
            for i < @len(params)
                collect_list_types_from_type(@addr(params[i]), seen, arena)
                i++
            end
            collect_list_types_from_type(ret, seen, arena)
        )
        _ => ()
    end
end

def render_list_typedef(list_ty ref(ast.Type), arena ref(allocators.Arena), output ref(ref(u8)), output_len ref(usize))
    val element_ty ref(ast.Type) = get_list_element_type(list_ty)
    val list_name ref(u8) = c_type(list_ty, arena)
    val element_c_type ref(u8) = c_type(element_ty, arena)
    append_str(output, output_len, "typedef struct {\n")
    append_str(output, output_len, "    ")
    append_str(output, output_len, element_c_type)
    append_str(output, output_len, " *data;\n")
    append_str(output, output_len, "    int32_t len;\n")
    append_str(output, output_len, "    int32_t cap;\n")
    append_str(output, output_len, "} ")
    append_str(output, output_len, list_name)
    append_str(output, output_len, ";\n")
end

def render_list_helpers(list_ty ref(ast.Type), arena ref(allocators.Arena), output ref(ref(u8)), output_len ref(usize))
    val element_ty ref(ast.Type) = get_list_element_type(list_ty)
    val list_name ref(u8) = c_type(list_ty, arena)
    val element_c_type ref(u8) = c_type(element_ty, arena)
    val helper_prefix ref(u8) = list_helper_prefix(element_ty, arena)

    append_str(output, output_len, "static ")
    append_str(output, output_len, list_name)
    append_str(output, output_len, " ")
    append_str(output, output_len, helper_prefix)
    append_str(output, output_len, "_new(void) {\n")
    append_str(output, output_len, "    return (")
    append_str(output, output_len, list_name)
    append_str(output, output_len, "){ .data = NULL, .len = 0, .cap = 0 };\n")
    append_str(output, output_len, "}\n\n")

    append_str(output, output_len, "static void ")
    append_str(output, output_len, helper_prefix)
    append_str(output, output_len, "_ensure_capacity(")
    append_str(output, output_len, list_name)
    append_str(output, output_len, " *list, int32_t requested) {\n")
    append_str(output, output_len, "    if (requested < 0) {\n")
    append_str(output, output_len, "        scar_runtime_panic(\"list capacity cannot be negative\");\n")
    append_str(output, output_len, "    }\n")
    append_str(output, output_len, "    if (requested <= list->cap) {\n")
    append_str(output, output_len, "        return;\n")
    append_str(output, output_len, "    }\n")
    append_str(output, output_len, "    int32_t new_cap = list->cap > 0 ? list->cap : 4;\n")
    append_str(output, output_len, "    while (new_cap < requested) {\n")
    append_str(output, output_len, "        if (new_cap > INT32_MAX / 2) {\n")
    append_str(output, output_len, "            new_cap = requested;\n")
    append_str(output, output_len, "            break;\n")
    append_str(output, output_len, "        }\n")
    append_str(output, output_len, "        new_cap *= 2;\n")
    append_str(output, output_len, "    }\n")
    append_str(output, output_len, "    void *resized = realloc(list->data, sizeof(")
    append_str(output, output_len, element_c_type)
    append_str(output, output_len, ") * (size_t)new_cap);\n")
    append_str(output, output_len, "    if (resized == NULL) {\n")
    append_str(output, output_len, "        scar_runtime_panic(\"failed to allocate list storage\");\n")
    append_str(output, output_len, "    }\n")
    append_str(output, output_len, "    list->data = (")
    append_str(output, output_len, element_c_type)
    append_str(output, output_len, " *)resized;\n")
    append_str(output, output_len, "    list->cap = new_cap;\n")
    append_str(output, output_len, "}\n\n")

    append_str(output, output_len, "static ")
    append_str(output, output_len, list_name)
    append_str(output, output_len, " ")
    append_str(output, output_len, helper_prefix)
    append_str(output, output_len, "_from_array(")
    append_str(output, output_len, element_c_type)
    append_str(output, output_len, " const *items, int32_t len) {\n")
    append_str(output, output_len, "    ")
    append_str(output, output_len, list_name)
    append_str(output, output_len, " list = ")
    append_str(output, output_len, helper_prefix)
    append_str(output, output_len, "_new();\n")
    append_str(output, output_len, "    if (len == 0) {\n")
    append_str(output, output_len, "        return list;\n")
    append_str(output, output_len, "    }\n")
    append_str(output, output_len, "    ")
    append_str(output, output_len, helper_prefix)
    append_str(output, output_len, "_ensure_capacity(&list, len);\n")
    append_str(output, output_len, "    memcpy(list.data, items, sizeof(")
    append_str(output, output_len, element_c_type)
    append_str(output, output_len, ") * (size_t)len);\n")
    append_str(output, output_len, "    list.len = len;\n")
    append_str(output, output_len, "    return list;\n")
    append_str(output, output_len, "}\n\n")

    append_str(output, output_len, "static ")
    append_str(output, output_len, element_c_type)
    append_str(output, output_len, " *")
    append_str(output, output_len, helper_prefix)
    append_str(output, output_len, "_at(")
    append_str(output, output_len, list_name)
    append_str(output, output_len, " *list, int32_t index) {\n")
    append_str(output, output_len, "    if (index < 0 || index >= list->len) {\n")
    append_str(output, output_len, "        fprintf(stderr, \"scar: panic: list index out of bounds (index %d, len %d)\\n\", index, list->len);\n")
    append_str(output, output_len, "        exit(1);\n")
    append_str(output, output_len, "    }\n")
    append_str(output, output_len, "    return &list->data[index];\n")
    append_str(output, output_len, "}\n\n")

    append_str(output, output_len, "static int32_t ")
    append_str(output, output_len, helper_prefix)
    append_str(output, output_len, "_capacity(")
    append_str(output, output_len, list_name)
    append_str(output, output_len, " *list) {\n")
    append_str(output, output_len, "    return list->cap;\n")
    append_str(output, output_len, "}\n\n")

    append_str(output, output_len, "static uintptr_t ")
    append_str(output, output_len, helper_prefix)
    append_str(output, output_len, "_len(")
    append_str(output, output_len, list_name)
    append_str(output, output_len, " *list) {\n")
    append_str(output, output_len, "    return (uintptr_t)list->len;\n")
    append_str(output, output_len, "}\n\n")

    append_str(output, output_len, "static void ")
    append_str(output, output_len, helper_prefix)
    append_str(output, output_len, "_reserve(")
    append_str(output, output_len, list_name)
    append_str(output, output_len, " *list, int32_t capacity) {\n")
    append_str(output, output_len, "    ")
    append_str(output, output_len, helper_prefix)
    append_str(output, output_len, "_ensure_capacity(list, capacity);\n")
    append_str(output, output_len, "}\n\n")

    append_str(output, output_len, "static void ")
    append_str(output, output_len, helper_prefix)
    append_str(output, output_len, "_append(")
    append_str(output, output_len, list_name)
    append_str(output, output_len, " *list, ")
    append_str(output, output_len, element_c_type)
    append_str(output, output_len, " value) {\n")
    append_str(output, output_len, "    ")
    append_str(output, output_len, helper_prefix)
    append_str(output, output_len, "_ensure_capacity(list, list->len + 1);\n")
    append_str(output, output_len, "    list->data[list->len++] = value;\n")
    append_str(output, output_len, "}\n\n")

    append_str(output, output_len, "static void ")
    append_str(output, output_len, helper_prefix)
    append_str(output, output_len, "_set(")
    append_str(output, output_len, list_name)
    append_str(output, output_len, " *list, int32_t index, ")
    append_str(output, output_len, element_c_type)
    append_str(output, output_len, " value) {\n")
    append_str(output, output_len, "    *")
    append_str(output, output_len, helper_prefix)
    append_str(output, output_len, "_at(list, index) = value;\n")
    append_str(output, output_len, "}\n\n")

    append_str(output, output_len, "static void ")
    append_str(output, output_len, helper_prefix)
    append_str(output, output_len, "_insert(")
    append_str(output, output_len, list_name)
    append_str(output, output_len, " *list, int32_t index, ")
    append_str(output, output_len, element_c_type)
    append_str(output, output_len, " value) {\n")
    append_str(output, output_len, "    if (index < 0 || index > list->len) {\n")
    append_str(output, output_len, "        fprintf(stderr, \"scar: panic: list insert index out of bounds (index %d, len %d)\\n\", index, list->len);\n")
    append_str(output, output_len, "        exit(1);\n")
    append_str(output, output_len, "    }\n")
    append_str(output, output_len, "    ")
    append_str(output, output_len, helper_prefix)
    append_str(output, output_len, "_ensure_capacity(list, list->len + 1);\n")
    append_str(output, output_len, "    if (index < list->len) {\n")
    append_str(output, output_len, "        memmove(&list->data[index + 1], &list->data[index], sizeof(")
    append_str(output, output_len, element_c_type)
    append_str(output, output_len, ") * (size_t)(list->len - index));\n")
    append_str(output, output_len, "    }\n")
    append_str(output, output_len, "    list->data[index] = value;\n")
    append_str(output, output_len, "    list->len += 1;\n")
    append_str(output, output_len, "}\n\n")

    append_str(output, output_len, "static ")
    append_str(output, output_len, element_c_type)
    append_str(output, output_len, " ")
    append_str(output, output_len, helper_prefix)
    append_str(output, output_len, "_remove(")
    append_str(output, output_len, list_name)
    append_str(output, output_len, " *list, int32_t index) {\n")
    append_str(output, output_len, "    ")
    append_str(output, output_len, element_c_type)
    append_str(output, output_len, " removed = *")
    append_str(output, output_len, helper_prefix)
    append_str(output, output_len, "_at(list, index);\n")
    append_str(output, output_len, "    if (index + 1 < list->len) {\n")
    append_str(output, output_len, "        memmove(&list->data[index], &list->data[index + 1], sizeof(")
    append_str(output, output_len, element_c_type)
    append_str(output, output_len, ") * (size_t)(list->len - index - 1));\n")
    append_str(output, output_len, "    }\n")
    append_str(output, output_len, "    list->len -= 1;\n")
    append_str(output, output_len, "    return removed;\n")
    append_str(output, output_len, "}\n\n")

    append_str(output, output_len, "static void ")
    append_str(output, output_len, helper_prefix)
    append_str(output, output_len, "_clear(")
    append_str(output, output_len, list_name)
    append_str(output, output_len, " *list) {\n")
    append_str(output, output_len, "    list->len = 0;\n")
    append_str(output, output_len, "}\n")
end

def render_typedef_forward(td ref(ast.TypeDef), output ref(ref(u8)), output_len ref(usize))
    match td.kind
        ast.TypeDefKind.Struct => (
            append_str(output, output_len, "typedef struct ")
            append_str(output, output_len, td.name)
            append_str(output, output_len, "_scar_tag ")
            append_str(output, output_len, td.name)
            append_str(output, output_len, ";\n")
        )
        ast.TypeDefKind.Union => (
            append_str(output, output_len, "typedef struct ")
            append_str(output, output_len, td.name)
            append_str(output, output_len, "_scar_tag ")
            append_str(output, output_len, td.name)
            append_str(output, output_len, ";\n")
        )
        ast.TypeDefKind.Enum => ()
    end
end

def render_typedef(td ref(ast.TypeDef), arena ref(allocators.Arena), output ref(ref(u8)), output_len ref(usize))
    match td.kind
        ast.TypeDefKind.Enum => (
            val enum_c_prefix ref(u8) = make_enum_c_prefix(td.name, arena)
            append_str(output, output_len, "typedef enum {\n")
            var i usize = 0
            for i < @len(td.variants)
                append_str(output, output_len, "    ")
                append_str(output, output_len, enum_c_prefix)
                append_str(output, output_len, "_")
                append_str(output, output_len, td.variants[i].name)
                append_str(output, output_len, " = ")
                append_usize(output, output_len, i, arena)
                append_str(output, output_len, ",\n")
                i++
            end
            append_str(output, output_len, "} ")
            append_str(output, output_len, enum_c_prefix)
            append_str(output, output_len, ";\n")
            append_str(output, output_len, "typedef ")
            append_str(output, output_len, enum_c_prefix)
            append_str(output, output_len, " ")
            append_str(output, output_len, td.name)
            append_str(output, output_len, ";\n\n")
        )
        ast.TypeDefKind.Union => (
            append_str(output, output_len, "enum {\n")
            var i usize = 0
            for i < @len(td.variants)
                append_str(output, output_len, "    ")
                append_str(output, output_len, td.name)
                append_str(output, output_len, "__tag__")
                append_str(output, output_len, td.variants[i].name)
                append_str(output, output_len, " = ")
                append_usize(output, output_len, i, arena)
                append_str(output, output_len, ",\n")
                i++
            end
            append_str(output, output_len, "};\n")
            append_str(output, output_len, "typedef struct ")
            append_str(output, output_len, td.name)
            append_str(output, output_len, "_scar_tag {\n")
            append_str(output, output_len, "    int32_t tag;\n")
            append_str(output, output_len, "    union {\n")
            i = 0
            for i < @len(td.variants)
                append_str(output, output_len, "        struct {\n")
                var j usize = 0
                for j < @len(td.variants[i].payload_types)
                    append_str(output, output_len, "            ")
                    append_str(output, output_len, c_type(@addr(td.variants[i].payload_types[j]), arena))
                    append_str(output, output_len, " _")
                    append_usize(output, output_len, j, arena)
                    append_str(output, output_len, ";\n")
                    j++
                end
                append_str(output, output_len, "        } ")
                append_str(output, output_len, td.variants[i].name)
                append_str(output, output_len, ";\n")
                i++
            end
            append_str(output, output_len, "    } data;\n")
            append_str(output, output_len, "} ")
            append_str(output, output_len, td.name)
            append_str(output, output_len, ";\n\n")
        )
        ast.TypeDefKind.Struct => (
            append_str(output, output_len, "typedef struct ")
            append_str(output, output_len, td.name)
            append_str(output, output_len, "_scar_tag {\n")
            var i usize = 0
            for i < @len(td.fields)
                val field ref(ast.FieldDef) = @addr(td.fields[i])
                append_str(output, output_len, "    ")
                append_str(output, output_len, c_type(@addr(field.ty), arena))
                append_str(output, output_len, " ")
                append_str(output, output_len, field.name)
                append_str(output, output_len, ";\n")
                i++
            end
            append_str(output, output_len, "} ")
            append_str(output, output_len, td.name)
            append_str(output, output_len, ";\n\n")
        )
    end
end

def make_enum_c_prefix(name ref(u8), arena ref(allocators.Arena)) ref(u8)
    val prefix ref(u8) = "scar__enum__"
    val plen usize = str.len(prefix)
    val nlen usize = str.len(name)
    val res_res = allocators.Arena.alloc(arena, plen + nlen + 1)
    var res ref(u8) = none
    match res_res
        ok m => res = m as ref(u8)
        error _ => return name
    end
    @memcpy(res, prefix, plen)
    @memcpy(@add(res, plen), name, nlen)
    @deref(@as_mut(@add(res, plen + nlen))) = 0
    return res
end

def is_integer_ast_type(ty ref(ast.Type)) bool
    match @deref(ty)
        ast.Type.I8(_) => return true
        ast.Type.I16(_) => return true
        ast.Type.I32(_) => return true
        ast.Type.I64(_) => return true
        ast.Type.Isize(_) => return true
        ast.Type.U8(_) => return true
        ast.Type.U16(_) => return true
        ast.Type.U32(_) => return true
        ast.Type.U64(_) => return true
        ast.Type.Usize(_) => return true
        ast.Type.Bool(_) => return true
        _ => return false
    end
end

def lookup_type_def(name ref(u8), info ref(sema.ProgramInfo)) ref(sema.TypeEntry)
    val dot_pos usize = find_last_dot(name)
    var bare ref(u8) = name
    if dot_pos < str.len(name)
        bare = @add(name, dot_pos + 1)
    end
    var i usize = 0
    for i < @len(info.types)
        if str.eql(info.types[i].name, bare) || str.eql(info.types[i].name, name)
            return @addr(info.types[i])
        end
        i++
    end
    return none
end

def is_enum_type_from_info(name ref(u8), info ref(sema.ProgramInfo)) bool
    val dot_pos usize = find_last_dot(name)
    var bare ref(u8) = name
    if dot_pos < str.len(name)
        bare = @add(name, dot_pos + 1)
    end
    var i usize = 0
    for i < @len(info.types)
        if str.eql(info.types[i].name, bare) || str.eql(info.types[i].name, name)
            if @len(info.types[i].info.variant_map) == 0
                return false
            end
            var j usize = 0
            for j < @len(info.types[i].info.variant_map)
                if @len(info.types[i].info.variant_map[j].payload_types) > 0
                    return false
                end
                j++
            end
            return true
        end
        i++
    end
    return false
end

def infer_match_expr_type(expr ref(ast.Expr), fun ref(ast.Function), info ref(sema.ProgramInfo)) ast.Type
    match @deref(expr)
        ast.Expr.IntLit(_) => return ast.Type.I32(0)
        ast.Expr.CharLit(_) => return ast.Type.U8(0)
        ast.Expr.BoolLit(_) => return ast.Type.Bool(0)
        ast.Expr.Ident(name) => (
            val ty ref(ast.Type) = lookup_local_type(name, fun, info)
            match @deref(ty)
                ast.Type.Void(_) => (
                    var i usize = 0
                    for i < @len(fun.params)
                        if str.eql(fun.params[i].name, name)
                            return fun.params[i].ty
                        end
                        i++
                    end
                )
                _ => ()
            end
            return @deref(ty)
        )
        ast.Expr.Path(segments) => (
            if @len(segments) == 1
                return @deref(lookup_local_type(segments[0], fun, info))
            end
            return ast.Type.Void(0)
        )
        ast.Expr.BuiltinCall(bc) => (
            if str.eql(bc.name, "deref") && @len(bc.args) == 1
                val inner_ty ast.Type = infer_match_expr_type(@addr(bc.args[0]), fun, info)
                match inner_ty
                    ast.Type.Ref(inner) => return @deref(inner)
                    ast.Type.Mut(inner) => return @deref(inner)
                    _ => return inner_ty
                end
            end
            return ast.Type.Void(0)
        )
        _ => return ast.Type.Void(0)
    end
end

def render_function(fun ref(ast.Function), info ref(sema.ProgramInfo), arena ref(allocators.Arena), output ref(ref(u8)), output_len ref(usize))
    render_signature(fun, info, arena, output, output_len)
    append_str(output, output_len, " {\n")

    if !is_void_type(@addr(fun.return_type))
        indent(output, output_len, 1)
        append_str(output, output_len, c_type_bare(@addr(fun.return_type), arena))
        append_str(output, output_len, " __scar_return_value;\n")
    end

    var next_temp_id usize = 0
    var i usize = 0
    for i < @len(fun.body)
        render_stmt(@addr(fun.body[i]), fun, info, 1, @addr(next_temp_id), arena, output, output_len)
        i++
    end

    append_str(output, output_len, "__scar_return:\n")
    if is_void_type(@addr(fun.return_type))
        append_str(output, output_len, "    return;\n")
    else
        append_str(output, output_len, "    return __scar_return_value;\n")
    end
    append_str(output, output_len, "}\n")
end

def render_signature(fun ref(ast.Function), info ref(sema.ProgramInfo), arena ref(allocators.Arena), output ref(ref(u8)), output_len ref(usize))
    val return_type ref(u8) = c_type_bare(@addr(fun.return_type), arena)
    val symbol ref(u8) = lookup_symbol(fun.name, info, arena)

    if fun.is_extern
        append_str(output, output_len, "extern ")
    end
    append_str(output, output_len, return_type)
    append_str(output, output_len, " ")
    append_str(output, output_len, symbol)
    append_str(output, output_len, "(")

    if @len(fun.params) == 0
        append_str(output, output_len, "void")
    else
        var i usize = 0
        for i < @len(fun.params)
            if i > 0
                append_str(output, output_len, ", ")
            end
            append_str(output, output_len, c_type_bare(@addr(fun.params[i].ty), arena))
            append_str(output, output_len, " ")
            append_str(output, output_len, mangle_local_symbol(fun.params[i].name, arena))
            i++
        end
    end
    append_str(output, output_len, ")")
end

def render_stmt(stmt ref(ast.Stmt), fun ref(ast.Function), info ref(sema.ProgramInfo), level usize, next_temp_id ref(usize), arena ref(allocators.Arena), output ref(ref(u8)), output_len ref(usize))
    match @deref(stmt)
        ast.Stmt.VarDecl(vd) => (
            val ty ref(ast.Type) = lookup_local_type(vd.name, fun, info)
            indent(output, output_len, level)
            if !vd.mutable && !is_aggregate_type(ty)
                append_str(output, output_len, "const ")
            end
            append_str(output, output_len, c_type_named(ty, vd.name, arena))
            append_str(output, output_len, " = ")
            if is_list_lit_expr(@addr(vd.init))
                append_list_literal_from_expr(@addr(vd.init), ty, fun, info, arena, output, output_len)
            else
                append_expr(@addr(vd.init), fun, info, arena, output, output_len)
            end
            append_str(output, output_len, ";\n")
        )
        ast.Stmt.Assign(a) => (
            indent(output, output_len, level)
            append_expr(@addr(a.target), fun, info, arena, output, output_len)
            append_str(output, output_len, " = ")
            if is_list_lit_expr(@addr(a.value))
                append_list_literal_from_expr(@addr(a.value), get_expr_type(@addr(a.target), fun, info), fun, info, arena, output, output_len)
            else
                append_expr(@addr(a.value), fun, info, arena, output, output_len)
            end
            append_str(output, output_len, ";\n")
        )
        ast.Stmt.AddAssign(a) => (
            indent(output, output_len, level)
            append_expr(@addr(a.target), fun, info, arena, output, output_len)
            append_str(output, output_len, " += ")
            append_expr(@addr(a.value), fun, info, arena, output, output_len)
            append_str(output, output_len, ";\n")
        )
        ast.Stmt.SubAssign(a) => (
            indent(output, output_len, level)
            append_expr(@addr(a.target), fun, info, arena, output, output_len)
            append_str(output, output_len, " -= ")
            append_expr(@addr(a.value), fun, info, arena, output, output_len)
            append_str(output, output_len, ";\n")
        )
        ast.Stmt.MulAssign(a) => (
            indent(output, output_len, level)
            append_expr(@addr(a.target), fun, info, arena, output, output_len)
            append_str(output, output_len, " *= ")
            append_expr(@addr(a.value), fun, info, arena, output, output_len)
            append_str(output, output_len, ";\n")
        )
        ast.Stmt.DivAssign(a) => (
            indent(output, output_len, level)
            append_expr(@addr(a.target), fun, info, arena, output, output_len)
            append_str(output, output_len, " /= ")
            append_expr(@addr(a.value), fun, info, arena, output, output_len)
            append_str(output, output_len, ";\n")
        )
        ast.Stmt.BitXorAssign(a) => (
            indent(output, output_len, level)
            append_expr(@addr(a.target), fun, info, arena, output, output_len)
            append_str(output, output_len, " ^= ")
            append_expr(@addr(a.value), fun, info, arena, output, output_len)
            append_str(output, output_len, ";\n")
        )
        ast.Stmt.BitAndAssign(a) => (
            indent(output, output_len, level)
            append_expr(@addr(a.target), fun, info, arena, output, output_len)
            append_str(output, output_len, " &= ")
            append_expr(@addr(a.value), fun, info, arena, output, output_len)
            append_str(output, output_len, ";\n")
        )
        ast.Stmt.BitOrAssign(a) => (
            indent(output, output_len, level)
            append_expr(@addr(a.target), fun, info, arena, output, output_len)
            append_str(output, output_len, " |= ")
            append_expr(@addr(a.value), fun, info, arena, output, output_len)
            append_str(output, output_len, ";\n")
        )
        ast.Stmt.Return(r) => (
            indent(output, output_len, level)
            if !is_void_type(@addr(fun.return_type))
                append_str(output, output_len, "__scar_return_value = ")
                append_expr(@addr(r.value), fun, info, arena, output, output_len)
                append_str(output, output_len, ";\n")
            end
            append_str(output, output_len, "    goto __scar_return;\n")
        )
        ast.Stmt.If(if_stmt) => (
            indent(output, output_len, level)
            append_str(output, output_len, "if (")
            append_expr(@addr(if_stmt.condition), fun, info, arena, output, output_len)
            append_str(output, output_len, ") {\n")
            var k usize = 0
            for k < @len(if_stmt.then_body)
                render_stmt(@addr(if_stmt.then_body[k]), fun, info, level + 1, next_temp_id, arena, output, output_len)
                k++
            end
            indent(output, output_len, level)
            append_str(output, output_len, "}")
            if @len(if_stmt.else_body) > 0
                append_str(output, output_len, " else {\n")
                k = 0
                for k < @len(if_stmt.else_body)
                    render_stmt(@addr(if_stmt.else_body[k]), fun, info, level + 1, next_temp_id, arena, output, output_len)
                    k++
                end
                indent(output, output_len, level)
                append_str(output, output_len, "}\n")
            else
                append_str(output, output_len, "\n")
            end
        )
        ast.Stmt.While(w) => (
            indent(output, output_len, level)
            append_str(output, output_len, "while (")
            append_expr(@addr(w.condition), fun, info, arena, output, output_len)
            append_str(output, output_len, ") {\n")
            var k usize = 0
            for k < @len(w.body)
                render_stmt(@addr(w.body[k]), fun, info, level + 1, next_temp_id, arena, output, output_len)
                k++
            end
            indent(output, output_len, level)
            append_str(output, output_len, "}\n")
        )
        ast.Stmt.ForRange(fr) => (
            val var_ty ref(ast.Type) = lookup_local_type(fr.var_name, fun, info)
            indent(output, output_len, level)
            append_str(output, output_len, "for (")
            append_str(output, output_len, c_type(var_ty, arena))
            append_str(output, output_len, " ")
            append_str(output, output_len, mangle_local_symbol(fr.var_name, arena))
            append_str(output, output_len, " = ")
            append_expr(@addr(fr.start), fun, info, arena, output, output_len)
            append_str(output, output_len, "; ")
            append_str(output, output_len, mangle_local_symbol(fr.var_name, arena))
            append_str(output, output_len, " < ")
            append_expr(@addr(fr.End), fun, info, arena, output, output_len)
            append_str(output, output_len, "; ++")
            append_str(output, output_len, mangle_local_symbol(fr.var_name, arena))
            append_str(output, output_len, ") {\n")
            var k usize = 0
            for k < @len(fr.body)
                render_stmt(@addr(fr.body[k]), fun, info, level + 1, next_temp_id, arena, output, output_len)
                k++
            end
            indent(output, output_len, level)
            append_str(output, output_len, "}\n")
        )
        ast.Stmt.Match(m) => (
            val temp_id usize = @deref(next_temp_id)
            @deref(next_temp_id) = temp_id + 1
            var temp_name_buf list[u8] = []
            format_temp_name("__scar_match_", temp_id, @addr(temp_name_buf))
            val temp_name ref(u8) = @addr(temp_name_buf[0])

            val matched_ty ast.Type = infer_match_expr_type(@addr(m.expr), fun, info)

            indent(output, output_len, level)
            append_str(output, output_len, "{\n")
            indent(output, output_len, level + 1)
            append_str(output, output_len, c_type_bare(@addr(matched_ty), arena))
            append_str(output, output_len, " ")
            append_str(output, output_len, temp_name)
            append_str(output, output_len, " = ")
            append_expr(@addr(m.expr), fun, info, arena, output, output_len)
            append_str(output, output_len, ";\n")

            if is_integer_ast_type(@addr(matched_ty))
                var k usize = 0
                var had_wildcard bool = false
                for k < @len(m.arms) && !had_wildcard
                    indent(output, output_len, level + 1)
                    match m.arms[k].kind
                        ast.MatchArmKind.Wild(_) => (
                            had_wildcard = true
                            if k == 0
                                append_str(output, output_len, "{\n")
                            else
                                append_str(output, output_len, "else {\n")
                            end
                        )
                        ast.MatchArmKind.VariantName(vname) => (
                            if k == 0
                                append_str(output, output_len, "if (")
                            else
                                append_str(output, output_len, "else if (")
                            end
                            append_str(output, output_len, temp_name)
                            append_str(output, output_len, " == ")
                            append_str(output, output_len, vname)
                            append_str(output, output_len, ") {\n")
                        )
                        _ => (
                            if k == 0
                                append_str(output, output_len, "{\n")
                            else
                                append_str(output, output_len, "else {\n")
                            end
                        )
                    end
                    var l usize = 0
                    for l < @len(m.arms[k].body)
                        render_stmt(@addr(m.arms[k].body[l]), fun, info, level + 2, next_temp_id, arena, output, output_len)
                        l++
                    end
                    indent(output, output_len, level + 1)
                    append_str(output, output_len, "}\n")
                    k++
                end
            else
                match matched_ty
                    ast.Type.Named(type_name) => (
                        val dot_pos2 usize = find_last_dot(type_name)
                        var bare_type_name ref(u8) = type_name
                        if dot_pos2 < str.len(type_name)
                            bare_type_name = @add(type_name, dot_pos2 + 1)
                        end
                        var k usize = 0
                        var had_wildcard bool = false
                        for k < @len(m.arms) && !had_wildcard
                            indent(output, output_len, level + 1)
                            match m.arms[k].kind
                                ast.MatchArmKind.Wild(_) => (
                                    had_wildcard = true
                                    if k == 0
                                        append_str(output, output_len, "{\n")
                                    else
                                        append_str(output, output_len, "else {\n")
                                    end
                                )
                                ast.MatchArmKind.VariantName(vname) => (
                                    val dot_pos usize = find_last_dot(vname)
                                    var bare_variant ref(u8) = vname
                                    if dot_pos < str.len(vname)
                                        bare_variant = @add(vname, dot_pos + 1)
                                    end
                                    if k == 0
                                        append_str(output, output_len, "if (")
                                    else
                                        append_str(output, output_len, "else if (")
                                    end
                                    append_str(output, output_len, temp_name)
                                    append_str(output, output_len, ".tag == ")
                                    append_str(output, output_len, bare_type_name)
                                    append_str(output, output_len, "__tag__")
                                    append_str(output, output_len, bare_variant)
                                    append_str(output, output_len, ") {\n")
                                    var bi usize = 0
                                    for bi < @len(m.arms[k].bindings)
                                        val bname ref(u8) = m.arms[k].bindings[bi]
                                        if str.len(bname) > 0 && !str.eql(bname, "_")
                                            var payload_ty ref(u8) = "void *"
                                            var ti usize = 0
                                            for ti < @len(info.types)
                                                if str.eql(info.types[ti].name, bare_type_name)
                                                    var vi usize = 0
                                                    for vi < @len(info.types[ti].info.variant_map)
                                                        if str.eql(info.types[ti].info.variant_map[vi].name, bare_variant)
                                                            if bi < @len(info.types[ti].info.variant_map[vi].payload_types)
                                                                payload_ty = c_type(@addr(info.types[ti].info.variant_map[vi].payload_types[bi]), arena)
                                                            end
                                                            break
                                                        end
                                                        vi++
                                                    end
                                                    break
                                                end
                                                ti++
                                            end
                                            indent(output, output_len, level + 2)
                                            append_str(output, output_len, payload_ty)
                                            append_str(output, output_len, " loc__")
                                            append_str(output, output_len, bname)
                                            append_str(output, output_len, " = ")
                                            append_str(output, output_len, temp_name)
                                            append_str(output, output_len, ".data.")
                                            append_str(output, output_len, bare_variant)
                                            append_str(output, output_len, "._")
                                            append_usize(output, output_len, bi, arena)
                                            append_str(output, output_len, ";\n")
                                        end
                                        bi++
                                    end
                                )
                                ast.MatchArmKind.Ok(_) => (
                                    if k == 0
                                        append_str(output, output_len, "if (!")
                                    else
                                        append_str(output, output_len, "else if (!")
                                    end
                                    append_str(output, output_len, temp_name)
                                    append_str(output, output_len, ".is_error) {\n")
                                )
                                ast.MatchArmKind.Error(_) => (
                                    if k == 0
                                        append_str(output, output_len, "if (")
                                    else
                                        append_str(output, output_len, "else if (")
                                    end
                                    append_str(output, output_len, temp_name)
                                    append_str(output, output_len, ".is_error) {\n")
                                )
                            end
                            var l usize = 0
                            for l < @len(m.arms[k].body)
                                render_stmt(@addr(m.arms[k].body[l]), fun, info, level + 2, next_temp_id, arena, output, output_len)
                                l++
                            end
                            indent(output, output_len, level + 1)
                            append_str(output, output_len, "}\n")
                            k++
                        end
                    )
                    ast.Type.Result(_) => (
                        var k usize = 0
                        for k < @len(m.arms)
                            indent(output, output_len, level + 1)
                            match m.arms[k].kind
                                ast.MatchArmKind.Ok(_) => (
                                    if k == 0
                                        append_str(output, output_len, "if (!")
                                    else
                                        append_str(output, output_len, "else if (!")
                                    end
                                    append_str(output, output_len, temp_name)
                                    append_str(output, output_len, ".is_error) {\n")
                                    if @len(m.arms[k].bindings) > 0
                                        if str.len(m.arms[k].bindings[0]) > 0
                                            indent(output, output_len, level + 2)
                                            append_str(output, output_len, "void *loc__")
                                            append_str(output, output_len, m.arms[k].bindings[0])
                                            append_str(output, output_len, " = ")
                                            append_str(output, output_len, temp_name)
                                            append_str(output, output_len, ".ok;\n")
                                        end
                                    end
                                )
                                ast.MatchArmKind.Error(_) => (
                                    if k == 0
                                        append_str(output, output_len, "if (")
                                    else
                                        append_str(output, output_len, "else if (")
                                    end
                                    append_str(output, output_len, temp_name)
                                    append_str(output, output_len, ".is_error) {\n")
                                    if @len(m.arms[k].bindings) > 0
                                        if str.len(m.arms[k].bindings[0]) > 0
                                            indent(output, output_len, level + 2)
                                            append_str(output, output_len, "const char *loc__")
                                            append_str(output, output_len, m.arms[k].bindings[0])
                                            append_str(output, output_len, " = ")
                                            append_str(output, output_len, temp_name)
                                            append_str(output, output_len, ".error;\n")
                                        end
                                    end
                                )
                                ast.MatchArmKind.Wild(_) => (
                                    if k == 0
                                        append_str(output, output_len, "{\n")
                                    else
                                        append_str(output, output_len, "else {\n")
                                    end
                                )
                                _ => (
                                    if k == 0
                                        append_str(output, output_len, "{\n")
                                    else
                                        append_str(output, output_len, "else {\n")
                                    end
                                )
                            end
                            var l usize = 0
                            for l < @len(m.arms[k].body)
                                render_stmt(@addr(m.arms[k].body[l]), fun, info, level + 2, next_temp_id, arena, output, output_len)
                                l++
                            end
                            indent(output, output_len, level + 1)
                            append_str(output, output_len, "}\n")
                            k++
                        end
                    )
                    _ => (
                        var k usize = 0
                        for k < @len(m.arms)
                            indent(output, output_len, level + 1)
                            if k == 0
                                append_str(output, output_len, "{\n")
                            else
                                append_str(output, output_len, "else {\n")
                            end
                            var l usize = 0
                            for l < @len(m.arms[k].body)
                                render_stmt(@addr(m.arms[k].body[l]), fun, info, level + 2, next_temp_id, arena, output, output_len)
                                l++
                            end
                            indent(output, output_len, level + 1)
                            append_str(output, output_len, "}\n")
                            k++
                        end
                    )
                end
            end
            indent(output, output_len, level)
            append_str(output, output_len, "}\n")
        )
        ast.Stmt.ExprStmt(e) => (
            indent(output, output_len, level)
            append_expr(e, fun, info, arena, output, output_len)
            append_str(output, output_len, ";\n")
        )
        ast.Stmt.Increment(e) => (
            indent(output, output_len, level)
            append_expr(e, fun, info, arena, output, output_len)
            append_str(output, output_len, "++;\n")
        )
        ast.Stmt.Decrement(e) => (
            indent(output, output_len, level)
            append_expr(e, fun, info, arena, output, output_len)
            append_str(output, output_len, "--;\n")
        )
        ast.Stmt.Assert(e) => (
            indent(output, output_len, level)
            append_str(output, output_len, "if (!(")
            append_expr(e, fun, info, arena, output, output_len)
            append_str(output, output_len, ")) {\n")
            indent(output, output_len, level + 1)
            append_str(output, output_len, "scar_runtime_panic(\"assertion failed\");\n")
            indent(output, output_len, level)
            append_str(output, output_len, "}\n")
        )
        ast.Stmt.Block(body) => (
            var k usize = 0
            for k < @len(body)
                render_stmt(@addr(body[k]), fun, info, level, next_temp_id, arena, output, output_len)
                k++
            end
        )
        _ => ()
    end
end

def translate_format_string(fmt ref(u8), arena ref(allocators.Arena)) ref(u8)
    val flen usize = str.len(fmt)
    val res_res = allocators.Arena.alloc(arena, flen * 2 + 1)
    var res ref(u8) = none
    match res_res
        ok m => res = m as ref(u8)
        error _ => return fmt
    end
    var i usize = 0
    var j usize = 0
    for i < flen
        val ch u8 = @deref(@add(fmt, i))
        if ch == '{'
            if @deref(@add(fmt, i + 1)) == '}'
                @deref(@as_mut(@add(res, j))) = '%'
                @deref(@as_mut(@add(res, j + 1))) = 'd'
                j = j + 2
                i = i + 2
                continue
            elif @deref(@add(fmt, i + 1)) == 'c' && @deref(@add(fmt, i + 2)) == '}'
                @deref(@as_mut(@add(res, j))) = '%'
                @deref(@as_mut(@add(res, j + 1))) = 'c'
                j = j + 2
                i = i + 3
                continue
            elif @deref(@add(fmt, i + 1)) == 's' && @deref(@add(fmt, i + 2)) == '}'
                @deref(@as_mut(@add(res, j))) = '%'
                @deref(@as_mut(@add(res, j + 1))) = 's'
                j = j + 2
                i = i + 3
                continue
            elif @deref(@add(fmt, i + 1)) == 'u' && @deref(@add(fmt, i + 2)) == '}'
                @deref(@as_mut(@add(res, j))) = '%'
                @deref(@as_mut(@add(res, j + 1))) = 'u'
                j = j + 2
                i = i + 3
                continue
            end
        end
        @deref(@as_mut(@add(res, j))) = ch
        j = j + 1
        i = i + 1
    end
    @deref(@as_mut(@add(res, j))) = 0
    return res
end

def append_expr(expr ref(ast.Expr), fun ref(ast.Function), info ref(sema.ProgramInfo), arena ref(allocators.Arena), output ref(ref(u8)), output_len ref(usize))
    match @deref(expr)
        ast.Expr.IntLit(v) => append_u64(output, output_len, v, arena)
        ast.Expr.FloatLit(v) => append_f64(output, output_len, v, arena)
        ast.Expr.BoolLit(v) => (
            if v
                append_str(output, output_len, "1")
            else
                append_str(output, output_len, "0")
            end
        )
        ast.Expr.CharLit(v) => append_u64(output, output_len, v as u64, arena)
        ast.Expr.StrLit(s) => (
            append_str(output, output_len, "\"")
            append_escaped_str(output, output_len, s)
            append_str(output, output_len, "\"")
        )
        ast.Expr.None(_) => append_str(output, output_len, "NULL")
        ast.Expr.Ident(name) => (
            if is_local_variable(name, fun, info)
                append_str(output, output_len, mangle_local_symbol(name, arena))
            else
                append_str(output, output_len, lookup_symbol(name, info, arena))
            end
        )
        ast.Expr.Path(segments) => (
            if @len(segments) == 1
                append_str(output, output_len, mangle_local_symbol(segments[0], arena))
            else
                if is_local_variable(segments[0], fun, info)
                    val use_arrow bool = is_ref_type_by_name(segments[0], fun, info)
                    append_str(output, output_len, "(")
                    append_str(output, output_len, mangle_local_symbol(segments[0], arena))
                    append_str(output, output_len, ")")
                    var i usize = 1
                    for i < @len(segments)
                        if use_arrow && i == 1
                            append_str(output, output_len, "->")
                        else
                            append_str(output, output_len, ".")
                        end
                        append_str(output, output_len, segments[i])
                        i++
                    end
                else
                    val joined ref(u8) = join_segments_with_dunder(segments, arena)
                    append_str(output, output_len, lookup_symbol(joined, info, arena))
                end
            end
        )
        ast.Expr.Binary(b) => (
            append_str(output, output_len, "(")
            append_expr(b.lhs, fun, info, arena, output, output_len)
            append_str(output, output_len, " ")
            append_str(output, output_len, binary_op_str(b.op))
            append_str(output, output_len, " ")
            append_expr(b.rhs, fun, info, arena, output, output_len)
            append_str(output, output_len, ")")
        )
        ast.Expr.Unary(u) => (
            match u.op
                ast.UnaryOp.Neg => (
                    append_str(output, output_len, "(-")
                    append_expr(u.expr, fun, info, arena, output, output_len)
                    append_str(output, output_len, ")")
                )
                ast.UnaryOp.LogicalNot => (
                    append_str(output, output_len, "(!")
                    append_expr(u.expr, fun, info, arena, output, output_len)
                    append_str(output, output_len, ")")
                )
                ast.UnaryOp.BitNot => (
                    append_str(output, output_len, "(~")
                    append_expr(u.expr, fun, info, arena, output, output_len)
                    append_str(output, output_len, ")")
                )
            end
        )
        ast.Expr.Call(c) => (
            var is_union_ctor bool = false
            var union_type_name ref(u8) = ""
            var union_variant_name ref(u8) = ""
            match @deref(c.callee)
                ast.Expr.Path(segments) => (
                    if @len(segments) == 2
                        var ti usize = 0
                        for ti < @len(info.types)
                            if str.eql(info.types[ti].name, segments[0])
                                if info.types[ti].info.kind == sema.TypeDefKind.Union
                                    is_union_ctor = true
                                    union_type_name = segments[0]
                                    union_variant_name = segments[1]
                                end
                                break
                            end
                            ti++
                        end
                    elif @len(segments) == 3
                        var ti usize = 0
                        for ti < @len(info.types)
                            if str.eql(info.types[ti].name, segments[1])
                                if info.types[ti].info.kind == sema.TypeDefKind.Union
                                    is_union_ctor = true
                                    union_type_name = segments[1]
                                    union_variant_name = segments[2]
                                end
                                break
                            end
                            ti++
                        end
                    end
                )
                _ => ()
            end
            if is_union_ctor
                append_str(output, output_len, "((")
                append_str(output, output_len, union_type_name)
                append_str(output, output_len, "){ .tag = ")
                append_str(output, output_len, union_type_name)
                append_str(output, output_len, "__tag__")
                append_str(output, output_len, union_variant_name)
                append_str(output, output_len, ", .data.")
                append_str(output, output_len, union_variant_name)
                append_str(output, output_len, " = { ")
                var i usize = 0
                for i < @len(c.args)
                    if i > 0
                        append_str(output, output_len, ", ")
                    end
                    append_str(output, output_len, "._")
                    append_usize(output, output_len, i, arena)
                    append_str(output, output_len, " = ")
                    append_expr(@addr(c.args[i]), fun, info, arena, output, output_len)
                    i++
                end
                append_str(output, output_len, " } })")
            else
                append_expr(c.callee, fun, info, arena, output, output_len)
                append_str(output, output_len, "(")
                var i usize = 0
                for i < @len(c.args)
                    if i > 0
                        append_str(output, output_len, ", ")
                    end
                    if is_list_lit_expr(@addr(c.args[i]))
                        val param_ty ref(ast.Type) = lookup_function_param_type(c.callee, i, info)
                        append_list_literal_from_expr(@addr(c.args[i]), param_ty, fun, info, arena, output, output_len)
                    else
                        append_expr(@addr(c.args[i]), fun, info, arena, output, output_len)
                    end
                    i++
                end
                append_str(output, output_len, ")")
            end
        )
        ast.Expr.Index(idx) => (
            val base_ty ref(ast.Type) = get_expr_type(idx.base, fun, info)
            val base_ty_deref ref(ast.Type) = deref_type(base_ty)
            val element_ty ref(ast.Type) = get_list_element_type(base_ty_deref)
            val helper_prefix ref(u8) = list_helper_prefix(element_ty, arena)
            append_str(output, output_len, "(*")
            append_str(output, output_len, helper_prefix)
            append_str(output, output_len, "_at(")
            if is_ref_type(base_ty)
                append_expr(idx.base, fun, info, arena, output, output_len)
            else
                append_str(output, output_len, "&(")
                append_expr(idx.base, fun, info, arena, output, output_len)
                append_str(output, output_len, ")")
            end
            append_str(output, output_len, ", ")
            append_expr(idx.index, fun, info, arena, output, output_len)
            append_str(output, output_len, "))")
        )
        ast.Expr.Field(f) => (
            append_str(output, output_len, "(")
            append_expr(f.base, fun, info, arena, output, output_len)
            var use_arrow bool = false
            val base_ty_for_arrow ref(ast.Type) = get_expr_type(f.base, fun, info)
            match @deref(base_ty_for_arrow)
                ast.Type.Ref(_) => (
                    use_arrow = true
                )
                ast.Type.Mut(inner) => (
                    match @deref(inner)
                        ast.Type.Ref(_) => use_arrow = true
                        _ => ()
                    end
                )
                _ => (
                    match @deref(f.base)
                        ast.Expr.Ident(name) => (
                            if is_ref_type_by_name(name, fun, info)
                                use_arrow = true
                            end
                        )
                        ast.Expr.Path(segments) => (
                            if @len(segments) == 1
                                if is_ref_type_by_name(segments[0], fun, info)
                                    use_arrow = true
                                end
                            end
                        )
                        _ => ()
                    end
                )
            end
            if use_arrow
                append_str(output, output_len, ")->")
            else
                append_str(output, output_len, ").")
            end
            append_str(output, output_len, f.field)
        )
        ast.Expr.Cast(c) => (
            append_str(output, output_len, "((")
            append_str(output, output_len, c_type(@addr(c.ty), arena))
            append_str(output, output_len, ")(")
            append_expr(c.expr, fun, info, arena, output, output_len)
            append_str(output, output_len, "))")
        )
        ast.Expr.BitCast(bc) => (
            append_str(output, output_len, "((")
            append_str(output, output_len, c_type(@addr(bc.ty), arena))
            append_str(output, output_len, ")(")
            append_expr(bc.expr, fun, info, arena, output, output_len)
            append_str(output, output_len, "))")
        )
        ast.Expr.SizeOf(ty) => (
            append_str(output, output_len, "((size_t)sizeof(")
            append_str(output, output_len, c_type(ty, arena))
            append_str(output, output_len, "))")
        )
        ast.Expr.ListLit(elems) => (
            if @len(elems) == 0
                append_str(output, output_len, "list_new()")
            else
                append_str(output, output_len, "{")
                var i usize = 0
                for i < @len(elems)
                    if i > 0
                        append_str(output, output_len, ", ")
                    end
                    append_expr(@addr(elems[i]), fun, info, arena, output, output_len)
                    i++
                end
                append_str(output, output_len, "}")
            end
        )
        ast.Expr.StructInit(si) => (
            append_str(output, output_len, "(")
            append_str(output, output_len, si.name)
            append_str(output, output_len, "){ ")
            var i usize = 0
            for i < @len(si.fields)
                if i > 0
                    append_str(output, output_len, ", ")
                end
                append_str(output, output_len, ".")
                append_str(output, output_len, si.fields[i].name)
                append_str(output, output_len, " = ")
                val field_ty ref(ast.Type) = infer_field_type_simple(@addr(ast.Type.Named(si.name)), si.fields[i].name, info)
                if is_list_lit_expr(@addr(si.fields[i].value))
                    append_list_literal_from_expr(@addr(si.fields[i].value), field_ty, fun, info, arena, output, output_len)
                else
                    append_expr(@addr(si.fields[i].value), fun, info, arena, output, output_len)
                end
                i++
            end
            append_str(output, output_len, " }")
        )
        ast.Expr.MethodCall(mc) => (
            val receiver_ty ref(ast.Type) = get_expr_type(mc.receiver, fun, info)
            val deref_ty ref(ast.Type) = deref_type(receiver_ty)
            if is_list_type(deref_ty)
                val element_ty ref(ast.Type) = get_list_element_type(deref_ty)
                val helper_prefix ref(u8) = list_helper_prefix(element_ty, arena)
                append_str(output, output_len, helper_prefix)
                append_str(output, output_len, "_")
                append_str(output, output_len, mc.method)
                append_str(output, output_len, "(")
                if is_ref_type(receiver_ty)
                    append_expr(mc.receiver, fun, info, arena, output, output_len)
                else
                    append_str(output, output_len, "&(")
                    append_expr(mc.receiver, fun, info, arena, output, output_len)
                    append_str(output, output_len, ")")
                end
                var i usize = 0
                for i < @len(mc.args)
                    append_str(output, output_len, ", ")
                    append_expr(@addr(mc.args[i]), fun, info, arena, output, output_len)
                    i++
                end
                append_str(output, output_len, ")")
            else
                append_str(output, output_len, "list_")
                append_str(output, output_len, mc.method)
                append_str(output, output_len, "(")
                append_expr(mc.receiver, fun, info, arena, output, output_len)
                var i usize = 0
                for i < @len(mc.args)
                    append_str(output, output_len, ", ")
                    append_expr(@addr(mc.args[i]), fun, info, arena, output, output_len)
                    i++
                end
                append_str(output, output_len, ")")
            end
        )
        ast.Expr.BuiltinCall(bc) => (
            append_builtin_call(bc, fun, info, arena, output, output_len)
        )
        ast.Expr.Try(inner) => (
            append_str(output, output_len, "(")
            append_expr(inner, fun, info, arena, output, output_len)
            append_str(output, output_len, ".ok)")
        )
        ast.Expr.Pack(elems) => (
            var i usize = 0
            for i < @len(elems)
                if i > 0
                    append_str(output, output_len, ", ")
                end
                append_expr(@addr(elems[i]), fun, info, arena, output, output_len)
                i++
            end
        )
        ast.Expr.ErrorLit(msg) => (
            append_str(output, output_len, msg)
        )
        ast.Expr.Specialize(sp) => (
            append_expr(sp.callee, fun, info, arena, output, output_len)
        )
    end
end

def append_builtin_call(bc ref(ast.ExprBuiltinCall), fun ref(ast.Function), info ref(sema.ProgramInfo), arena ref(allocators.Arena), output ref(ref(u8)), output_len ref(usize))
    if str.eql(bc.name, "puts")
        append_str(output, output_len, "puts(")
        append_expr(@addr(bc.args[0]), fun, info, arena, output, output_len)
        append_str(output, output_len, ")")
    elif str.eql(bc.name, "flush")
        append_str(output, output_len, "fflush(stdout)")
    elif str.eql(bc.name, "args")
        append_str(output, output_len, "({ list_ref_u8 __scar_args = list_ref_u8_new(); list_ref_u8_ensure_capacity(&__scar_args, scar__argc); memcpy(__scar_args.data, scar__argv, sizeof(const char *) * (size_t)scar__argc); __scar_args.len = scar__argc; __scar_args; })")
    elif str.eql(bc.name, "print")
        var fmt ref(u8) = ""
        match bc.args[0]
            ast.Expr.StrLit(s) => fmt = s
            _ => ()
        end
        
        var flat_args list[ast.Expr] = []
        var i usize = 1
        for i < @len(bc.args)
            match bc.args[i]
                ast.Expr.Pack(elems) => (
                    var j usize = 0
                    for j < @len(elems)
                        @append(flat_args, elems[j])
                        j++
                    end
                )
                _ => @append(flat_args, bc.args[i])
            end
            i++
        end

        var translated list[u8] = []
        var markers list[ref(u8)] = []
        val flen usize = str.len(fmt)
        var idx usize = 0
        for idx < flen
            val ch u8 = @deref(@add(fmt, idx))
            if ch == '{'
                var end_idx usize = idx + 1
                for end_idx < flen && @deref(@add(fmt, end_idx)) != '}'
                    end_idx++
                end
                if end_idx < flen
                    val mlen usize = end_idx - (idx + 1)
                    val marker_res = allocators.Arena.alloc(arena, mlen + 1)
                    var marker ref(u8) = none
                    match marker_res
                        ok m => marker = m as ref(u8)
                        error _ => ()
                    end
                    if marker != none
                        @memcpy(marker, @add(fmt, idx + 1), mlen)
                        @deref(@as_mut(@add(marker, mlen))) = 0
                        @append(markers, marker)
                    end
                    
                    if str.eql(marker, "d") || str.eql(marker, "")
                        @append(translated, '%')
                        @append(translated, 'j')
                        @append(translated, 'd')
                    elif str.eql(marker, "u")
                        @append(translated, '%')
                        @append(translated, 'j')
                        @append(translated, 'u')
                    elif str.eql(marker, "s")
                        @append(translated, '%')
                        @append(translated, 's')
                    elif str.eql(marker, "c")
                        @append(translated, '%')
                        @append(translated, 'c')
                    else
                        @append(translated, '%')
                        var k usize = 0
                        for k < mlen
                            @append(translated, @deref(@add(marker, k)))
                            k++
                        end
                    end
                    idx = end_idx + 1
                    continue
                end
            end
            @append(translated, ch)
            idx++
        end
        @append(translated, 0)
        val translated_fmt ref(u8) = @addr(translated[0])

        append_str(output, output_len, "printf(\"")
        var fmt_idx usize = 0
        for fmt_idx < @len(translated)
            val fmt_ch u8 = translated[fmt_idx]
            if fmt_ch == 0
                break
            elif fmt_ch == '\\'
                append_str(output, output_len, "\\\\")
            elif fmt_ch == '"'
                append_str(output, output_len, "\\\"")
            elif fmt_ch == '\n'
                append_str(output, output_len, "\\n")
            elif fmt_ch == '\t'
                append_str(output, output_len, "\\t")
            elif fmt_ch == '\r'
                append_str(output, output_len, "\\r")
            elif fmt_ch < 32 || fmt_ch > 126
                append_str(output, output_len, "\\x")
                val hi u8 = (fmt_ch >> 4) & 0xf
                val lo u8 = fmt_ch & 0xf
                var hi_ch u8 = 0
                if hi < 10
                    hi_ch = '0' + hi
                else
                    hi_ch = 'a' + hi - 10
                end
                var lo_ch u8 = 0
                if lo < 10
                    lo_ch = '0' + lo
                else
                    lo_ch = 'a' + lo - 10
                end
                val cur usize = @deref(output_len)
                @deref(@as_mut(@add(@deref(output), cur))) = hi_ch
                @deref(@as_mut(@add(@deref(output), cur + 1))) = lo_ch
                @deref(output_len) = cur + 2
            else
                val cur usize = @deref(output_len)
                @deref(@as_mut(@add(@deref(output), cur))) = fmt_ch
                @deref(output_len) = cur + 1
            end
            fmt_idx++
        end
        append_str(output, output_len, "\"")
        var arg_idx usize = 0
        for arg_idx < @len(flat_args)
            append_str(output, output_len, ", ")
            var marker ref(u8) = ""
            if arg_idx < @len(markers)
                marker = markers[arg_idx]
            end
            if str.eql(marker, "d") || str.eql(marker, "")
                append_str(output, output_len, "((intmax_t)(")
                append_expr(@addr(flat_args[arg_idx]), fun, info, arena, output, output_len)
                append_str(output, output_len, "))")
            elif str.eql(marker, "u")
                append_str(output, output_len, "((uintmax_t)(")
                append_expr(@addr(flat_args[arg_idx]), fun, info, arena, output, output_len)
                append_str(output, output_len, "))")
            elif str.eql(marker, "c")
                append_str(output, output_len, "((int)(")
                append_expr(@addr(flat_args[arg_idx]), fun, info, arena, output, output_len)
                append_str(output, output_len, "))")
            else
                append_expr(@addr(flat_args[arg_idx]), fun, info, arena, output, output_len)
            end
            arg_idx++
        end
        append_str(output, output_len, ")")
    elif str.eql(bc.name, "alloc")
        append_str(output, output_len, "scar_runtime_alloc(")
        append_expr(@addr(bc.args[0]), fun, info, arena, output, output_len)
        append_str(output, output_len, ")")
    elif str.eql(bc.name, "realloc")
        append_str(output, output_len, "scar_runtime_realloc(")
        append_expr(@addr(bc.args[0]), fun, info, arena, output, output_len)
        append_str(output, output_len, ", ")
        append_expr(@addr(bc.args[1]), fun, info, arena, output, output_len)
        append_str(output, output_len, ")")
    elif str.eql(bc.name, "free")
        append_str(output, output_len, "scar_runtime_free(")
        append_expr(@addr(bc.args[0]), fun, info, arena, output, output_len)
        append_str(output, output_len, ")")
    elif str.eql(bc.name, "addr")
        append_str(output, output_len, "(&")
        append_expr(@addr(bc.args[0]), fun, info, arena, output, output_len)
        append_str(output, output_len, ")")
    elif str.eql(bc.name, "deref")
        append_str(output, output_len, "(*")
        append_expr(@addr(bc.args[0]), fun, info, arena, output, output_len)
        append_str(output, output_len, ")")
    elif str.eql(bc.name, "memcpy")
        append_str(output, output_len, "memcpy(")
        append_expr(@addr(bc.args[0]), fun, info, arena, output, output_len)
        append_str(output, output_len, ", ")
        append_expr(@addr(bc.args[1]), fun, info, arena, output, output_len)
        append_str(output, output_len, ", ")
        append_expr(@addr(bc.args[2]), fun, info, arena, output, output_len)
        append_str(output, output_len, ")")
    elif str.eql(bc.name, "memset")
        append_str(output, output_len, "memset(")
        append_expr(@addr(bc.args[0]), fun, info, arena, output, output_len)
        append_str(output, output_len, ", ")
        append_expr(@addr(bc.args[1]), fun, info, arena, output, output_len)
        append_str(output, output_len, ", ")
        append_expr(@addr(bc.args[2]), fun, info, arena, output, output_len)
        append_str(output, output_len, ")")
    elif str.eql(bc.name, "zeroed")
        append_str(output, output_len, "{0}")
    elif str.eql(bc.name, "neg")
        append_str(output, output_len, "(-")
        append_expr(@addr(bc.args[0]), fun, info, arena, output, output_len)
        append_str(output, output_len, ")")
    elif str.eql(bc.name, "shl")
        append_str(output, output_len, "(")
        append_expr(@addr(bc.args[0]), fun, info, arena, output, output_len)
        append_str(output, output_len, " << ")
        append_expr(@addr(bc.args[1]), fun, info, arena, output, output_len)
        append_str(output, output_len, ")")
    elif str.eql(bc.name, "shr")
        append_str(output, output_len, "(")
        append_expr(@addr(bc.args[0]), fun, info, arena, output, output_len)
        append_str(output, output_len, " >> ")
        append_expr(@addr(bc.args[1]), fun, info, arena, output, output_len)
        append_str(output, output_len, ")")
    elif str.eql(bc.name, "as_mut")
        append_expr(@addr(bc.args[0]), fun, info, arena, output, output_len)
    elif str.eql(bc.name, "add")
        append_str(output, output_len, "(")
        append_expr(@addr(bc.args[0]), fun, info, arena, output, output_len)
        append_str(output, output_len, " + ")
        append_expr(@addr(bc.args[1]), fun, info, arena, output, output_len)
        append_str(output, output_len, ")")
    elif str.eql(bc.name, "call")
        append_expr(@addr(bc.args[0]), fun, info, arena, output, output_len)
        append_str(output, output_len, "(")
        var i usize = 1
        for i < @len(bc.args)
            if i > 1
                append_str(output, output_len, ", ")
            end
            append_expr(@addr(bc.args[i]), fun, info, arena, output, output_len)
            i++
        end
        append_str(output, output_len, ")")
    elif str.eql(bc.name, "len")
        if @len(bc.args) > 0
            val arg_ty ref(ast.Type) = get_expr_type(@addr(bc.args[0]), fun, info)
            val deref_ty ref(ast.Type) = deref_type(arg_ty)
            if is_list_type(deref_ty)
                val element_ty ref(ast.Type) = get_list_element_type(deref_ty)
                val helper_prefix ref(u8) = list_helper_prefix(element_ty, arena)
                append_str(output, output_len, helper_prefix)
                append_str(output, output_len, "_len(")
                if is_ref_type(arg_ty)
                    append_expr(@addr(bc.args[0]), fun, info, arena, output, output_len)
                else
                    append_str(output, output_len, "&(")
                    append_expr(@addr(bc.args[0]), fun, info, arena, output, output_len)
                    append_str(output, output_len, ")")
                end
                append_str(output, output_len, ")")
            else
                append_expr(@addr(bc.args[0]), fun, info, arena, output, output_len)
                append_str(output, output_len, ".len")
            end
        else
            append_str(output, output_len, "0")
        end
    elif str.eql(bc.name, "append")
        if @len(bc.args) > 0
            val arg_ty ref(ast.Type) = get_expr_type(@addr(bc.args[0]), fun, info)
            val deref_ty ref(ast.Type) = deref_type(arg_ty)
            if is_list_type(deref_ty)
                val element_ty ref(ast.Type) = get_list_element_type(deref_ty)
                val helper_prefix ref(u8) = list_helper_prefix(element_ty, arena)
                append_str(output, output_len, helper_prefix)
                append_str(output, output_len, "_append(")
                if is_ref_type(arg_ty)
                    append_expr(@addr(bc.args[0]), fun, info, arena, output, output_len)
                else
                    append_str(output, output_len, "&(")
                    append_expr(@addr(bc.args[0]), fun, info, arena, output, output_len)
                    append_str(output, output_len, ")")
                end
                var i usize = 1
                for i < @len(bc.args)
                    append_str(output, output_len, ", ")
                    append_expr(@addr(bc.args[i]), fun, info, arena, output, output_len)
                    i++
                end
                append_str(output, output_len, ")")
            else
                append_expr(@addr(bc.args[0]), fun, info, arena, output, output_len)
                append_str(output, output_len, ".append(")
                var i usize = 1
                for i < @len(bc.args)
                    if i > 1
                        append_str(output, output_len, ", ")
                    end
                    append_expr(@addr(bc.args[i]), fun, info, arena, output, output_len)
                    i++
                end
                append_str(output, output_len, ")")
            end
        end
    else
        append_str(output, output_len, "0")
    end
end

def render_entrypoint(fun ref(ast.Function), info ref(sema.ProgramInfo), arena ref(allocators.Arena), output ref(ref(u8)), output_len ref(usize))
    val symbol ref(u8) = lookup_symbol(fun.name, info, arena)
    append_str(output, output_len, "int main(int argc, char *argv[]) {\n")
    append_str(output, output_len, "    scar__argc = argc;\n")
    append_str(output, output_len, "    scar__argv = argv;\n")
    append_str(output, output_len, "    scar_runtime_install_signal_handlers();\n")
    append_str(output, output_len, "    ")
    append_str(output, output_len, symbol)
    append_str(output, output_len, "();\n")
    append_str(output, output_len, "    return 0;\n")
    append_str(output, output_len, "}\n")
end

def c_type(ty ref(ast.Type), arena ref(allocators.Arena)) ref(u8)
    match @deref(ty)
        ast.Type.Void(_) => return "void"
        ast.Type.Bool(_) => return "int32_t"
        ast.Type.I8(_) => return "int8_t"
        ast.Type.I16(_) => return "int16_t"
        ast.Type.I32(_) => return "int32_t"
        ast.Type.I64(_) => return "int64_t"
        ast.Type.Isize(_) => return "intptr_t"
        ast.Type.U8(_) => return "uint8_t"
        ast.Type.U16(_) => return "uint16_t"
        ast.Type.U32(_) => return "uint32_t"
        ast.Type.U64(_) => return "uint64_t"
        ast.Type.Usize(_) => return "size_t"
        ast.Type.F32(_) => return "float"
        ast.Type.F64(_) => return "double"
        ast.Type.Ref(inner) => (
            val inner_type ref(u8) = c_type(inner, arena)
            val inner_len usize = str.len(inner_type)
            val result_res = allocators.Arena.alloc(arena, inner_len + 3)
            var result ref(u8) = none
            match result_res
                ok m => result = m as ref(u8)
                error _ => return "void *"
            end
            @memcpy(result, inner_type, inner_len)
            @deref(@as_mut(@add(result, inner_len))) = ' '
            @deref(@as_mut(@add(result, inner_len + 1))) = '*'
            @deref(@as_mut(@add(result, inner_len + 2))) = 0
            return result
        )
        ast.Type.Mut(inner) => (
            val inner_type ref(u8) = c_type(inner, arena)
            val inner_len usize = str.len(inner_type)
            val result_res = allocators.Arena.alloc(arena, inner_len + 3)
            var result ref(u8) = none
            match result_res
                ok m => result = m as ref(u8)
                error _ => return "void *"
            end
            @memcpy(result, inner_type, inner_len)
            @deref(@as_mut(@add(result, inner_len))) = ' '
            @deref(@as_mut(@add(result, inner_len + 1))) = '*'
            @deref(@as_mut(@add(result, inner_len + 2))) = 0
            return result
        )
        ast.Type.List(inner) => (
            val suffix ref(u8) = type_suffix(inner, arena)
            val slen usize = str.len(suffix)
            val prefix ref(u8) = "scar_list__"
            val plen usize = str.len(prefix)
            val result_res = allocators.Arena.alloc(arena, plen + slen + 1)
            var result ref(u8) = none
            match result_res
                ok m => result = m as ref(u8)
                error _ => return "void"
            end
            @memcpy(result, prefix, plen)
            @memcpy(@add(result, plen), suffix, slen)
            @deref(@as_mut(@add(result, plen + slen))) = 0
            return result
        )
        ast.Type.Result(_) => return "scar_result"
        ast.Type.Named(name) => return name
        ast.Type.Applied(name, _) => return name
        ast.Type.FnPtr(_, _) => return "void *"
        ast.Type.Infer(_) => return "void"
        ast.Type.Error(_) => return "const char *"
        ast.Type.None(_) => return "NULL"
    end
    return "void"
end

def c_type_bare(ty ref(ast.Type), arena ref(allocators.Arena)) ref(u8)
    return c_type(ty, arena)
end

def mangle_type_name(name ref(u8), arena ref(allocators.Arena)) ref(u8)
    val nlen usize = str.len(name)
    var has_dot bool = false
    var i usize = 0
    for i < nlen
        if @deref(@add(name, i)) == '.'
            has_dot = true
            break
        end
        i++
    end
    if !has_dot
        return name
    end
    val result_res = allocators.Arena.alloc(arena, nlen + 2)
    var result ref(u8) = none
    match result_res
        ok m => result = m as ref(u8)
        error _ => return name
    end
    var src usize = 0
    var dst usize = 0
    for src < nlen
        val ch u8 = @deref(@add(name, src))
        if ch == '.'
            @deref(@as_mut(@add(result, dst))) = '_'
            dst++
            @deref(@as_mut(@add(result, dst))) = '_'
            dst++
        else
            @deref(@as_mut(@add(result, dst))) = ch
            dst++
        end
        src++
    end
    @deref(@as_mut(@add(result, dst))) = 0
    return result
end

def c_type_named(ty ref(ast.Type), name ref(u8), arena ref(allocators.Arena)) ref(u8)
    val base ref(u8) = c_type_bare(ty, arena)
    val base_len usize = str.len(base)
    val mangled ref(u8) = mangle_local_symbol(name, arena)
    val mangled_len usize = str.len(mangled)
    val result_res = allocators.Arena.alloc(arena, base_len + 1 + mangled_len + 1)
    var result ref(u8) = none
    match result_res
        ok m => result = m as ref(u8)
        error _ => return "void error"
    end
    @memcpy(result, base, base_len)
    @deref(@as_mut(@add(result, base_len))) = ' '
    @memcpy(@add(result, base_len + 1), mangled, mangled_len)
    @deref(@as_mut(@add(result, base_len + 1 + mangled_len))) = 0
    return result
end

def type_suffix(ty ref(ast.Type), arena ref(allocators.Arena)) ref(u8)
    match @deref(ty)
        ast.Type.Void(_) => return "void"
        ast.Type.Bool(_) => return "bool"
        ast.Type.I8(_) => return "i8"
        ast.Type.I16(_) => return "i16"
        ast.Type.I32(_) => return "i32"
        ast.Type.I64(_) => return "i64"
        ast.Type.Isize(_) => return "isize"
        ast.Type.U8(_) => return "u8"
        ast.Type.U16(_) => return "u16"
        ast.Type.U32(_) => return "u32"
        ast.Type.U64(_) => return "u64"
        ast.Type.Usize(_) => return "usize"
        ast.Type.F32(_) => return "f32"
        ast.Type.F64(_) => return "f64"
        ast.Type.Named(name) => (
            val nlen usize = str.len(name)
            val result_res = allocators.Arena.alloc(arena, nlen + 1)
            var result ref(u8) = none
            match result_res
                ok m => result = m as ref(u8)
                error _ => return "error"
            end
            var i usize = 0
            for i < nlen
                val ch u8 = @deref(@add(name, i))
                if (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_'
                    @deref(@as_mut(@add(result, i))) = ch
                else
                    @deref(@as_mut(@add(result, i))) = '_'
                end
                i++
            end
            @deref(@as_mut(@add(result, nlen))) = 0
            return result
        )
        ast.Type.List(inner) => (
            val inner_suffix ref(u8) = type_suffix(inner, arena)
            val islen usize = str.len(inner_suffix)
            val prefix ref(u8) = "list__"
            val plen usize = str.len(prefix)
            val result_res = allocators.Arena.alloc(arena, plen + islen + 1)
            var result ref(u8) = none
            match result_res
                ok m => result = m as ref(u8)
                error _ => return "error"
            end
            @memcpy(result, prefix, plen)
            @memcpy(@add(result, plen), inner_suffix, islen)
            @deref(@as_mut(@add(result, plen + islen))) = 0
            return result
        )
        ast.Type.Ref(inner) => (
            val inner_suffix ref(u8) = type_suffix(inner, arena)
            val islen usize = str.len(inner_suffix)
            val prefix ref(u8) = "ref__"
            val plen usize = str.len(prefix)
            val result_res = allocators.Arena.alloc(arena, plen + islen + 1)
            var result ref(u8) = none
            match result_res
                ok m => result = m as ref(u8)
                error _ => return "error"
            end
            @memcpy(result, prefix, plen)
            @memcpy(@add(result, plen), inner_suffix, islen)
            @deref(@as_mut(@add(result, plen + islen))) = 0
            return result
        )
        ast.Type.Mut(inner) => (
            val inner_suffix ref(u8) = type_suffix(inner, arena)
            val islen usize = str.len(inner_suffix)
            val prefix ref(u8) = "mut__"
            val plen usize = str.len(prefix)
            val result_res = allocators.Arena.alloc(arena, plen + islen + 1)
            var result ref(u8) = none
            match result_res
                ok m => result = m as ref(u8)
                error _ => return "error"
            end
            @memcpy(result, prefix, plen)
            @memcpy(@add(result, plen), inner_suffix, islen)
            @deref(@as_mut(@add(result, plen + islen))) = 0
            return result
        )
        ast.Type.Result(inner) => (
            val inner_suffix ref(u8) = type_suffix(inner, arena)
            val islen usize = str.len(inner_suffix)
            val prefix ref(u8) = "result__"
            val plen usize = str.len(prefix)
            val result_res = allocators.Arena.alloc(arena, plen + islen + 1)
            var result ref(u8) = none
            match result_res
                ok m => result = m as ref(u8)
                error _ => return "error"
            end
            @memcpy(result, prefix, plen)
            @memcpy(@add(result, plen), inner_suffix, islen)
            @deref(@as_mut(@add(result, plen + islen))) = 0
            return result
        )
        ast.Type.FnPtr(params, ret) => (
            val ret_suffix ref(u8) = type_suffix(ret, arena)
            val rlen usize = str.len(ret_suffix)
            val prefix ref(u8) = "fn__"
            val plen usize = str.len(prefix)
            var total usize = plen + rlen + 1
            var i usize = 0
            for i < @len(params)
                val param_suffix ref(u8) = type_suffix(@addr(params[i]), arena)
                total = total + str.len(param_suffix) + 2
                i++
            end
            val result_res = allocators.Arena.alloc(arena, total)
            var result ref(u8) = none
            match result_res
                ok m => result = m as ref(u8)
                error _ => return "error"
            end
            @memcpy(result, prefix, plen)
            var offset usize = plen
            i = 0
            for i < @len(params)
                val param_suffix ref(u8) = type_suffix(@addr(params[i]), arena)
                val pslen usize = str.len(param_suffix)
                @memcpy(@add(result, offset), param_suffix, pslen)
                offset = offset + pslen
                @deref(@as_mut(@add(result, offset))) = '_'
                offset++
                @deref(@as_mut(@add(result, offset))) = '_'
                offset++
                i++
            end
            @memcpy(@add(result, offset), ret_suffix, rlen)
            offset = offset + rlen
            @deref(@as_mut(@add(result, offset))) = 0
            return result
        )
        ast.Type.Applied(name, type_args) => (
            val nlen usize = str.len(name)
            var total usize = nlen + 2
            var i usize = 0
            for i < @len(type_args)
                val arg_suffix ref(u8) = type_suffix(@addr(type_args[i]), arena)
                total = total + str.len(arg_suffix) + 2
                i++
            end
            val result_res = allocators.Arena.alloc(arena, total)
            var result ref(u8) = none
            match result_res
                ok m => result = m as ref(u8)
                error _ => return "error"
            end
            @memcpy(result, name, nlen)
            var offset usize = nlen
            @deref(@as_mut(@add(result, offset))) = '_'
            offset++
            @deref(@as_mut(@add(result, offset))) = '_'
            offset++
            i = 0
            for i < @len(type_args)
                val arg_suffix ref(u8) = type_suffix(@addr(type_args[i]), arena)
                val aslen usize = str.len(arg_suffix)
                @memcpy(@add(result, offset), arg_suffix, aslen)
                offset = offset + aslen
                @deref(@as_mut(@add(result, offset))) = '_'
                offset++
                @deref(@as_mut(@add(result, offset))) = '_'
                offset++
                i++
            end
            @deref(@as_mut(@add(result, offset - 2))) = 0
            return result
        )
        _ => return "void"
    end
end

def list_helper_prefix(element_ty ref(ast.Type), arena ref(allocators.Arena)) ref(u8)
    val suffix ref(u8) = type_suffix(element_ty, arena)
    val slen usize = str.len(suffix)
    val prefix ref(u8) = "scar_list__"
    val plen usize = str.len(prefix)
    val result_res = allocators.Arena.alloc(arena, plen + slen + 1)
    var result ref(u8) = none
    match result_res
        ok m => result = m as ref(u8)
        error _ => return "scar_list__void"
    end
    @memcpy(result, prefix, plen)
    @memcpy(@add(result, plen), suffix, slen)
    @deref(@as_mut(@add(result, plen + slen))) = 0
    return result
end

def mangle_local_symbol(name ref(u8), arena ref(allocators.Arena)) ref(u8)
    if name == none
        return "loc__"
    end
    val prefix ref(u8) = "loc__"
    val plen usize = str.len(prefix)
    val nlen usize = str.len(name)
    if nlen == 0
        return "loc__"
    end
    val result_res = allocators.Arena.alloc(arena, plen + nlen + 1)
    var result ref(u8) = none
    match result_res
        ok m => result = m as ref(u8)
        error _ => return "loc__error"
    end
    @memcpy(result, prefix, plen)
    var i usize = 0
    for i < nlen
        val ch u8 = @deref(@add(name, i))
        if (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_'
            @deref(@as_mut(@add(result, plen + i))) = ch
        else
            @deref(@as_mut(@add(result, plen + i))) = '_'
        end
        i++
    end
    @deref(@as_mut(@add(result, plen + nlen))) = 0
    return result
end

def find_last_dot(s ref(u8)) usize
    val slen usize = str.len(s)
    var i usize = slen
    for i > 0
        i--
        if @deref(@add(s, i)) == '.'
            return i
        end
    end
    return slen
end

def join_segments_with_dunder(segments list[ref(u8)], arena ref(allocators.Arena)) ref(u8)
    var total usize = 1
    var i usize = 0
    for i < @len(segments)
        total = total + str.len(segments[i])
        if i > 0
            total = total + 2
        end
        i++
    end
    val buf_res = allocators.Arena.alloc(arena, total)
    var buf ref(u8) = none
    match buf_res
        ok m => buf = m as ref(u8)
        error _ => return ""
    end
    var offset usize = 0
    i = 0
    for i < @len(segments)
        if i > 0
            @deref(@as_mut(@add(buf, offset))) = '_'
            offset++
            @deref(@as_mut(@add(buf, offset))) = '_'
            offset++
        end
        val slen usize = str.len(segments[i])
        @memcpy(@add(buf, offset), segments[i], slen)
        offset = offset + slen
        i++
    end
    @deref(@as_mut(@add(buf, offset))) = 0
    return buf
end

def strip_module_prefix(name ref(u8)) ref(u8)
    val nlen usize = str.len(name)
    var last_sep usize = nlen
    var i usize = 0
    for i + 1 < nlen
        if @deref(@add(name, i)) == '_' && @deref(@add(name, i + 1)) == '_'
            last_sep = i + 2
        end
        i++
    end
    if last_sep < nlen
        return @add(name, last_sep)
    end
    return name
end

def is_ref_type(ty ref(ast.Type)) bool
    match @deref(ty)
        ast.Type.Ref(_) => return true
        ast.Type.Mut(inner) => (
            match @deref(inner)
                ast.Type.Ref(_) => return true
                _ => return false
            end
        )
        _ => return false
    end
end

def deref_type(ty ref(ast.Type)) ref(ast.Type)
    match @deref(ty)
        ast.Type.Ref(inner) => return deref_type(inner)
        ast.Type.Mut(inner) => return deref_type(inner)
        _ => return ty
    end
end

def is_list_lit_expr(expr ref(ast.Expr)) bool
    match @deref(expr)
        ast.Expr.ListLit(_) => return true
        _ => return false
    end
end

def append_list_literal_from_expr(expr ref(ast.Expr), hint ref(ast.Type), fun ref(ast.Function), info ref(sema.ProgramInfo), arena ref(allocators.Arena), output ref(ref(u8)), output_len ref(usize))
    match @deref(expr)
        ast.Expr.ListLit(elems) => (
            val deref_hint ref(ast.Type) = deref_type(hint)
            var element_ty ref(ast.Type) = get_list_element_type(deref_hint)
            match @deref(element_ty)
                ast.Type.Void(_) => (
                    if @len(elems) > 0
                        element_ty = get_expr_type(@addr(elems[0]), fun, info)
                    end
                )
                _ => ()
            end
            val helper_prefix ref(u8) = list_helper_prefix(element_ty, arena)
            if @len(elems) == 0
                append_str(output, output_len, helper_prefix)
                append_str(output, output_len, "_new()")
            else
                append_str(output, output_len, helper_prefix)
                append_str(output, output_len, "_from_array((")
                append_str(output, output_len, c_type(element_ty, arena))
                append_str(output, output_len, " const []){")
                var i usize = 0
                for i < @len(elems)
                    if i > 0
                        append_str(output, output_len, ", ")
                    end
                    if is_list_lit_expr(@addr(elems[i]))
                        append_list_literal_from_expr(@addr(elems[i]), element_ty, fun, info, arena, output, output_len)
                    else
                        append_expr(@addr(elems[i]), fun, info, arena, output, output_len)
                    end
                    i++
                end
                append_str(output, output_len, "}, ")
                append_u64(output, output_len, @len(elems) as u64, arena)
                append_str(output, output_len, ")")
            end
        )
        _ => append_expr(expr, fun, info, arena, output, output_len)
    end
end

def lookup_function_param_type(callee ref(ast.Expr), param_idx usize, info ref(sema.ProgramInfo)) ref(ast.Type)
    match @deref(callee)
        ast.Expr.Ident(name) => (
            var i usize = 0
            for i < @len(info.functions)
                if str.eql(info.functions[i].name, name)
                    if param_idx < @len(info.functions[i].sig.params)
                        return @addr(info.functions[i].sig.params[param_idx])
                    end
                end
                i++
            end
        )
        ast.Expr.Path(segments) => (
            if @len(segments) == 1
                var i usize = 0
                for i < @len(info.functions)
                    if str.eql(info.functions[i].name, segments[0])
                        if param_idx < @len(info.functions[i].sig.params)
                            return @addr(info.functions[i].sig.params[param_idx])
                        end
                    end
                    i++
                end
            end
        )
        _ => ()
    end
    return @addr(ast.Type.Void(0))
end

def get_expr_type(expr ref(ast.Expr), fun ref(ast.Function), info ref(sema.ProgramInfo)) ref(ast.Type)
    match @deref(expr)
        ast.Expr.Ident(name) => (
            val ty ref(ast.Type) = lookup_local_type(name, fun, info)
            match @deref(ty)
                ast.Type.Void(_) => (
                    var i usize = 0
                    for i < @len(fun.params)
                        if str.eql(fun.params[i].name, name)
                            return @addr(fun.params[i].ty)
                        end
                        i++
                    end
                )
                _ => ()
            end
            return ty
        )
        ast.Expr.Field(f) => (
            val base_ty ref(ast.Type) = get_expr_type(f.base, fun, info)
            val base_ty_deref ref(ast.Type) = deref_type(base_ty)
            return infer_field_type_simple(base_ty_deref, f.field, info)
        )
        ast.Expr.Index(idx) => (
            val base_ty ref(ast.Type) = get_expr_type(idx.base, fun, info)
            val base_ty_deref ref(ast.Type) = deref_type(base_ty)
            return get_list_element_type(base_ty_deref)
        )
        ast.Expr.Path(segments) => (
            if @len(segments) == 1
                return lookup_local_type(segments[0], fun, info)
            end
            if @len(segments) == 2
                val base_ty ref(ast.Type) = lookup_local_type(segments[0], fun, info)
                val base_ty_deref ref(ast.Type) = deref_type(base_ty)
                return infer_field_type_simple(base_ty_deref, segments[1], info)
            end
            return @addr(ast.Type.Void(0))
        )
        ast.Expr.IntLit(_) => return @addr(ast.Type.I64(0))
        ast.Expr.FloatLit(_) => return @addr(ast.Type.F64(0))
        ast.Expr.BoolLit(_) => return @addr(ast.Type.Bool(0))
        ast.Expr.CharLit(_) => return @addr(ast.Type.U8(0))
        ast.Expr.StrLit(_) => return @addr(ast.Type.Ref(@addr(ast.Type.U8(0))))
        ast.Expr.Call(c) => (
            match @deref(c.callee)
                ast.Expr.Ident(name) => (
                    var i usize = 0
                    for i < @len(info.functions)
                        if str.eql(info.functions[i].name, name)
                            return @addr(info.functions[i].sig.return_type)
                        end
                        i++
                    end
                )
                ast.Expr.Path(segments) => (
                    if @len(segments) == 1
                        var i usize = 0
                        for i < @len(info.functions)
                            if str.eql(info.functions[i].name, segments[0])
                                return @addr(info.functions[i].sig.return_type)
                            end
                            i++
                        end
                    end
                )
                _ => ()
            end
        )
        _ => return @addr(ast.Type.Void(0))
    end
end

def infer_field_type_simple(base_ty ref(ast.Type), field ref(u8), info ref(sema.ProgramInfo)) ref(ast.Type)
    match @deref(base_ty)
        ast.Type.Named(name) => (
            val dot_pos usize = find_last_dot(name)
            var bare_name ref(u8) = name
            if dot_pos < str.len(name)
                bare_name = @add(name, dot_pos + 1)
            end
            var i usize = 0
            for i < @len(info.types)
                if str.eql(info.types[i].name, bare_name) || str.eql(info.types[i].name, name)
                    var j usize = 0
                    for j < @len(info.types[i].info.field_map)
                        if str.eql(info.types[i].info.field_map[j].name, field)
                            return @addr(info.types[i].info.field_map[j].ty)
                        end
                        j++
                    end
                    break
                end
                i++
            end
        )
        _ => ()
    end
    return @addr(ast.Type.Void(0))
end

def get_list_element_type(ty ref(ast.Type)) ref(ast.Type)
    match @deref(ty)
        ast.Type.List(inner) => return inner
        _ => return @addr(ast.Type.Void(0))
    end
end

def is_list_type(ty ref(ast.Type)) bool
    match @deref(ty)
        ast.Type.List(_) => return true
        _ => return false
    end
end

def lookup_symbol(name ref(u8), info ref(sema.ProgramInfo), arena ref(allocators.Arena)) ref(u8)
    var i usize = 0
    for i < @len(info.function_symbols)
        if str.eql(info.function_symbols[i].name, name)
            return info.function_symbols[i].symbol
        end
        i++
    end
    return mangle_local_symbol(name, arena)
end

def is_ref_type_by_name(name ref(u8), fun ref(ast.Function), info ref(sema.ProgramInfo)) bool
    var i usize = 0
    for i < @len(fun.params)
        if str.eql(fun.params[i].name, name)
            match fun.params[i].ty
                ast.Type.Ref(_) => return true
                ast.Type.Mut(inner) => (
                    match @deref(inner)
                        ast.Type.Ref(_) => return true
                        _ => ()
                    end
                )
                _ => ()
            end
            return false
        end
        i++
    end
    i = 0
    for i < @len(info.locals)
        if str.eql(info.locals[i].function_name, fun.name)
            var j usize = 0
            for j < @len(info.locals[i].bindings)
                if str.eql(info.locals[i].bindings[j].name, name)
                    match info.locals[i].bindings[j].ty
                        ast.Type.Ref(_) => return true
                        ast.Type.Mut(inner) => (
                            match @deref(inner)
                                ast.Type.Ref(_) => return true
                                _ => ()
                            end
                        )
                        _ => ()
                    end
                    return false
                end
                j++
            end
            break
        end
        i++
    end
    return false
end

def lookup_local_type(name ref(u8), fun ref(ast.Function), info ref(sema.ProgramInfo)) ref(ast.Type)
    var i usize = 0
    for i < @len(info.locals)
        if str.eql(info.locals[i].function_name, fun.name)
            var j usize = 0
            for j < @len(info.locals[i].bindings)
                if str.eql(info.locals[i].bindings[j].name, name)
                    return @addr(info.locals[i].bindings[j].ty)
                end
                j++
            end
            break
        end
        i++
    end
    i = 0
    for i < @len(fun.params)
        if str.eql(fun.params[i].name, name)
            return @addr(fun.params[i].ty)
        end
        i++
    end
    return @addr(ast.Type.Void(0))
end

def is_local_variable(name ref(u8), fun ref(ast.Function), info ref(sema.ProgramInfo)) bool
    val ty ref(ast.Type) = lookup_local_type(name, fun, info)
    match @deref(ty)
        ast.Type.Void(_) => return false
        _ => return true
    end
end

def binary_op_str(op ast.BinaryOp) ref(u8)
    match op
        ast.BinaryOp.Add => return "+"
        ast.BinaryOp.Subtract => return "-"
        ast.BinaryOp.Multiply => return "*"
        ast.BinaryOp.Divide => return "/"
        ast.BinaryOp.Modulo => return "%"
        ast.BinaryOp.LogicalAnd => return "&&"
        ast.BinaryOp.LogicalOr => return "||"
        ast.BinaryOp.BitAnd => return "&"
        ast.BinaryOp.BitOr => return "|"
        ast.BinaryOp.BitXor => return "^"
        ast.BinaryOp.ShiftLeft => return "<<"
        ast.BinaryOp.ShiftRight => return ">>"
        ast.BinaryOp.LessThan => return "<"
        ast.BinaryOp.LessEqual => return "<="
        ast.BinaryOp.GreaterThan => return ">"
        ast.BinaryOp.GreaterEqual => return ">="
        ast.BinaryOp.Equal => return "=="
        ast.BinaryOp.NotEqual => return "!="
    end
    return "?"
end

def is_void_type(ty ref(ast.Type)) bool
    match @deref(ty)
        ast.Type.Void(_) => return true
        _ => return false
    end
end

def is_aggregate_type(ty ref(ast.Type)) bool
    match @deref(ty)
        ast.Type.Named(_) => return true
        ast.Type.Applied(_, _) => return true
        ast.Type.List(_) => return true
        ast.Type.Result(_) => return true
        _ => return false
    end
end

def indent(output ref(ref(u8)), output_len ref(usize), level usize)
    var i usize = 0
    for i < level
        append_str(output, output_len, "    ")
        i++
    end
end

def append_str(output ref(ref(u8)), output_len ref(usize), s ref(u8))
    val slen usize = str.len(s)
    val current_len usize = @deref(output_len)
    @memcpy(@add(@deref(output), current_len), s, slen)
    @deref(output_len) = current_len + slen
end

def append_escaped_str(output ref(ref(u8)), output_len ref(usize), s ref(u8))
    var i usize = 0
    val slen usize = str.len(s)
    for i < slen
        val ch u8 = @deref(@add(s, i))
        if ch == '\\'
            append_str(output, output_len, "\\\\")
        elif ch == '"'
            append_str(output, output_len, "\\\"")
        elif ch == '\n'
            append_str(output, output_len, "\\n")
        elif ch == '\r'
            append_str(output, output_len, "\\r")
        elif ch == '\t'
            append_str(output, output_len, "\\t")
        elif ch < 32 || ch > 126
            append_str(output, output_len, "\\x")
            val hi u8 = (ch >> 4) & 0xf
            val lo u8 = ch & 0xf
            var hi_ch u8 = 0
            if hi < 10
                hi_ch = '0' + hi
            else
                hi_ch = 'a' + hi - 10
            end
            var lo_ch u8 = 0
            if lo < 10
                lo_ch = '0' + lo
            else
                lo_ch = 'a' + lo - 10
            end
            val cur usize = @deref(output_len)
            @deref(@as_mut(@add(@deref(output), cur))) = hi_ch
            @deref(@as_mut(@add(@deref(output), cur + 1))) = lo_ch
            @deref(output_len) = cur + 2
        else
            val current_len usize = @deref(output_len)
            @deref(@as_mut(@add(@deref(output), current_len))) = ch
            @deref(output_len) = current_len + 1
        end
        i++
    end
end

def append_u64(output ref(ref(u8)), output_len ref(usize), v u64, arena ref(allocators.Arena))
    val buf_res = allocators.Arena.alloc(arena, 32)
    var buf ref(u8) = none
    match buf_res
        ok m => buf = m as ref(u8)
        error _ => return
    end
    var value u64 = v
    var i usize = 31
    @deref(@as_mut(@add(buf, i))) = 0
    if value == 0
        i--
        @deref(@as_mut(@add(buf, i))) = '0'
    else
        for value > 0
            i--
            val digit u8 = (value % 10) as u8 + '0'
            @deref(@as_mut(@add(buf, i))) = digit
            value /= 10
        end
    end
    append_str(output, output_len, @add(buf, i))
end

def append_usize(output ref(ref(u8)), output_len ref(usize), v usize, arena ref(allocators.Arena))
    append_u64(output, output_len, v as u64, arena)
end

def append_f64(output ref(ref(u8)), output_len ref(usize), v f64, arena ref(allocators.Arena))
    append_str(output, output_len, "0.0")
end

def format_temp_name(prefix ref(u8), id usize, buf ref(list[u8]))
    val plen usize = str.len(prefix)
    var i usize = 0
    for i < plen
        @append(buf, @deref(@add(prefix, i)))
        i++
    end
    var value usize = id
    if value == 0
        @append(buf, '0')
    else
        var digits list[u8] = []
        for value > 0
            @append(digits, ((value % 10) as u8) + '0')
            value = value / 10
        end
        var k usize = @len(digits)
        for k > 0
            k--
            @append(buf, digits[k])
        end
    end
    @append(buf, 0)
end
