val str = use("std/string")
val ast = use("ast")
val allocators = use("std/allocators")
val gen = use("generics")

pub type GenericState
    templates list[ast.Function]
    generated list[ast.Function]
    instantiated_keys list[ref(u8)]
    instantiated_names list[ref(u8)]
    type_defs list[ast.TypeDef]
    current_body list[ast.Stmt]
    current_params list[ast.Param]
end

def find_template(state ref(GenericState), name ref(u8)) ref(ast.Function)
    var i usize = 0
    for i < @len(state.templates)
        if str.eql(state.templates[i].name, name)
            return @addr(state.templates[i])
        end
        i++
    end
    return none
end

def find_instantiated(state ref(GenericState), key ref(u8)) ref(u8)
    var i usize = 0
    for i < @len(state.instantiated_keys)
        if str.eql(state.instantiated_keys[i], key)
            return state.instantiated_names[i]
        end
        i++
    end
    return none
end

def make_specialization_key(name ref(u8), type_args ref(list[ast.Type]), arena ref(allocators.Arena)) ref(u8)
    var result ref(u8) = gen.concat3(name, "[", "", arena)
    var i usize = 0
    for i < @len(@deref(type_args))
        if i > 0
            result = gen.concat3(result, ",", "", arena)
        end
        result = gen.concat3(result, gen.type_suffix(@addr(@deref(type_args)[i]), arena), "", arena)
        i++
    end
    result = gen.concat3(result, "]", "", arena)
    return result
end

def instantiate(state ref(GenericState), name ref(u8), type_args ref(list[ast.Type]), arena ref(allocators.Arena)) ref(u8)
    val key ref(u8) = make_specialization_key(name, type_args, arena)
    val existing ref(u8) = find_instantiated(state, key)
    if existing != none
        return existing
    end

    val template ref(ast.Function) = find_template(state, name)
    if template == none
        return name
    end

    val specialized_name ref(u8) = gen.build_specialized_name(name, type_args, arena)
    @append(state.instantiated_keys, key)
    @append(state.instantiated_names, specialized_name)

    var new_params list[ast.Param] = []
    var i usize = 0
    for i < @len(template.params)
        val param ref(ast.Param) = @addr(template.params[i])
        @append(new_params, ast.Param(
            name: param.name,
            ty: gen.substitute_type(@addr(param.ty), @addr(template.generic_params), type_args, arena),
            line: param.line,
            column: param.column
        ))
        i++
    end

    val new_ret ast.Type = gen.substitute_type(@addr(template.return_type), @addr(template.generic_params), type_args, arena)

    var new_body list[ast.Stmt] = []
    i = 0
    for i < @len(template.body)
        @append(new_body, gen.substitute_stmt(@addr(template.body[i]), @addr(template.generic_params), type_args, arena))
        i++
    end

    val specialized ast.Function = ast.Function(
        name: specialized_name,
        params: new_params,
        return_type: new_ret,
        body: new_body,
        is_pub: false,
        is_extern: false,
        extern_name: template.extern_name,
        generic_params: [] as list[ref(u8)],
        line: template.line,
        column: template.column
    )
    rewrite_function_calls(state, @addr(specialized), arena)

    @append(state.generated, specialized)

    return specialized_name
end

def rewrite_expr_calls(state ref(GenericState), expr ref(ast.Expr), arena ref(allocators.Arena)) ast.Expr
    match @deref(expr)
        ast.Expr.Call(c) => (
            match @deref(c.callee)
                ast.Expr.Specialize(sp) => (
                    var fn_name ref(u8) = none
                    match @deref(sp.callee)
                        ast.Expr.Ident(name) => fn_name = name
                        ast.Expr.Path(segs) => (
                            if @len(segs) > 0
                                fn_name = segs[@len(segs) - 1]
                                if @len(segs) > 1
                                    val joined_dunder ref(u8) = join_segs(segs, arena)
                                    fn_name = joined_dunder
                                    var tpl ref(ast.Function) = find_template(state, fn_name)
                                    if tpl == none
                                        val joined_dot ref(u8) = join_segs_with_dots(segs, arena)
                                        tpl = find_template(state, joined_dot)
                                        if tpl != none
                                            fn_name = joined_dot
                                        elif @len(segs) >= 3
                                            val joined_mixed ref(u8) = join_segs_mixed(segs, arena)
                                            tpl = find_template(state, joined_mixed)
                                            if tpl != none
                                                fn_name = joined_mixed
                                            end
                                        end
                                    end
                                end
                            end
                        )
                        _ => ()
                    end
                    if fn_name != none
                        var resolved_type_args list[ast.Type] = sp.type_args
                        val template_ref ref(ast.Function) = find_template(state, fn_name)
                        if template_ref != none
                            resolved_type_args = infer_type_args(template_ref, @addr(c.args), @addr(sp.type_args), state, arena)
                        end
                        val concrete_name ref(u8) = instantiate(state, fn_name, @addr(resolved_type_args), arena)
                        var new_args list[ast.Expr] = []
                        var i usize = 0
                        for i < @len(c.args)
                            @append(new_args, rewrite_expr_calls(state, @addr(c.args[i]), arena))
                            i++
                        end
                        val raw = allocators.Arena.alloc(arena, @sizeof(ast.ExprCall) as usize)
                        match raw
                            ok m => (
                                var p ref(ast.ExprCall) = @bitcast(m, ref(ast.ExprCall))
                                val callee_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)
                                match callee_raw
                                    ok cm => (
                                        var cp ref(ast.Expr) = @bitcast(cm, ref(ast.Expr))
                                        @deref(cp) = ast.Expr.Ident(concrete_name)
                                        p.callee = cp
                                    )
                                    error _ => p.callee = c.callee
                                end
                                p.args = new_args
                                return ast.Expr.Call(p)
                            )
                            error _ => return @deref(expr)
                        end
                    end
                    return @deref(expr)
                )
                _ => (
                    val raw = allocators.Arena.alloc(arena, @sizeof(ast.ExprCall) as usize)
                    match raw
                        ok m => (
                            var p ref(ast.ExprCall) = @bitcast(m, ref(ast.ExprCall))
                            val callee_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)
                            match callee_raw
                                ok cm => (
                                    var cp ref(ast.Expr) = @bitcast(cm, ref(ast.Expr))
                                    @deref(cp) = rewrite_expr_calls(state, c.callee, arena)
                                    p.callee = cp
                                )
                                error _ => p.callee = c.callee
                            end
                            var new_args list[ast.Expr] = []
                            var i usize = 0
                            for i < @len(c.args)
                                @append(new_args, rewrite_expr_calls(state, @addr(c.args[i]), arena))
                                i++
                            end
                            p.args = new_args
                            return ast.Expr.Call(p)
                        )
                        error _ => return @deref(expr)
                    end
                )
            end
        )
        ast.Expr.Binary(b) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.ExprBinary) as usize)
            match raw
                ok m => (
                    var p ref(ast.ExprBinary) = @bitcast(m, ref(ast.ExprBinary))
                    val lhs_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)
                    val rhs_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)
                    match lhs_raw
                        ok lm => (
                            var lp ref(ast.Expr) = @bitcast(lm, ref(ast.Expr))
                            @deref(lp) = rewrite_expr_calls(state, b.lhs, arena)
                            p.lhs = lp
                        )
                        error _ => p.lhs = b.lhs
                    end
                    match rhs_raw
                        ok rm => (
                            var rp ref(ast.Expr) = @bitcast(rm, ref(ast.Expr))
                            @deref(rp) = rewrite_expr_calls(state, b.rhs, arena)
                            p.rhs = rp
                        )
                        error _ => p.rhs = b.rhs
                    end
                    p.op = b.op
                    return ast.Expr.Binary(p)
                )
                error _ => return @deref(expr)
            end
        )
        ast.Expr.Unary(u) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.ExprUnary) as usize)
            match raw
                ok m => (
                    var p ref(ast.ExprUnary) = @bitcast(m, ref(ast.ExprUnary))
                    val inner_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)
                    match inner_raw
                        ok im => (
                            var ip ref(ast.Expr) = @bitcast(im, ref(ast.Expr))
                            @deref(ip) = rewrite_expr_calls(state, u.expr, arena)
                            p.expr = ip
                        )
                        error _ => p.expr = u.expr
                    end
                    p.op = u.op
                    return ast.Expr.Unary(p)
                )
                error _ => return @deref(expr)
            end
        )
        ast.Expr.Field(f) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.ExprField) as usize)
            match raw
                ok m => (
                    var p ref(ast.ExprField) = @bitcast(m, ref(ast.ExprField))
                    val base_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)
                    match base_raw
                        ok bm => (
                            var bp ref(ast.Expr) = @bitcast(bm, ref(ast.Expr))
                            @deref(bp) = rewrite_expr_calls(state, f.base, arena)
                            p.base = bp
                        )
                        error _ => p.base = f.base
                    end
                    p.field = f.field
                    return ast.Expr.Field(p)
                )
                error _ => return @deref(expr)
            end
        )
        ast.Expr.Index(idx) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.ExprIndex) as usize)
            match raw
                ok m => (
                    var p ref(ast.ExprIndex) = @bitcast(m, ref(ast.ExprIndex))
                    val base_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)
                    val idx_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)
                    match base_raw
                        ok bm => (
                            var bp ref(ast.Expr) = @bitcast(bm, ref(ast.Expr))
                            @deref(bp) = rewrite_expr_calls(state, idx.base, arena)
                            p.base = bp
                        )
                        error _ => p.base = idx.base
                    end
                    match idx_raw
                        ok im => (
                            var ip ref(ast.Expr) = @bitcast(im, ref(ast.Expr))
                            @deref(ip) = rewrite_expr_calls(state, idx.index, arena)
                            p.index = ip
                        )
                        error _ => p.index = idx.index
                    end
                    return ast.Expr.Index(p)
                )
                error _ => return @deref(expr)
            end
        )
        ast.Expr.MethodCall(mc) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.ExprMethodCall) as usize)
            match raw
                ok m => (
                    var p ref(ast.ExprMethodCall) = @bitcast(m, ref(ast.ExprMethodCall))
                    val recv_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)
                    match recv_raw
                        ok rm => (
                            var rp ref(ast.Expr) = @bitcast(rm, ref(ast.Expr))
                            @deref(rp) = rewrite_expr_calls(state, mc.receiver, arena)
                            p.receiver = rp
                        )
                        error _ => p.receiver = mc.receiver
                    end
                    p.method = mc.method
                    var new_args list[ast.Expr] = []
                    var i usize = 0
                    for i < @len(mc.args)
                        @append(new_args, rewrite_expr_calls(state, @addr(mc.args[i]), arena))
                        i++
                    end
                    p.args = new_args
                    return ast.Expr.MethodCall(p)
                )
                error _ => return @deref(expr)
            end
        )
        ast.Expr.BuiltinCall(bc) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.ExprBuiltinCall) as usize)
            match raw
                ok m => (
                    var p ref(ast.ExprBuiltinCall) = @bitcast(m, ref(ast.ExprBuiltinCall))
                    p.name = bc.name
                    var new_args list[ast.Expr] = []
                    var i usize = 0
                    for i < @len(bc.args)
                        @append(new_args, rewrite_expr_calls(state, @addr(bc.args[i]), arena))
                        i++
                    end
                    p.args = new_args
                    return ast.Expr.BuiltinCall(p)
                )
                error _ => return @deref(expr)
            end
        )
        ast.Expr.Try(inner) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)
            match raw
                ok m => (
                    var p ref(ast.Expr) = @bitcast(m, ref(ast.Expr))
                    @deref(p) = rewrite_expr_calls(state, inner, arena)
                    return ast.Expr.Try(p)
                )
                error _ => return @deref(expr)
            end
        )
        ast.Expr.Pack(elems) => (
            var new_elems list[ast.Expr] = []
            var i usize = 0
            for i < @len(elems)
                @append(new_elems, rewrite_expr_calls(state, @addr(elems[i]), arena))
                i++
            end
            return ast.Expr.Pack(new_elems)
        )
        ast.Expr.ListLit(elems) => (
            var new_elems list[ast.Expr] = []
            var i usize = 0
            for i < @len(elems)
                @append(new_elems, rewrite_expr_calls(state, @addr(elems[i]), arena))
                i++
            end
            return ast.Expr.ListLit(new_elems)
        )
        ast.Expr.StructInit(si) => (
            var new_fields list[ast.FieldInit] = []
            var i usize = 0
            for i < @len(si.fields)
                @append(new_fields, ast.FieldInit(
                    name: si.fields[i].name,
                    value: rewrite_expr_calls(state, @addr(si.fields[i].value), arena)
                ))
                i++
            end
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.ExprStructInit) as usize)
            match raw
                ok m => (
                    var p ref(ast.ExprStructInit) = @bitcast(m, ref(ast.ExprStructInit))
                    p.name = si.name
                    p.type_args = si.type_args
                    p.fields = new_fields
                    return ast.Expr.StructInit(p)
                )
                error _ => return @deref(expr)
            end
        )
        _ => return @deref(expr)
    end
end

def join_segs(segs list[ref(u8)], arena ref(allocators.Arena)) ref(u8)
    var total usize = 0
    var i usize = 0
    for i < @len(segs)
        total += str.len(segs[i])
        if i + 1 < @len(segs)
            total += 2
        end
        i++
    end
    val buf_res = allocators.Arena.alloc(arena, total + 1)
    var buf ref(u8) = none
    match buf_res
        ok m => buf = m as ref(u8)
        error _ => return segs[0]
    end
    var pos usize = 0
    i = 0
    for i < @len(segs)
        val slen usize = str.len(segs[i])
        @memcpy(@add(buf, pos), segs[i], slen)
        pos += slen
        if i + 1 < @len(segs)
            @deref(@as_mut(@add(buf, pos))) = '_'
            pos++
            @deref(@as_mut(@add(buf, pos))) = '_'
            pos++
        end
        i++
    end
    @deref(@as_mut(@add(buf, pos))) = 0
    return buf
end

def join_segs_with_dots(segs list[ref(u8)], arena ref(allocators.Arena)) ref(u8)
    var total usize = 0
    var i usize = 0
    for i < @len(segs)
        total += str.len(segs[i])
        if i + 1 < @len(segs)
            total++
        end
        i++
    end
    val buf_res = allocators.Arena.alloc(arena, total + 1)
    var buf ref(u8) = none
    match buf_res
        ok m => buf = m as ref(u8)
        error _ => return segs[0]
    end
    var pos usize = 0
    i = 0
    for i < @len(segs)
        val slen usize = str.len(segs[i])
        @memcpy(@add(buf, pos), segs[i], slen)
        pos += slen
        if i + 1 < @len(segs)
            @deref(@as_mut(@add(buf, pos))) = 46
            pos++
        end
        i++
    end
    @deref(@as_mut(@add(buf, pos))) = 0
    return buf
end

def join_segs_mixed(segs list[ref(u8)], arena ref(allocators.Arena)) ref(u8)
    var result ref(u8) = segs[0]
    var i usize = 1
    for i < @len(segs)
        if i == 1
            result = gen.concat3(result, "__", segs[i], arena)
        else
            result = gen.concat3(result, ".", segs[i], arena)
        end
        i++
    end
    return result
end

def rewrite_stmt_calls(state ref(GenericState), stmt ref(ast.Stmt), arena ref(allocators.Arena)) ast.Stmt
    match @deref(stmt)
        ast.Stmt.VarDecl(vd) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtVarDecl) as usize)
            match raw
                ok m => (
                    var p ref(ast.StmtVarDecl) = @bitcast(m, ref(ast.StmtVarDecl))
                    p.name = vd.name
                    p.mutable = vd.mutable
                    p.declared_type = vd.declared_type
                    p.init = rewrite_expr_calls(state, @addr(vd.init), arena)
                    p.line = vd.line
                    p.column = vd.column
                    return ast.Stmt.VarDecl(p)
                )
                error _ => return @deref(stmt)
            end
        )
        ast.Stmt.Assign(a) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtAssign) as usize)
            match raw
                ok m => (
                    var p ref(ast.StmtAssign) = @bitcast(m, ref(ast.StmtAssign))
                    p.target = rewrite_expr_calls(state, @addr(a.target), arena)
                    p.value = rewrite_expr_calls(state, @addr(a.value), arena)
                    p.line = a.line
                    p.column = a.column
                    return ast.Stmt.Assign(p)
                )
                error _ => return @deref(stmt)
            end
        )
        ast.Stmt.AddAssign(a) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtAssign) as usize)
            match raw
                ok m => (
                    var p ref(ast.StmtAssign) = @bitcast(m, ref(ast.StmtAssign))
                    p.target = rewrite_expr_calls(state, @addr(a.target), arena)
                    p.value = rewrite_expr_calls(state, @addr(a.value), arena)
                    p.line = a.line
                    p.column = a.column
                    return ast.Stmt.AddAssign(p)
                )
                error _ => return @deref(stmt)
            end
        )
        ast.Stmt.SubAssign(a) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtAssign) as usize)
            match raw
                ok m => (
                    var p ref(ast.StmtAssign) = @bitcast(m, ref(ast.StmtAssign))
                    p.target = rewrite_expr_calls(state, @addr(a.target), arena)
                    p.value = rewrite_expr_calls(state, @addr(a.value), arena)
                    p.line = a.line
                    p.column = a.column
                    return ast.Stmt.SubAssign(p)
                )
                error _ => return @deref(stmt)
            end
        )
        ast.Stmt.MulAssign(a) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtAssign) as usize)
            match raw
                ok m => (
                    var p ref(ast.StmtAssign) = @bitcast(m, ref(ast.StmtAssign))
                    p.target = rewrite_expr_calls(state, @addr(a.target), arena)
                    p.value = rewrite_expr_calls(state, @addr(a.value), arena)
                    p.line = a.line
                    p.column = a.column
                    return ast.Stmt.MulAssign(p)
                )
                error _ => return @deref(stmt)
            end
        )
        ast.Stmt.DivAssign(a) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtAssign) as usize)
            match raw
                ok m => (
                    var p ref(ast.StmtAssign) = @bitcast(m, ref(ast.StmtAssign))
                    p.target = rewrite_expr_calls(state, @addr(a.target), arena)
                    p.value = rewrite_expr_calls(state, @addr(a.value), arena)
                    p.line = a.line
                    p.column = a.column
                    return ast.Stmt.DivAssign(p)
                )
                error _ => return @deref(stmt)
            end
        )
        ast.Stmt.BitAndAssign(a) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtAssign) as usize)
            match raw
                ok m => (
                    var p ref(ast.StmtAssign) = @bitcast(m, ref(ast.StmtAssign))
                    p.target = rewrite_expr_calls(state, @addr(a.target), arena)
                    p.value = rewrite_expr_calls(state, @addr(a.value), arena)
                    p.line = a.line
                    p.column = a.column
                    return ast.Stmt.BitAndAssign(p)
                )
                error _ => return @deref(stmt)
            end
        )
        ast.Stmt.BitOrAssign(a) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtAssign) as usize)
            match raw
                ok m => (
                    var p ref(ast.StmtAssign) = @bitcast(m, ref(ast.StmtAssign))
                    p.target = rewrite_expr_calls(state, @addr(a.target), arena)
                    p.value = rewrite_expr_calls(state, @addr(a.value), arena)
                    p.line = a.line
                    p.column = a.column
                    return ast.Stmt.BitOrAssign(p)
                )
                error _ => return @deref(stmt)
            end
        )
        ast.Stmt.BitXorAssign(a) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtAssign) as usize)
            match raw
                ok m => (
                    var p ref(ast.StmtAssign) = @bitcast(m, ref(ast.StmtAssign))
                    p.target = rewrite_expr_calls(state, @addr(a.target), arena)
                    p.value = rewrite_expr_calls(state, @addr(a.value), arena)
                    p.line = a.line
                    p.column = a.column
                    return ast.Stmt.BitXorAssign(p)
                )
                error _ => return @deref(stmt)
            end
        )
        ast.Stmt.Return(r) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtReturn) as usize)
            match raw
                ok m => (
                    var p ref(ast.StmtReturn) = @bitcast(m, ref(ast.StmtReturn))
                    p.value = rewrite_expr_calls(state, @addr(r.value), arena)
                    p.line = r.line
                    p.column = r.column
                    return ast.Stmt.Return(p)
                )
                error _ => return @deref(stmt)
            end
        )
        ast.Stmt.If(if_stmt) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtIf) as usize)
            match raw
                ok m => (
                    var p ref(ast.StmtIf) = @bitcast(m, ref(ast.StmtIf))
                    p.condition = rewrite_expr_calls(state, @addr(if_stmt.condition), arena)
                    p.line = if_stmt.line
                    p.column = if_stmt.column
                    var new_then list[ast.Stmt] = []
                    var new_else list[ast.Stmt] = []
                    var k usize = 0
                    for k < @len(if_stmt.then_body)
                        @append(new_then, rewrite_stmt_calls(state, @addr(if_stmt.then_body[k]), arena))
                        k++
                    end
                    k = 0
                    for k < @len(if_stmt.else_body)
                        @append(new_else, rewrite_stmt_calls(state, @addr(if_stmt.else_body[k]), arena))
                        k++
                    end
                    p.then_body = new_then
                    p.else_body = new_else
                    return ast.Stmt.If(p)
                )
                error _ => return @deref(stmt)
            end
        )
        ast.Stmt.While(w) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtWhile) as usize)
            match raw
                ok m => (
                    var p ref(ast.StmtWhile) = @bitcast(m, ref(ast.StmtWhile))
                    p.condition = rewrite_expr_calls(state, @addr(w.condition), arena)
                    p.line = w.line
                    p.column = w.column
                    var new_body list[ast.Stmt] = []
                    var k usize = 0
                    for k < @len(w.body)
                        @append(new_body, rewrite_stmt_calls(state, @addr(w.body[k]), arena))
                        k++
                    end
                    p.body = new_body
                    return ast.Stmt.While(p)
                )
                error _ => return @deref(stmt)
            end
        )
        ast.Stmt.ForRange(fr) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtForRange) as usize)
            match raw
                ok m => (
                    var p ref(ast.StmtForRange) = @bitcast(m, ref(ast.StmtForRange))
                    p.var_name = fr.var_name
                    p.start = rewrite_expr_calls(state, @addr(fr.start), arena)
                    p.End = rewrite_expr_calls(state, @addr(fr.End), arena)
                    p.line = fr.line
                    p.column = fr.column
                    var new_body list[ast.Stmt] = []
                    var k usize = 0
                    for k < @len(fr.body)
                        @append(new_body, rewrite_stmt_calls(state, @addr(fr.body[k]), arena))
                        k++
                    end
                    p.body = new_body
                    return ast.Stmt.ForRange(p)
                )
                error _ => return @deref(stmt)
            end
        )
        ast.Stmt.ForEach(fe) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtForEach) as usize)
            match raw
                ok m => (
                    var p ref(ast.StmtForEach) = @bitcast(m, ref(ast.StmtForEach))
                    p.var_name = fe.var_name
                    p.iterable = rewrite_expr_calls(state, @addr(fe.iterable), arena)
                    p.line = fe.line
                    p.column = fe.column
                    var new_body list[ast.Stmt] = []
                    var k usize = 0
                    for k < @len(fe.body)
                        @append(new_body, rewrite_stmt_calls(state, @addr(fe.body[k]), arena))
                        k++
                    end
                    p.body = new_body
                    return ast.Stmt.ForEach(p)
                )
                error _ => return @deref(stmt)
            end
        )
        ast.Stmt.Match(m) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtMatch) as usize)
            match raw
                ok m2 => (
                    var p ref(ast.StmtMatch) = @bitcast(m2, ref(ast.StmtMatch))
                    p.expr = rewrite_expr_calls(state, @addr(m.expr), arena)
                    p.line = m.line
                    p.column = m.column
                    var new_arms list[ast.MatchArm] = []
                    var k usize = 0
                    for k < @len(m.arms)
                        var new_body list[ast.Stmt] = []
                        var l usize = 0
                        for l < @len(m.arms[k].body)
                            @append(new_body, rewrite_stmt_calls(state, @addr(m.arms[k].body[l]), arena))
                            l++
                        end
                        @append(new_arms, ast.MatchArm(
                            kind: m.arms[k].kind,
                            bindings: m.arms[k].bindings,
                            body: new_body
                        ))
                        k++
                    end
                    p.arms = new_arms
                    return ast.Stmt.Match(p)
                )
                error _ => return @deref(stmt)
            end
        )
        ast.Stmt.ExprStmt(e) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)
            match raw
                ok m => (
                    var p ref(ast.Expr) = @bitcast(m, ref(ast.Expr))
                    @deref(p) = rewrite_expr_calls(state, e, arena)
                    return ast.Stmt.ExprStmt(p)
                )
                error _ => return @deref(stmt)
            end
        )
        ast.Stmt.Increment(e) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)
            match raw
                ok m => (
                    var p ref(ast.Expr) = @bitcast(m, ref(ast.Expr))
                    @deref(p) = rewrite_expr_calls(state, e, arena)
                    return ast.Stmt.Increment(p)
                )
                error _ => return @deref(stmt)
            end
        )
        ast.Stmt.Decrement(e) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)
            match raw
                ok m => (
                    var p ref(ast.Expr) = @bitcast(m, ref(ast.Expr))
                    @deref(p) = rewrite_expr_calls(state, e, arena)
                    return ast.Stmt.Decrement(p)
                )
                error _ => return @deref(stmt)
            end
        )
        ast.Stmt.Assert(a) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.StmtAssert) as usize)
            match raw
                ok m => (
                    var p ref(ast.StmtAssert) = @bitcast(m, ref(ast.StmtAssert))
                    @deref(p) = ast.StmtAssert(
                        condition: rewrite_expr_calls(state, @addr(a.condition), arena),
                        line: a.line,
                        column: a.column,
                        filename: a.filename
                    )
                    return ast.Stmt.Assert(p)
                )
                error _ => return @deref(stmt)
            end
        )
        ast.Stmt.Block(body) => (
            var new_body list[ast.Stmt] = []
            var k usize = 0
            for k < @len(body)
                @append(new_body, rewrite_stmt_calls(state, @addr(body[k]), arena))
                k++
            end
            return ast.Stmt.Block(new_body)
        )
        ast.Stmt.Defer(body) => (
            var new_body list[ast.Stmt] = []
            var k usize = 0
            for k < @len(body)
                @append(new_body, rewrite_stmt_calls(state, @addr(body[k]), arena))
                k++
            end
            return ast.Stmt.Defer(new_body)
        )
        _ => return @deref(stmt)
    end
end

def infer_type_from_expr(expr ref(ast.Expr), state ref(GenericState), arena ref(allocators.Arena)) ast.Type
    match @deref(expr)
        ast.Expr.Ident(name) => (
            var i usize = 0
            for i < @len(state.current_body)
                match state.current_body[i]
                    ast.Stmt.VarDecl(vd) => (
                        if str.eql(vd.name, name)
                            return infer_type_from_expr(@addr(vd.init), state, arena)
                        end
                    )
                    _ => ()
                end
                i++
            end
            i = 0
            for i < @len(state.current_params)
                if str.eql(state.current_params[i].name, name)
                    return state.current_params[i].ty
                end
                i++
            end
            return ast.Type.Named("_")
        )
        ast.Expr.Try(inner) => (
            return infer_type_from_expr(inner, state, arena)
        )
        ast.Expr.IntLit(_) => return ast.Type.I32(0)
        ast.Expr.FloatLit(_) => return ast.Type.F64(0)
        ast.Expr.BoolLit(_) => return ast.Type.Bool(0)
        ast.Expr.CharLit(_) => return ast.Type.U8(0)
        ast.Expr.Unary(u) => (
            match u.op
                ast.UnaryOp.Neg => return infer_type_from_expr(u.expr, state, arena)
                _ => return ast.Type.Named("_")
            end
        )
        ast.Expr.StrLit(_) => (
            val raw = allocators.Arena.alloc(arena, @sizeof(ast.Type) as usize)
            match raw
                ok m => (
                    var p ref(ast.Type) = @bitcast(m, ref(ast.Type))
                    @deref(p) = ast.Type.U8(0)
                    return ast.Type.Ref(p)
                )
                error _ => return ast.Type.Named("_")
            end
        )
        ast.Expr.Call(c) => (
            match @deref(c.callee)
                ast.Expr.Ident(callee_name) => (
                    var i usize = 0
                    for i < @len(state.type_defs)
                        if str.eql(state.type_defs[i].name, callee_name)
                            return ast.Type.Named(callee_name)
                        end
                        i++
                    end
                    return ast.Type.Named("_")
                )
                ast.Expr.Path(segments) => (
                    if @len(segments) >= 2
                        var type_name ref(u8) = segments[0]
                        var i usize = 1
                        for i < @len(segments) - 1
                            type_name = gen.concat3(type_name, "__", segments[i], arena)
                            i++
                        end
                        type_name = gen.concat3(type_name, "__", segments[@len(segments) - 1], arena)
                        var i2 usize = 0
                        for i2 < @len(state.type_defs)
                            if str.eql(state.type_defs[i2].name, type_name)
                                return ast.Type.Named(type_name)
                            end
                            i2++
                        end
                    end
                    return ast.Type.Named("_")
                )
                _ => return ast.Type.Named("_")
            end
        )
        ast.Expr.MethodCall(mc) => (
            val type_name ref(u8) = type_name_from_receiver(mc.receiver, arena)
            if !str.eql(type_name, "")
                var i usize = 0
                for i < @len(state.type_defs)
                    if str.eql(state.type_defs[i].name, type_name)
                        return ast.Type.Named(type_name)
                    end
                    i++
                end
            end
            return ast.Type.Named("_")
        )
        ast.Expr.BuiltinCall(bc) => (
            if str.eql(bc.name, "@addr") && @len(bc.args) >= 1
                val inner_raw = allocators.Arena.alloc(arena, @sizeof(ast.Type) as usize)
                match inner_raw
                    ok inner_m => (
                        var inner_p ref(ast.Type) = @bitcast(inner_m, ref(ast.Type))
                        @deref(inner_p) = infer_type_from_expr(@addr(bc.args[0]), state, arena)
                        val ref_raw = allocators.Arena.alloc(arena, @sizeof(ast.Type) as usize)
                        match ref_raw
                            ok ref_m => (
                                var ref_p ref(ast.Type) = @bitcast(ref_m, ref(ast.Type))
                                @deref(ref_p) = ast.Type.Ref(inner_p)
                                return @deref(ref_p)
                            )
                            error _ => return ast.Type.Ref(inner_p)
                        end
                    )
                    error _ => return ast.Type.Named("_")
                end
            end
            return ast.Type.Named("_")
        )
        _ => return ast.Type.Named("_")
    end
end

def type_name_from_receiver(expr ref(ast.Expr), arena ref(allocators.Arena)) ref(u8)
    match @deref(expr)
        ast.Expr.Ident(name) => return name
        ast.Expr.Field(f) => (
            val base ref(u8) = type_name_from_receiver(f.base, arena)
            if str.eql(base, "")
                return ""
            end
            return gen.concat3(base, "__", f.field, arena)
        )
        _ => return ""
    end
end

def needs_inference(ty ref(ast.Type)) bool
    match @deref(ty)
        ast.Type.Named(name) => return str.eql(name, "_")
        ast.Type.Infer(_) => return true
        _ => return false
    end
end

def is_inferred_type(ty ref(ast.Type)) bool
    match @deref(ty)
        ast.Type.Named(name) => return !str.eql(name, "_")
        ast.Type.Infer(_) => return false
        ast.Type.Void(_) => return false
        ast.Type.None(_) => return false
        ast.Type.Error(_) => return false
        _ => return true
    end
end

def param_type_to_generic_name(ty ref(ast.Type)) ref(u8)
    match @deref(ty)
        ast.Type.Named(name) => return name
        ast.Type.Ref(inner) => return param_type_to_generic_name(inner)
        ast.Type.Mut(inner) => return param_type_to_generic_name(inner)
        _ => return ""
    end
end

def strip_to_match(param_ty ref(ast.Type), inferred_ty ref(ast.Type)) ast.Type
    match @deref(param_ty)
        ast.Type.Ref(_) => (
            match @deref(inferred_ty)
                ast.Type.Ref(inner) => return @deref(inner)
                _ => return @deref(inferred_ty)
            end
        )
        ast.Type.Mut(_) => (
            match @deref(inferred_ty)
                ast.Type.Mut(inner) => return @deref(inner)
                ast.Type.Ref(inner) => return @deref(inner)
                _ => return @deref(inferred_ty)
            end
        )
        _ => return @deref(inferred_ty)
    end
end

def try_infer_param(template ref(ast.Function), call_args ref(list[ast.Expr]), result ref(list[ast.Type]), param_idx usize, state ref(GenericState), arena ref(allocators.Arena))
    val param_type_name ref(u8) = param_type_to_generic_name(@addr(template.params[param_idx].ty))
    if str.eql(param_type_name, "")
        return
    end
    var j usize = 0
    for j < @len(template.generic_params)
        if str.eql(template.generic_params[j], param_type_name) && param_idx < @len(@deref(call_args))
            if needs_inference(@addr(@deref(result)[j]))
                val inferred ast.Type = infer_type_from_expr(@addr(@deref(call_args)[param_idx]), state, arena)
                if is_inferred_type(@addr(inferred))
                    @deref(result)[j] = strip_to_match(@addr(template.params[param_idx].ty), @addr(inferred))
                end
            end
            break
        end
        j++
    end
end

def infer_type_args(template ref(ast.Function), call_args ref(list[ast.Expr]), type_args ref(list[ast.Type]), state ref(GenericState), arena ref(allocators.Arena)) list[ast.Type]
    var result list[ast.Type] = []
    var i usize = 0
    for i < @len(@deref(type_args))
        @append(result, @deref(type_args)[i])
        i++
    end
    i = 0
    for i < @len(template.params)
        try_infer_param(template, call_args, @addr(result), i, state, arena)
        i++
    end
    return result
end

def rewrite_function_calls(state ref(GenericState), fun ref(ast.Function), arena ref(allocators.Arena))
    val saved_body list[ast.Stmt] = state.current_body
    val saved_params list[ast.Param] = state.current_params
    state.current_body = fun.body
    state.current_params = fun.params
    var new_body list[ast.Stmt] = []
    var i usize = 0
    for i < @len(fun.body)
        @append(new_body, rewrite_stmt_calls(state, @addr(fun.body[i]), arena))
        i++
    end
    fun.body = new_body
    state.current_body = saved_body
    state.current_params = saved_params
end

pub def instantiate_generics(program ref(ast.Program), arena ref(allocators.Arena)) ast.Program
    var state GenericState = GenericState(
        templates: [] as list[ast.Function],
        generated: [] as list[ast.Function],
        instantiated_keys: [] as list[ref(u8)],
        instantiated_names: [] as list[ref(u8)],
        type_defs: program.type_defs,
        current_body: [] as list[ast.Stmt],
        current_params: [] as list[ast.Param]
    )

    var concrete_functions list[ast.Function] = []
    var i usize = 0
    for i < @len(program.functions)
        val fn_ref ref(ast.Function) = @addr(program.functions[i])
        if @len(fn_ref.generic_params) > 0
            @append(state.templates, @deref(fn_ref))
        else
            @append(concrete_functions, @deref(fn_ref))
        end
        i++
    end

    i = 0
    for i < @len(concrete_functions)
        rewrite_function_calls(@addr(state), @addr(concrete_functions[i]), arena)
        i++
    end

    var all_functions list[ast.Function] = []
    i = 0
    for i < @len(concrete_functions)
        @append(all_functions, concrete_functions[i])
        i++
    end
    i = 0
    for i < @len(state.generated)
        @append(all_functions, state.generated[i])
        i++
    end

    return ast.Program(
        module_uses: program.module_uses,
        functions: all_functions,
        type_defs: program.type_defs,
        interface_defs: program.interface_defs,
        tests: program.tests,
        extern_headers: program.extern_headers,
        globals: program.globals
    )
end
