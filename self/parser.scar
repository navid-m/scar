val str = use("std/string")
val ast = use("ast")
val lxr = use("lexer")
val allocators = use("std/allocators")
val os = use("std/os")

val KW_PUB    u8 = 1
val KW_DEF    u8 = 2
val KW_END    u8 = 3
val KW_VAR    u8 = 4
val KW_VAL    u8 = 5
val KW_RETURN u8 = 6
val KW_IF     u8 = 7
val KW_ELSE   u8 = 8
val KW_ELIF   u8 = 9
val KW_FOR    u8 = 10
val KW_WHILE  u8 = 11
val KW_MATCH  u8 = 12
val KW_BREAK  u8 = 13
val KW_CONT   u8 = 14
val KW_VOID   u8 = 15
val KW_BOOL   u8 = 16
val KW_I8     u8 = 17
val KW_I16    u8 = 18
val KW_I32    u8 = 19
val KW_I64    u8 = 20
val KW_ISIZE  u8 = 21
val KW_U8     u8 = 22
val KW_U16    u8 = 23
val KW_U32    u8 = 24
val KW_U64    u8 = 25
val KW_USIZE  u8 = 26
val KW_F32    u8 = 27
val KW_F64    u8 = 28
val KW_MUT    u8 = 29
val KW_REF    u8 = 30
val KW_LIST   u8 = 31
val KW_AS     u8 = 32
val KW_IN     u8 = 33
val KW_EXTERN u8 = 34
val KW_TEST   u8 = 35
val KW_TRUE   u8 = 36
val KW_FALSE  u8 = 37
val KW_NONE   u8 = 38
val KW_TYPE   u8 = 39
val KW_UNION  u8 = 40
val KW_ENUM   u8 = 41
val KW_IFACE  u8 = 42
val KW_TSET   u8 = 43
val KW_DEFER  u8 = 44
val KW_WHEN   u8 = 45
val KW_LINK   u8 = 46
val KW_GUARD  u8 = 47
val KW_ASSERT u8 = 48

var error_count usize = 0

def box_expr(arena ref(allocators.Arena), e ast.Expr) ref(ast.Expr)
    val res = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)
    match res
        ok m => (
            var p ref(ast.Expr) = @bitcast(m, ref(ast.Expr))
            @deref(p) = e
            return p
        )
        error _ => return none
    end
end

def is_keyword(p ref(ast.TokenList), id u8) bool
    match p.tokens[p.pos].kind
        ast.TokenKind.Keyword(v) => return v == id
        _ => return false
    end
end

def advance(p ref(ast.TokenList))
    p.pos++
end

def is_eof(p ref(ast.TokenList)) bool
    match p.tokens[p.pos].kind
        ast.TokenKind.Eof(_) => return true
        _ => return false
    end
end

def consume_newlines(p ref(ast.TokenList))
    for
        match p.tokens[p.pos].kind
            ast.TokenKind.Newline(_) => p.pos++
            _ => break
        end
    end
end

def expect_ident(p ref(ast.TokenList), arena ref(allocators.Arena)) ref(u8)
    match p.tokens[p.pos].kind
        ast.TokenKind.Ident(name) => (
            advance(p)
            return name
        )
        _ => (
            val empty_res = allocators.Arena.alloc(arena, 1)
            match empty_res
                ok m => (
                    @deref(@as_mut(m as ref(u8))) = 0
                    return m as ref(u8)
                )
                error _ => return ""
            end
        )
    end
end

def expect_newline(p ref(ast.TokenList))
    match p.tokens[p.pos].kind
        ast.TokenKind.Newline(_) => consume_newlines(p)
        _ => consume_newlines(p)
    end
end

def next_is_keyword(p ref(ast.TokenList), id u8) bool
    var i usize = p.pos + 1
    for i < @len(p.tokens)
        match p.tokens[i].kind
            ast.TokenKind.Newline(_) => i++
            _ => (
                match p.tokens[i].kind
                    ast.TokenKind.Keyword(v) => return v == id
                    _ => return false
                end
            )
        end
    end
    return false
end

def peek_is_type_arg(p ref(ast.TokenList)) bool
    val next_pos usize = p.pos + 1
    if next_pos >= @len(p.tokens)
        return false
    end
    match p.tokens[next_pos].kind
        ast.TokenKind.Keyword(v) => (
            return v == KW_VOID || v == KW_BOOL
                || v == KW_I8 || v == KW_I16 || v == KW_I32 || v == KW_I64 || v == KW_ISIZE
                || v == KW_U8 || v == KW_U16 || v == KW_U32 || v == KW_U64 || v == KW_USIZE
                || v == KW_F32 || v == KW_F64
                || v == KW_REF || v == KW_MUT || v == KW_LIST
        )
        ast.TokenKind.Ident(_) => return true
        ast.TokenKind.RBracket(_) => return false
        _ => return false
    end
end

def supports_specialization(expr ref(ast.Expr)) bool
    match @deref(expr)
        ast.Expr.Ident(_) => return true
        ast.Expr.Path(_) => return true
        ast.Expr.Field(f) => return supports_specialization(f.base)
        _ => return false
    end
end

def is_type_arg_followed_by_call(p ref(ast.TokenList)) bool
    var depth usize = 1
    var i usize = p.pos + 1
    for i < @len(p.tokens)
        match p.tokens[i].kind
            ast.TokenKind.LBracket(_) => depth++
            ast.TokenKind.RBracket(_) => (
                depth--
                if depth == 0
                    var j usize = i + 1
                    for j < @len(p.tokens)
                        match p.tokens[j].kind
                            ast.TokenKind.Newline(_) => j++
                            ast.TokenKind.LParen(_) => return true
                            _ => return false
                        end
                        j++
                    end
                    return false
                end
            )
            _ => ()
        end
        i++
    end
    return false
end

def next_non_newline_kind(p ref(ast.TokenList)) u8
    var i usize = p.pos
    for i < @len(p.tokens)
        match p.tokens[i].kind
            ast.TokenKind.Newline(_) => i++
            ast.TokenKind.Keyword(v) => return v
            ast.TokenKind.Ident(_) => return 100
            ast.TokenKind.Int(_) => return 101
            ast.TokenKind.LParen(_) => return 200
            ast.TokenKind.RParen(_) => return 201
            ast.TokenKind.LBracket(_) => return 202
            ast.TokenKind.RBracket(_) => return 203
            ast.TokenKind.ColonColon(_) => return 204
            ast.TokenKind.Str(_) => return 205
            ast.TokenKind.Eof(_) => return 255
            _ => i++
        end
    end
    return 255
end

def platform_matches(current_platform ref(u8), target ref(u8)) bool
    if str.eql(target, "posix")
        return str.eql(current_platform, "linux")
            || str.eql(current_platform, "darwin")
            || str.eql(current_platform, "freebsd")
            || str.eql(current_platform, "openbsd")
            || str.eql(current_platform, "netbsd")
            || str.eql(current_platform, "dragonflybsd")
            || str.eql(current_platform, "android")
            || str.eql(current_platform, "ios")
            || str.eql(current_platform, "haiku")
    end
    return str.eql(current_platform, target)
end

def parse_when_condition(p ref(ast.TokenList), arena ref(allocators.Arena), current_platform ref(u8)) bool
    val first ref(u8) = expect_ident(p, arena)
    var matches bool = platform_matches(current_platform, first)
    for
        match p.tokens[p.pos].kind
            ast.TokenKind.Pipe(_) => advance(p)
            _ => break
        end
        val name ref(u8) = expect_ident(p, arena)
        if platform_matches(current_platform, name)
            matches = true
        end
    end
    return matches
end

def skip_to_newline(p ref(ast.TokenList))
    for !is_eof(p)
        match p.tokens[p.pos].kind
            ast.TokenKind.Newline(_) => (
                advance(p)
                return
            )
            _ => advance(p)
        end
    end
end

def needs_end_kw(kw_id u8) bool
    return kw_id == KW_IF 
        || kw_id == KW_FOR 
        || kw_id == KW_MATCH 
        || kw_id == KW_WHEN 
        || kw_id == KW_DEFER 
        || kw_id == KW_GUARD 
        || kw_id == KW_TYPE 
        || kw_id == KW_ENUM 
        || kw_id == KW_UNION 
        || kw_id == KW_IFACE 
        || kw_id == KW_TSET 
        || kw_id == KW_DEF 
        || kw_id == KW_TEST
end

def skip_block(p ref(ast.TokenList))
    var depth usize = 0
    consume_newlines(p)
    for !is_eof(p)
        match p.tokens[p.pos].kind
            ast.TokenKind.Keyword(v) => (
                if v == KW_END
                    if depth == 0
                        advance(p)
                        return
                    end
                    depth--
                elif needs_end_kw(v)
                    depth++
                end
                advance(p)
            )
            _ => advance(p)
        end
    end
end

def starts_type(tokens_val ref(ast.TokenList)) bool
    match tokens_val.tokens[tokens_val.pos].kind
        ast.TokenKind.Keyword(v) => return v == KW_VOID 
            || v == KW_BOOL || v == KW_I8 || v == KW_I16 
            || v == KW_I32 || v == KW_I64 || v == KW_ISIZE || v == KW_U8 || v == KW_U16 || v == KW_U32 
            || v == KW_U64 || v == KW_USIZE || v == KW_F32 || v == KW_F64 || v == KW_MUT 
            || v == KW_REF || v == KW_LIST
        ast.TokenKind.Ident(_) => return true
        ast.TokenKind.LParen(_) => return true
        ast.TokenKind.LBracket(_) => return true
        _ => return false
    end
end

def parse_type(p ref(ast.TokenList), arena ref(allocators.Arena)) ast.Type
    match p.tokens[p.pos].kind
        ast.TokenKind.Keyword(v) => (
            if v == KW_VOID
                advance(p)
                return ast.Type.Void(0)
            elif v == KW_BOOL
                advance(p)
                return ast.Type.Bool(0)
            elif v == KW_I8
                advance(p)
                return ast.Type.I8(0)
            elif v == KW_I16
                advance(p)
                return ast.Type.I16(0)
            elif v == KW_I32
                advance(p)
                return ast.Type.I32(0)
            elif v == KW_I64
                advance(p)
                return ast.Type.I64(0)
            elif v == KW_ISIZE
                advance(p)
                return ast.Type.Isize(0)
            elif v == KW_U8
                advance(p)
                return ast.Type.U8(0)
            elif v == KW_U16
                advance(p)
                return ast.Type.U16(0)
            elif v == KW_U32
                advance(p)
                return ast.Type.U32(0)
            elif v == KW_U64
                advance(p)
                return ast.Type.U64(0)
            elif v == KW_USIZE
                advance(p)
                return ast.Type.Usize(0)
            elif v == KW_F32
                advance(p)
                return ast.Type.F32(0)
            elif v == KW_F64
                advance(p)
                return ast.Type.F64(0)
            elif v == KW_MUT
                advance(p)
                match p.tokens[p.pos].kind
                    ast.TokenKind.LParen(_) => advance(p)
                    _ => ()
                end
                val inner ast.Type = parse_type(p, arena)
                match p.tokens[p.pos].kind
                    ast.TokenKind.RParen(_) => advance(p)
                    _ => ()
                end
                val raw_res = allocators.Arena.alloc(arena, @sizeof(ast.Type) as usize)
                match raw_res
                    ok raw => (
                        var inner_ptr ref(ast.Type) = @bitcast(raw, ref(ast.Type))
                        @deref(inner_ptr) = inner
                        return ast.Type.Mut(inner_ptr)
                    )
                    error _ => return ast.Type.Void(0)
                end
            elif v == KW_REF
                advance(p)
                match p.tokens[p.pos].kind
                    ast.TokenKind.LParen(_) => advance(p)
                    _ => ()
                end
                val inner ast.Type = parse_type(p, arena)
                match p.tokens[p.pos].kind
                    ast.TokenKind.RParen(_) => advance(p)
                    _ => ()
                end
                val raw_res = allocators.Arena.alloc(arena, @sizeof(ast.Type) as usize)
                match raw_res
                    ok raw => (
                        var inner_ptr ref(ast.Type) = @bitcast(raw, ref(ast.Type))
                        @deref(inner_ptr) = inner
                        return ast.Type.Ref(inner_ptr)
                    )
                    error _ => return ast.Type.Void(0)
                end
            elif v == KW_LIST
                advance(p)
                match p.tokens[p.pos].kind
                    ast.TokenKind.LBracket(_) => advance(p)
                    _ => ()
                end
                val inner ast.Type = parse_type(p, arena)
                match p.tokens[p.pos].kind
                    ast.TokenKind.RBracket(_) => advance(p)
                    _ => ()
                end
                val raw_res = allocators.Arena.alloc(arena, @sizeof(ast.Type) as usize)
                match raw_res
                    ok raw => (
                        var inner_ptr ref(ast.Type) = @bitcast(raw, ref(ast.Type))
                        @deref(inner_ptr) = inner
                        return ast.Type.List(inner_ptr)
                    )
                    error _ => return ast.Type.Void(0)
                end
            end
            advance(p)
            return ast.Type.Void(0)
        )
        ast.TokenKind.Ident(name) => (
            advance(p)
            var type_name ref(u8) = name
            match p.tokens[p.pos].kind
                ast.TokenKind.Dot(_) => (
                    advance(p)
                    val second ref(u8) = expect_ident(p, arena)
                    val len1 usize = str.len(type_name)
                    val len2 usize = str.len(second)
                    var combined_res = allocators.Arena.alloc(arena, len1 + 1 + len2 + 1)
                    var combined ref(u8) = none
                    match combined_res
                        ok m => combined = m as ref(u8)
                        error _ => return ast.Type.Void(0)
                    end
                    @memcpy(combined, type_name, len1)
                    @deref(@as_mut(@add(combined, len1))) = 46
                    @memcpy(@add(combined, len1 + 1), second, len2)
                    @deref(@as_mut(@add(combined, len1 + 1 + len2))) = 0
                    type_name = combined
                )
                _ => ()
            end
            match p.tokens[p.pos].kind
                ast.TokenKind.LBracket(_) => (
                    advance(p)
                    var type_args list[ast.Type] = []
                    for
                        @append(type_args, parse_type(p, arena))
                        match p.tokens[p.pos].kind
                            ast.TokenKind.Comma(_) => advance(p)
                            _ => break
                        end
                    end
                    match p.tokens[p.pos].kind
                        ast.TokenKind.RBracket(_) => advance(p)
                        _ => ()
                    end
                    return ast.Type.Applied(type_name, type_args)
                )
                _ => return ast.Type.Named(type_name)
            end
        )
        ast.TokenKind.LBracket(_) => (
            advance(p)
            var size u64 = 0
            match p.tokens[p.pos].kind
                ast.TokenKind.Int(v) => (
                    size = v
                    advance(p)
                )
                _ => ()
            end
            match p.tokens[p.pos].kind
                ast.TokenKind.RBracket(_) => advance(p)
                _ => ()
            end
            val inner ast.Type = parse_type(p, arena)
            val raw_res = allocators.Arena.alloc(arena, @sizeof(ast.Type) as usize)
            match raw_res
                ok raw => (
                    var inner_ptr ref(ast.Type) = @bitcast(raw, ref(ast.Type))
                    @deref(inner_ptr) = inner
                    return ast.Type.StaticArray(size, inner_ptr)
                )
                error _ => return ast.Type.Void(0)
            end
        )
        _ => return ast.Type.Void(0)
    
    end
end

def parse_type_with_error_union(p ref(ast.TokenList), arena ref(allocators.Arena)) ast.Type
    val base ast.Type = parse_type(p, arena)
    match p.tokens[p.pos].kind
        ast.TokenKind.Pipe(_) => (
            var i usize = p.pos + 1
            match p.tokens[i].kind
                ast.TokenKind.Ident(name) => (
                    if str.eql(name, "error")
                        advance(p)
                        advance(p)
                        val raw_res = allocators.Arena.alloc(arena, @sizeof(ast.Type) as usize)
                        match raw_res
                            ok raw => (
                                var inner_ptr ref(ast.Type) = @bitcast(raw, ref(ast.Type))
                                @deref(inner_ptr) = base
                                return ast.Type.Result(inner_ptr)
                            )
                            error _ => return base
                        end
                    end
                    return base
                )
                _ => return base
            end
        )
        _ => return base
    end
end

def parse_dotted_name(p ref(ast.TokenList), arena ref(allocators.Arena)) ref(u8)
    val first ref(u8) = expect_ident(p, arena)
    match p.tokens[p.pos].kind
        ast.TokenKind.Dot(_) => (
            advance(p)
            val second ref(u8) = expect_ident(p, arena)
            val len1 usize = str.len(first)
            val len2 usize = str.len(second)
            var combined_res = allocators.Arena.alloc(arena, len1 + 1 + len2 + 1)
            var combined ref(u8) = none
            match combined_res
                ok m => combined = m as ref(u8)
                error _ => return first
            end
            @memcpy(combined, first, len1)
            @deref(@as_mut(@add(combined, len1))) = 46
            @memcpy(@add(combined, len1 + 1), second, len2)
            @deref(@as_mut(@add(combined, len1 + 1 + len2))) = 0
            return combined
        )
        _ => return first
    end
end

def is_keyword_in(p ref(ast.TokenList), ids list[u8]) bool
    match p.tokens[p.pos].kind
        ast.TokenKind.Keyword(v) => (
            var i usize = 0
            for i < @len(ids)
                if ids[i] == v
                    return true
                end
                i++
            end
            return false
        )
        _ => return false
    end
end

def parse_block_until(p ref(ast.TokenList), arena ref(allocators.Arena), terminators list[u8], current_platform ref(u8)) list[ast.Stmt]
    var body list[ast.Stmt] = []
    consume_newlines(p)
    for !is_eof(p)
        if is_keyword_in(p, terminators)
            break
        end
        @append(body, parse_stmt(p, arena, current_platform))
        consume_newlines(p)
    end
    return body
end

def parse_block(p ref(ast.TokenList), arena ref(allocators.Arena), current_platform ref(u8)) list[ast.Stmt]
    return parse_block_until(p, arena, [KW_END], current_platform)
end

def parse_stmt(p ref(ast.TokenList), arena ref(allocators.Arena), current_platform ref(u8)) ast.Stmt
    consume_newlines(p)

    if is_keyword(p, KW_VAL) || is_keyword(p, KW_VAR)
        val mutable bool = is_keyword(p, KW_VAR)
        advance(p)
        val line usize = p.tokens[p.pos].line
        val column usize = p.tokens[p.pos].column

        match p.tokens[p.pos].kind
            ast.TokenKind.LParen(_) => (
                advance(p)
                consume_newlines(p)
                var decls list[ast.Stmt] = []
                for !is_eof(p)
                    match p.tokens[p.pos].kind
                        ast.TokenKind.RParen(_) => break
                        _ => ()
                    end
                    val decl_line usize = p.tokens[p.pos].line
                    val decl_col usize = p.tokens[p.pos].column
                    val decl_name ref(u8) = expect_ident(p, arena)
                    var decl_type ast.Type = ast.Type.Void(0)
                    match p.tokens[p.pos].kind
                        ast.TokenKind.Assign(_) => ()
                        _ => (
                            if starts_type(p)
                                decl_type = parse_type(p, arena)
                            end
                        )
                    end
                    match p.tokens[p.pos].kind
                        ast.TokenKind.Assign(_) => advance(p)
                        _ => ()
                    end
                    val decl_init ast.Expr = parse_expr(p, arena)
                    @append(decls, ast.Stmt.VarDecl(@addr(ast.StmtVarDecl(
                        name: decl_name,
                        mutable: mutable,
                        declared_type: decl_type,
                        init: decl_init,
                        line: decl_line,
                        column: decl_col
                    ))))
                    consume_newlines(p)
                end
                match p.tokens[p.pos].kind
                    ast.TokenKind.RParen(_) => advance(p)
                    _ => ()
                end
                return ast.Stmt.Block(decls)
            )
            _ => ()
        end

        val name ref(u8) = expect_ident(p, arena)
        var declared_type ast.Type = ast.Type.Void(0)
        match p.tokens[p.pos].kind
            ast.TokenKind.Assign(_) => ()
            _ => (
                if starts_type(p)
                    declared_type = parse_type(p, arena)
                end
            )
        end
        match p.tokens[p.pos].kind
            ast.TokenKind.Assign(_) => advance(p)
            _ => ()
        end
        val init ast.Expr = parse_expr(p, arena)
        return ast.Stmt.VarDecl(@addr(ast.StmtVarDecl(
            name: name,
            mutable: mutable,
            declared_type: declared_type,
            init: init,
            line: line,
            column: column
        )))
    end

    if is_keyword(p, KW_RETURN)
        val line usize = p.tokens[p.pos].line
        val column usize = p.tokens[p.pos].column
        advance(p)
        var value ast.Expr = ast.Expr.None(0)
        match p.tokens[p.pos].kind
            ast.TokenKind.Newline(_) => ()
            ast.TokenKind.Eof(_) => ()
            _ => value = parse_expr(p, arena)
        end
        return ast.Stmt.Return(@addr(ast.StmtReturn(
            value: value,
            line: line,
            column: column
        )))
    end

    if is_keyword(p, KW_IF)
        return parse_if_stmt(p, arena, current_platform)
    end

    if is_keyword(p, KW_GUARD)
        val line usize = p.tokens[p.pos].line
        val column usize = p.tokens[p.pos].column
        advance(p)
        val condition ast.Expr = parse_expr(p, arena)
        if is_keyword(p, KW_ELSE)
            advance(p)
        end
        expect_newline(p)
        val else_body list[ast.Stmt] = parse_block_until(p, arena, [KW_END], current_platform)
        if is_keyword(p, KW_END)
            advance(p)
        end
        val negated_raw = allocators.Arena.alloc(arena, @sizeof(ast.ExprUnary) as usize)
        var negated_p ref(ast.ExprUnary) = none
        match negated_raw
            ok m => negated_p = @bitcast(m, ref(ast.ExprUnary))
            error _ => ()
        end
        val cond_raw = allocators.Arena.alloc(arena, @sizeof(ast.Expr) as usize)
        var cond_p ref(ast.Expr) = none
        match cond_raw
            ok m => cond_p = @bitcast(m, ref(ast.Expr))
            error _ => ()
        end
        @deref(cond_p) = condition
        negated_p.op = ast.UnaryOp.LogicalNot
        negated_p.expr = cond_p
        return ast.Stmt.If(@addr(ast.StmtIf(
            condition: ast.Expr.Unary(negated_p),
            then_body: else_body,
            else_body: [] as list[ast.Stmt],
            line: line,
            column: column
        )))
    end

    if is_keyword(p, KW_ASSERT)
        advance(p)
        val condition ast.Expr = parse_expr(p, arena)
        return ast.Stmt.Assert(box_expr(arena, condition))
    end

    if is_keyword(p, KW_FOR)
        return parse_for_stmt(p, arena, current_platform)
    end

    if is_keyword(p, KW_WHILE)
        return parse_while_stmt(p, arena, current_platform)
    end

    if is_keyword(p, KW_MATCH)
        return parse_match_stmt(p, arena, current_platform)
    end

    if is_keyword(p, KW_BREAK)
        advance(p)
        return ast.Stmt.Break(0)
    end

    if is_keyword(p, KW_CONT)
        advance(p)
        return ast.Stmt.Continue(0)
    end

    if is_keyword(p, KW_DEFER)
        advance(p)
        expect_newline(p)
        val body list[ast.Stmt] = parse_block(p, arena, current_platform)
        if !is_eof(p) && is_keyword(p, KW_END)
            advance(p)
        end
        return ast.Stmt.Defer(body)
    end

    if is_keyword(p, KW_WHEN)
        return parse_when_stmt(p, arena, current_platform)
    end

    val (
        line   usize    = p.tokens[p.pos].line
        column usize    = p.tokens[p.pos].column
        expr   ast.Expr = parse_expr(p, arena)
    )

    match p.tokens[p.pos].kind
        ast.TokenKind.Assign(_) => (
            advance(p)
            consume_newlines(p)
            val value ast.Expr = parse_expr(p, arena)
            return ast.Stmt.Assign(@addr(ast.StmtAssign(
                target: expr,
                value: value,
                line: line,
                column: column
            )))
        )
        ast.TokenKind.PlusEqual(_) => (
            advance(p)
            consume_newlines(p)
            val value ast.Expr = parse_expr(p, arena)
            return ast.Stmt.AddAssign(@addr(ast.StmtAssign(
                target: expr,
                value: value,
                line: line,
                column: column
            )))
        )
        ast.TokenKind.MinusEqual(_) => (
            advance(p)
            consume_newlines(p)
            val value ast.Expr = parse_expr(p, arena)
            return ast.Stmt.SubAssign(@addr(ast.StmtAssign(
                target: expr,
                value: value,
                line: line,
                column: column
            )))
        )
        ast.TokenKind.StarEqual(_) => (
            advance(p)
            consume_newlines(p)
            val value ast.Expr = parse_expr(p, arena)
            return ast.Stmt.MulAssign(@addr(ast.StmtAssign(
                target: expr,
                value: value,
                line: line,
                column: column
            )))
        )
        ast.TokenKind.SlashEqual(_) => (
            advance(p)
            consume_newlines(p)
            val value ast.Expr = parse_expr(p, arena)
            return ast.Stmt.DivAssign(@addr(ast.StmtAssign(
                target: expr,
                value: value,
                line: line,
                column: column
            )))
        )
        ast.TokenKind.CaretEqual(_) => (
            advance(p)
            consume_newlines(p)
            val value ast.Expr = parse_expr(p, arena)
            return ast.Stmt.BitXorAssign(@addr(ast.StmtAssign(
                target: expr,
                value: value,
                line: line,
                column: column
            )))
        )
        ast.TokenKind.AmpEqual(_) => (
            advance(p)
            consume_newlines(p)
            val value ast.Expr = parse_expr(p, arena)
            return ast.Stmt.BitAndAssign(@addr(ast.StmtAssign(
                target: expr,
                value: value,
                line: line,
                column: column
            )))
        )
        ast.TokenKind.PipeEqual(_) => (
            advance(p)
            consume_newlines(p)
            val value ast.Expr = parse_expr(p, arena)
            return ast.Stmt.BitOrAssign(@addr(ast.StmtAssign(
                target: expr,
                value: value,
                line: line,
                column: column
            )))
        )
        ast.TokenKind.PlusPlus(_) => (
            advance(p)
            return ast.Stmt.Increment(box_expr(arena, expr))
        )
        ast.TokenKind.MinusMinus(_) => (
            advance(p)
            return ast.Stmt.Decrement(box_expr(arena, expr))
        )
        ast.TokenKind.Newline(_) => return ast.Stmt.ExprStmt(box_expr(arena, promote_bracketless_call(arena, expr)))
        ast.TokenKind.Eof(_) => return ast.Stmt.ExprStmt(box_expr(arena, promote_bracketless_call(arena, expr)))
        _ => return ast.Stmt.ExprStmt(box_expr(arena, promote_bracketless_call(arena, expr)))
    end
end

def promote_bracketless_call(arena ref(allocators.Arena), expr ast.Expr) ast.Expr
    match expr
        ast.Expr.Ident(_) => (
            val raw_res = allocators.Arena.alloc(arena, @sizeof(ast.ExprCall) as usize)
            match raw_res
                ok raw => (
                    var p ref(ast.ExprCall) = @bitcast(raw, ref(ast.ExprCall))
                    p.callee = box_expr(arena, expr)
                    p.args = [] as list[ast.Expr]
                    return ast.Expr.Call(p)
                )
                error _ => return expr
            end
        )
        _ => return expr
    end
end

def parse_when_stmt(p ref(ast.TokenList), arena ref(allocators.Arena), current_platform ref(u8)) ast.Stmt
    advance(p)
    val matches bool = parse_when_condition(p, arena, current_platform)
    expect_newline(p)
    val body list[ast.Stmt] = parse_block(p, arena, current_platform)
    if !is_eof(p) && is_keyword(p, KW_END)
        advance(p)
    end
    if matches
        return ast.Stmt.Block(body)
    else
        return ast.Stmt.Block([] as list[ast.Stmt])
    end
end

def parse_if_stmt(p ref(ast.TokenList), arena ref(allocators.Arena), current_platform ref(u8)) ast.Stmt
    advance(p)
    val line usize = p.tokens[p.pos].line
    val column usize = p.tokens[p.pos].column
    val condition ast.Expr = parse_expr(p, arena)
    expect_newline(p)
    val then_body list[ast.Stmt] = parse_block_until(p, arena, [KW_ELSE, KW_ELIF, KW_END], current_platform)

    var else_body list[ast.Stmt] = []
    if is_keyword(p, KW_ELSE)
        advance(p)
        expect_newline(p)
        else_body = parse_block_until(p, arena, [KW_END], current_platform)
    elif is_keyword(p, KW_ELIF)
        var elif_arms list[ast.Stmt] = []
        var elif_bodies list[list[ast.Stmt]] = []
        var elif_conds list[ast.Expr] = []
        for is_keyword(p, KW_ELIF)
            advance(p)
            val elif_cond ast.Expr = parse_expr(p, arena)
            expect_newline(p)
            val elif_then list[ast.Stmt] = parse_block_until(p, arena, [KW_ELSE, KW_ELIF, KW_END], current_platform)
            @append(elif_conds, elif_cond)
            @append(elif_bodies, elif_then)
        end
        if is_keyword(p, KW_ELSE)
            advance(p)
            expect_newline(p)
            else_body = parse_block_until(p, arena, [KW_END], current_platform)
        end
        var k usize = @len(elif_conds)
        for k > 0
            k--
            val ec ast.Expr = elif_conds[k]
            val eb list[ast.Stmt] = elif_bodies[k]
            val wrapped ast.Stmt = ast.Stmt.If(@addr(ast.StmtIf(
                condition: ec,
                then_body: eb,
                else_body: else_body,
                line: 0,
                column: 0
            )))
            else_body = [wrapped]
        end
    end

    if !is_eof(p) && is_keyword(p, KW_END)
        advance(p)
    end

    return ast.Stmt.If(@addr(ast.StmtIf(
        condition: condition,
        then_body: then_body,
        else_body: else_body,
        line: line,
        column: column
    )))
end

def parse_for_stmt(p ref(ast.TokenList), arena ref(allocators.Arena), current_platform ref(u8)) ast.Stmt
    advance(p)
    val line usize = p.tokens[p.pos].line
    val column usize = p.tokens[p.pos].column

    if is_keyword(p, KW_VAR)
        advance(p)
        val var_name ref(u8) = expect_ident(p, arena)
        match p.tokens[p.pos].kind
            ast.TokenKind.Assign(_) => (
                advance(p)
                val start ast.Expr = parse_expr(p, arena)
                match p.tokens[p.pos].kind
                    ast.TokenKind.DotDot(_) => (
                        advance(p)
                        val end_expr ast.Expr = parse_expr(p, arena)
                        expect_newline(p)
                        val body list[ast.Stmt] = parse_block(p, arena, current_platform)
                        if !is_eof(p) && is_keyword(p, KW_END)
                            advance(p)
                        end
                        return ast.Stmt.ForRange(@addr(ast.StmtForRange(
                            var_name: var_name,
                            start: start,
                            End: end_expr,
                            body: body,
                            line: line,
                            column: column
                        )))
                    )
                    _ => ()
                end
            )
            _ => ()
        end
        if is_keyword(p, KW_IN)
            advance(p)
            val iterable ast.Expr = parse_expr(p, arena)
            expect_newline(p)
            val body list[ast.Stmt] = parse_block(p, arena, current_platform)
            if !is_eof(p) && is_keyword(p, KW_END)
                advance(p)
            end
            return ast.Stmt.ForEach(@addr(ast.StmtForEach(
                var_name: var_name,
                iterable: iterable,
                body: body,
                line: line,
                column: column
            )))
        end
    end

    var condition ast.Expr = ast.Expr.IntLit(1)
    match p.tokens[p.pos].kind
        ast.TokenKind.Newline(_) => ()
        ast.TokenKind.Eof(_) => ()
        _ => condition = parse_expr(p, arena)
    end
    expect_newline(p)
    val body list[ast.Stmt] = parse_block(p, arena, current_platform)
    if !is_eof(p) && is_keyword(p, KW_END)
        advance(p)
    end
    return ast.Stmt.While(@addr(ast.StmtWhile(
        condition: condition,
        body: body,
        line: line,
        column: column
    )))
end

def parse_while_stmt(p ref(ast.TokenList), arena ref(allocators.Arena), current_platform ref(u8)) ast.Stmt
    advance(p)
    val line usize = p.tokens[p.pos].line
    val column usize = p.tokens[p.pos].column
    val condition ast.Expr = parse_expr(p, arena)
    expect_newline(p)
    val body list[ast.Stmt] = parse_block(p, arena, current_platform)
    if !is_eof(p) && is_keyword(p, KW_END)
        advance(p)
    end
    return ast.Stmt.While(@addr(ast.StmtWhile(
        condition: condition,
        body: body,
        line: line,
        column: column
    )))
end

def parse_match_stmt(p ref(ast.TokenList), arena ref(allocators.Arena), current_platform ref(u8)) ast.Stmt
    advance(p)
    val line usize = p.tokens[p.pos].line
    val column usize = p.tokens[p.pos].column
    val expr ast.Expr = parse_expr(p, arena)
    expect_newline(p)
    var arms list[ast.MatchArm] = []
    consume_newlines(p)
    for !is_eof(p) && !is_keyword(p, KW_END)
        val kind ast.MatchArmKind = parse_match_arm_kind(p, arena)
        var bindings list[ref(u8)] = []
        match kind
            ast.MatchArmKind.Ok(_) | ast.MatchArmKind.Error(_) => (
                match p.tokens[p.pos].kind
                    ast.TokenKind.Ident(name) => (
                        advance(p)
                        @append(bindings, name)
                    )
                    _ => ()
                end
            )
            _ => ()
        end
        match p.tokens[p.pos].kind
            ast.TokenKind.LParen(_) => (
                advance(p)
                for !is_eof(p)
                    match p.tokens[p.pos].kind
                        ast.TokenKind.RParen(_) => (
                            advance(p)
                            break
                        )
                        ast.TokenKind.Ident(name) => (
                            advance(p)
                            @append(bindings, name)
                        )
                        _ => advance(p)
                    end
                    match p.tokens[p.pos].kind
                        ast.TokenKind.Comma(_) => advance(p)
                        _ => ()
                    end
                end
            )
            _ => ()
        end
        match p.tokens[p.pos].kind
            ast.TokenKind.FatArrow(_) => advance(p)
            _ => ()
        end
        consume_newlines(p)
        var arm_body list[ast.Stmt] = []
        match p.tokens[p.pos].kind
            ast.TokenKind.LParen(_) => (
                advance(p)
                for !is_eof(p)
                    match p.tokens[p.pos].kind
                        ast.TokenKind.RParen(_) => break
                        _ => ()
                    end
                    @append(arm_body, parse_stmt(p, arena, current_platform))
                    consume_newlines(p)
                end
                match p.tokens[p.pos].kind
                    ast.TokenKind.RParen(_) => advance(p)
                    _ => ()
                end
            )
            _ => @append(arm_body, parse_stmt(p, arena, current_platform))
        end
        @append(arms, ast.MatchArm(
            kind: kind,
            bindings: bindings,
            body: arm_body
        ))
        consume_newlines(p)
    end
    if !is_eof(p) && is_keyword(p, KW_END)
        advance(p)
    end
    return ast.Stmt.Match(@addr(ast.StmtMatch(
        expr: expr,
        arms: arms,
        line: line,
        column: column
    )))
end

def parse_match_arm_kind(p ref(ast.TokenList), arena ref(allocators.Arena)) ast.MatchArmKind
    match p.tokens[p.pos].kind
        ast.TokenKind.Ident(name) => (
            if str.eql(name, "_")
                advance(p)
                return ast.MatchArmKind.Wild(0)
            elif str.eql(name, "ok")
                advance(p)
                match p.tokens[p.pos].kind
                    ast.TokenKind.LParen(_) => return ast.MatchArmKind.VariantName(name)
                    _ => return ast.MatchArmKind.Ok(0)
                end
            elif str.eql(name, "error")
                advance(p)
                match p.tokens[p.pos].kind
                    ast.TokenKind.LParen(_) => return ast.MatchArmKind.VariantName(name)
                    _ => return ast.MatchArmKind.Error(0)
                end
            else
                advance(p)
                match p.tokens[p.pos].kind
                    ast.TokenKind.Dot(_) => (
                        advance(p)
                        val second ref(u8) = expect_ident(p, arena)
                        val len1 usize = str.len(name)
                        val len2 usize = str.len(second)
                        match p.tokens[p.pos].kind
                            ast.TokenKind.Dot(_) => (
                                advance(p)
                                val third ref(u8) = expect_ident(p, arena)
                                val len3 usize = str.len(third)
                                var combined_res = allocators.Arena.alloc(arena, len1 + 1 + len2 + 1 + len3 + 1)
                                var combined ref(u8) = none
                                match combined_res
                                    ok m => combined = m as ref(u8)
                                    error _ => return ast.MatchArmKind.VariantName(name)
                                end
                                @memcpy(combined, name, len1)
                                @deref(@as_mut(@add(combined, len1))) = 46
                                @memcpy(@add(combined, len1 + 1), second, len2)
                                @deref(@as_mut(@add(combined, len1 + 1 + len2))) = 46
                                @memcpy(@add(combined, len1 + 1 + len2 + 1), third, len3)
                                @deref(@as_mut(@add(combined, len1 + 1 + len2 + 1 + len3))) = 0
                                return ast.MatchArmKind.VariantName(combined)
                            )
                            _ => ()
                        end
                        var combined_res = allocators.Arena.alloc(arena, len1 + 1 + len2 + 1)
                        var combined ref(u8) = none
                        match combined_res
                            ok m => combined = m as ref(u8)
                            error _ => return ast.MatchArmKind.VariantName(name)
                        end
                        @memcpy(combined, name, len1)
                        @deref(@as_mut(@add(combined, len1))) = 46
                        @memcpy(@add(combined, len1 + 1), second, len2)
                        @deref(@as_mut(@add(combined, len1 + 1 + len2))) = 0
                        return ast.MatchArmKind.VariantName(combined)
                    )
                    _ => return ast.MatchArmKind.VariantName(name)
                end
            end
        )
        ast.TokenKind.Int(v) => (
            var buf_res = allocators.Arena.alloc(arena, 32)
            var buf ref(u8) = none
            match buf_res
                ok m => (
                    buf = m as ref(u8)
                    var digits_buf list[u8] = []
                    format_u64_for_str(v, @addr(digits_buf))
                    @memcpy(buf, @addr(digits_buf[0]), @len(digits_buf))
                    @deref(@as_mut(@add(buf, @len(digits_buf)))) = 0
                    advance(p)
                    return ast.MatchArmKind.VariantName(buf)
                )
                error _ => (
                    advance(p)
                    return ast.MatchArmKind.Wild(0)
                )
            end
        )
        ast.TokenKind.Char(ch) => (
            var buf_res = allocators.Arena.alloc(arena, 32)
            var buf ref(u8) = none
            match buf_res
                ok m => (
                    buf = m as ref(u8)
                    var digits_buf list[u8] = []
                    format_u64_for_str(ch as u64, @addr(digits_buf))
                    @memcpy(buf, @addr(digits_buf[0]), @len(digits_buf))
                    @deref(@as_mut(@add(buf, @len(digits_buf)))) = 0
                    advance(p)
                    return ast.MatchArmKind.VariantName(buf)
                )
                error _ => (
                    advance(p)
                    return ast.MatchArmKind.Wild(0)
                )
            end
        )
        _ => (
            advance(p)
            return ast.MatchArmKind.Wild(0)
        )
    end
end

def format_u64_for_str(v u64, buf ref(list[u8]))
    var value u64 = v
    if value == 0
        @append(@deref(buf), '0')
        return
    end
    var digits list[u8] = []
    for value > 0
        @append(digits, ((value % 10) as u8) + '0')
        value = value / 10
    end
    var k usize = @len(digits)
    for k > 0
        k--
        @append(@deref(buf), digits[k])
    end
end

def parse_expr(p ref(ast.TokenList), arena ref(allocators.Arena)) ast.Expr
    return parse_expr_or(p, arena, 0)
end

def parse_expr_or(p ref(ast.TokenList), arena ref(allocators.Arena), min_prec usize) ast.Expr
    var left ast.Expr = parse_expr_and(p, arena, min_prec)
    for
        match p.tokens[p.pos].kind
            ast.TokenKind.PipePipe(_) => ()
            _ => break
        end
        val op_opt usize = binary_op_precedence_or()
        if op_opt == 0 || op_opt < min_prec
            break
        end
        val op_val = token_to_binary_op(p.tokens[p.pos].kind)
        advance(p)
        consume_newlines(p)
        val right ast.Expr = parse_expr_and(p, arena, op_opt + 1)
        left = ast.Expr.Binary(@addr(ast.ExprBinary(
            lhs: box_expr(arena, left),
            op: op_val,
            rhs: box_expr(arena, right)
        )))
    end
    return left
end

def parse_expr_and(p ref(ast.TokenList), arena ref(allocators.Arena), min_prec usize) ast.Expr
    var left ast.Expr = parse_expr_bitor(p, arena, min_prec)
    for
        match p.tokens[p.pos].kind
            ast.TokenKind.AmpAmp(_) => ()
            _ => break
        end
        val op_opt usize = binary_op_precedence_and()
        if op_opt == 0 || op_opt < min_prec
            break
        end
        val op_val = token_to_binary_op(p.tokens[p.pos].kind)
        advance(p)
        consume_newlines(p)
        val right ast.Expr = parse_expr_bitor(p, arena, op_opt + 1)
        left = ast.Expr.Binary(@addr(ast.ExprBinary(
            lhs: box_expr(arena, left),
            op: op_val,
            rhs: box_expr(arena, right)
        )))
    end
    return left
end

def parse_expr_bitor(p ref(ast.TokenList), arena ref(allocators.Arena), min_prec usize) ast.Expr
    var left ast.Expr = parse_expr_bitxor(p, arena, min_prec)
    for
        match p.tokens[p.pos].kind
            ast.TokenKind.Pipe(_) => ()
            _ => break
        end
        val op_opt usize = binary_op_precedence_bitor()
        if op_opt == 0 || op_opt < min_prec
            break
        end
        val op_val = token_to_binary_op(p.tokens[p.pos].kind)
        advance(p)
        consume_newlines(p)
        val right ast.Expr = parse_expr_bitxor(p, arena, op_opt + 1)
        left = ast.Expr.Binary(@addr(ast.ExprBinary(
            lhs: box_expr(arena, left),
            op: op_val,
            rhs: box_expr(arena, right)
        )))
    end
    return left
end

def parse_expr_bitxor(p ref(ast.TokenList), arena ref(allocators.Arena), min_prec usize) ast.Expr
    var left ast.Expr = parse_expr_bitand(p, arena, min_prec)
    for
        match p.tokens[p.pos].kind
            ast.TokenKind.Caret(_) => ()
            _ => break
        end
        val op_opt usize = binary_op_precedence_bitxor()
        if op_opt == 0 || op_opt < min_prec
            break
        end
        val op_val = token_to_binary_op(p.tokens[p.pos].kind)
        advance(p)
        consume_newlines(p)
        val right ast.Expr = parse_expr_bitand(p, arena, op_opt + 1)
        left = ast.Expr.Binary(@addr(ast.ExprBinary(
            lhs: box_expr(arena, left),
            op: op_val,
            rhs: box_expr(arena, right)
        )))
    end
    return left
end

def parse_expr_bitand(p ref(ast.TokenList), arena ref(allocators.Arena), min_prec usize) ast.Expr
    var left ast.Expr = parse_expr_comparison(p, arena, min_prec)
    for
        match p.tokens[p.pos].kind
            ast.TokenKind.Amp(_) => ()
            _ => break
        end
        val op_opt usize = binary_op_precedence_bitand()
        if op_opt == 0 || op_opt < min_prec
            break
        end
        val op_val = token_to_binary_op(p.tokens[p.pos].kind)
        advance(p)
        consume_newlines(p)
        val right ast.Expr = parse_expr_comparison(p, arena, op_opt + 1)
        left = ast.Expr.Binary(@addr(ast.ExprBinary(
            lhs: box_expr(arena, left),
            op: op_val,
            rhs: box_expr(arena, right)
        )))
    end
    return left
end

def parse_expr_comparison(p ref(ast.TokenList), arena ref(allocators.Arena), min_prec usize) ast.Expr
    var left ast.Expr = parse_expr_shift(p, arena, min_prec)
    for
        match p.tokens[p.pos].kind
            ast.TokenKind.Less(_) => ()
            ast.TokenKind.LessEqual(_) => ()
            ast.TokenKind.Greater(_) => ()
            ast.TokenKind.GreaterEqual(_) => ()
            ast.TokenKind.EqualEqual(_) => ()
            ast.TokenKind.BangEqual(_) => ()
            _ => break
        end
        val op_opt usize = binary_op_precedence_comparison()
        if op_opt == 0 || op_opt < min_prec
            break
        end
        val op_val = token_to_binary_op(p.tokens[p.pos].kind)
        advance(p)
        consume_newlines(p)
        val right ast.Expr = parse_expr_shift(p, arena, op_opt + 1)
        left = ast.Expr.Binary(@addr(ast.ExprBinary(
            lhs: box_expr(arena, left),
            op: op_val,
            rhs: box_expr(arena, right)
        )))
    end
    return left
end

def parse_expr_shift(p ref(ast.TokenList), arena ref(allocators.Arena), min_prec usize) ast.Expr
    var left ast.Expr = parse_expr_additive(p, arena, min_prec)
    for
        match p.tokens[p.pos].kind
            ast.TokenKind.ShiftLeft(_) => ()
            ast.TokenKind.ShiftRight(_) => ()
            _ => break
        end
        val op_opt usize = binary_op_precedence_shift()
        if op_opt == 0 || op_opt < min_prec
            break
        end
        val op_val = token_to_binary_op(p.tokens[p.pos].kind)
        advance(p)
        consume_newlines(p)
        val right ast.Expr = parse_expr_additive(p, arena, op_opt + 1)
        left = ast.Expr.Binary(@addr(ast.ExprBinary(
            lhs: box_expr(arena, left),
            op: op_val,
            rhs: box_expr(arena, right)
        )))
    end
    return left
end

def parse_expr_additive(p ref(ast.TokenList), arena ref(allocators.Arena), min_prec usize) ast.Expr
    var left ast.Expr = parse_expr_multiplicative(p, arena, min_prec)
    for
        match p.tokens[p.pos].kind
            ast.TokenKind.Plus(_) => ()
            ast.TokenKind.Minus(_) => ()
            _ => break
        end
        val op_opt usize = binary_op_precedence_additive()
        if op_opt == 0 || op_opt < min_prec
            break
        end
        val op_val = token_to_binary_op(p.tokens[p.pos].kind)
        advance(p)
        consume_newlines(p)
        val right ast.Expr = parse_expr_multiplicative(p, arena, op_opt + 1)
        left = ast.Expr.Binary(@addr(ast.ExprBinary(
            lhs: box_expr(arena, left),
            op: op_val,
            rhs: box_expr(arena, right)
        )))
    end
    return left
end

def parse_expr_multiplicative(p ref(ast.TokenList), arena ref(allocators.Arena), min_prec usize) ast.Expr
    var left ast.Expr = parse_expr_postfix(p, arena)
    for
        match p.tokens[p.pos].kind
            ast.TokenKind.Star(_) => ()
            ast.TokenKind.Slash(_) => ()
            ast.TokenKind.Percent(_) => ()
            _ => break
        end
        val op_opt usize = binary_op_precedence_multiplicative()
        if op_opt == 0 || op_opt < min_prec
            break
        end
        val op_val = token_to_binary_op(p.tokens[p.pos].kind)
        advance(p)
        consume_newlines(p)
        val right ast.Expr = parse_expr_postfix(p, arena)
        left = ast.Expr.Binary(@addr(ast.ExprBinary(
            lhs: box_expr(arena, left),
            op: op_val,
            rhs: box_expr(arena, right)
        )))
    end
    return left
end

def looks_like_struct_init(p ref(ast.TokenList)) bool
    var i usize = p.pos + 1
    for i < @len(p.tokens)
        match p.tokens[i].kind
            ast.TokenKind.Newline(_) => i++
            _ => break
        end
    end
    if i >= @len(p.tokens)
        return false
    end
    match p.tokens[i].kind
        ast.TokenKind.Ident(_) => ()
        _ => return false
    end
    i++
    for i < @len(p.tokens)
        match p.tokens[i].kind
            ast.TokenKind.Newline(_) => i++
            _ => break
        end
    end
    if i >= @len(p.tokens)
        return false
    end
    match p.tokens[i].kind
        ast.TokenKind.Colon(_) => return true
        _ => return false
    end
end

def get_struct_name(expr ast.Expr, arena ref(allocators.Arena)) ref(u8)
    match expr
        ast.Expr.Ident(name) => return name
        ast.Expr.Path(segments) => (
            if @len(segments) == 0
                return ""
            end
            var total_len usize = 0
            var i usize = 0
            for i < @len(segments)
                if i > 0
                    total_len++
                end
                total_len = total_len + str.len(segments[i])
                i++
            end
            val res = allocators.Arena.alloc(arena, total_len + 1)
            match res
                ok m => (
                    var dest ref(u8) = m as ref(u8)
                    var offset usize = 0
                    i = 0
                    for i < @len(segments)
                        if i > 0
                            @deref(@as_mut(@add(dest, offset))) = '.'
                            offset++
                        end
                        val segment_len usize = str.len(segments[i])
                        @memcpy(@add(dest, offset), segments[i], segment_len)
                        offset = offset + segment_len
                        i++
                    end
                    @deref(@as_mut(@add(dest, offset))) = 0
                    return dest
                )
                error _ => return ""
            end
        )
        _ => return ""
    end
end

def parse_struct_init(p ref(ast.TokenList), arena ref(allocators.Arena), name ref(u8)) ast.Expr
    advance(p)
    consume_newlines(p)
    var fields list[ast.FieldInit] = []
    for !is_eof(p)
        match p.tokens[p.pos].kind
            ast.TokenKind.RParen(_) => break
            _ => ()
        end
        val field_name ref(u8) = expect_ident(p, arena)
        match p.tokens[p.pos].kind
            ast.TokenKind.Colon(_) => advance(p)
            _ => ()
        end
        consume_newlines(p)
        val value ast.Expr = parse_expr(p, arena)
        @append(fields, ast.FieldInit(name: field_name, value: value))
        consume_newlines(p)
        match p.tokens[p.pos].kind
            ast.TokenKind.Comma(_) => (
                advance(p)
                consume_newlines(p)
            )
            _ => break
        end
    end
    consume_newlines(p)
    match p.tokens[p.pos].kind
        ast.TokenKind.RParen(_) => advance(p)
        _ => ()
    end
    val res = allocators.Arena.alloc(arena, @sizeof(ast.ExprStructInit) as usize)
    match res
        ok m => (
            var struct_init ref(ast.ExprStructInit) = @bitcast(m, ref(ast.ExprStructInit))
            @deref(struct_init) = ast.ExprStructInit(
                name: name,
                type_args: [] as list[ast.Type],
                fields: fields
            )
            return ast.Expr.StructInit(struct_init)
        )
        error _ => return ast.Expr.None(0)
    end
end

def parse_expr_postfix(p ref(ast.TokenList), arena ref(allocators.Arena)) ast.Expr
    var expr ast.Expr = parse_primary(p, arena)
    for
        match p.tokens[p.pos].kind
            ast.TokenKind.LParen(_) => (
                val struct_name ref(u8) = get_struct_name(expr, arena)
                if str.len(struct_name) > 0 && looks_like_struct_init(p)
                    expr = parse_struct_init(p, arena, struct_name)
                else
                    advance(p)
                    var args list[ast.Expr] = []
                    consume_newlines(p)
                    for !is_eof(p)
                        match p.tokens[p.pos].kind
                            ast.TokenKind.RParen(_) => break
                            _ => ()
                        end
                        @append(args, parse_expr(p, arena))
                        consume_newlines(p)
                        match p.tokens[p.pos].kind
                            ast.TokenKind.Comma(_) => (
                                advance(p)
                                consume_newlines(p)
                            )
                            _ => break
                        end
                    end
                    consume_newlines(p)
                    match p.tokens[p.pos].kind
                        ast.TokenKind.RParen(_) => advance(p)
                        _ => ()
                    end
                    var is_error_ctor bool = false
                    var error_msg ref(u8) = none
                    match expr
                        ast.Expr.Ident(name) => (
                            if @len(args) == 1 && str.eql(name, "error")
                                match @deref(@addr(args[0]))
                                    ast.Expr.StrLit(msg) => (
                                        is_error_ctor = true
                                        error_msg = msg
                                    )
                                    _ => ()
                                end
                            end
                        )
                        _ => ()
                    end
                    if is_error_ctor
                        expr = ast.Expr.ErrorLit(error_msg)
                    else
                        expr = ast.Expr.Call(@addr(ast.ExprCall(
                            callee: box_expr(arena, expr),
                            args: args
                        )))
                    end
                end
            )
            ast.TokenKind.Dot(_) => (
                advance(p)
                val field ref(u8) = expect_ident(p, arena)
                match p.tokens[p.pos].kind
                    ast.TokenKind.LParen(_) => (
                        advance(p)
                        var args list[ast.Expr] = []
                        consume_newlines(p)
                        for !is_eof(p)
                            match p.tokens[p.pos].kind
                                ast.TokenKind.RParen(_) => break
                                _ => ()
                            end
                            @append(args, parse_expr(p, arena))
                            consume_newlines(p)
                            match p.tokens[p.pos].kind
                                ast.TokenKind.Comma(_) => (
                                    advance(p)
                                    consume_newlines(p)
                                )
                                _ => break
                            end
                        end
                        consume_newlines(p)
                        match p.tokens[p.pos].kind
                            ast.TokenKind.RParen(_) => advance(p)
                            _ => ()
                        end
                        expr = ast.Expr.MethodCall(@addr(ast.ExprMethodCall(
                            receiver: box_expr(arena, expr),
                            method: field,
                            args: args
                        )))
                    )
                    _ => expr = ast.Expr.Field(@addr(ast.ExprField(
                        base: box_expr(arena, expr),
                        field: field
                    )))
                end
            )
            ast.TokenKind.LBracket(_) => (
                if supports_specialization(@addr(expr)) && peek_is_type_arg(p) && is_type_arg_followed_by_call(p)
                    advance(p)
                    var type_args list[ast.Type] = []
                    for !is_eof(p)
                        match p.tokens[p.pos].kind
                            ast.TokenKind.RBracket(_) => break
                            _ => ()
                        end
                        @append(type_args, parse_type(p, arena))
                        match p.tokens[p.pos].kind
                            ast.TokenKind.Comma(_) => advance(p)
                            _ => break
                        end
                    end
                    match p.tokens[p.pos].kind
                        ast.TokenKind.RBracket(_) => advance(p)
                        _ => ()
                    end
                    val sp_res = allocators.Arena.alloc(arena, @sizeof(ast.ExprSpecialize) as usize)
                    match sp_res
                        ok m => (
                            var sp_ptr ref(ast.ExprSpecialize) = @bitcast(m, ref(ast.ExprSpecialize))
                            sp_ptr.callee = box_expr(arena, expr)
                            sp_ptr.type_args = type_args
                            expr = ast.Expr.Specialize(sp_ptr)
                        )
                        error _ => ()
                    end
                else
                    advance(p)
                    val index ast.Expr = parse_expr(p, arena)
                    match p.tokens[p.pos].kind
                        ast.TokenKind.RBracket(_) => advance(p)
                        _ => ()
                    end
                    expr = ast.Expr.Index(@addr(ast.ExprIndex(
                        base: box_expr(arena, expr),
                        index: box_expr(arena, index)
                    )))
                end
            )
            ast.TokenKind.Keyword(v) => (
                if v == KW_AS
                    advance(p)
                    val cast_ty ast.Type = parse_type(p, arena)
                    val cast_res = allocators.Arena.alloc(arena, @sizeof(ast.ExprCast) as usize)
                    match cast_res
                        ok m => (
                            var cast_ptr ref(ast.ExprCast) = @bitcast(m, ref(ast.ExprCast))
                            @deref(cast_ptr) = ast.ExprCast(
                                expr: box_expr(arena, expr),
                                ty: cast_ty
                            )
                            expr = ast.Expr.Cast(cast_ptr)
                        )
                        error _ => ()
                    end
                else
                    break
                end
            )
            ast.TokenKind.Question(_) => (
                advance(p)
                expr = ast.Expr.Try(box_expr(arena, expr))
            )
            _ => break
        end
    end
    return expr
end

def parse_primary(p ref(ast.TokenList), arena ref(allocators.Arena)) ast.Expr
    match p.tokens[p.pos].kind
        ast.TokenKind.Int(v) => (
            advance(p)
            return ast.Expr.IntLit(v)
        )
        ast.TokenKind.Float(v) => (
            advance(p)
            return ast.Expr.FloatLit(v)
        )
        ast.TokenKind.Char(v) => (
            advance(p)
            return ast.Expr.CharLit(v)
        )
        ast.TokenKind.Str(s) => (
            advance(p)
            return ast.Expr.StrLit(s)
        )
        ast.TokenKind.Keyword(v) => (
            if v == KW_TRUE
                advance(p)
                return ast.Expr.BoolLit(1)
            elif v == KW_FALSE
                advance(p)
                return ast.Expr.BoolLit(0)
            elif v == KW_NONE
                advance(p)
                return ast.Expr.None(0)
            end
            val tok_line usize = p.tokens[p.pos].line
            val tok_col usize = p.tokens[p.pos].column
            @print("{s}:{d}:{d}: parse error: unexpected keyword in expression\n", {p.source_file, tok_line, tok_col})
            error_count++
            advance(p)
            return ast.Expr.None(0)
        )
        ast.TokenKind.At(_) => (
            advance(p)
            val name ref(u8) = expect_ident(p, arena)
            var args list[ast.Expr] = []
            match p.tokens[p.pos].kind
                ast.TokenKind.LParen(_) => (
                    advance(p)
                    consume_newlines(p)
                    for !is_eof(p)
                        consume_newlines(p)
                        match p.tokens[p.pos].kind
                            ast.TokenKind.RParen(_) => break
                            _ => ()
                        end
                        @append(args, parse_expr(p, arena))
                        consume_newlines(p)
                        match p.tokens[p.pos].kind
                            ast.TokenKind.Comma(_) => (
                                advance(p)
                                consume_newlines(p)
                            )
                            _ => break
                        end
                    end
                    consume_newlines(p)
                    match p.tokens[p.pos].kind
                        ast.TokenKind.RParen(_) => advance(p)
                        _ => ()
                    end
                )
                _ => ()
            end
            return ast.Expr.BuiltinCall(@addr(ast.ExprBuiltinCall(
                name: name,
                args: args
            )))
        )
        ast.TokenKind.Bang(_) => (
            advance(p)
            val expr ast.Expr = parse_expr_postfix(p, arena)
            return ast.Expr.Unary(@addr(ast.ExprUnary(
                op: ast.UnaryOp.LogicalNot,
                expr: box_expr(arena, expr)
            )))
        )
        ast.TokenKind.Minus(_) => (
            advance(p)
            val expr ast.Expr = parse_expr_postfix(p, arena)
            return ast.Expr.Unary(@addr(ast.ExprUnary(
                op: ast.UnaryOp.Neg,
                expr: box_expr(arena, expr)
            )))
        )
        ast.TokenKind.Tilde(_) => (
            advance(p)
            val expr ast.Expr = parse_expr_postfix(p, arena)
            return ast.Expr.Unary(@addr(ast.ExprUnary(
                op: ast.UnaryOp.BitNot,
                expr: box_expr(arena, expr)
            )))
        )
        ast.TokenKind.LParen(_) => (
            advance(p)
            consume_newlines(p)
            val expr ast.Expr = parse_expr(p, arena)
            consume_newlines(p)
            match p.tokens[p.pos].kind
                ast.TokenKind.RParen(_) => advance(p)
                _ => ()
            end
            return expr
        )
        ast.TokenKind.LBracket(_) => (
            advance(p)
            var elems list[ast.Expr] = []
            consume_newlines(p)
            for !is_eof(p)
                match p.tokens[p.pos].kind
                    ast.TokenKind.RBracket(_) => break
                    _ => ()
                end
                @append(elems, parse_expr(p, arena))
                match p.tokens[p.pos].kind
                    ast.TokenKind.Comma(_) => (
                        advance(p)
                        consume_newlines(p)
                    )
                    _ => break
                end
            end
            match p.tokens[p.pos].kind
                ast.TokenKind.RBracket(_) => advance(p)
                _ => ()
            end
            return ast.Expr.ListLit(elems)
        )
        ast.TokenKind.LBrace(_) => (
            advance(p)
            var elems list[ast.Expr] = []
            consume_newlines(p)
            for !is_eof(p)
                match p.tokens[p.pos].kind
                    ast.TokenKind.RBrace(_) => break
                    _ => ()
                end
                @append(elems, parse_expr(p, arena))
                match p.tokens[p.pos].kind
                    ast.TokenKind.Comma(_) => (
                        advance(p)
                        consume_newlines(p)
                    )
                    _ => break
                end
            end
            match p.tokens[p.pos].kind
                ast.TokenKind.RBrace(_) => advance(p)
                _ => ()
            end
            return ast.Expr.Pack(elems)
        )
        ast.TokenKind.Ident(name) => (
            advance(p)
            var segments list[ref(u8)] = [name]
            for
                match p.tokens[p.pos].kind
                    ast.TokenKind.Dot(_) => ()
                    _ => break
                end
                advance(p)
                val next ref(u8) = expect_ident(p, arena)
                @append(segments, next)
            end
            if @len(segments) == 1
                return ast.Expr.Ident(name)
            else
                return ast.Expr.Path(segments)
            end
        )
        _ => (
            val tok_line usize = p.tokens[p.pos].line
            val tok_col usize = p.tokens[p.pos].column
            @print("{s}:{d}:{d}: parse error: unexpected token in expression\n", {p.source_file, tok_line, tok_col})
            error_count++
            advance(p)
            return ast.Expr.None(0)
        )
    end
end

def binary_op_precedence_or() usize
    return 1
end

def binary_op_precedence_and() usize
    return 2
end

def binary_op_precedence_bitor() usize
    return 3
end

def binary_op_precedence_bitxor() usize
    return 4
end

def binary_op_precedence_bitand() usize
    return 5
end

def binary_op_precedence_comparison() usize
    return 6
end

def binary_op_precedence_shift() usize
    return 7
end

def binary_op_precedence_additive() usize
    return 8
end

def binary_op_precedence_multiplicative() usize
    return 9
end

def token_to_binary_op(kind ast.TokenKind) ast.BinaryOp
    match kind
        ast.TokenKind.Plus(_) => return ast.BinaryOp.Add
        ast.TokenKind.Minus(_) => return ast.BinaryOp.Subtract
        ast.TokenKind.Star(_) => return ast.BinaryOp.Multiply
        ast.TokenKind.Slash(_) => return ast.BinaryOp.Divide
        ast.TokenKind.Percent(_) => return ast.BinaryOp.Modulo
        ast.TokenKind.AmpAmp(_) => return ast.BinaryOp.LogicalAnd
        ast.TokenKind.PipePipe(_) => return ast.BinaryOp.LogicalOr
        ast.TokenKind.Amp(_) => return ast.BinaryOp.BitAnd
        ast.TokenKind.Pipe(_) => return ast.BinaryOp.BitOr
        ast.TokenKind.Caret(_) => return ast.BinaryOp.BitXor
        ast.TokenKind.ShiftLeft(_) => return ast.BinaryOp.ShiftLeft
        ast.TokenKind.ShiftRight(_) => return ast.BinaryOp.ShiftRight
        ast.TokenKind.Less(_) => return ast.BinaryOp.LessThan
        ast.TokenKind.LessEqual(_) => return ast.BinaryOp.LessEqual
        ast.TokenKind.Greater(_) => return ast.BinaryOp.GreaterThan
        ast.TokenKind.GreaterEqual(_) => return ast.BinaryOp.GreaterEqual
        ast.TokenKind.EqualEqual(_) => return ast.BinaryOp.Equal
        ast.TokenKind.BangEqual(_) => return ast.BinaryOp.NotEqual
        _ => return ast.BinaryOp.Add
    end
end

def is_module_use(p ref(ast.TokenList)) bool
    var i usize = p.pos + 1
    for i < @len(p.tokens)
        match p.tokens[i].kind
            ast.TokenKind.Newline(_) => i++
            _ => break
        end
    end
    match p.tokens[i].kind
        ast.TokenKind.Ident(_) => i++
        _ => return false
    end
    match p.tokens[i].kind
        ast.TokenKind.Assign(_) => i++
        _ => return false
    end
    match p.tokens[i].kind
        ast.TokenKind.Ident(name) => return str.eql(name, "use")
        _ => return false
    end
end

def parse_module_use(p ref(ast.TokenList), arena ref(allocators.Arena)) ast.ModuleUse
    advance(p)
    val name ref(u8) = expect_ident(p, arena)
    match p.tokens[p.pos].kind
        ast.TokenKind.Assign(_) => advance(p)
        _ => ()
    end
    match p.tokens[p.pos].kind
        ast.TokenKind.Ident(_) => advance(p)
        _ => ()
    end
    match p.tokens[p.pos].kind
        ast.TokenKind.LParen(_) => advance(p)
        _ => ()
    end
    var path ref(u8) = @zeroed()
    match p.tokens[p.pos].kind
        ast.TokenKind.Str(s) => (
            path = s
            advance(p)
        )
        _ => (
            val empty_res = allocators.Arena.alloc(arena, 1)
            match empty_res
                ok m => (
                    @deref(@as_mut(m as ref(u8))) = 0
                    path = m as ref(u8)
                )
                error _ => path = ""
            end
        )
    end
    match p.tokens[p.pos].kind
        ast.TokenKind.RParen(_) => advance(p)
        _ => ()
    end
    expect_newline(p)
    return ast.ModuleUse(name: name, path: path)
end

def parse_function(p ref(ast.TokenList), arena ref(allocators.Arena), is_pub bool, current_platform ref(u8)) ast.Function
    val line usize = p.tokens[p.pos].line
    val column usize = p.tokens[p.pos].column
    advance(p)

    val name ref(u8) = parse_dotted_name(p, arena)

    var generic_params list[ref(u8)] = []
    match p.tokens[p.pos].kind
        ast.TokenKind.LBracket(_) => (
            advance(p)
            for !is_eof(p)
                match p.tokens[p.pos].kind
                    ast.TokenKind.RBracket(_) => break
                    _ => ()
                end
                val gname ref(u8) = expect_ident(p, arena)
                @append(generic_params, gname)
                match p.tokens[p.pos].kind
                    ast.TokenKind.Colon(_) => (
                        advance(p)
                        parse_type(p, arena)
                    )
                    _ => ()
                end
                match p.tokens[p.pos].kind
                    ast.TokenKind.Comma(_) => advance(p)
                    _ => break
                end
            end
            match p.tokens[p.pos].kind
                ast.TokenKind.RBracket(_) => advance(p)
                _ => ()
            end
        )
        _ => ()
    end

    match p.tokens[p.pos].kind
        ast.TokenKind.LParen(_) => advance(p)
        _ => ()
    end
    consume_newlines(p)

    var params list[ast.Param] = []
    match p.tokens[p.pos].kind
        ast.TokenKind.RParen(_) => advance(p)
        _ => (
            for
                val pline usize = p.tokens[p.pos].line
                val pcol usize = p.tokens[p.pos].column
                val pname ref(u8) = expect_ident(p, arena)
                val ptype ast.Type = parse_type(p, arena)
                @append(params, ast.Param(name: pname, ty: ptype, line: pline, column: pcol))
                match p.tokens[p.pos].kind
                    ast.TokenKind.Comma(_) => (
                        advance(p)
                        consume_newlines(p)
                    )
                    _ => break
                end
            end
            consume_newlines(p)
            match p.tokens[p.pos].kind
                ast.TokenKind.RParen(_) => advance(p)
                _ => ()
            end
        )
    end

    var return_type ast.Type = @zeroed()
    if starts_type(p)
        return_type = parse_type_with_error_union(p, arena)
    else
        return_type = ast.Type.Void(0)
    end

    expect_newline(p)
    val body list[ast.Stmt] = parse_block(p, arena, current_platform)
    if !is_eof(p)
        advance(p)
    end
  
    val empty_res = allocators.Arena.alloc(arena, 1)
    var empty ref(u8) = ""
    match empty_res
        ok m => (
            @deref(@as_mut(m as ref(u8))) = 0
            empty = m as ref(u8)
        )
        error _ => ()
    end

    return ast.Function(
        name: name,
        params: params,
        return_type: return_type,
        body: body,
        is_pub: is_pub,
        is_extern: false,
        extern_name: empty,
        generic_params: generic_params,
        line: line,
        column: column
    )
end

def parse_extern_function(p ref(ast.TokenList), arena ref(allocators.Arena), is_pub bool) ast.Function
    val line usize = p.tokens[p.pos].line
    val column usize = p.tokens[p.pos].column
    advance(p)

    val name ref(u8) = parse_dotted_name(p, arena)

    match p.tokens[p.pos].kind
        ast.TokenKind.LParen(_) => advance(p)
        _ => ()
    end
    consume_newlines(p)

    var params list[ast.Param] = []
    match p.tokens[p.pos].kind
        ast.TokenKind.RParen(_) => advance(p)
        _ => (
            for
                val pline usize = p.tokens[p.pos].line
                val pcol usize = p.tokens[p.pos].column
                val pname ref(u8) = expect_ident(p, arena)
                val ptype ast.Type = parse_type(p, arena)
                @append(params, ast.Param(name: pname, ty: ptype, line: pline, column: pcol))
                match p.tokens[p.pos].kind
                    ast.TokenKind.Comma(_) => (
                        advance(p)
                        consume_newlines(p)
                    )
                    _ => break
                end
            end
            consume_newlines(p)
            match p.tokens[p.pos].kind
                ast.TokenKind.RParen(_) => advance(p)
                _ => ()
            end
        )
    end

    var return_type ast.Type = ast.Type.Void(0)
    if next_non_newline_kind(p) == 204
        return_type = ast.Type.Void(0)
    elif starts_type(p)
        return_type = parse_type_with_error_union(p, arena)
    else
        return_type = ast.Type.Void(0)
    end

    match p.tokens[p.pos].kind
        ast.TokenKind.ColonColon(_) => advance(p)
        _ => ()
    end

    val extern_name_res = allocators.Arena.alloc(arena, 1)
    var extern_name ref(u8) = ""
    match extern_name_res
        ok m => (
            @deref(@as_mut(m as ref(u8))) = 0
            extern_name = m as ref(u8)
        )
        error _ => ()
    end

    match p.tokens[p.pos].kind
        ast.TokenKind.Str(s) => (
            extern_name = s
            advance(p)
        )
        _ => ()
    end

    expect_newline(p)

    return ast.Function(
        name: name,
        params: params,
        return_type: return_type,
        body: ([] as list[ast.Stmt]),
        is_pub: is_pub,
        is_extern: true,
        extern_name: extern_name,
        generic_params: [] as list[ref(u8)],
        line: line,
        column: column
    )
end

def parse_test_block(p ref(ast.TokenList), arena ref(allocators.Arena), current_platform ref(u8)) ast.TestBlock
    advance(p)

    val name_res = allocators.Arena.alloc(arena, 1)
    var name ref(u8) = ""
    match name_res
        ok m => (
            @deref(@as_mut(m as ref(u8))) = 0
            name = m as ref(u8)
        )
        error _ => ()
    end

    match p.tokens[p.pos].kind
        ast.TokenKind.Str(s) => (
            name = s
            advance(p)
        )
        _ => ()
    end

    expect_newline(p)
    val body list[ast.Stmt] = parse_block(p, arena, current_platform)
    if !is_eof(p)
        advance(p)
    end

    return ast.TestBlock(name: name, body: body)
end

def skip_top_level_item(p ref(ast.TokenList))
    match p.tokens[p.pos].kind
        ast.TokenKind.Keyword(v) => (
            if v == KW_PUB
                advance(p)
                skip_top_level_item(p)
            elif needs_end_kw(v)
                advance(p)
                if v == KW_WHEN
                    skip_to_newline(p)
                end
                skip_block(p)
            elif v == KW_LINK
                advance(p)
                skip_to_newline(p)
            else
                advance(p)
            end
        )
        _ => advance(p)
    end
end

def parse_interface_def(p ref(ast.TokenList), arena ref(allocators.Arena), is_pub_val bool) ast.InterfaceDef
    advance(p)
    val name ref(u8) = expect_ident(p, arena)
    expect_newline(p)
    var methods list[ast.InterfaceMethod] = []
    for !is_keyword(p, KW_END) && !is_eof(p)
        var method_is_pub bool = false
        if is_keyword(p, KW_PUB)
            advance(p)
            method_is_pub = true
        end
        if is_keyword(p, KW_DEF)
            advance(p)
        end
        val method_name ref(u8) = expect_ident(p, arena)
        match p.tokens[p.pos].kind
            ast.TokenKind.LParen(_) => advance(p)
            _ => ()
        end
        consume_newlines(p)
        var params list[ast.Param] = []
        match p.tokens[p.pos].kind
            ast.TokenKind.RParen(_) => advance(p)
            _ => (
                for
                    val pline usize = p.tokens[p.pos].line
                    val pcol usize = p.tokens[p.pos].column
                    val pname ref(u8) = expect_ident(p, arena)
                    val ptype ast.Type = parse_type(p, arena)
                    @append(params, ast.Param(name: pname, ty: ptype, line: pline, column: pcol))
                    match p.tokens[p.pos].kind
                        ast.TokenKind.Comma(_) => (
                            advance(p)
                            consume_newlines(p)
                        )
                        _ => break
                    end
                end
                consume_newlines(p)
                match p.tokens[p.pos].kind
                    ast.TokenKind.RParen(_) => advance(p)
                    _ => ()
                end
            )
        end
        var return_type ast.Type = ast.Type.Void(0)
        if starts_type(p)
            return_type = parse_type_with_error_union(p, arena)
        end
        expect_newline(p)
        @append(methods, ast.InterfaceMethod(
            is_pub: method_is_pub,
            name: method_name,
            params: params,
            return_type: return_type
        ))
        consume_newlines(p)
    end
    if !is_eof(p)
        advance(p)
    end
    consume_newlines(p)
    return ast.InterfaceDef(
        is_pub: is_pub_val,
        name: name,
        methods: methods
    )
end

def parse_type_def(p ref(ast.TokenList), arena ref(allocators.Arena), is_pub_val bool) ast.TypeDef
    advance(p)
    val name ref(u8) = expect_ident(p, arena)
    var derives list[ref(u8)] = []
    match p.tokens[p.pos].kind
        ast.TokenKind.Colon(_) => (
            advance(p)
            val iface_name ref(u8) = expect_ident(p, arena)
            @append(derives, iface_name)
        )
        _ => ()
    end
    consume_newlines(p)
    var fields list[ast.FieldDef] = []
    for !is_keyword(p, KW_END) && !is_eof(p)
        val field_name ref(u8) = expect_ident(p, arena)
        val field_type ast.Type = parse_type(p, arena)
        expect_newline(p)
        consume_newlines(p)
        val field_def ast.FieldDef = ast.FieldDef(
            name: field_name,
            ty: field_type,
            line: 0,
            column: 0
        )
        @append(fields, field_def)
    end
    if !is_eof(p)
        advance(p)
    end
    consume_newlines(p)
    return ast.TypeDef(
        name: name,
        kind: ast.TypeDefKind.Struct,
        fields: fields,
        variants: ([] as list[ast.VariantDef]),
        is_pub: is_pub_val,
        derives: derives
    )
end

def parse_union_def(p ref(ast.TokenList), arena ref(allocators.Arena), is_pub_val bool) ast.TypeDef
    advance(p)
    val name ref(u8) = expect_ident(p, arena)
    consume_newlines(p)
    var variants list[ast.VariantDef] = []
    for !is_keyword(p, KW_END) && !is_eof(p)
        val variant_name ref(u8) = expect_ident(p, arena)
        var payload_types list[ast.Type] = []
        match p.tokens[p.pos].kind
            ast.TokenKind.LParen(_) => (
                advance(p)
                consume_newlines(p)
                if !is_keyword(p, KW_END) && !is_eof(p)
                    for
                        @append(payload_types, parse_type(p, arena))
                        match p.tokens[p.pos].kind
                            ast.TokenKind.Comma(_) => (
                                advance(p)
                                consume_newlines(p)
                            )
                            _ => break
                        end
                    end
                end
                match p.tokens[p.pos].kind
                    ast.TokenKind.RParen(_) => advance(p)
                    _ => ()
                end
            )
            _ => ()
        end
        expect_newline(p)
        consume_newlines(p)
        val variant_def ast.VariantDef = ast.VariantDef(
            name: variant_name,
            payload_types: payload_types
        )
        @append(variants, variant_def)
    end
    if !is_eof(p)
        advance(p)
    end
    consume_newlines(p)
    return ast.TypeDef(
        name: name,
        kind: ast.TypeDefKind.Union,
        fields: ([] as list[ast.FieldDef]),
        variants: variants,
        is_pub: is_pub_val,
        derives: ([] as list[ref(u8)])
    )
end

def parse_enum_def(p ref(ast.TokenList), arena ref(allocators.Arena), is_pub_val bool) ast.TypeDef
    advance(p)
    val name ref(u8) = expect_ident(p, arena)
    consume_newlines(p)
    var variants list[ast.VariantDef] = []
    for !is_keyword(p, KW_END) && !is_eof(p)
        val variant_name ref(u8) = expect_ident(p, arena)
        expect_newline(p)
        consume_newlines(p)
        val variant_def ast.VariantDef = ast.VariantDef(
            name: variant_name,
            payload_types: ([] as list[ast.Type])
        )
        @append(variants, variant_def)
    end
    if !is_eof(p)
        advance(p)
    end
    consume_newlines(p)
    return ast.TypeDef(
        name: name,
        kind: ast.TypeDefKind.Enum,
        fields: ([] as list[ast.FieldDef]),
        variants: variants,
        is_pub: is_pub_val,
        derives: ([] as list[ref(u8)])
    )
end

pub def parse_program(tokens list[ast.Token], arena ref(allocators.Arena), current_platform ref(u8), source_file ref(u8)) ast.Program
    var p ast.TokenList = ast.TokenList(tokens: tokens, pos: 0, source_file: source_file)
    var module_uses list[ast.ModuleUse] = []
    var functions list[ast.Function] = []
    var type_defs list[ast.TypeDef] = []
    var interface_defs list[ast.InterfaceDef] = []
    var tests list[ast.TestBlock] = []
    var extern_headers list[ref(u8)] = []

    consume_newlines(@addr(p))

    for !is_eof(@addr(p))
        consume_newlines(@addr(p))
        if is_keyword(@addr(p), KW_DEF)
            @append(functions, parse_function(@addr(p), arena, false, current_platform))
        elif is_keyword(@addr(p), KW_PUB) && next_is_keyword(@addr(p), KW_EXTERN)
            advance(@addr(p))
            advance(@addr(p))
            if is_keyword(@addr(p), KW_DEF)
                @append(functions, parse_extern_function(@addr(p), arena, true))
            else
                skip_to_newline(@addr(p))
            end
        elif is_keyword(@addr(p), KW_PUB) && next_is_keyword(@addr(p), KW_DEF)
            advance(@addr(p))
            @append(functions, parse_function(@addr(p), arena, true, current_platform))
        elif is_keyword(@addr(p), KW_PUB) && next_is_keyword(@addr(p), KW_TYPE)
            advance(@addr(p))
            @append(type_defs, parse_type_def(@addr(p), arena, true))
        elif is_keyword(@addr(p), KW_PUB) && next_is_keyword(@addr(p), KW_UNION)
            advance(@addr(p))
            @append(type_defs, parse_union_def(@addr(p), arena, true))
        elif is_keyword(@addr(p), KW_PUB) && next_is_keyword(@addr(p), KW_ENUM)
            advance(@addr(p))
            @append(type_defs, parse_enum_def(@addr(p), arena, true))
        elif is_keyword(@addr(p), KW_PUB) && next_is_keyword(@addr(p), KW_IFACE)
            advance(@addr(p))
            @append(interface_defs, parse_interface_def(@addr(p), arena, true))
        elif is_keyword(@addr(p), KW_IFACE)
            @append(interface_defs, parse_interface_def(@addr(p), arena, false))
        elif is_keyword(@addr(p), KW_PUB)
            advance(@addr(p))
            skip_top_level_item(@addr(p))
        elif is_keyword(@addr(p), KW_EXTERN)
            advance(@addr(p))
            if is_keyword(@addr(p), KW_DEF)
                @append(functions, parse_extern_function(@addr(p), arena, false))
            else
                match p.tokens[p.pos].kind
                    ast.TokenKind.Str(s) => (
                        @append(extern_headers, s)
                        advance(@addr(p))
                        expect_newline(@addr(p))
                    )
                    _ => skip_to_newline(@addr(p))
                end
            end
        elif is_keyword(@addr(p), KW_TYPE)
            @append(type_defs, parse_type_def(@addr(p), arena, false))
        elif is_keyword(@addr(p), KW_UNION)
            @append(type_defs, parse_union_def(@addr(p), arena, false))
        elif is_keyword(@addr(p), KW_ENUM)
            @append(type_defs, parse_enum_def(@addr(p), arena, false))
        elif is_keyword(@addr(p), KW_TEST)
            @append(tests, parse_test_block(@addr(p), arena, current_platform))
        elif is_keyword(@addr(p), KW_VAL) && is_module_use(@addr(p))
            @append(module_uses, parse_module_use(@addr(p), arena))
        elif is_keyword(@addr(p), KW_VAL) || is_keyword(@addr(p), KW_VAR)
            skip_to_newline(@addr(p))
        elif is_keyword(@addr(p), KW_WHEN)
            advance(@addr(p))
            val matches bool = parse_when_condition(@addr(p), arena, current_platform)
            expect_newline(@addr(p))
            if matches
                consume_newlines(@addr(p))
                for !is_eof(@addr(p)) && !is_keyword(@addr(p), KW_END)
                    consume_newlines(@addr(p))
                    if is_keyword(@addr(p), KW_DEF)
                        @append(functions, parse_function(@addr(p), arena, false, current_platform))
                    elif is_keyword(@addr(p), KW_PUB) && next_is_keyword(@addr(p), KW_EXTERN)
                        advance(@addr(p))
                        advance(@addr(p))
                        if is_keyword(@addr(p), KW_DEF)
                            @append(functions, parse_extern_function(@addr(p), arena, true))
                        else
                            skip_to_newline(@addr(p))
                        end
                    elif is_keyword(@addr(p), KW_PUB) && next_is_keyword(@addr(p), KW_DEF)
                        advance(@addr(p))
                        @append(functions, parse_function(@addr(p), arena, true, current_platform))
                    elif is_keyword(@addr(p), KW_PUB) && next_is_keyword(@addr(p), KW_TYPE)
                        advance(@addr(p))
                        @append(type_defs, parse_type_def(@addr(p), arena, true))
                    elif is_keyword(@addr(p), KW_PUB) && next_is_keyword(@addr(p), KW_UNION)
                        advance(@addr(p))
                        @append(type_defs, parse_union_def(@addr(p), arena, true))
                    elif is_keyword(@addr(p), KW_PUB) && next_is_keyword(@addr(p), KW_ENUM)
                        advance(@addr(p))
                        @append(type_defs, parse_enum_def(@addr(p), arena, true))
                    elif is_keyword(@addr(p), KW_PUB) && next_is_keyword(@addr(p), KW_IFACE)
                        advance(@addr(p))
                        @append(interface_defs, parse_interface_def(@addr(p), arena, true))
                    elif is_keyword(@addr(p), KW_IFACE)
                        @append(interface_defs, parse_interface_def(@addr(p), arena, false))
                    elif is_keyword(@addr(p), KW_PUB)
                        advance(@addr(p))
                        skip_top_level_item(@addr(p))
                    elif is_keyword(@addr(p), KW_EXTERN)
                        advance(@addr(p))
                        if is_keyword(@addr(p), KW_DEF)
                            @append(functions, parse_extern_function(@addr(p), arena, false))
                        else
                            match p.tokens[p.pos].kind
                                ast.TokenKind.Str(s) => (
                                    @append(extern_headers, s)
                                    advance(@addr(p))
                                    expect_newline(@addr(p))
                                )
                                _ => skip_to_newline(@addr(p))
                            end
                        end
                    elif is_keyword(@addr(p), KW_TYPE)
                        @append(type_defs, parse_type_def(@addr(p), arena, false))
                    elif is_keyword(@addr(p), KW_UNION)
                        @append(type_defs, parse_union_def(@addr(p), arena, false))
                    elif is_keyword(@addr(p), KW_ENUM)
                        @append(type_defs, parse_enum_def(@addr(p), arena, false))
                    elif is_keyword(@addr(p), KW_TEST)
                        @append(tests, parse_test_block(@addr(p), arena, current_platform))
                    elif is_keyword(@addr(p), KW_VAL) && is_module_use(@addr(p))
                        @append(module_uses, parse_module_use(@addr(p), arena))
                    elif is_keyword(@addr(p), KW_VAL) || is_keyword(@addr(p), KW_VAR)
                        skip_to_newline(@addr(p))
                    elif is_keyword(@addr(p), KW_WHEN)
                        advance(@addr(p))
                        val inner_matches bool = parse_when_condition(@addr(p), arena, current_platform)
                        expect_newline(@addr(p))
                        if inner_matches
                            consume_newlines(@addr(p))
                            for !is_eof(@addr(p)) && !is_keyword(@addr(p), KW_END)
                                consume_newlines(@addr(p))
                                if is_keyword(@addr(p), KW_DEF)
                                    @append(functions, parse_function(@addr(p), arena, false, current_platform))
                                elif is_keyword(@addr(p), KW_PUB) && next_is_keyword(@addr(p), KW_EXTERN)
                                    advance(@addr(p))
                                    advance(@addr(p))
                                    if is_keyword(@addr(p), KW_DEF)
                                        @append(functions, parse_extern_function(@addr(p), arena, true))
                                    else
                                        skip_to_newline(@addr(p))
                                    end
                                elif is_keyword(@addr(p), KW_PUB) && next_is_keyword(@addr(p), KW_DEF)
                                    advance(@addr(p))
                                    @append(functions, parse_function(@addr(p), arena, true, current_platform))
                                elif is_keyword(@addr(p), KW_PUB) && next_is_keyword(@addr(p), KW_TYPE)
                                    advance(@addr(p))
                                    @append(type_defs, parse_type_def(@addr(p), arena, true))
                                elif is_keyword(@addr(p), KW_PUB) && next_is_keyword(@addr(p), KW_UNION)
                                    advance(@addr(p))
                                    @append(type_defs, parse_union_def(@addr(p), arena, true))
                                elif is_keyword(@addr(p), KW_PUB) && next_is_keyword(@addr(p), KW_ENUM)
                                    advance(@addr(p))
                                    @append(type_defs, parse_enum_def(@addr(p), arena, true))
                                elif is_keyword(@addr(p), KW_PUB) && next_is_keyword(@addr(p), KW_IFACE)
                                    advance(@addr(p))
                                    @append(interface_defs, parse_interface_def(@addr(p), arena, true))
                                elif is_keyword(@addr(p), KW_IFACE)
                                    @append(interface_defs, parse_interface_def(@addr(p), arena, false))
                                elif is_keyword(@addr(p), KW_PUB)
                                    advance(@addr(p))
                                    skip_top_level_item(@addr(p))
                                elif is_keyword(@addr(p), KW_EXTERN)
                                    advance(@addr(p))
                                    if is_keyword(@addr(p), KW_DEF)
                                        @append(functions, parse_extern_function(@addr(p), arena, false))
                                    else
                                        match p.tokens[p.pos].kind
                                            ast.TokenKind.Str(s) => (
                                                @append(extern_headers, s)
                                                advance(@addr(p))
                                                expect_newline(@addr(p))
                                            )
                                            _ => skip_to_newline(@addr(p))
                                        end
                                    end
                                elif is_keyword(@addr(p), KW_TYPE)
                                    @append(type_defs, parse_type_def(@addr(p), arena, false))
                                elif is_keyword(@addr(p), KW_UNION)
                                    @append(type_defs, parse_union_def(@addr(p), arena, false))
                                elif is_keyword(@addr(p), KW_ENUM)
                                    @append(type_defs, parse_enum_def(@addr(p), arena, false))
                                elif is_keyword(@addr(p), KW_TEST)
                                    @append(tests, parse_test_block(@addr(p), arena, current_platform))
                                elif is_keyword(@addr(p), KW_VAL) && is_module_use(@addr(p))
                                    @append(module_uses, parse_module_use(@addr(p), arena))
                                elif is_keyword(@addr(p), KW_VAL) || is_keyword(@addr(p), KW_VAR)
                                    skip_to_newline(@addr(p))
                                else
                                    skip_top_level_item(@addr(p))
                                end
                                consume_newlines(@addr(p))
                            end
                        else
                            skip_block(@addr(p))
                        end
                        if !is_eof(@addr(p)) && is_keyword(@addr(p), KW_END)
                            advance(@addr(p))
                        end
                    else
                        skip_top_level_item(@addr(p))
                    end
                    consume_newlines(@addr(p))
                end
            else
                skip_block(@addr(p))
            end
            if !is_eof(@addr(p)) && is_keyword(@addr(p), KW_END)
                advance(@addr(p))
            end
        else
            skip_top_level_item(@addr(p))
        end
        consume_newlines(@addr(p))
    end

    if error_count > 0
        @print("\nscar: compilation aborted with {d} errors\n", {error_count})
        os.exit(1)
    end

    return ast.Program(
        module_uses: module_uses,
        functions: functions,
        type_defs: type_defs,
        interface_defs: interface_defs,
        tests: tests,
        extern_headers: extern_headers
    )
end
