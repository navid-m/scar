import "std/os"
import "std/math"

class TreeNode:
    init:
        ref TreeNode this.left = nil
        ref TreeNode this.right = nil
    
    fn init_with_children(ref TreeNode left, ref TreeNode right) -> void:
        this.left = left
        this.right = right
    
    stat fn bottom_up_tree(int depth) -> ref TreeNode:
        if depth > 0:
            ref TreeNode left_child = TreeNode::bottom_up_tree(depth - 1)
            ref TreeNode right_child = TreeNode::bottom_up_tree(depth - 1)
            var node = new TreeNode()
            node.init_with_children(left_child, right_child)
            return node
        else:
            return new TreeNode()
    
    fn item_check() -> int:
        if this.left == nil:
            return 1
        else:
            return 1 + this.left.item_check() + this.right.item_check()

int MIN_DEPTH = 4
int NO_TASKS = 4

list[string] args = os::get_args()

int max_depth = 10  # Default value
if len(args) > 1:
    int parsed_depth = math::to_int(args[1])
    max_depth = math::max(MIN_DEPTH + 2, parsed_depth)

print "hi"

# Stretch tree
ref TreeNode stretch_tree = TreeNode::bottom_up_tree(max_depth + 1)
int stretch_check = stretch_tree.item_check()

print "hi2"

print "stretch tree of depth %d\t check: %d" | (max_depth + 1), stretch_check

# Long lived tree
ref TreeNode long_lived_tree = TreeNode::bottom_up_tree(max_depth)

# Calculate number of result entries
int result_count = (max_depth - MIN_DEPTH) / 2 + 1
allocate string results = result_count

# Process each depth level
for i = 0 to (result_count - 1):
    int depth = i * 2 + MIN_DEPTH
    int n = (1 << (max_depth - depth + MIN_DEPTH)) / NO_TASKS
    
    # Use parallel for with reduction to process tasks in parallel
    int total_check = 0
    
    parallel for t = 0 to (NO_TASKS - 1) reduce(sum: total_check):
        int check = 0
        for i32 j = n; j >= 1; j--:
            ref TreeNode tree = TreeNode::bottom_up_tree(depth)
            check = check + tree.item_check()
        total_check = total_check + check
    
    # Format result string
    print "%d\t trees of depth %d\t check: %d" | (n * NO_TASKS), depth, total_check

# Final long lived tree check
int long_lived_check = long_lived_tree.item_check()
print "long lived tree of depth %d\t check: %d" | max_depth, long_lived_check

free results
